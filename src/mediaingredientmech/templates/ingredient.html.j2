<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ingredient.preferred_term }} — MIM</title>
<link rel="stylesheet" href="{{ path_up }}style.css">
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>

<nav class="site-nav" aria-label="Site navigation">
  <a href="{{ path_up }}../index.html">Home</a> &middot;
  <a href="{{ path_up }}../browser.html">Browse ingredients</a> &middot;
  <a href="{{ path_up }}index.html">Record Index</a> &middot;
  <a href="{{ path_up }}../text_map.html">Text Map</a> &middot;
  <a href="{{ path_up }}../ingredient_umap.html">KG PaCMAP</a> &middot;
  <a href="{{ path_up }}../ingredient_graph.html">Graph Layout</a> &middot;
  <a href="{{ path_up }}../app/discussions/index.html">Discussions</a> &middot;
  <a href="{{ path_up }}../schema/index.html">Schema</a> &middot;
  <a href="{{ path_up }}../index.html#downloads">Downloads</a> &middot;
  <a href="https://culturebotai.github.io/mechs/">All Mech projects</a>
</nav>
{# The trail's category is the record's mapping status: a subset of the listing. #}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li><a href="{{ path_up }}../index.html">Home</a></li>
    <li><a href="{{ path_up }}../browser.html">Ingredients</a></li>
    {% if ingredient.mapping_status %}
    <li><a href="{{ path_up }}../browser.html?status={{ ingredient.mapping_status | urlencode }}">{{ ingredient.mapping_status }}</a></li>
    {% endif %}
    <li><span aria-current="page">{{ ingredient.preferred_term }}</span></li>
  </ol>
</nav>

<header>
  <form class="record-search" action="{{ path_up }}../browser.html" method="get" role="search">
    <label class="sr-only" for="record-search-input">Search ingredients</label>
    <input type="search" id="record-search-input" name="q" placeholder="Search ingredients, synonyms, or ontology IDs...">
    <button type="submit">Search</button>
  </form>
  <h1>{{ ingredient.preferred_term }}</h1>
  <div class="meta">
    <span class="curie">{{ ingredient.identifier }}</span>
    {% if ingredient.ingredient_type %}
      {% set t = ingredient.ingredient_type %}
      {% if t == 'SINGLE_INGREDIENT' %}
        <span class="badge type-defined">chemically defined</span>
      {% elif t == 'STOCK_SOLUTION' %}
        <span class="badge type-defined">defined mix</span>
      {% elif t == 'NAMED_MEDIUM' %}
        <span class="badge type-defined">defined medium</span>
      {% elif t == 'UNDEFINED_MIXTURE' %}
        <span class="badge type-complex">complex</span>
      {% endif %}
    {% endif %}
    {% if ingredient.mapping_status %}
      <span class="badge">{{ ingredient.mapping_status }}</span>
    {% endif %}
    {% set om = ingredient.ontology_mapping or {} %}
    {% if om.ontology_source %}
      <span class="badge">{{ om.ontology_source }}</span>
    {% endif %}
    {% if om.mapping_quality %}
      <span class="badge">{{ om.mapping_quality }}</span>
    {% endif %}
    <a class="badge" href="{{ path_up }}../text_map.html?q={{ ingredient.identifier | urlencode }}">View in Text Map &rarr;</a>
  </div>
  {% set status_meaning = status_meanings.get(ingredient.mapping_status) %}
  {% set quality_meaning = quality_meanings.get(om.mapping_quality) %}
  {% set history = ingredient.curation_history or [] %}
  {% if status_meaning or quality_meaning or history %}
  <details class="status-meaning small">
    <summary>What this status means</summary>
    {% if status_meaning %}<p><a href="{{ path_up }}../schema/enumerations-MappingStatusEnum.html">{{ ingredient.mapping_status }}</a>: {{ status_meaning }}</p>{% endif %}
    {% if quality_meaning and om.mapping_quality in review_claims %}
    {# The history names who made each change, not whether a person reviewed it. #}
    <p><a href="{{ path_up }}../schema/enumerations-MappingQualityEnum.html">{{ om.mapping_quality }}</a>: the schema describes this value as &ldquo;{{ quality_meaning }}&rdquo;. This page cannot confirm that: the curation history records each curator as a username or system, and does not say whether a person reviewed the mapping.</p>
    {% elif quality_meaning %}<p><a href="{{ path_up }}../schema/enumerations-MappingQualityEnum.html">{{ om.mapping_quality }}</a>: {{ quality_meaning }}</p>{% endif %}
    {% if history %}
    {% set curators = history | map(attribute='curator') | select | unique | list %}
    {% set assisted = history | selectattr('llm_assisted') | list %}
    <p>The <a href="#curation_history">curation history</a> lists {{ history|length }} event{{ 's' if history|length != 1 }} by {{ curators|length }} curator{{ 's' if curators|length != 1 }} ({{ curators|join(', ') }}); {{ assisted|length }} {{ 'is' if assisted|length == 1 else 'are' }} marked LLM-assisted.</p>
    {% endif %}
  </details>
  {% endif %}
</header>

<main id="main-content">
{% include "_partials/overview.html.j2" %}
{% for field, title in [('nutritional_roles', 'Nutritional roles'), ('physicochemical_roles', 'Physicochemical roles'), ('cellular_metabolic_roles', 'Cellular metabolic roles'), ('community_organism_roles', 'Community & organism roles'), ('environmental_context', 'Environmental context'), ('culturemech_reference', 'Related CultureMech recipe'), ('causal_graphs', 'Causal & mechanistic graphs'), ('cross_corpus_links', 'Cross-corpus links'), ('protein_examples', 'Protein examples'), ('proposed_experiments', 'Proposed experiments')] %}
{% if ingredient.get(field) %}<section id="{{ field|replace('_', '-') }}"><h2>{{ title }}</h2>{{ ingredient[field]|structured }}</section>{% endif %}
{% endfor %}
{% if ingredient.synonyms %}{% include "_partials/synonyms.html.j2" %}{% endif %}
{% if ingredient.chemical_properties %}{% include "_partials/chemical_properties.html.j2" %}{% endif %}
{% if om.evidence %}{% include "_partials/evidence.html.j2" %}{% endif %}
{% if ingredient.components %}{% include "_partials/components.html.j2" %}{% endif %}
{% if ingredient.occurrence_statistics %}{% include "_partials/occurrence.html.j2" %}{% endif %}
{% if ingredient.curation_history %}{% include "_partials/curation_history.html.j2" %}{% endif %}
{% if ingredient.datasets %}{% include "_partials/datasets.html.j2" %}{% endif %}
{% if ingredient.discussions %}{% include "_partials/discussions.html.j2" %}{% endif %}

{% if om.ontology_id or ingredient.components or ingredient.nutritional_roles or ingredient.physicochemical_roles or ingredient.cellular_metabolic_roles %}
<section id="causal-graph">
  <h2>Role &amp; Partonomy Graph</h2>
  <ul class="graph-edges" style="list-style:none;padding-left:0;display:grid;gap:0.45rem;">
    {% if om.ontology_id %}
    <li>
      <code>{{ ingredient.preferred_term }} ({{ ingredient.identifier }})</code>
      <strong>&rarr; [MAPPED_TO ({{ om.mapping_quality or 'CURATED' }})] &rarr;</strong>
      {% set om_url = curie_to_url(om.ontology_id) %}
      {% if om_url %}<a href="{{ om_url }}" rel="noreferrer"><code>{{ om.ontology_id }}</code></a>{% else %}<code>{{ om.ontology_id }}</code>{% endif %}
      {% if om.ontology_label %} ({{ om.ontology_label }}){% endif %}
    </li>
    {% endif %}
    {% for comp in (ingredient.components or []) %}
    <li>
      <code>{{ ingredient.preferred_term }}</code>
      <strong>&rarr; [HAS_COMPONENT] &rarr;</strong>
      <span>{{ comp.component_name or comp.preferred_term or 'Component' }}</span>
      {% if comp.component_id %} (<code>{{ comp.component_id|linked_text }}</code>){% endif %}
    </li>
    {% endfor %}
    {% for role_item in (ingredient.nutritional_roles or []) %}
    <li>
      <code>{{ ingredient.preferred_term }}</code>
      <strong>&rarr; [HAS_NUTRITIONAL_ROLE] &rarr;</strong>
      <span>{{ role_item.role if role_item is mapping else role_item }}</span>
    </li>
    {% endfor %}
    {% for role_item in (ingredient.physicochemical_roles or []) %}
    <li>
      <code>{{ ingredient.preferred_term }}</code>
      <strong>&rarr; [HAS_PHYSICOCHEMICAL_ROLE] &rarr;</strong>
      <span>{{ role_item.role if role_item is mapping else role_item }}</span>
    </li>
    {% endfor %}
    {% for role_item in (ingredient.cellular_metabolic_roles or []) %}
    <li>
      <code>{{ ingredient.preferred_term }}</code>
      <strong>&rarr; [PARTICIPATES_IN] &rarr;</strong>
      <span>{{ (role_item.process or role_item.role) if role_item is mapping else role_item }}</span>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section id="cross-mech-links">
  <h2>Cross-Mech &amp; External Links</h2>
  <ul>
    <li><a href="{{ sibling_search.CultureMech }}{{ ingredient.preferred_term | urlencode }}">Search CultureMech media recipes for {{ ingredient.preferred_term }}</a></li>
    {% set ident_url = curie_to_url(ingredient.identifier) %}
    {% if ident_url %}
    <li><a href="{{ ident_url }}" rel="noreferrer">External Ontology Record ({{ ingredient.identifier }})</a></li>
    {% endif %}
  </ul>
</section>

</main>
<footer>
  <p class="record-source">
    Source record: <a href="{{ source_url }}"><code>{{ source_path }}</code></a>
    (<a href="{{ source_raw_url }}">raw YAML</a>) &middot;
    <a href="{{ source_edit_url }}">Edit on GitHub</a> &middot;
    <a href="{{ feedback_url }}">Report a problem with this record</a>
  </p>
  <p>
    Generated {{ generated_at }} &middot;
    <a href="{{ path_up }}../schema/index.html">Schema</a> &middot;
    <a href="{{ path_up }}build.json">Build Manifest</a>
  </p>
  <p class="licence">{{ licence_html }}</p>
</footer>

<script src="{{ path_up }}../theme-toggle.js"></script>
</body>
</html>

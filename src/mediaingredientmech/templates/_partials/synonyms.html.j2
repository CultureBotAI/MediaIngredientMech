{% set resolving_synonyms = ingredient.synonyms
  | rejectattr('synonym_type', 'equalto', 'REJECTED_LABEL') | list %}
{% set rejected_labels = ingredient.synonyms
  | selectattr('synonym_type', 'equalto', 'REJECTED_LABEL') | list %}
{% if resolving_synonyms %}
<section id="synonyms">
<h2>Synonyms <small class="muted">({{ resolving_synonyms|length }})</small></h2>
<table class="synonyms">
<thead>
<tr><th>Synonym</th><th>Type</th><th>Source</th><th class="right">Occurrences</th></tr>
</thead>
<tbody>
{% for s in resolving_synonyms %}
<tr>
  <td>{{ s.synonym_text }}</td>
  <td><span class="badge small">{{ s.synonym_type or '' }}</span></td>
  <td class="muted">{{ s.source or '' }}</td>
  <td class="right">{{ s.occurrence_count or '' }}</td>
</tr>
{% endfor %}
</tbody>
</table>
</section>
{% endif %}
{% if rejected_labels %}
<section id="rejected-labels">
<h2>Rejected enrichment labels <small class="muted">({{ rejected_labels|length }})</small></h2>
<p class="muted">Provenance-only candidates: these are not synonyms and do not resolve to this record.</p>
<table class="synonyms">
<thead>
<tr><th>Rejected label</th><th>Disposition</th><th>Source</th><th class="right">Occurrences</th></tr>
</thead>
<tbody>
{% for s in rejected_labels %}
<tr>
  <td>{{ s.synonym_text }}</td>
  <td><span class="badge small">{{ s.synonym_type or '' }}</span></td>
  <td class="muted">{{ s.source or '' }}</td>
  <td class="right">{{ s.occurrence_count or '' }}</td>
</tr>
{% endfor %}
</tbody>
</table>
</section>
{% endif %}

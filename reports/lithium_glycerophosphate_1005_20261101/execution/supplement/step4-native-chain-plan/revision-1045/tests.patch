+@pytest.fixture
+def record_git(tmp_path, monkeypatch):
+    """Real Git paths, including Unicode and newline quoting; no source corpus writes."""
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    def git(*args):
+        return subprocess.check_output(["git", *args], cwd=repo)
+    git("init", "-q")
+    git("config", "core.quotePath", "true")
+    git("config", "user.name", "Offline test")
+    git("config", "user.email", "offline-test@example.invalid")
+    owner = "data/ingredients/mapped/target.yaml"
+    paths = {owner, "data/ingredients/mapped/ASCII.yaml", "data/ingredients/mapped/β-Nicotinamide.yaml", "data/ingredients/mapped/Café.yaml", "data/ingredients/mapped/line\nbreak.yaml"}
+    for name in paths:
+        path = repo / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text("identifier: fixture\n")
+    (repo / ".gitignore").write_text("data/ingredients/mapped/ignored/\n")
+    git("add", ".")
+    git("commit", "-qm", "Offline path fixture")
+    monkeypatch.setattr(c, "ROOT", repo)
+    monkeypatch.setattr(c, "BASE", git("rev-parse", "HEAD").decode().strip())
+    monkeypatch.setattr(c, "OWNER", owner)
+    c.base.cache_clear()
+    yield repo, paths, git
+    c.base.cache_clear()
+

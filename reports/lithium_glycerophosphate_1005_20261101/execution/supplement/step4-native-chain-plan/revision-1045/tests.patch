+def test_real_git_unicode_and_newline_paths_are_exact(record_git):
+    repo, paths, git = record_git
+    legacy = {p for p in git("ls-tree", "-r", "--name-only", c.BASE, "data/ingredients").decode().splitlines() if p.endswith(".yaml")}
+    assert legacy < paths  # Real Git quotes names; this is the original failure mechanism.
+    assert c.individual_record_scope() == paths
+
+
+def test_real_git_only_target_content_change_is_allowed(record_git):
+    repo, paths, _ = record_git
+    (repo / c.OWNER).write_text("identifier: authorized-target-change\n")
+    assert c.individual_record_scope() == paths
+
+
+def test_real_git_ignored_nested_addition_is_refused(record_git):
+    repo, _, git = record_git
+    path = repo / "data/ingredients/mapped/ignored/Ω-new.yaml"
+    path.parent.mkdir()
+    path.write_text("identifier: unexpected\n")
+    assert git("check-ignore", str(path)).strip()
+    with pytest.raises(ValueError, match="membership changed"):
+        c.individual_record_scope()
+
+
+@pytest.mark.parametrize("name", ["ASCII.yaml", "β-Nicotinamide.yaml"])
+def test_real_git_removed_record_is_refused(record_git, name):
+    repo, _, _ = record_git
+    (repo / "data/ingredients/mapped" / name).unlink()
+    with pytest.raises(ValueError, match="membership changed"):
+        c.individual_record_scope()
+

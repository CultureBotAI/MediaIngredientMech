+    (inputs / 'Dated.yaml').write_text(base + 'preferred_term: Dated\n'
+        'curation_history:\n  - timestamp: "2026-10-15T00:00:00Z"\n')
+    (inputs / 'Dateless.yaml').write_text(base + 'preferred_term: Dateless\n')

                ],
                "steps": [
                    {
                        "step": "pH 8.3"
                    },
                    {
                        "step": "Mix ingredients vitamin B12, vitamin mixture, bicarbonate solution and neutralized sulfide solution. Dispense the medium into suitable culture vessels under a stream of nitrogen gas, seal with butyl rubber stoppers and autoclave at 121\u00b0C for 15 min. Separately autoclave neutralized sulfide solution under a N2 atmosphere. Sterilize Vitamin B12 solution, vitamin mixture, bicarbonate solution by filtration. Prior to inoculation, aseptically and anaerobically add vitamin B12 solution, vitamin mixture, bicarbonate solution and neutralized sulfide solution."
                    }
                ],
                "equipment": {
                    "27": "Filter",
                    "2077": "Autoclave",
                    "2325": "Anaerobic workbench"
                }

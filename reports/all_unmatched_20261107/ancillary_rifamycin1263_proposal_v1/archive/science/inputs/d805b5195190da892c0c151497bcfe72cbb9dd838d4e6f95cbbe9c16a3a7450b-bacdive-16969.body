				<div id="section_1" class="nav_viewport_section my-20 small-tables active" data-section-count="1">

					<h2>
						<!-- <img src="images/icons/icon-1.svg" class="section-icon" />  -->
						Name and taxonomic classification					</h2>

					<div class="detail-taxonomy">

						<!-- SECTION 1 START -->
						
															<div class="box px-20 py-10">
																			<a target="_blank" href="https://straininfo.dsmz.de/strain/40348"><img style="vertical-align:baseline;" src="images/logo/straininfo.svg" width="100"> <span>SI-ID 40348</span></a>

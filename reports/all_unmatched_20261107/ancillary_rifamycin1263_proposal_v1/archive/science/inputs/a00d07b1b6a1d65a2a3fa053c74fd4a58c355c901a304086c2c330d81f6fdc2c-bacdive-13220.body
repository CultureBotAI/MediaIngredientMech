					<h2>
						<!-- <img src="images/icons/icon-5.svg" class="section-icon" />  -->
						Isolation, sampling and environmental information					</h2>

					<div class="detail-taxonomy">

						<!-- SECTION 1 START -->
																												<div class="sub_section" id="sub_section_5_1" data-section-count="1">

name":"gastrointestinal drug","definition":"A drug used for its effects on the gastrointestinal system, e.g. controlling gastric acidity, regulating gastrointestinal motility and water flow, and improving digestion.","id":55324,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:176497","name":"geroprotector","definition":"Any compound that supports healthy aging, slows the biological aging process, or extends lifespan.","id":176497,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35620","name":"vasodilator agent","definition":"A drug used to cause dilation of the blood vessels.","id":35620,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:55323","name":"antidiarrhoeal drug","definition":"Any drug found useful in the symptomatic treatment of diarrhoea.","id":55323,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:66981","name":"ophthalmology drug","definition":"Any compound used for the treatment of eye conditions or eye diseases.","id":66981,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35554","name":"cardiovascular drug","definition":"A drug that affects the rate or intensity of cardiac contraction, blood vessel diameter or blood volume.","id":35554,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50864","name":"insulin-sensitizing drug","definition":"An agent which overcomes insulin resistance by activation of the peroxisome proliferator activated receptor gamma (PPAR-gamma).","id":50864,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:74518","name":"anti-obesity agent","definition":"Any substance which is used to reduce or control weight.","id":74518,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:79314","name":"flame retardant","definition":"Any compound that is added to manufactured materials to inhibit, suppress, or delay the production of flames and so prevent the spread of fire.","id":79314,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:231911","name":"renoprotective agent","definition":"Any compound that is able to prevent damage to the kidneys.","id":231911,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50748","name":"antipsoriatic","definition":"A drug used to treat psoriasis.","id":50748,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:76916","name":"hyperglycemic agent","definition":"A drug which increases the blood glucose level.","id":76916,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:73336","name":"vulnerary","definition":"A drug used in treating and healing of wounds.","id":73336,"biological_role":false},{"application":true,"chemical_role":true,"chebi_accession":"CHEBI:228364","name":"NMR chemical shift reference compound","definition":"Any compound that produces a peak used as reference frequency in the δ chemical shift scale.","id":228364,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35480","name":"analgesic","definition":"An agent capable of relieving pain without the loss of consciousness or without producing anaesthesia. In addition, analgesic is a role played by a compound which is exhibited by a capability to cause a reduction of pain symptoms.","id":35480,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:22587","name":"antiviral agent","definition":"A substance that destroys or inhibits replication of viruses.","id":22587,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:36047","name":"antibacterial drug","definition":"A drug used to treat or prevent bacterial infections.","id":36047,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:48407","name":"antiparkinson drug","definition":"A drug used in the treatment of Parkinson's disease.","id":48407,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:75835","name":"anti-anaemic agent","definition":"A compound which increases either the number of red cells or the amount of haemoglobin in the blood.","id":75835,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35623","name":"anticonvulsant","definition":"A drug used to prevent seizures or reduce their severity.","id":35623,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35469","name":"antidepressant","definition":"Antidepressants are mood-stimulating drugs used primarily in the treatment of affective disorders and related conditions.","id":35469,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35845","name":"gout suppressant","definition":"A drug that increases uric acid excretion by the kidney (uricosuric drug), decreases uric acid production (antihyperuricemic), or alleviates the pain and inflammation of acute attacks of gout.","id":35845,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:38068","name":"antimalarial","definition":"A drug used in the treatment of malaria. Antimalarials are usually classified on the basis of their action against <em>Plasmodia</em> at different stages in their life cycle in the human.","id":38068,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35674","name":"antihypertensive agent","definition":"Any drug used in the treatment of acute or chronic vascular hypertension regardless of pharmacological mechanism.","id":35674,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35526","name":"hypoglycemic agent","definition":"A drug which lowers the blood glucose level.","id":35526,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:62868","name":"hepatoprotective agent","definition":"Any compound that is able to prevent damage to the liver.","id":62868,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:63726","name":"neuroprotective agent","definition":"Any compound that can be used for the treatment of neurodegenerative disorders.","id":63726,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50503","name":"laxative","definition":"An agent that produces a soft formed stool, and relaxes and loosens the bowels, typically used over a protracted period, to relieve constipation. Compare with cathartic, which is a substance that accelerates defecation. A substances can be both a laxative and a cathartic.","id":50503,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35441","name":"antiinfective agent","definition":"A substance used in the prophylaxis or therapy of infectious diseases.","id":35441,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:33231","name":"antitubercular agent","definition":"A substance that kills or slows the growth of <em>Mycobacterium tuberculosis</em> and is used in the treatment of tuberculosis.","id":33231,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:149552","name":"emetic","definition":"Any agent that induces nausea and vomiting.","id":149552,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35474","name":"anxiolytic drug","definition":"Anxiolytic drugs are agents that alleviate anxiety, tension, and anxiety disorders, promote sedation, and have a calming effect without affecting clarity of consciousness or neurologic conditions.","id":35474,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:64946","name":"anti-HIV agent","definition":"An antiviral agent that destroys or inhibits the replication of the human immunodeficiency virus.","id":64946,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:64951","name":"anti-HBV agent","definition":"An antiviral agent that destroys or inhibits the replication of the hepatitis B virus.","id":64951,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:65023","name":"anti-asthmatic agent","definition":"Any compound that has anti-asthmatic effects.","id":65023,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35610","name":"antineoplastic agent","definition":"A substance that inhibits or prevents the proliferation of neoplasms.","id":35610,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50247","name":"antidote","definition":"Any protective agent counteracting or neutralizing the action of poisons.","id":50247,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:38070","name":"anti-arrhythmia drug","definition":"A drug used for the treatment or prevention of cardiac arrhythmias. Anti-arrhythmia drugs may affect the polarisation-repolarisation phase of the action potential, its excitability or refractoriness, or impulse conduction or membrane responsiveness within cardiac fibres.","id":38070,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:51177","name":"antitussive","definition":"An agent that suppresses cough. Antitussives have a central or a peripheral action on the cough reflex, or a combination of both. Compare with  <em>expectorants</em>, which are considered to increase the volume of secretions in the respiratory tract, so facilitating their removal by ciliary action and coughing, and <em>mucolytics</em>, which decrease the viscosity of mucus, facilitating its removal by ciliary action and expectoration.","id":51177,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:33282","name":"antibacterial agent","definition":"A substance (or active part thereof) that kills or slows the growth of bacteria.","id":33282,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:33281","name":"antimicrobial agent","definition":"A substance that kills or slows the growth of microorganisms, including bacteria, viruses, fungi and protozoans.","id":33281,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50919","name":"antiemetic","definition":"A drug used to prevent nausea or vomiting. An antiemetic may act by a wide range of mechanisms: it might affect the medullary control centres (the vomiting centre and the chemoreceptive trigger zone) or affect the peripheral receptors.","id":50919,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50177","name":"dermatologic drug","definition":"A drug used to treat or prevent skin disorders or for the routine care of skin.","id":50177,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35705","name":"immunosuppressive agent","definition":"An agent that suppresses immune function by one of several mechanisms of action. Classical cytotoxic immunosuppressants act by inhibiting DNA synthesis. Others may act through activation of T-cells or by inhibiting the activation of helper cells. In addition, an immunosuppressive agent is a role played by a compound which is exhibited by a capability to diminish the extent and/or voracity of an immune response.","id":35705,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:149553","name":"anticoronaviral agent","definition":"Any antiviral agent which inhibits the activity of coronaviruses.","id":149553,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:67079","name":"anti-inflammatory agent","definition":"Any compound that has anti-inflammatory effects.","id":67079,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50779","name":"appetite enhancer","definition":"A drug which increases appetite.","id":50779,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:39456","name":"antiglaucoma drug","definition":"Any drug which can be used to prevent or alleviate glaucoma, a disease in which the optic nerve is damaged, resulting in progressive, irreversible loss of vision. It is often, though not always, associated with increased pressure of the fluid in the eye.","id":39456,"biological_role":false}],"is_released":true}
  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Bring to boil under 80% N2, 20% CO2. Wait until reduced. Stopper with butyl rubber."
    },
    {
      "paragraph_index": 3,
      "comment": "Dispense under same gas phase into anaerobic aluminum seal type culture tubes (Bellco #2048-18150)."
    },
    {
      "paragraph_index": 4,
      "comment": "Adjust final pH to 7.0. Autoclave at 121C for 15 min."
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": ""
    },
    {
      "paragraph_index": 11,
      "comment": ""
    },
    {
      "paragraph_index": 13,
      "comment": ""
    },
    {
      "paragraph_index": 14,
      "comment": "Add distilled water to 500 ml round-bottom flask. Add fresh NaOH; bring to boil under N2."
    },
    {
      "paragraph_index": 15,
      "comment": "Remove gassing probe, add cysteine (swirling to dissolve), then Na2S solution."
    },
    {
      "paragraph_index": 16,
      "comment": "Renew gassing for several minutes; seal with butyl rubber stoppers. Transfer to hood and dispense into 8.0 ml/18 mm Hungate tubes."
    },
    {
      "paragraph_index": 17,
      "comment": ""
    },
    {
      "paragraph_index": 19,
      "comment": "Available from ATCC as a sterile ready-to-use liquid (Trace Mineral Supplement, catalog no. MD-TMS.)"
    },
    {
      "paragraph_index": 20,
      "comment": ""
    },
    {
      "paragraph_index": 21,
      "comment": "Add nitrilotriacetic acid to approximately 500 ml of water and adjust to pH 6.5 with KOH to dissolve the compound."
    },
    {
      "paragraph_index": 22,
      "comment": "Bring volume to 1.0 L with remaining water and add remaining compounds one at a time."
    }
  ]
}
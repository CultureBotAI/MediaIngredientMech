  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Heat medium without sodium carbonate to boiling and cool under a stream of 100% CO2."
    },
    {
      "paragraph_index": 3,
      "comment": "Add sodium carbonate and equilibrate medium under same gas phase for approximately 10 minutes."
    },
    {
      "paragraph_index": 4,
      "comment": "Dispense anaerobically into desired containers. Autoclave at 121C for 15 minutes."
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "Prior to inoculation, add the following reducing agents which have been prepared as stock solutions under nitrogen and autoclaved:"
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": "Final pH of completed medium is 6.6 +/- 0.1."
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 14,
      "comment": ""
    },
    {
      "paragraph_index": 16,
      "comment": "Add volatile fatty acids to approximately 200 ml distilled water."
    },
    {
      "paragraph_index": 17,
      "comment": "Neutralize to pH 7.0 with NaOH pellets. Bring volume to 310 ml."
    }
  ]
}
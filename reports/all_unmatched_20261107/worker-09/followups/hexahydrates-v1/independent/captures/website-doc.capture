        <div id="documentation" class="">
            <div class="content">

                <h1>
                    <i class="ph ph-browser ph-lg mr-10 text-danger"></i>
                    Website documentation
                </h1>

                <p>
                    This documentation covers how to use the website.
                </p>
            </div>

            <section id="toc" class=" d-block d-lg-none section">
                <h2>
                    Content
                    <a href="#toc" class="hash">#</a>
                </h2>

                <ol class="doc-nav" id="doc-nav">
                    <a href="#media-components">media-components</a>
                    <a href="#db-structure">database structure</a>
                    <a href="#medium-overview">The media view page</a>
                    <a href="#strains">strains and strain-specific modifications</a>
                    <a href="#medium-finder">Find media by their components</a>
                    <a href="#solution-finder">Find solutions using the <em>solution finder</em></a>
                    <a href="#compare-solutions">Compare solutions</a>

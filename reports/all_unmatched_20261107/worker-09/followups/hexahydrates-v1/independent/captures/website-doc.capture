        box-shadow: 0 0 0 .5rem rgba(95, 138, 50, 0.2);
    }

    .tree span.danger:hover {
        box-shadow: 0 0 0 .5rem rgba(128, 0, 41, 0.2);
    }

    .tree span.muted:hover {
        box-shadow: 0 0 0 .5rem rgba(0, 0, 0, 0.2);
    }


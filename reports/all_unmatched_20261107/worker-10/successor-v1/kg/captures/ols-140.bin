henyl)but-3-en-2-ylidene]amino}oxy)methyl]phenyl}-2-(methoxyimino)-N-methylacetamide","(2E)-2-{2-[({[(2E,3E)-4-(2,6-dichlorophenyl)but-3-en-2-ylidene]amino}oxy)methyl]phenyl}-2-(methoxyimino)-N-methylacetamide","(alphaE)-2-((((E)-((2E)-3-(2,6-dichlorophenyl)-1-methyl-2-propen-1-ylidene)amino)oxy)methyl)-alpha-(methoxyimino)-N-methylbenzeneacetamide","(alphaE)-2-[[[(E)-[(2E)-3-(2,6-dichlorophenyl)-1-methyl-2-propen-1-ylidene]amino]oxy]methyl]-alpha-(methoxyimino)-N-methylbenzeneacetamide","Fenaminstrobine","SYP 1620","Xiwojunan"],"ontology_prefix":"CHEBI","short_form":"CHEBI_83220","description":["A monocarboxylic acid amide obtained by formal condensation of the carboxy group of (2\u003ci\u003eE\u003c/i\u003e)-{2-[({(\u003ci\u003eE\u003c/i\u003e)-[(3\u003ci\u003eE\u003c/i\u003e)-4-(2,6-dichlorophenyl)but-3-en-2-ylidene]amino}oxy)methyl]phenyl}(methoxyimino)acetic acid with the amino group of methylamine. A broad-spectrum fungicide."],"label":"fenaminstrobin","obo_id":"CHEBI:83220","type":"class","exact_synonyms":["(2E)-2-{2-[({(E)-[(3E)-4-(2,6-dichlorophenyl)but-3-en-2-ylidene]amino}oxy)methyl]phenyl}-2-(methoxyimino)-N-methylacetamide"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_169440","ontology_name":"chebi","related_synonyms":["N-[2-(1H-indol-3-yl)ethyl]-N-methylacetamide"],"ontology_prefix":"CHEBI","short_form":"CHEBI_169440","description":[],"label":"Nb-Acetyl-Nb-methyltryptamine","obo_id":"CHEBI:169440","type":"class","exact_synonyms":["N-[2-(1H-indol-3-yl)ethyl]-N-methylacetamide"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_34847","ontology_name":"chebi","related_synonyms":["3-(acetylamino)-5-(acetylmethylamino)-2,4,6-triiodobenzoic acid","3-(acetylamino)-5-[acetyl(methyl)amino]-2,4,6-triiodobenzoic acid","3-acetamido-2,4,6-triiodo-5-(N-methylacetamido)benzoic acid","3-acetamido-2,4,6-triiodo-5-N-methylacetamidobenzoic acid","Metrizoic acid","V08AA02","acide metrizoique","acidum metrizoicum"],"ontology_prefix":"CHEBI","short_form":"CHEBI_34847","descri
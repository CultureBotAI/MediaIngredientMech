                    {
                        "recipe_order": 20,
                        "solution": "Vitamin solution B (1000 x stock)",
                        "solution_id": 5933,
                        "amount": 0.25,
                        "unit": "ml",
                        "optional": 0
                    }
                ],
                "steps": [
                    {
                        "step": "The CTM-Medium consists of two parts. Part one is autoclavable and called CTM-Medium basis. Part two is named mixed solution and contains non-autoclavable components. Solid CTM-Medium contains 1% three times washed Bactoagar and is added to the CTM-Medium basis prior autoclaving."
                    },
                    {
                        "recipe_order": 2,
                        "step": "Note: Bacto peptone can be omitted with only using amino acids as carbon source, which will maker it a defined medium. Amount of amino acids will then have to be increased to 100mg/L each."
                    },
                    {
                        "recipe_order": 8,
                        "step": "Make up to <span class='amount' data-volume='970'>970</span> ml with distilled water."
                    },
                    {
                        "recipe_order": 9,
                        "step": "Adjust pH to 7.0 with NaOH (2M)."
                    },
                    {
                        "recipe_order": 10,
                        "step": "Autoclave at 121 \u00b0C for 20 min."
                    },
                    {
                        "recipe_order": 11,
                        "step": "Seal medium bottle immediately after autoclaving in order to avoid oxygenation."
                    },
                    {
                        "recipe_order": 12,
                        "step": "Cool down to 70 \u00b0C (in a water bath)."
                    },
                    {
                        "recipe_order": 13,
                        "step": "Add mixed solution to the CTM basis for completing the CTM-Medium (30 mL),"
                    },
                    {
                        "recipe_order": 14,
                        "step": "Note: Always prepare freshly! Mix the following components (e.g., in a volume of approx. 30 mL) and add the filter sterilized mixture to the autoclaved CTM-Medium basis:"
                    },
                    {
                        "step": "Keep CTM-Medium tightly sealed and between 50-70\u02daC prior usage."
                    },
                    {
                        "step": "It is strongly recommended to use up the CTM-Medium as soon as possible after preparation! Short term storage of CTM-Medium basis possible under strictly anaerobic conditions. Mixed solutions should then be added freshly before use."
                    },
                    {
                        "step": "Pour CTM-Medium into flasks, bottles or similar and leave a quarter air headspace and seal them."
                    }
                ],
                "equipment": {
                    "5055": "Autoclave",
                    "5056": "Water bath",
                    "5065": "Filter"
                }
            },

      "synonyms" : [ "Bacto™ Soytone", "soytone", "soytone" ],
      "annotation" : {
        "createdBy" : [ "Carrine Blank" ],
        "definition" : [ "A mixed enzymatic digest of flour made of the seed of the soybean (Hordeum vulgare), used for the culturing of microorganisms." ],
        "definition source" : [ "From BD Bionutrients Technical Manual (3rd edition revised):\n\nEnzymeatic digests of soy flour.  Soy contains several heat labile protease inhibitors.  The most common way of eliminating these factors is to heat or toast the defatted soy beans in a processing plant under controlled conditions. Soy flour, the principle substrate in a soy peptone, is rich in high-quality protein, carbohydrates, calcium and B vitamins. The enzymes used in the digestion of soy flour are typically from animal-free sources or from microorganisms that have been grown in animal-free media.\n\nAsh content is 12%\nNaCl content is 0.2%" ],
        "has_exact_synonym" : [ "bacto soytone", "papaic digest of soybean", "soya peptone" ]

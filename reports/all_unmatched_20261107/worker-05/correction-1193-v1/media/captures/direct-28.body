	<script>
		document.addEventListener("DOMContentLoaded", function() {
			const clickableColumns = document.querySelectorAll(".make-column-clickable-elementor");

			clickableColumns.forEach(column => {
				column.addEventListener("click", function(e) {
				if (e.target.closest("a") || e.target.closest("button")) return;

				const url = this.getAttribute("data-column-clickable");
				const target = this.getAttribute("data-column-clickable-blank") || "_self";

				if (url) {
					window.open(url, target);
				}
				});
			});
		});
	</script>

	 

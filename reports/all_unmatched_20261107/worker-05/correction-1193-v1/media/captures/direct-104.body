  <body class="page basicpage is-publish" id="page-48ea7913fa" data-cmp-link-accessibility-enabled data-cmp-link-accessibility-text="opens in a new tab" data-cmp-data-websdk-layer-enabled="true" data-links-popup-config="{}" data-environment="PROD">
    

<script>
    (function () {
        "use strict";

        function initializePageViewAnalyticsEvent() {
            const isLoggedIn = localStorage.getItem('bmxUserLoggedIn') === 'true';

            const url_without_params = window.location.protocol + '//' + window.location.host + window.location.pathname;
            const previousSection = sessionStorage.getItem('previousSection') || '';
            const section = 'Errors' || 'Home';
            const name = '404'.replace(/-/g, ' ');
            const userLang = navigator.language || navigator.userLanguage;
            const acceptedLanguagesWithQualityValues = window.localStorage.getItem('languagePreferences') || navigator.languages?.join(',') || navigator.language;
            const envType = (document.body.getAttribute("data-environment") || "dev").toLowerCase();

            const isEndowmentFund = document.body.classList.contains('endowment-root');

            const siteName = isEndowmentFund ? "Biomerieux Endowment Fund" : "Biomerieux";
            const siteType = (envType === "prod") ? "public" : "internal";

            sessionStorage.setItem('previousSection', section);

            function getOperatingSystem() {
                const userAgent = navigator.userAgent || navigator.vendor || window.opera;

                if (/windows phone/i.test(userAgent)) {
                    return "Windows Phone";
                }
                if (/win/i.test(userAgent)) {
                    return "Windows";
                }
                if (/android/i.test(userAgent)) {
                    return "Android";
                }
                if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) {
                    return "iOS";
                }
                if (/Macintosh|Mac OS X/i.test(userAgent)) {
                    return "MacOS";
                }
                if (/Linux/i.test(userAgent)) {
                    return "Linux";
                }
                return "Unknown";
            }

            function getReferrerType() {
                if (!document.referrer) return "external";
                try {
                    return new URL(document.referrer).hostname === window.location.hostname
                        ? "internal"
                        : "external";
                } catch (e) {
                    return "external";
                }
            };

            function getDeviceType() {
                const userAgent = navigator.userAgent;
                const isTablet = /iPad|tablet|Tablet/i.test(userAgent) ||
                    (navigator.maxTouchPoints > 1 && /Macintosh/i.test(userAgent));
                if (isTablet) return "tablet";
                if (/Mobi|Android/i.test(userAgent)) return "mobile";
                return "desktop";
            };

            const pageViewEvent = {
                    event: "pageView",
                    _biomerieuxsa: {
                        site: {
                            name: siteName,
                            type: siteType,
                        },
                        page: {
                            topic: '',
                            path: window.location.pathname,
                            title: document.title,
                            section,
                            subsection1: 'Page Not Found',
                            subsection2: '',
                            subsection3: '',
                            subsection4: '',
                            previousURL: document.referrer,
                            previousSection,
                            URLwithQSP: window.location.href,
                            language: 'en'
                        },
                        user: {
                            language: userLang
                        }
                    },
                    web: {
                        webPageDetails: {
                            URL: url_without_params,
                            name,
                            siteSection: window.location.pathname,
                            server: window.location.hostname,
                            isErrorPage: false,
                            isHomePage: false
                        },
                        webReferrer: {
                            URL: document.referrer,
                            type: getReferrerType()
                        }
                    },
                    environment: {
                        type: envType,
                        operatingSystem: getOperatingSystem(),
                        browserDetails: {
                            acceptLanguage: acceptedLanguagesWithQualityValues,
                            cookiesEnabled: navigator.cookieEnabled,
                            javaEnabled: navigator.javaEnabled ? navigator.javaEnabled() : false,
                            javaScriptEnabled: true,
                            javaScriptVersion: "ES6",
                            userAgent: navigator.userAgent
                        }
                    },
                    device: {
                        type: getDeviceType()
                    },
                    userAccount: {
                        loginStatus: isLoggedIn ? "logged in" : "logged out"
                    }
                };

            if (window.enableTarget) {
                pageViewEvent._biomerieuxsa.page.enableTarget = true;
            }

            if (name === '404') {
                const errPrev =
                    new URLSearchParams(window.location.search).get('referer') ||
                    window.location.pathname;

                pageViewEvent.web.webPageDetails.isErrorPage = true;
                pageViewEvent._biomerieuxsa.page.previousURL = errPrev;
                pageViewEvent.web.webReferrer.URL = errPrev;
            }

            window.adobeDataLayer = window.adobeDataLayer || [];
            adobeDataLayer.push(pageViewEvent);
        }

        initializePageViewAnalyticsEvent();

        window.onebmxAnalytics = {
            initializePageViewAnalyticsEvent: initializePageViewAnalyticsEvent
        };
}());
</script>

    
    
      


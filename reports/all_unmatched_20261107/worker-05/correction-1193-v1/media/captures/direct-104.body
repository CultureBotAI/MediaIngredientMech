        function loadScript(src) {
          return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = src;
            script.onload = () => resolve(src);
            script.onerror = () => reject(new Error('Failed to load: ' + src));
            document.head.appendChild(script);
          });
        }

        function initImageAnalytics() {
            assetAnalytics.defaultTrackable = true;
            assetAnalytics.attrAssetID = 'asset-id';
            assetAnalytics.assetImpressionPollInterval = 2000;

            /**
             * this attribute enables logging. Any 'truthy' value will enable logging
             *
             * @param debug  enable/disable logs
             */
            // assetAnalytics.debug = false;

            assetAnalytics.dispatcher.init(
                    'biomerieuxglobalprod',
                    'biomerieux.data.adobedc.net',
                    'biomerieux',
                    '',
                    '',
                    '',
                    '',
                    undefined
                    );

            assetAnalytics.dispatcher.s.cookieDomain = window.location.hostname;
            assetAnalytics.dispatcher.s.usePlugins=true;
            assetAnalytics.dispatcher.s.doPlugins=assetAnalytics.core.updateContextData;

            assetAnalytics.core.optimizedAssetInsights();
            assetAnalytics.dispatcher.s.t();

            document.dispatchEvent(new Event('asset-analytics-script-ready'));
        }

        Promise.all([
            loadScript('/etc.clientlibs/cq/analytics/clientlibs/sitecatalyst/appmeasurement.js'),
            loadScript('/etc.clientlibs/dam/clientlibs/assetinsights/pagetracker.js'),
        ]).then(() => {
          initImageAnalytics();
        });
    </script>





    
    

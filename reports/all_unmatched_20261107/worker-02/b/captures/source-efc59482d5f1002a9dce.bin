<TR><TD WIDTH=75%> MES                                                      </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;1.95&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>
<TR><TD WIDTH=75%> Sulfur (powder)                                         </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;12.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>
<TR><TD WIDTH=75%> Trace minerals (see Medium No. <a href="/cgi-bin/jcm/jcm_grmd?GRMD=151">151</a>)                   </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;10.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> ml  </TD></TR>

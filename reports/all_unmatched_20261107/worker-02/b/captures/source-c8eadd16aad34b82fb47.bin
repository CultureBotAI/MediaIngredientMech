<TR><TD WIDTH=75%> Fe<sub>2</sub>(SO<sub>4</sub>)<sub>3</sub>&#183;<I>x</I>H<sub>2</sub>O                  </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;0.01&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>

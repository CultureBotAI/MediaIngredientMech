                ],
                "steps": [
                    {
                        "step": "Dilute 20 ml of solution 1 to 700ml with distilled water."
                    },
                    {
                        "step": "Add 100mL of solution 5, 50 mL of solution 8, 20mL of solution 6 and 7 and 10 mL of\r\nsolution 3."
                    },
                    {
                        "step": "Add 1ml trace element solution."
                    },
                    {
                        "step": "Add 0.4 mL solution 2."
                    },
                    {
                        "step": "Add 0.1 mL solution 4."
                    },
                    {
                        "step": "Add 1.0 mL solution 9."
                    },
                    {
                        "step": "Disolve and bring to 1L."
                    },
                    {
                        "step": "Adjust pH to 7.8 with HCl or NaOH.\r\nAutoclave medium."
                    },
                    {
                        "step": "After autoclaving add 10mL per liter of filter sterilized methanol."
                    }
                ]

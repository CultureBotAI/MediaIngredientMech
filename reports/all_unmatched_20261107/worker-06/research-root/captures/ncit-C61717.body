{
  "_embedded" : {
    "terms" : [ {
      "iri" : "http://purl.obolibrary.org/obo/NCIT_C61717",
      "lang" : "en",
      "description" : [ "The monohydrate form of D-glucose, a natural monosaccharide and carbohydrate. Dextrose serves to replenish lost nutrients and electrolytes. The agent provides metabolic energy and is the primary ingredient in oral rehydration salts (ORS) and is used in intravenous (IV) fluids to provide nutrients to patients under intensive care who are unable to receive them by the oral route. Solutions containing dextrose restore blood glucose levels, provide calories, may aid in minimizing liver glycogen depletion and exerts a protein-sparing action. Dextrose also plays a role in the production of proteins and in lipid metabolism." ],
      "synonyms" : [ "DEXTROSE MONOHYDRATE", "Dextrose Monohydrate" ],

    },
    {
      "paragraph_index": 5,
      "comment": "Combine all ingredients except for the horse serum. Adjust pH to 7.8 +/- 0.2."
    },
    {
      "paragraph_index": 6,
      "comment": "Autoclave at 121C and let medium cool to 55C."
    },
    {
      "paragraph_index": 7,
      "comment": "Aseptically add horse serum and dispense as required."
    }

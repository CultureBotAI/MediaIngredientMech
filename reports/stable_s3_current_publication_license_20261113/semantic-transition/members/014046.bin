lizer","definition":"A fertilizer is any substance that is added to soil or water to assist the growth of plants.","id":33287,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35610","name":"antineoplastic agent","definition":"A substance that inhibits or prevents the proliferation of neoplasms.","id":35610,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:38070","name":"anti-arrhythmia drug","definition":"A drug used for the treatment or prevention of cardiac arrhythmias. Anti-arrhythmia drugs may affect the polarisation-repolarisation phase of the action potential, its excitability or refractoriness, or impulse conduction or membrane responsiveness within cardiac fibres.","id":38070,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:176497","name":"geroprotector","definition":"Any compound that supports healthy aging, slows the biological aging process, or extends lifespan.","id":176497,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50646","name":"bone density conservation agent","definition":"An agent that inhibits bone resorption and/or favor bone mineralization and bone regeneration. Used to heal bone fractures and to treat bone diseases such as osteopenia and osteoporosis.","id":50646,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:75835","name":"anti-anaemic agent","definition":"A compound which increases either the number of red cells or the amount of haemoglobin in the blood.","id":75835,"biological_role":false},{"application":true,"chemical_role":true,"chebi_accession":"CHEBI:77182","name":"food colouring","definition":"A food additive that imparts colour to food. In European countries, E-numbers for permitted food colours are from E 100 to E 199, divided into yellows (E 100-109), oranges (E 110-119), reds (E 120-129), blues and violets (E 130-139), greens (E 140-149), browns and blacks (E 150-159), and others (E 160-199).","id":77182,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:74518","name":"anti-obesity agent","definition":"Any substance which is used to reduce or control weight.","id":74518,"biological_role":true},{"application":true,"chemical_role":true,"chebi_accession":"CHEBI:77960","name":"food firming agent","definition":"A food additive that is used to make or keep fruit or vegetable tissues firm and crisp. or which interacts with gelling agents such as pectin to produce or strengthen a gel.","id":77960,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35526","name":"hypoglycemic agent","definition":"A drug which lowers the blood glucose level.","id":35526,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:62868","name":"hepatoprotective agent","definition":"Any compound that is able to prevent damage to the liver.","id":62868,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:64946","name":"anti-HIV agent","definition":"An antiviral agent that destroys or inhibits the replication of the human immunodeficiency virus.","id":64946,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:65265","name":"antacid","definition":"Any substance which is used to neutralise stomach acidity.","id":65265,"biological_role":true}],"is_released":true}
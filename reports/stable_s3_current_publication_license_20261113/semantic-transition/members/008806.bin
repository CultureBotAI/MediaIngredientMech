        <a href="https://hub.dsmz.de/" target="_blank" class="link">
          DSMZ Digital Diversity
        </a>
      </p>

      <form id="d3search" onsubmit="d3searchFunction()">
        <div class="input-group">
          <input type="search" name="search" id="hub-search" class="form-control" placeholder="Search across all DSMZ Digital Diversity databases">
          <div class="input-group-append">
            <button class="btn"><i class="ph ph-magnifying-glass" aria-hidden="true"></i></button>
          </div>
        </div>
      </form>

      <script>
        function d3searchFunction() {
          event.preventDefault();
          var val = $('#hub-search').val();
          // url encode the search term
          var search = encodeURIComponent(val);
          var action_src = "https://hub.dsmz.de/#/search/" + search;
          window.open(action_src, '_blank');

        }
      </script>

      <div class="">
        <p class="font-size-12">provided to you by</p>

{"response":{"docs":[{"iri":"http://id.nlm.nih.gov/mesh/C020720","ontology_name":"mesh","related_synonyms":["chromalum","chrome alum, dodecahydrate","chromic potassium sulfate dodecahydrate","chromic potassium sulfate"],"ontology_prefix":"mesh","short_form":"mesh_C020720","description":[],"label":"chrome alum","obo_id":"mesh:C020720","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87397","ontology_name":"chebi","related_synonyms":["3,3\u0027-[(3-carboxy-4-oxocyclohexa-2,5-dien-1-ylidene)methylene]bis(6-hydroxybenzoic acid)","5,5\u0027-(3-Carboxy-4-oxocyclohexa-2,5-dienylidenemethylene)di(salicylic acid)","Aluminon free acid","chrome violet CG free acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_87397","description":["A member of the class of quinomethanes that is 3-methylidene-6-oxocyclohexa-1,4-diene-1-carboxylic acid in which the methylidene hydrogens are replaced by 4-carboxy-3-hydroxyphenyl groups. The trisodium salt is the biological stain \u0027chrome violet CG\u0027 while the triammonium salt is \u0027aluminon\u0027."],"label":"aurintricarboxylic acid","obo_id":"CHEBI:87397","type":"class","exact_synonyms":["3,3\u0027-[(3-carboxy-4-oxocyclohexa-2,5-dien-1-ylidene)methylene]bis(6-hydroxybenzoic acid)"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C45892","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C45892","description":["A yellowish, crystalline, inorganic compound that emits toxic chromium fumes upon heating. Strontium chromate is highly corrosive and is a strong oxidizing agent. This substance is used as a colorant in polyvinyl chloride, in pyrotechnics, in chrome plating, in aluminum flake coatings, and as a corrosion inhibitor and metal conditioner. Strontium chromate primarily affects the lungs causing shortness of breath, bronchitis, pneumonia and asthma but can also affect the gastrointestinal tract, liver, kidneys and immune system. This substance is a known human carcinogen and is associated with an increased risk of developing lung cancer and cancer of the sinonasal cavity. (NCI05)"],"label":"Strontium Chromate","obo_id":"NCIT:C45892","type":"class","exact_synonyms":["C.I. Pigment Yellow 32","Chromic Acid, Strontium Salt (1:1)","STRONTIUM CHROMATE","Strontium Chromate"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_90106","ontology_name":"chebi","related_synonyms":["1-carboxy-7-(dimethylamino)-3,4-dihydroxyphenoxazin-5-ium chloride","Alizarine Navy Blue AT","Anthracene Blue SWGG","Brilliant Chrome Blue P","C.I. 51030","C.I. Mordant Blue 10","Fast Violet","Gallocyanine","Mordant blue 10","Solid Violet"],"ontology_prefix":"CHEBI","short_form":"CHEBI_90106","description":["An organic chloride salt composed of 1-carboxy-7-(dimethylamino)-3,4-dihydroxyphenoxazin-5-ium and chloride ions in a 1:1 ratio. A histological dye used in solution with an iron alum mordant as a hematoxylin substitute in the H\u0026E stain."],"label":"gallocyanin","obo_id":"CHEBI:90106","type":"class","exact_synonyms":["1-carboxy-7-(dimethylamino)-3,4-dihydroxyphenoxazin-5-ium chloride"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87397","ontology_name":"micro","related_synonyms":["5,5\u0027-(3-Carboxy-4-oxocyclohexa-2,5-dienylidenemethylene)di(salicylic acid)","Aluminon free acid","chrome violet CG free acid"],"ontology_prefix":"MICRO","short_form":"CHEBI_87397","description":["A member of the class of quinomethanes that is 3-methylidene-6-oxocyclohexa-1,4-diene-1-carboxylic acid in which the methylidene hydrogens are replaced by 4-carboxy-3-hydroxyphenyl groups. The trisodium salt is the biological stain \u0027chrome violet CG\u0027 while the triammonium salt is \u0027aluminon\u0027."],"label":"aurintricarboxylic acid","obo_id":"CHEBI:87397","type":"class","exact_synonyms":["3,3\u0027-[(3-carboxy-4-oxocyclohexa-2,5-dien-1-ylidene)methylene]bis(6-hydroxybenzoic acid)"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87397","ontology_name":"slm","related_synonyms":["3,3\u0027-[(3-carboxy-4-oxocyclohexa-2
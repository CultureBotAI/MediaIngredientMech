{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/CHEBI_27810","ontology_name":"chebi","related_synonyms":["1,3-Benzenediol","1,3-Dihydroxybenzene","1,3-Dihydroxybenzol","C.I.-76505","C.i. oxidation base 31","D.d.d.","FEMA NO. 3589","NSC-1571","RESORCINOL","Resorcin","Resorcinol","Resorcinum","Resorzin","Tilloderm","benzene-1,3-diol","m-Hydroquinone","m-hydroxyphenol","resorcinol"],"ontology_prefix":"CHEBI","short_form":"CHEBI_27810","description":["A  benzenediol that is benzene dihydroxylated at positions 1 and 3."],"label":"resorcinol","obo_id":"CHEBI:27810","type":"class","exact_synonyms":["benzene-1,3-diol"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C77056","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C77056","description":[],"label":"Resorcinol","obo_id":"NCIT:C77056","type":"class","exact_synonyms":["RESORCINOL","Resorcinol"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_52680","ontology_name":"chebi","related_synonyms":["(8Z,11Z)-5-(pentadeca-8,11,14-trien-1-yl)resorcinol","5-(8Z,11Z,14-Pentadecatrienyl)resorcinol","5-[(8Z,11Z)-pentadeca-8,11,14-trien-1-yl]benzene-1,3-diol","Cardol triene"],"ontology_prefix":"CHEBI","short_form":"CHEBI_52680","description":["A resorcinol compound having an 8-\u003ci\u003ecis\u003c/i\u003e,11-\u003ci\u003ecis\u003c/i\u003e-pentadeca-8,11,14-trien-1-yl substituent at the 5-position."],"label":"5-(pentadeca-8,11,14-trien-1-yl)resorcinol","obo_id":"CHEBI:52680","type":"class","exact_synonyms":["5-[(8Z,11Z)-pentadeca-8,11,14-trien-1-yl]benzene-1,3-diol"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_71267","ontology_name":"chebi","related_synonyms":["3-hydroxyphenyl hydrogen sulfate","resorcinol monosulfate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_71267","description":["An aryl sulfate that is resorcinol with one of the two hydroxy groups substituted by a sulfo group."],"label":"resorcinol sulfate","obo_id":"CHEBI:71267","type":"class","exact_synonyms":["3-hydroxyphenyl hydrogen sulfate","resorcinol monosulfate"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C44376","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C44376","description":["A combustible, yellowish liquid with a slight phenolic odor. Diglycidyl resorcinol ether is used as a liquid spray epoxy resin and in the production of other epoxy resins. Exposure to this substance irritates the eyes, skin and respiratory tract and adversely affects the immune system, central nervous system, liver and gastrointestinal tract. This substance is reasonably anticipated to be a human carcinogen based on evidence of carcinogenicity in experimental animals. (NCI05)"],"label":"Diglycidyl Resorcinol Ether","obo_id":"NCIT:C44376","type":"class","exact_synonyms":["1,3-Bis(2,3-epoxypropoxy)benzene","1,3-Diglycidyloxybenzene","2,2\u0027-[1,3-Phenylenebis(oxymethylene)]bisoxirane","Araldite ERE 1359","Diglycidyl Resorcinol Ether","M-BIS(2,3-EPOXYPROPOXY)BENZENE","NCI-C54966","RDGE","Resorcinol Bis(2,3-epoxypropyl)ether"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C84136","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C84136","description":[],"label":"Resorcinol Monoacetate","obo_id":"NCIT:C84136","type":"class","exact_synonyms":["RESORCINOL MONOACETATE","Resorcinol Monoacetate"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_2022","ontology_name":"chebi","related_synonyms":["5-(Heptadec-12-enyl)resorcinol","5-[(12Z)-heptadec-12-en-1-yl]benzene-1,3-diol"],"ontology_prefix":"CHEBI","short_form":"CHEBI_2022","description":["A resorcinol compound having a \u003ci\u003ecis\u003c/i\u003e-heptadec-12-enyl substituent at the 5-position."],"label":"5-(heptadec-12-enyl)resorcinol","obo_id":"CHEBI:2022","type":"class","exact_synonyms":["5-[(12Z)-heptadec-12-en-1-yl]benzene-1,3-diol"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_195467","ontology_name":"chebi","related_synonyms":["2-hexyl-5-(5-hydroxypentyl)resorcinol"],"ontology_prefix":"CHEBI","short_form":"CHEBI_195467","description
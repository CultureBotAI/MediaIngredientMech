xact_synonyms":["D-phenylalanyl-L-prolyl-L-arginyl-L-prolylglycylglycylglycylglycyl-L-asparaginylglycyl-L-alpha-aspartyl-L-phenylalanyl-L-alpha-glutamyl-L-alpha-glutamyl-L-isoleucyl-L-prolyl-L-alpha-glutamyl-L-alpha-glutamyl-L-tyrosyl-L-leucine"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_229660","ontology_name":"chebi","related_synonyms":["Zilbrysq","Zilucoplan sodium","acetyl-[L-lysyl(1)-L-valyl(2)-L-glutamyl(3)-L-arginyl(4)-L-phenylalanyl(5)-L-aspartyl(6)]-N-methyl-L-aspartyl(7)-L tert-leucyl(8)-L-tyrosyl(9)-L-7-azatryptophyl(10)-L-glutamyl(11)-L-tyrosyl(12)-L-prolyl(13)-L-cyclohexylglycyl(14)-[L-lysyl(15), Nepsilon-palmitoyl-gamma-L-glutamyl-(1-amino-3,6,9,12,15,18,21,24,27,30,33,36,39,42,45,48,51,54,57,60,63,66,69,72-tetracosaoxapentaheptacontan-75-oyl)], cyclic (lactam 1-6), tetra sodium","zilucoplan tetrasodium"],"ontology_prefix":"CHEBI","short_form":"CHEBI_229660","description":["An organic sodium salt that is the tetrasodium salt of zilucoplan. It is a complement component 5 inhibitor approved for the treatment of generalized myasthenia gravis in adult patients who are anti-acetylcholine receptor antibody positive."],"label":"zilucoplan sodium","obo_id":"CHEBI:229660","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_229659","ontology_name":"chebi","related_synonyms":["N-{[(2S,5S,8S,11S,14S,22S)-22-acetamido-11-benzyl-8-(3-carbamimidamidopropyl)-5-(2-carboxyethyl)-3,6,9,12,16,23-hexaoxo-2-(propan-2-yl)-1,4,7,10,13,17-hexaazacyclotricosan-14-yl]carbonyl}-N-methyl-L-alpha-aspartyl-3-methyl-L-valyl-L-tyrosyl-3-(1H-pyrrolo[2,3-b]pyridin-3-yl)-L-alanyl-L-alpha-glutamyl-L-tyrosyl-N-{(1S,4S)-4-carboxy-1-cyclohexyl-84-[(N-hexadecanoyl-L-gamma-glutamyl)amino]-2,10-dioxo-13,16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82-tetracosaoxa-3,9-diazatetraoctacont-1-yl}-L-prolinamide","RA 101495","RA-101495","RA101495","RA3193","zilucoplan","zilucoplanum"],"ontology_prefix":"CHEBI","short_form":"CHEBI_229659","description":["A 15 amino-acid, synthetic macrocyclic peptide with formula C\u003csmall\u003e\u003csub\u003e172\u003c/sub\u003e\u003c/small\u003eH\u003csmall\u003e\u003csub\u003e278\u003c/sub\u003e\u003c/small\u003eN\u003csmall\u003e\u003csub\u003e24\u003c/sub\u003e\u003c/small\u003eO\u003csmall\u003e\u003csub\u003e55\u003c/sub\u003e\u003c/small\u003e. Its sodium salt is used for the treatment of generalised myasthenia gravis (a disease that leads to muscle weakness and tiredness) in adults whose immune system produces antibodies against acetylcholine receptors."],"label":"zilucoplan","obo_id":"CHEBI:229659","type":"class","exact_synonyms":["N-{[(2S,5S,8S,11S,14S,22S)-22-acetamido-11-benzyl-8-(3-carbamimidamidopropyl)-5-(2-carboxyethyl)-3,6,9,12,16,23-hexaoxo-2-(propan-2-yl)-1,4,7,10,13,17-hexaazacyclotricosan-14-yl]carbonyl}-N-methyl-L-alpha-aspartyl-3-methyl-L-valyl-L-tyrosyl-3-(1H-pyrrolo[2,3-b]pyridin-3-yl)-L-alanyl-L-alpha-glutamyl-L-tyrosyl-N-{(1S,4S)-4-carboxy-1-cyclohexyl-84-[(N-hexadecanoyl-L-gamma-glutamyl)amino]-2,10-dioxo-13,16,19,22,25,28,31,34,37,40,43,46,49,52,55,58,61,64,67,70,73,76,79,82-tetracosaoxa-3,9-diazatetraoctacont-1-yl}-L-prolinamide"]}],"numFound":4,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["CHEBI","4"],"isDefiningOntology":["true","4"],"ontologyId":["dron","23","mesh","8","pr","4","chebi","4","micro","3","ncit","3","slm","3","mod","1","snomed","1","go","1","hgnc.genegroup","1","hgnc","1"],"ontologyIri":["http://purl.obolibrary.org/obo/chebi.owl","4"],"isObsolete":["false","4"],"type":["class","4"]}}}
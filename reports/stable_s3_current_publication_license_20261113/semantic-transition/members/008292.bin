{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/CHEBI_60720","ontology_name":"chebi","related_synonyms":["Sodium polysilicate","Sodium sesquisilicate","Sodium silicate glass","Sodium siliconate","disodium oxosilanediolate","sodium metasilicate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_60720","description":["An inorganic sodium salt having silicate as the counterion."],"label":"sodium silicate","obo_id":"CHEBI:60720","type":"class","exact_synonyms":["disodium oxosilanediolate"]},{"iri":"http://id.nlm.nih.gov/mesh/C005691","ontology_name":"mesh","related_synonyms":["silicic acid (H2O3Si), disodium salt, pentahydrate","silicic acid (H2O5Si2), disodium salt","silicic acid (H2O7Si3), disodium salt","silicic acid (H2O9Si4), disodium salt","silicic acid (H4O4Si), tetrasodium salt","silicic acid (H7O7Si2), hexasodium salt"],"ontology_prefix":"mesh","short_form":"mesh_C005691","description":[],"label":"sodium silicate","obo_id":"mesh:C005691","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_60720","ontology_name":"micro","related_synonyms":["Sodium polysilicate","Sodium sesquisilicate","Sodium silicate glass","Sodium siliconate","sodium metasilicate"],"ontology_prefix":"MICRO","short_form":"CHEBI_60720","description":["An inorganic sodium salt having silicate as the counterion."],"label":"sodium silicate","obo_id":"CHEBI:60720","type":"class","exact_synonyms":["disodium oxosilanediolate"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_132108","ontology_name":"chebi","related_synonyms":["Sodium metasilicate nonahydrate","sodium oxosilanebis(olate)--water (1/9)"],"ontology_prefix":"CHEBI","short_form":"CHEBI_132108","description":["A hydrate that is the nonahydrate form of sodium silicate."],"label":"sodium silicate nonahydrate","obo_id":"CHEBI:132108","type":"class","exact_synonyms":["sodium oxosilanebis(olate)--water (1/9)"]},{"iri":"http://id.nlm.nih.gov/mesh/C583464","ontology_name":"mesh","related_synonyms":["GE-100"],"ontology_prefix":"mesh","short_form":"mesh_C583464","description":[],"label":"lithium magnesium sodium silicate","obo_id":"mesh:C583464","type":"class"},{"iri":"http://purl.obolibrary.org/obo/FOODON_03413243","ontology_name":"foodon","ontology_prefix":"FOODON","short_form":"FOODON_03413243","description":["Food additive; technological purpose(s): anticaking agent."],"label":"sodium aluminium silicate","obo_id":"FOODON:03413243","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/C021746","ontology_name":"mesh","related_synonyms":["silicotungstic acid, hydrogen","silicotungstic acid, sodium salt"],"ontology_prefix":"mesh","short_form":"mesh_C021746","description":[],"label":"silicotungstic acid","obo_id":"mesh:C021746","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/C120461","ontology_name":"mesh","related_synonyms":["Biosilicate","Na2O-CaO-SiO2-P2O5 glass","P2O5-Na2O-CaO-SiO2 glass"],"ontology_prefix":"mesh","short_form":"mesh_C120461","description":[],"label":"sodium oxide-calcium oxide-silicon dioxide-diphosphorus pentoxide","obo_id":"mesh:C120461","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/C021080","ontology_name":"mesh","related_synonyms":["Olean-12-en-29-oic acid, 3-(3-carboxy-1-oxopropoxy)-11-oxo-, disodium salt, (3beta,20beta)-, mixt. with aluminum hydroxide (Al(OH)3), silicic acid (H2Si3O7) magnesium salt (1:1) and sodium hydrogen carbonate","Olean-12-en-29-oic acid, 3-(3-carboxy-1-oxopropoxy)-11-oxo-, disodium salt, (3beta,20beta)-, mixt. with aluminum hydroxide, silicic acid (H2Si3O7) magnesium salt (1:1) and sodium hydrogen carbonate"],"ontology_prefix":"mesh","short_form":"mesh_C021080","description":[],"label":"pyrogastrone","obo_id":"mesh:C021080","type":"class"},{"iri":"http://purl.obolibrary.org/obo/ENVO_01000483","ontology_name":"envo","ontology_prefix":"ENVO","short_form":"ENVO_01000483","description":["Most flat glass is soda-lime glass produced by the float glass process. It is more water soluble than container glass.","Flat glass is a soda-lime glass which is composed of approximately 73% silicon dioxide (silica), 14% sodium oxide, 9% calcium oxide, 4% magnesium oxide, 0.15% aluminium oxide, 0.03% potassium oxide, 0.02% titanum dioxide, and 0.01% iron III oxide."],"label":"flat glass","obo_id":"ENVO:01000483","type":"class","exact_synonyms":["plate glass","sheet glass"]},{"iri":"http://purl.obolibrary.org/obo/ENVO_01000484","ontology_name":"envo","ontology_prefix":"ENVO","short_form":"ENVO_01000484","description":["Container glass is less water soluble than flat glass.","Container glass is a soda-lime glass which is composed of approximately 74% silicon dioxide (silica), 13% sodium oxide, 10.5% calcium oxide, 1.3% aluminium oxide, 0.3% potassium oxide, 0.2% sulphur trioxide, 0.2% magnesium oxide,  0.04% iron III oxide, and 0.01%  titanum dioxide."],"label":"container glass","obo_id":"ENVO:01000484","type":"class"},{"iri":"http://purl.obolibrary.org/obo/ENVO_01000482","ontology_name":"envo","ontology_prefix":"ENVO","short_form":"ENVO_01000482","broad_synonyms":["glass"],"description":["Soda-lime glass is a silica-based glass which is composed of approximately 75% silicon dioxide, with sodium oxide and calcium oxide consituting most of its remaining composition.","This type of glass constitutes 90% of manufactured glass."],"label":"soda-lime glass","obo_id":"ENVO:01000482","type":"class","exact_synonyms":["soda-lime-silica glass"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_46677","ontology_name":"chebi","related_synonyms":["Hornblendeasbest","amphibole","amphibole-group minerals","amphiboles","anfibol","anfiboles"],"ontology_prefix":"CHEBI","short_form":"CHEBI_46677","description":["A class of asbestos minerals that includes silicates of magnesium, iron, calcium, and sodium."],"label":"amphibole asbestos","obo_id":"CHEBI:46677","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/D017636","ontology_name":"mesh","related_synonyms":["Amphibole Asbestos","Amphibole","Amphiboles","Asbestos, Amphibole group Minerals","Asbestos, Amphibole-group Minerals"],"ontology_prefix":"mesh","short_form":"mesh_D017636","description":["A class of asbestos that includes silicates of magnesium, iron, calcium, and sodium. The fibers are generally brittle and cannot be spun, but are more resistant to chemicals and heat than ASBESTOS, SERPENTINE. (From Hawley\u0027s Condensed Chemical Dictionary, 11th ed)"],"label":"Asbestos, Amphibole","obo_id":"mesh:D017636","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_131189","ontology_name":"chebi","ontology_prefix":"CHEBI","short_form":"CHEBI_131189","description":["A hard, amorphous, brittle, inorganic, usually transparent, polymerous silicate of basic oxides, usually potassium or sodium."],"label":"glass","obo_id":"CHEBI:131189","type":"class"},{"iri":"http://purl.obolibrary.org/obo/ENVO_01000232","ontology_name":"envo","ontology_prefix":"ENVO","short_form":"ENVO_01000232","description":["Felsic lava is lava which is high in silica (\u003e 69 percent by weight), aluminium, potassium, sodium, and calcium, forming a polymerized liquid rich in feldspar and quartz. Felsic lava has a  higher viscosity than other magma types. Felsic magmas can erupt at temperatures as low as 650 to 750 °C. Unusually hot (\u003e950 °C) rhyolite lavas, however, may flow for distances of many tens of kilometres"],"label":"felsic lava","obo_id":"ENVO:01000232","type":"class","exact_synonyms":["silicic lava"]},{"iri":"http://id.nlm.nih.gov/mesh/D005898","ontology_name":"mesh","ontology_prefix":"mesh","short_form":"mesh_D005898","description":["Hard, amorphous, brittle, inorganic, usually transparent, polymerous silicate of basic oxides, usually potassium or sodium. It is used in the form of hard sheets, vessels, tubing, fibers, ceramics, beads, etc."],"label":"Glass","obo_id":"mesh:D005898","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_144039","ontology_name":"chebi","related_synonyms":["3-(trimethylsilyl)((2)H6)propane-1-sulfonic acid","DSS-d6"],"ontology_prefix":"CHEBI","short_form":"CHEBI_144039","description":["A deuterated compound that is is an isotopologue of 3-(trimethylsilyl)propane-1-sulfonic acid (DSS) in which the six hydrogen atoms attached to the carbon chain linking the silicon and the sulfur atoms have been replaced by deuterium. It is often used in NMR spectroscopy (often as the corresponding sodium salt) as a calibration standard - it is much more water soluble that tetramethylsilane, so is often used for studies on proteins in water."],"label":"3-(trimethylsilyl)-1-propanesulfonic acid-d6","obo_id":"CHEBI:144039","type":"class","exact_synonyms":["3-(trimethylsilyl)((2)H6)propane-1-sulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_133354","ontology_name":"chebi","related_synonyms":["Alum bentonite","Aluminium silicate hydrate","Aluminum silicate hydrate","Benclay","Bentonite magma","Bentonite","Bentonitum","Ci 77004","Colloidal clay","E-558","INS NO.558","INS-558","Smectite","Wilkonite"],"ontology_prefix":"CHEBI","short_form":"CHEBI_133354","description":["An aluminosilicate mineral consisting mostly of montmorillonite. The different types of bentonite (aluminium bentonite; calcium bentonite; potassium bentonite; sodium bentonite) are named after their dominant element."],"label":"bentonite","obo_id":"CHEBI:133354","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_132108","ontology_name":"micro","related_synonyms":["Sodium metasilicate nonahydrate"],"ontology_prefix":"MICRO","short_form":"CHEBI_132108","description":["A hydrate that is the nonahydrate form of sodium silicate."],"label":"sodium silicate nonahydrate","obo_id":"CHEBI:132108","type":"class","exact_synonyms":["sodium oxosilanebis(olate)--water (1/9)"]},{"iri":"http://purl.obolibrary.org/obo/ENVO_01000483","ontology_name":"micro","ontology_prefix":"MICRO","short_form":"ENVO_01000483","description":["Flat glass is a soda-lime glass which is composed of approximately 73% silicon dioxide (silica), 14% sodium oxide, 9% calcium oxide, 4% magnesium oxide, 0.15% aluminium oxide, 0.03% potassium oxide, 0.02% titanum dioxide, and 0.01% iron III oxide.","Most flat glass is soda-lime glass produced by the float glass process. It is more water soluble than container glass."],"label":"flat glass","obo_id":"ENVO:01000483","type":"class","exact_synonyms":["plate glass","sheet glass"]},{"iri":"http://purl.obolibrary.org/obo/ENVO_01000484","ontology_name":"micro","ontology_prefix":"MICRO","short_form":"ENVO_01000484","description":["Container glass is a soda-lime glass which is composed of approximately 74% silicon dioxide (silica), 13% sodium oxide, 10.5% calcium oxide, 1.3% aluminium oxide, 0.3% potassium oxide, 0.2% sulphur trioxide, 0.2% magnesium oxide,  0.04% iron III oxide, and 0.01%  titanum dioxide.","Container glass is less water soluble than flat glass."],"label":"container glass","obo_id":"ENVO:01000484","type":"class"},{"iri":"http://purl.obolibrary.org/obo/ENVO_01000482","ontology_name":"micro","ontology_prefix":"MICRO","short_form":"ENVO_01000482","broad_synonyms":["glass"],"description":["Soda-lime glass is a silica-based glass which is composed of approximately 75% silicon dioxide, with sodium oxide and calcium oxide consituting most of its remaining composition.","This type of glass constitutes 90% of manufactured glass."],"label":"soda-lime glass","obo_id":"ENVO:01000482","type":"class","exact_synonyms":["soda-lime-silica glass"]},{"iri":"http://purl.obolibrary.org/obo/ENVO_01000232","ontology_name":"micro","ontology_prefix":"MICRO","short_form":"ENVO_01000232","description":["Felsic lava is lava which is high in silica (\u003e 69 percent by weight), aluminium, potassium, sodium, and calcium, forming a polymerized liquid rich in feldspar and quartz. Felsic lava has a  higher viscosity than other magma types. Felsic magmas can erupt at temperatures as low as 650 to 750 °C. Unusually hot (\u003e950 °C) rhyolite lavas, however, may flow for distances of many tens of kilometres"],"label":"felsic lava","obo_id":"ENVO:01000232","type":"class","exact_synonyms":["silicic lava"]}],"numFound":24,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["mesh","7","CHEBI","6","MICRO","6","ENVO","4","FOODON","1"],"isDefiningOntology":["true","18","false","6"],"ontologyId":["dron","9","mesh","7","chebi","6","micro","6","slm","5","enm","5","envo","4","ohd","3","ecto","2","snomed","2","tfo","1","foodon","1","gaz","1"],"ontologyIri":["https://w3id.org/biopragmatics/resources/mesh/mesh.ofn","7","http://purl.obolibrary.org/obo/chebi.owl","6","http://purl.obolibrary.org/obo/MicrO.owl","6","http://purl.obolibrary.org/obo/envo.owl","4","http://purl.obolibrary.org/obo/foodon.owl","1"],"isObsolete":["false","24"],"type":["class","24"]}}}
    {
      "proposal_id": "NSV4-PROP-NBRC_1020_Se_W_Solution",
      "case_ids": [
        "CM_NAME:8f4f818454b45cde5b8fac36155fb028ce405d508d1c62d696f00675a673e89b"
      ],
      "kind": "new_owner",
      "owner_path": "data/ingredients/mapped/NBRC_1020_Se_W_Solution.yaml",
      "before_sha256": null,
      "after_capture": {
        "root": "artifact",
        "path": "successor-1226-1237-v1/payloads/NSV4-PROP-NBRC_1020_Se_W_Solution.yaml",
        "sha256": "d6a2c6de6bb04cc2c7ea3fc2c97dc1a0227151caa331af1baed4875dfbe8651f"
      },
      "description": "Literal printed masses and added distilled-water volume per source preparation. G/MG_PER_PREPARATION_WITH_1_L_WATER describes a recipe batch containing1L added water, not a final1L solution or final concentration. NBRC1020 and JCM317 have the same nominal listed masses (4 mg sodium selenite and 4 mg tungstate reagent) plus 1 L distilled water, but NBRC1020 omits hydrate qualifiers while JCM317 explicitly states Na2WO4·2H2O. Omission establishes neither anhydrous identity nor equality/difference. Keep these source-bound partial proposals; do not merge or co-install them as proved-distinct owners without source-applicable supplied-reagent evidence or an explicitly reviewed common nominal scope. The 1 L is added water, not a demonstrated final solution volume.",
      "evidence_ids": [
        "NS-S-019",
        "NS-S-020",
        "NS-L-DOSES",
        "NS-P-nbrc-1020",
        "NSC-OLS-NBRC_1020_Se_W_Solution",
        "NSC-FAMILY-VALIDATION",
        "NSC-FAMILY-SEARCH",
        "NSC-FAMILY-APPLICABILITY",
        "NSV2-terms",
        "NSV2-components",
        "NSC-NATIVE",

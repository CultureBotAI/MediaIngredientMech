            "evidence": [
              {
                "reference": "doi:10.5283/epub.34741",
                "supports": "SUPPORT",
                "explanation": "Growth supported on the 1/2 SME+S0 variant. Phase-2 flagged that this formulation differs from the parent (KI, SrCl2.6H2O, NaHCO3, different boric acid level); treat as variant-scoped evidence, not parent identity. | Identifiers: DSM 13166T"
              }
            ]
          }

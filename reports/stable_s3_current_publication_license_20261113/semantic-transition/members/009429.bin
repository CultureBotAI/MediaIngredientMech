    <main role="main" class="flex-shrink-0 mt-0">
            <div class="container pt-4 pb-5">
                <h2><span>カタログ検索結果</span>
                    <small class="text-muted">詳細情報</small></h2>
                <h3>Medium Detail Information</h3>
                <table border="1" width="600">
                    <tbody>
                        <tr>
                            <th class="w-30" width="20%">
                                <div align="left">Medium No.</div>
                            </th>
                            <td width="80%">943</td>
                        </tr>
                        <tr>
                            <th class="w-30" width="20%">
                                <div align="left">Medium</div>
                            </th>
                            <td width="80%">Modified <i>Prosthecomicrobium </i>and <i>Ancalomicrobium </i>Medium</td>
                        </tr>
                        <tr>
                            <th colspan="2">
                                <div align="left">Composition</div>
                            </th>
                        </tr>
                        <tr>
                            <td colspan="2" id="medium-comp"><table width='600' border='0'><tr height='1px'><td width='5%'>&nbsp;</td><td width='60%' align='left' colspan='4'>Bacto Peptone (Difco)</td><td width='20%' align='right'>0.15</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='60%' align='left' colspan='4'>Yeast extract</td><td width='20%' align='right'>0.15</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='60%' align='left' colspan='4'>(NH<sub>4</sub>)<sub>2</sub>SO<sub>4</sub></td><td width='20%' align='right'>0.25</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='60%' align='left' colspan='4'>Glucose</td><td width='20%' align='right'>1</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='60%' align='left' colspan='4'>Vitamin solution*</td><td width='20%' align='right'>10</td><td width='15%' align='left'>ml</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='60%' align='left' colspan='4'>Modified Hutner's solution**</td><td width='20%' align='right'>20</td><td width='15%' align='left'>ml</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='60%' align='left' colspan='4'>Agar (if needed)</td><td width='20%' align='right'>15</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='60%' align='left' colspan='4'>Distilled water</td><td width='20%' align='right'>970</td><td width='15%' align='left'>ml</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='80%' colspan='5' align='right'>pH unadjusted</td><td width='15%'>&nbsp;</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='15%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='15%'>&nbsp;</td></tr><tr><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='90%' colspan='5' align='left'>*Vitamin solution</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Biotin</td><td width='20%' align='right'>2</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Folic acid</td><td width='20%' align='right'>2</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Thiamine-HCl</td><td width='20%' align='right'>5</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Ca-pantothenate</td><td width='20%' align='right'>5</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Vitamin B<sub>12</sub></td><td width='20%' align='right'>0.1</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Riboflavin</td><td width='20%' align='right'>5</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Distilled water</td><td width='20%' align='right'>1</td><td width='15%' align='left'>L</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='15%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='15%'>&nbsp;</td></tr><tr><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='90%' colspan='5' align='left'>**Modified Hutner's solution</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Nitrilotriacetic acid (NTA)</td><td width='20%' align='right'>10</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>MgSO<sub>4</sub>&middot;7H<sub>2</sub>O</td><td width='20%' align='right'>29.7</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>CaCl<sub>2</sub>&middot;2H<sub>2</sub>O</td><td width='20%' align='right'>3.34</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>(NH<sub>4</sub>)<sub>6</sub>Mo<sub>7</sub>O<sub>24</sub>&middot;2H<sub>2</sub>O</td><td width='20%' align='right'>9.25</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>FeSO<sub>4</sub>&middot;7H<sub>2</sub>O</td><td width='20%' align='right'>99</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Metal salt solution 44***</td><td width='20%' align='right'>50</td><td width='15%' align='left'>ml</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='90%' colspan='5'>Adjust volume to 1 L with distilled water.</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='90%' colspan='5'>Dissolve and neutralize the nitrilotriacetic acid with KOH (7.3 g); add the other ingredients and adjust the pH to 6.6-6.8 before bringing the volume to 1.0 L with distilled water.</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='15%'>&nbsp;</td><td width='20%'>&nbsp;</td><td width='15%'>&nbsp;</td></tr><tr><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='90%' colspan='5' align='left'>***Metal salt solution 44</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Na-EDTA</td><td width='20%' align='right'>250</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>ZnSO<sub>4</sub>&middot;7H<sub>2</sub>O</td><td width='20%' align='right'>1095</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>FeSO<sub>4</sub>&middot;7H<sub>2</sub>O</td><td width='20%' align='right'>0.5</td><td width='15%' align='left'>g</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>MnSO<sub>4</sub>&middot;H<sub>2</sub>O</td><td width='20%' align='right'>154</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>CuSO<sub>4</sub>&middot;5H<sub>2</sub>O</td><td width='20%' align='right'>39.2</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Co(NO<sub>3</sub>)<sub>2</sub>&middot;6H<sub>2</sub>O</td><td width='20%' align='right'>24.8</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Na<sub>2</sub>B<sub>4</sub>O<sub>7</sub>&middot;10H<sub>2</sub>O</td><td width='20%' align='right'>17.7</td><td width='15%' align='left'>mg</td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='50%' align='left' colspan='2'>Distilled water</td><td width='20%' align='right'>100</td><td width='15%' align='left'>ml</td></tr><tr height='1px'><td width='100%' colspan='7'></td></tr><tr height='1px'><td width='5%'>&nbsp;</td><td width='5%'>&nbsp;</td><td width='90%' colspan='5'>Dissolve the EDTA and add a few drops of concentrated H<sub>2</sub>SO<sub>4</sub> to retard precipitation of the heavy metal ions. Store in the dark and cold (5℃).</td></tr></table></td>
                        </tr>
                        <tr>
                            <th class="w-30">

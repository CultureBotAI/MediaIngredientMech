  "comments": [
    {
      "paragraph_index": 1,
      "comment": "Mycoplasrna capricolum ATCC 27343 was grown for 24 h at 37 ° C in a medium containing 2.2% w/v PPLO broth (Difco), 1% v/v calf serum (Gibco), 0.2% w/v glucose, 400 units(U)/ml of penicillin G, and 50 mM Tris-HC1 (pH 7.6)."
    },

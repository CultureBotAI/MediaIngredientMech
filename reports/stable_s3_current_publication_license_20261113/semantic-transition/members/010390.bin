    {
      "proposal_id": "W05-FINAL-MAT-032",
      "after_capture": {
        "root": "artifact",
        "path": "buffer-parts-v1/parents/proposed/Soy_Peptone.yaml",
        "sha256": "d7b33ac1b22e870286902ae2c8a756884aa5066fb5acb94f464c6be1675b7cee"
      },
      "reviewer": "/root/final_skeptical",
      "assessment": "Full MICRO:0000181 definition and its source discussion describe generic enzymatic soy-flour digest, consistent with MediaDive75 and the independent manufacturer definition. This is a supported exact generic identity. The erroneous Hordeum parenthesis, branded/papaic synonyms and numerical product annotations are not imported. The complete final payload preserves five existing alias exclusions, the unresolved peptic-process alias context, old evidence/history, statistics and roles. The separately reviewed rejected Bacto tombstone prevents the inherited shared-ID representative from acquiring an unsupported generic-Soy equivalence. Neither shared-ID source membership nor export admission is established.",
      "conclusion": "PASS_BOUNDED_SOURCE_PROPOSAL_WITH_LIMITATIONS",
      "complete_payload_read": true,
      "protected_fields": "Original history/evidence, roles, statistics, source forms and raw names checked in complete payloads and independent parsed comparisons. No source/owner/export approval.",
      "assessment_origin": {
        "path": ".temp/w05-buffer-parts-v1/review/parents-scientific-review-v1.json",
        "sha256": "25889e17450b8e7503a816355727345160fb4dc3af872e70a8647e1116169c3b"
      },
      "actual_scientific_reviewer": "/root/final_skeptical",

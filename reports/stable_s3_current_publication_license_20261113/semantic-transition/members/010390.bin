    {
      "proposal_id": "W05-PARENTS-BACTO-SOYTONE-CONTINUITY",
      "after_capture": {
        "root": "artifact",
        "path": "buffer-parts-v1/parents/tombstone/proposed-v2/Bacto_Soytone.yaml",
        "sha256": "f242b5c54ac1f1785200c1f604be368d8dabd47ef553164dee8c8e291b6d7a7d"
      },
      "reviewer": "/root/final_skeptical",
      "assessment": "The authentic rejected Bacto Soytone tombstone previously redirected through a nonunique FOODON identifier. Explicit empty representative is the native unresolved-target mechanism; removal instead invokes legacy identifier fallback. Independent execution confirms the empty value retains the tombstone name and emits no SSSOM rows while avoiding active shared-ID owner credit. A redirect to generic MICRO181 would assert unsupported product equivalence. All original identity/mapping/status/aliases/zero statistics/history/evidence remain unchanged; only the bounded continuity annotation and event are appended. The new unsupported human attribution was removed in exact v2; historical enums and objects remain intact. This does not reconstruct a branded owner or repartition historic source membership.",
      "conclusion": "PASS_BOUNDED_SOURCE_PROPOSAL_WITH_LIMITATIONS",
      "complete_payload_read": true,
      "protected_fields": "Original history/evidence, roles, statistics, source forms and raw names checked in complete payloads and independent parsed comparisons. No source/owner/export approval.",

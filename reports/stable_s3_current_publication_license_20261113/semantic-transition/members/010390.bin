    },
    {
      "proposal_id": "W05-FINAL-MAT-039",
      "after_capture": {
        "root": "artifact",
        "path": "buffer-parts-v1/parents-direct-v1/proposed/Peptone.yaml",
        "sha256": "c083794668a362203de6430eaa2609c34cd8ef78574a1230aa25b4a64fb55fd7"
      },
      "assessment": "Complete final Peptone payload read. The direct ordinary generic material sense is supported by NLM definition/entry term and manufacturer material description; source labels have no independently established different specified preparation. Current notes clearly supersede prior assay-gate/FoodOn inference while retaining the actual earlier history and evidence. No process, manufacturer, nutrient role or source-occurrence approval is added. Exact one-row native identity agrees with selected semantics; generic references require separate final byte review.",
      "assessment_origin": {

	<div class="modal" id="strd-change-prop" tabindex="-1" role="dialog">
		<div class="modal-dialog" role="document">
			<div class="modal-content">

				<button class="close" role="button" data-dismiss="modal">
					<span aria-hidden="true">&times;</span>
				</button>

				<div class="form-to-fill">
					<h2>Change proposal</h2>
					<p>You found an error in Bac<span class="italic">Dive</span>? Please tell us about it!</p>
					<p>Note that changes will be reviewed and judged. If your changes are legitimate, changes will occur within the next Bac<span class="italic">Dive</span> update. Only proposed changes supported by the according reference will be reviewed. The Bac<span class="italic">Dive</span> team reserves the right to reject proposed changes.</p>

					<form id="proposal" action="" accept-charset="utf-8" method="post">

						<input name="proposal[token]" value="" autocomplete="off" type="hidden" class="proposal-token">
						<input class="tbl-src" name="proposal[tbl_src]" value="" autocomplete="off" type="hidden">
						<input name="proposal[strain_id]" value="168456" autocomplete="off" type="hidden">

						<div>
							<p>Field you want to change:</p>
							<div class="field-content"></div>
						</div>

						<div class="form-group">
							<label for="prop-text">Your change proposal*</label>
							<textarea class="form-control" id="prop-text" required="" name="proposal[text]"></textarea>
						</div>

						<div class="form-group">
							<label for="prop-reference">Reference*</label>
							<input class="form-control" id="prop-reference" maxlength="255" name="proposal[reference]" value="" type="text" required="">
						</div>

						<div class="form-group">
							<label for="prop-fam-name">Name *</label>
							<input class="form-control" id="prop-fam-name" required="" maxlength="70" name="proposal[fam-name]" value="" type="text">
							<input name="proposal[name]" class="help-field name" value="" tabindex="500" type="text">
						</div>

						<div class="form-group">
							<label for="prop-email">Email *</label>
							<input class="form-control" id="prop-mail" required="" maxlength="255" name="proposal[mail]" value="" type="email">
							<input name="proposal[email]" class="help-field email" value="" tabindex="500" type="text">
						</div>

						<div class="form-group">
							<label for="prop-institution">Institution</label>
							<input class="form-control" id="prop-institution" maxlength="255" name="proposal[institution]" value="" type="text">
						</div>

						<div class="form-group input-field-captcha">
							<br>
							<img src="/captcha/change_prop" alt="CAPTCHA" data-captcha="change_prop" class="captcha-image"><img src="images/icons/loop.svg" alt="Reload captcha" class="reload-captcha">
							<br>
							<label for="prop-captcha">Please Enter the Captcha Text</label>
							<input class="form-control" type="text" id="prop-captcha" name="proposal[captcha]" required="" autocomplete="off">
						</div>

						<div class="btn-send clearfix">
							<button type="submit" form="proposal" name="proposal[submit]" value="submit-contact" class="btn primary">
								<i class="ph ph-paper-plane-tilt mr-5"></i>
								<img src="images/ajax-loader.gif" class="img-load"> Send
							</button>
						</div>
					</form>
				</div>

				<div class="success-message hide">
					<h2>Change proposal</h2>
					<p>Successfully sent</p>
				</div>

				<div class="text-right mt-20">
					<button data-dismiss="modal" class="btn primary">Close</button>
				</div>

			</div>
		</div>

	</div>


                "steps": [
                    {
                        "step": "The growth medium contains the following components (per liter): "
                    },
                    {
                        "step": "Bring up to 1 liter"
                    },
                    {
                        "step": "Combine the distilled water and Solutions A-D in an Erlenmeyer flask and dispense into glass serum bottles."
                    },
                    {
                        "step": "Seal the serum bottles with butyl rubber stoppers and crimp seals. Using a syringe and needle, inject pure 10% methane."
                    },
                    {
                        "step": "Autoclave the serum bottles for 20 minutes at 121 \u00b0C."
                    },
                    {
                        "step": "Upon cooling to room temperature, add solution E from a filter-sterilized stock solution."
                    },
                    {
                        "step": "The final pH of the medium should be 7.0"
                    }
                ]
            },

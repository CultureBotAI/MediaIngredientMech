  "comments": [
    {
      "paragraph_index": 1,
      "comment": "Prepare a 2X stock of medium:"
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 4,
      "comment": "Adjust pH to7.5 (not higher because mediumwill precipitate)."
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "Prepare 2X agar solution:"
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": "Autoclaveboth solutionsat 121C. Allow to cool down, mix both solutionsand aseptically add:"
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 13,
      "comment": "Dispense as required."
    },
    {
      "paragraph_index": 14,
      "comment": "****Autoclaving of the 2X stock culture medium might cause the formation of a precipitate, but this won’t interfere with the growth of the strain*****"
    },
    {
      "paragraph_index": 15,
      "comment": ""
    },
    {
      "paragraph_index": 17,
      "comment": ""
    },
    {
      "paragraph_index": 18,
      "comment": "***Trace elements solution can be autoclaved and stored at 4C. Autoclaving causes the formation of a precipitate, but this won’t interfere with the growth of the strain (shake well before use).******"
    }
  ]
}
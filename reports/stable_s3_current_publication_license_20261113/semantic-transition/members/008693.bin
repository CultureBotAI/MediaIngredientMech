{"id":62946,"chebi_accession":"CHEBI:62946","name":"ammonium sulfate","stars":3,"definition":"An inorganic sulfate salt obtained by reaction of sulfuric acid with two equivalents of ammonia. A high-melting (decomposes above 280°C) white solid which is very soluble in water (70.6 g/100 g water at 0°C; 103.8 g/100 g water at 100°C), it is widely used as a fertilizer for alkaline soils.","ascii_name":"ammonium sulfate","names":{"SYNONYM":[{"name":"ammonium sulfate (2:1)","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"ammonium sulfate (2:1)","adapted":true,"language_code":"en"},{"name":"ammonium sulphate","status":"C","type":"SYNONYM","source":"SUBMITTER","ascii_name":"ammonium sulphate","adapted":false,"language_code":"en"},{"name":"diammonium sulfate","status":"C","type":"SYNONYM","source":"IUPAC","ascii_name":"diammonium sulfate","adapted":false,"language_code":"en"},{"name":"mascagnite","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"mascagnite","adapted":true,"language_code":"en"},{"name":"(NH<small><sub>4</sub></small>)<small><sub>2</sub></small>SO<small><sub>4</sub></small>","status":"C","type":"SYNONYM","source":"ChEBI","ascii_name":"(NH4)2SO4","adapted":false,"language_code":"en"},{"name":"sulfuric acid ammonium salt (1:2)","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"sulfuric acid ammonium salt (1:2)","adapted":true,"language_code":"en"},{"name":"sulfuric acid, diammonium salt","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"sulfuric acid, diammonium salt","adapted":true,"language_code":"en"},{"name":"sulphate of ammonia","status":"C","type":"SYNONYM","source":"ChEBI","ascii_name":"sulphate of ammonia","adapted":false,"language_code":"en"}],"IUPAC NAME":[{"name":"diazanium sulfate","status":"C","type":"IUPAC NAME","source":"IUPAC","ascii_name":"diazanium sulfate","adapted":false,"language_code":"en"}]},"chemical_data":{"formula":"2H4N.O4S","charge":0,"mass":"132.141","monoisotopic_mass
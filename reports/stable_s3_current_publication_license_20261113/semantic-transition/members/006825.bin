    {
      "paragraph_index": 3,
      "comment": "Combine all components except Na2S and bring to boil."
    },
    {
      "paragraph_index": 4,
      "comment": "Cool under 80% N2, 20% CO2. Add Na2S after cooling, just prior to dispensing."
    },
    {
      "paragraph_index": 5,
      "comment": "Adjust pH to 7.2 - 7.4. Autoclave at 121C for 15 minutes."
    },
    {
      "paragraph_index": 6,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": "Bacteriology may flush the headspace with 80% H2, 20% CO2 prior to inoculation."
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": "Dissolve the NTA in 200.0 ml water. Adjust pH to 6.5. Add additional ingredients. Bring water to 1.0 L."

        <div class="un_info_footer">
          <div class="un_info_footer_notation">
            <p class="un_info_footer_notationLabel">Designated quasi-drug</p>
            <p class="un_info_footer_notationTxt">Gastrointestinal Aid and Nutritional Supplement</p>
          </div>
          <div class="un_info_footer_note">

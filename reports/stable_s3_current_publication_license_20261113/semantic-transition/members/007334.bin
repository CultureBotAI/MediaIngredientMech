              </li>
              <li class="un_infoItem_product un_infoItem_product__pouch_large">
                <div class="un_infoItem_productImg"><img src="/special/ebios/assets/img/product/product_img_ebios_pouch_large.webp" alt="EBIOS Tablets 900 tablets" width="430" height="514"></div>
                <p class="un_infoItem_productPrice">900 tablets</p>

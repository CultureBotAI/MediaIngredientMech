              </li>
            </ul>
          </li>
          <li class="un_infoItem">
            <p class="un_infoItem_nameTag">For taking with you on the go</p>
            <p class="un_infoItem_name">Pouch Type</p>
            <ul class="un_infoItem_productList">
              <li class="un_infoItem_product un_infoItem_product__pouch_small">

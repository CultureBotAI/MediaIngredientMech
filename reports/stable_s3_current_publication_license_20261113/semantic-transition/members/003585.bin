"""Save a genuine native self-review in a separately owned private Git fixture."""
from pathlib import Path
import datetime,hashlib,importlib.util,json,os,subprocess,sys
sys.dont_write_bytecode=True
D=Path(__file__).absolute().parent;C=D.parents[1];A=C/'integration/ancillary1258-worktree';F=D/'native-author-fixture'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def write(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
def save(p,x):write(p,(json.dumps(x,indent=2,ensure_ascii=False)+'\n').encode())
assert F.is_dir() and (F/'.git').is_dir()
assert not (D/'NATIVE-AUTHOR-RECEIPT.json').exists()
assert sha(D/'candidates/Menadione.yaml')=='4fe793abcf278200df7d1f2572922e410e81a8220dd8ebb6c25b3d88c66de591'
# Append-only metadata repair: first attempt and its genuine fixture stay intact.
for name in ['save_author_review.py','save-author.stdout','save-author.stderr','fixture-creation.json','save_author_review_v2.py']:
 dest=F/'evidence'/'author-save-attempts'/name
 write(dest,(D/name).read_bytes())
spec=importlib.util.spec_from_file_location('menadione_author_review',F/'scripts/record_review.py');rr=importlib.util.module_from_spec(spec);spec.loader.exec_module(rr)
sel=json.loads((D/'SELECTOR.json').read_text());tid=sel['operation_id']
targets=[{'target_id':tid,'path':'evidence/candidates/Menadione.yaml','label':'Menadione private Hemodal applicability successor','kind':'source','ownership_note':'C-authored private complete payload; authentic maintained destination data/ingredients/mapped/Menadione.yaml and original W08 proposal/case retained in origin-proof. No maintained application.'}]
inputs=[str(p.relative_to(F)) for p in F.rglob('*') if p.is_file() and '.git' not in p.relative_to(F).parts]
ins=rr.inspect_source(F,targets,inputs)
now=datetime.datetime.now(datetime.UTC);at=now.isoformat().replace('+00:00','Z');rid=now.strftime('%Y%m%dT%H%M%SZ')+'-c-menadione-hemodal-author-response'
ev=[]
for eid,rel,kind,summary in [
 ('E-ISSUE','inputs/issue/readback-00.json','record_content','Exact root-filed #718 comment6724713374 precedes candidate authoring.'),
 ('E-PRIMARY','inputs/research/research/c/search-07.json','record_content','Captured original Santa Cruz sections1/3 distinguish neutral menadioneCAS58-27-5 and bisulfiteCAS130-37-0 under Hemodal; failed direct HTTP responses remain separate in original W02 packet.'),
 ('E-BAYER','inputs/research/research/c/captures/coimbra-p22.png','record_content','Visually inspected original Bayer advertisement separates tablet derivative and sodium-bisulfite injectable; complete original PDF and acquisition receipt also captured.'),
 ('E-POSITIVE','inputs/research/skeptic/captures-v2/nist-menadione.body','record_content','Positive neutral-menadione Hemodal chemical-name usage preserved; not a declaration that every use is false.'),
 ('E-DELTA','field-delta.json','record_content','One synonym type plus truthful LLM evidence/history, exact inverse preservation of all other fields and old prefixes.'),
 ('E-ORIGIN','origin-proof.json','record_content','Original W08 full proposal/case/evidence and authentic A842 beforeimage retained; no new origin or source decision.'),
 ('E-CHECKS','verification.json','validation','15 actual author checks: native schema/roundtrip, inverse and negative controls, full2956 partonomy, exact native row and forced-KG rejection.'),
 ('E-ROWS','native-row-diagnostic.json','validation','Native diagnostic with real KG gzip and full authentic A842 context changes only source and other; Hemodal cannot return via KG variants.'),
 ('E-BOUNDARY','inputs/research/inputs/atcc1257-original-capture.pdf','record_content','Original ATCC1257 evidence retains the menadione solute versus ethanol/water stock boundary; flattened dose is not validated.'),
 ('E-PLAN','SELECTOR.json','record_content','Explicit private author successor, exact original operation and independent/apply flags false; original four-only input configuration untouched.')]:
  p=F/'evidence'/rel;ev.append({'evidence_id':eid,'kind':kind,'reference':str(p.relative_to(F)),'snapshot_sha256':sha(p),'accessed_at':at,'support':'supports','summary':summary})
review={'schema_version':'1.0.0','review_id':rid,'kind':'record','repository':ins['repository'],'title':'Author response: preserve ambiguous inherited Hemodal without unqualified resolution','started_at':json.loads((D/'field-delta.json').read_text())['new_history']['timestamp'].replace('+00:00','Z'),'finished_at':at,'reviewer':{'identity':'Codex /root/step7d_science_c','kind':'agent','independence':'self_review','independence_basis':'C authored this exact private candidate and the collection/triage. This is only the author integrity/response record, not independent source science or whole-owner approval. Root assigned B a distinct complete-byte review. Fixture Git identity is review-only, not production842.'},'skill':'curate-yaml-record','completion':'completed','verdict':'pass_with_limitations','scientific_review':False,'summary':'Narrow private successor changes only the unqualified Hemodal entry to REJECTED_LABEL with truthful LLM evidence/history. All original fields and source/ATCC/role/count limits remain. Native writer/resolver/projection controls pass; independent whole-owner review and final batch/row selection remain pending.','source':ins['source'],'targets':targets,'scope':{'description':'One complete private candidate and its bounded alias-applicability response/integrity checks.','selection':'Exactly ORIGINAL-w08::vm-prop-menadione selected d18105cf successor4fe793ab.','coverage':'full','population_size':1,'reviewed_target_ids':[tid],'exclusions':[{'target':'Independent whole-owner/row/source science approval','reason':'Self-authored response; distinct review and W01 full-row findings remain separate.'},{'target':'Source application, current final batch, canonical publication and export','reason':'No native prepare/apply, synchronization, full generation or acceptance performed.'}]},'checks':[{'check_id':'C-BOUNDED','name':'Guarded exact candidate/schema/preservation and native diagnostic controls','status':'passed','required':True,'target_ids':[tid],'evidence_ids':['E-DELTA','E-CHECKS','E-ROWS','E-ORIGIN'],'command':'Maintained Python3.13 author_successor.py followed by verify_projection.py in this private packet','exit_code':0,'summary':'15 bounded checks pass. Genuine2956-owner overlay has zero partonomy violations; one native row changes only source and other, retaining every other cell and suppression object. Forced-KG variants do not restore Hemodal.'}],'evidence':ev,'assessments':[{'assessment_id':'A-DELTA','area':'provenance','topic':'Exact source/proposal/history preservation','outcome':'supported','target_ids':[tid],'evidence_ids':['E-DELTA','E-ORIGIN','E-BOUNDARY','E-PLAN'],'summary':'All fields except the one synonym type and appended evidence/history are exact. Original source objects, inherited authorship, ATCC stock/quantity limits, roles and counts persist; no new origin or current plan edit.'},{'assessment_id':'A-RESPONSE','area':'consistency','topic':'Claim-specific nonresolving interpretation','outcome':'supported','target_ids':[tid],'evidence_ids':['E-ISSUE','E-PRIMARY','E-BAYER','E-POSITIVE','E-DELTA'],'summary':'Author response preserves the known neutral substance and positive chemical-name sense while explaining affirmative conflicting forms under the unqualified token. It is not blanket brand rejection, a new chemical identity or a claim that all Hemodal use is false.'},{'assessment_id':'A-CHECKS','area':'consistency','topic':'Native resolution and private projection limits','outcome':'supported','target_ids':[tid],'evidence_ids':['E-CHECKS','E-ROWS'],'summary':'Native resolving policy excludes the rejected entry; the actual-KG diagnostic removes it and rejects forced upper/lowercase reintroduction while retaining the three supported chemical names. This is not final full-campaign generation or row admission.'}],'findings':[],'actions':[],'limitations':['First native author-save attempt refused assessments.2.area=validation before saving any review; the original script/stderr and genuine fixture snapshot are retained. This successor uses the native consistency area; candidate and checks are unchanged.','This is an author self-review only; B distinct complete-byte assessment and W01 full-row findings remain required.','Original W02 review is needs_curation, limited to four token claims and qualified private native primitives; this author pair does not relabel it or add a science vote.','Historical finished-product formulations are not inferred. Positive neutral Hemodal usage remains; other three brand-name chemical senses are preserved.','No new provider calls, full canonical generation, native source preparation/application, source-case change, four-only configuration change or release hold clearance.','The genuine local fixture Git snapshot supports native saving with actual local inputs; no production baseline, reviewer identity or application approval is invented.']}
rr.validate_review(review);yp=rr.save_review(F,review);assert rr.read_review(F,str(yp.relative_to(F)))==review
mp=yp.with_name('review.md');receipt={'status':'NATIVE_AUTHOR_SELF_REVIEW_SAVED_AND_STRICT_READBACK','source_root':str(F),'fixture_git_revision':ins['source']['git_revision'],'pair':{'yaml':str(yp),'markdown':str(mp),'yaml_sha256':sha(yp),'markdown_sha256':sha(mp)},'inputs':len(ins['source']['inputs']),'scientific_review':False,'independence':'self_review','independent_approval':False,'application_authorized':False}
save(D/'NATIVE-AUTHOR-RECEIPT.json',receipt);print(json.dumps(receipt,indent=2))

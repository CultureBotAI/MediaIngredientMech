    document.addEventListener("DOMContentLoaded", () => {

        function checkBanner(msg, id) {

            if (!msg) return;
            id = `${id}-banner`;

            if ((new RegExp(`(^|; *)${id}=`)).test(document.cookie))
                return;

            document.querySelector(`#${id} > p`)
                    .insertAdjacentHTML("afterbegin", msg);
            document.getElementById(id).style.display = "table-row";

        }

        try { checkBanner(coopmsg, "coop"); } catch (error) {
            // The "coopmsg" variable may be undefined.
            if (!(error instanceof ReferenceError))
                throw error;
        }

        try { checkBanner(noncoopMessageALL, "noncoop"); }
        catch (error) {
            // The "noncoopMessageALL" variable may be undefined.
            if (!(error instanceof ReferenceError))
                throw error;
        }

    });

    var dcmsLinks = false,
        dcmsParam = dcmsLinks
                    ? function (sep) { return sep + "dcmsLinks=true"; }
                    : function (   ) { return ""                    ; };

</script>


<h3 class="mt-md-0" id="title-recipe">Culture medium recipe</h3>
<div class="d-flex justify-content-between">
    <form action="" method="get" class="mw-full w-350">
            </form>
    <div>
        <div id="volume-adjustment" class="input-group mw-full w-150">
            <div class="input-group-prepend">
                <span class="input-group-text text-decoration-none" data-toggle="tooltip" data-title="Adjust final volume on this page by factor." data-placement="bottom">
                    Vol.
                </span>
            </div>
            <input class="form-control" type="number" name="volume" value="1" onchange="adjustVolume(this)" autocomplete="off">
            <div class="input-group-append">
                <span class="input-group-text">&times;</span>
            </div>
        </div>
    </div>
</div>




<div class="solution-container" id="recipe-container">
    <script type="application/ld+json">{
    "@type": "labProtocol",
    "http://purl.org/dc/terms/conformsTo": "https://bioschemas.org/profiles/LabProtocol/0.6-DRAFT-2020_12_08",
    "headline": "RS Medium - Nutrient Medium (NM) Component",
    "url": "https://mediadive.dsmz.de/solutions/0",
    "keywords": [
        "chemical solution",
        "culture medium",
        "wetlab"
    ],
    "labEquipmentUsed": [
        "Autoclave",
        "Autoclavable bottles",
        "0.22 \u00b5m vaccum filters",
        "0.22 \u00b5m syringe filters",
        "50 ml conical tubes"
    ],
    "protocolPurpose": "Prepare the solution RS Medium - Nutrient Medium (NM) Component for the cultivation of microorganisms.",
    "steps": [],
    "reagentUsed": []
}</script>
        <div class="box solution solution-0 solution-main" id="sol-0">

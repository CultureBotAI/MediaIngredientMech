          "row_sha256": "5a9021a446d89d9256b3734d1c26637c2ceb162122e1e9d407a54867b12fa4bf"
        },
        "outcome": null,
        "reasoning": "NBRC1625 explicitly specifies L-glutamic acid monosodium salt monohydrate. CHEBI:232425 has one water and L stereochemistry, so the existing monohydrate owner is the correct identity. Its InChI/SMILES still omit water despite the correct formula; repair those exact form properties and add the explicit L alias.",
        "missing_requirement": null,
        "applicability": "Applies only to frozen case CM_NAME:6443039e386c491c89767d2bd3172cd009e6f1c8e3ece54320206ab6ac211fe3, source culturemech, identifier L-glutamic acid monosodium salt monohydrate; every listed recipe context and exact raw/processed label remains bound by case_input_sha256. Matching lexical labels do not extend source identity to unrelated cases. All inherited downstream and complete-payload publication holds remain in force.",
        "source_observations": null
      },
      {
        "worker_slot": 4,
        "binding": {
          "path": "/Users/marcin/Documents/VIMSS/ontology/Mechs/MediaIngredientMech/.temp/all-unmatched-20261107/integration/final-campaign-planning-v1/observed-inputs-v1/snapshot/w04/reports/all_unmatched_20261107/worker-04/successors/taps-method-v1/decisions.json",
          "sha256": "64fa1b4a11cbb20c261bb40018d507267bfc388d6993dce652adebd46572b57a",
          "selector": "/166",
          "row_sha256": "3a79d76f5981459fedd4153f44549266f1f028e5cce0cde3d2e5dfc107ee0f19"
        },
        "outcome": null,
        "reasoning": "Original DSMZ1454 specifies Sodium glutamate monohydrate1g. The conventional association to CHEBI:232425 follows the explicit §3 example; the MediaDive1291 automatic CAS6106-04-3/mass187.13 are not independent supplier evidence. NBRC1625 explicitly identifies the L-monosodium monohydrate and CHEBI:232425 independently supplies one-water InChI/SMILES, supporting the existing owner repair. Distinguish name-level association from a measured procurement form.",
        "missing_requirement": "No supplier/lot-specific stoichiometry, enantiomeric purity or hydrate phase measurement is claimed; existing source and publication holds remain.",
        "applicability": "Applies only to frozen case KG_CASE:8b8132641194a6ac99b475e8b178ac9d95b032a1e2497e6b888f1ff010331615, source mediadive, identifier mediadive.ingredient:1291; every listed recipe context and exact raw/processed label remains bound by case_input_sha256. KG helper/graph occurrence definition is retained verbatim and is not asserted to be recipe frequency. Matching lexical labels do not extend source identity to unrelated cases. All inherited downstream and complete-payload publication holds remain in force.",
        "source_observations": null
      },
      {
        "worker_slot": 4,
        "binding": {
          "path": "/Users/marcin/Documents/VIMSS/ontology/Mechs/MediaIngredientMech/.temp/all-unmatched-20261107/integration/final-campaign-planning-v1/observed-inputs-v1/snapshot/w04/reports/all_unmatched_20261107/worker-04/successors/taps-method-v1/decisions.json",
          "sha256": "64fa1b4a11cbb20c261bb40018d507267bfc388d6993dce652adebd46572b57a",
          "selector": "/47",
          "row_sha256": "de73c601416fdacb0dc5e95cb27b85bb95b542a73582d26e41f8e8d3ed1bbddf"
        },
        "outcome": null,
        "reasoning": "JCM904 explicitly specifies sodium glutamate·H2O, fixing one water. MAPPING_SEMANTICS §3 explicitly permits the conventional Sodium glutamate monohydrate association to CHEBI:232425. This permits a name-level association and the exact source spelling on the existing hydrate owner; it is not independent evidence of a particular purchased sodium stoichiometry, enantiomeric purity or supplier CAS. NBRC1625 independently and explicitly states L-glutamic acid monosodium salt monohydrate and supports the owner’s one-water structure repair. The earlier universal printed-Na/L prerequisite was over-broad.",
        "missing_requirement": "Supplier/lot-specific composition and optical purity remain unmeasured; no new procurement claim or release of inherited source/owner/export holds.",
        "applicability": "Applies only to frozen case CM_NAME:53f06327d6d3e2cf7a611d01814399f6ee2ea8308a800d86c58915c2731f16db, source culturemech, identifier Sodium glutamate・H2O; every listed recipe context and exact raw/processed label remains bound by case_input_sha256. Matching lexical labels do not extend source identity to unrelated cases. All inherited downstream and complete-payload publication holds remain in force.",
        "source_observations": null

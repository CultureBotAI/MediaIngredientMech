          "row_sha256": "4b9e0ca82c017ed7b3eaed1c7ed13de387feea8348736d85b5f24c1246b38ff1"
        },
        "outcome": null,
        "reasoning": "JCM558 names D-Calcium pantothenate in its seven-vitamin mixture. This agrees with D-specific CHEBI31345 and the salt stoichiometry corroborated by supplier hemicalcium nomenclature. The doubled hyphen is a harmless raw spelling, unlike a DL qualifier.",
        "missing_requirement": null,
        "applicability": "The one JCM558 occurrence has an exact D-qualified chemical component. The primary recipe gives5mg per100mL; the normalized5g/L value is not approved by this identity proposal. Exact frozen scopes: CultureMech:009957:ingredients/20",
        "source_observations": null
      },
      {
        "worker_slot": 6,
        "binding": {
          "path": "/Users/marcin/Documents/VIMSS/ontology/Mechs/MediaIngredientMech/.temp/all-unmatched-20261107/integration/final-campaign-planning-v1/observed-inputs-v1/snapshot/w06/reports/all_unmatched_20261107/worker-06/successor-v5/decisions.json",

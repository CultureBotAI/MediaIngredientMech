        "binding": {
          "path": "/Users/marcin/Documents/VIMSS/ontology/Mechs/MediaIngredientMech/.temp/all-unmatched-20261107/integration/final-campaign-planning-v1/observed-inputs-v1/snapshot/w05/reports/all_unmatched_20261107/worker-05/buffer-parts-v1/core/decisions.json",
          "sha256": "741bf2c03be4b5ec1ec8dc170508cf6b5d40f606bfacdc10dd2f1d109fda827e",

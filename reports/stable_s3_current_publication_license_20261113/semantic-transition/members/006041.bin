          "selector": "/170",
          "row_sha256": "c8ece7466ada4074fbcd2cc121b96d5510376a15a1737799b253859df95c1432"
        },
        "outcome": null,
        "reasoning": "The raw LaCl3 x7H2O label and primary ingredient1461 CAS10025-84-0 agree on lanthanum trichloride heptahydrate; DSMZ1610 places it in the100µM lanthanide stock. This case can share a proposed heptahydrate owner with the CM formula case only through that exact form agreement, never with anhydrous LaCl3 or the whole stock.",
        "missing_requirement": null,
        "applicability": "Assigned shard index170; source mediadive.ingredient:1461; exact frozen source_record={\"amount\": 0.04, \"compound\": \"LaCl3 x 7 H2O\", \"compound_id\": 1461, \"g_l\": 0.04, \"optional\": 0, \"recipe_order\": 2, \"unit\": \"g\"}. Assessed all 0 embedded downstream holds without changing them. The case digest preserves full nested provenance; KG helper occurrence counts are not measured recipe frequencies. Shared isolated proposal A-P-LANTHANUM-HEPTAHYDRATE applies only to the substance/formulation established by this case; it does not approve source-case, owner or export release.",
        "source_observations": null
      }

<TR><TD WIDTH=75%> Riboflavin                                              </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;7.5&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> mg  </TD></TR>

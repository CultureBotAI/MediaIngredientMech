  "comments": [
    {
      "paragraph_index": 2,
      "comment": "To complete the medium add appropriate amounts of solutions B to F to the sterile solution A in the sequence as indicated."
    },
    {
      "paragraph_index": 3,
      "comment": "The pH of the medium before inoculation should be at 7.2."
    },
    {
      "paragraph_index": 4,
      "comment": "Add solution G only after inoculation of the medium!"
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": "Sparge solution A with 80% H2 and 20% CO2 gas mixture for 30 – 45 min to make it anoxic, then dispense under same gas atmosphere into anoxic serum vials (e.g., 9 ml medium in 50 ml bottle)."
    },
    {
      "paragraph_index": 8,
      "comment": "Pressurize closed bottles with 80% H2 and 20% CO2 gas mixture to 0.5 bar overpressure and autoclave."
    },
    {
      "paragraph_index": 9,
      "comment": ""
    },
    {
      "paragraph_index": 11,
      "comment": "Solution B is autoclaved separately under 80% N2 and 20% CO2 gas atmosphere."
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 14,
      "comment": "Solutions C, D and F are autoclave under 100% N2 gas atmosphere."
    },
    {
      "paragraph_index": 15,
      "comment": ""
    },
    {
      "paragraph_index": 16,
      "comment": "Solution D: Trace element solution"
    },
    {
      "paragraph_index": 18,
      "comment": "First dissolve EDTA in distilled water, adjust pH to 7 using 2 N NaOH and add ferrous chloride."
    },
    {
      "paragraph_index": 19,
      "comment": "After ferrous chloride has dissolved add remaining compounds."
    },
    {
      "paragraph_index": 20,
      "comment": "Solutions C, D and F are autoclave under 100% N2 gas atmosphere."
    },
    {
      "paragraph_index": 21,
      "comment": ""
    },
    {
      "paragraph_index": 23,
      "comment": "Solution E is prepared under 100% N2 gas atmosphere and sterilized by filtration."
    },
    {
      "paragraph_index": 24,
      "comment": ""
    },
    {
      "paragraph_index": 26,
      "comment": "Solutions C, D and F are autoclave under 100% N2 gas atmosphere."
    },
    {
      "paragraph_index": 27,
      "comment": ""
    },
    {
      "paragraph_index": 29,
      "comment": "Prepare solution G by filling 13.5 ml hexadecane into a 50 ml serum bottle, then sparge with 100% N2 gas to make it anoxic and autoclave."
    },
    {
      "paragraph_index": 30,
      "comment": "Add 1.50 ml anoxic autoclaved tetrachloroethene to the sterile anoxic hexadecane solution by syringe."
    },
    {
      "paragraph_index": 31,
      "comment": ""
    },
    {
      "paragraph_index": 33,
      "comment": ""
    },
    {
      "paragraph_index": 35,
      "comment": "Solution is prepared under 100% N2 gas and sterilized by filtration."
    }
  ]
}
:["P-P-bond-hydrolysis-driven protein transmembrane transporter activity"],"ontology_prefix":"GO","short_form":"GO_0015450","description":["Primary active carrier-mediated transport of a protein across a membrane, driven by the hydrolysis of the diphosphate bond of inorganic pyrophosphate, ATP, or another nucleoside triphosphate. The transport protein may or may not be transiently phosphorylated, but the substrate is not phosphorylated."],"label":"protein-transporting ATPase activity","obo_id":"GO:0015450","type":"class","exact_synonyms":["protein translocase activity"]},{"iri":"https://www.enzyme-database.org/query.php?ec\u003d3.4.21.98","ontology_name":"ec","related_synonyms":["Cpro-2","hepatitis C virus NS3 serine proteinase"],"ontology_prefix":"EC","short_form":"EC_3.4.21.98","description":["Hydrolysis of four peptide bonds in the viral precursor polyprotein,commonly with Asp or Glu in the P6 position, Cys or Thr in P1 and Ser orAla in P1\u0027"],"label":"hepacivirin","obo_id":"EC:3.4.21.98","type":"class"},{"iri":"https://www.enzyme-database.org/query.php?ec\u003d3.4.24.21","ontology_name":"ec","related_synonyms":["Astacus proteinase","crayfish small-molecule proteinase"],"ontology_prefix":"EC","short_form":"EC_3.4.24.21","description":["Hydrolysis of peptide bonds in substrates containing five or more aminoacids, preferentially with Ala in P1\u0027, and Pro in P2\u0027"],"label":"astacin","obo_id":"EC:3.4.24.21","type":"class"},{"iri":"https://www.enzyme-database.org/query.php?ec\u003d3.4.24.72","ontology_name":"ec","related_synonyms":["fibrinolytic proteinase"],"ontology_prefix":"EC","short_form":"EC_3.4.24.72","description":["Hydrolysis of 14-Ala-|-Leu-15 in insulin B chain and 413-Lys-|-Leu-414 inalpha-chain of fibrinogen"],"label":"fibrolase","obo_id":"EC:3.4.24.72","type":"class"},{"iri":"https://www.enzyme-database.org/query.php?ec\u003d3.4.21.98","ontology_name":"ec","related_synonyms":["Cpro-2","hepatitis C virus NS3 serine proteinase"],"ontology_prefi
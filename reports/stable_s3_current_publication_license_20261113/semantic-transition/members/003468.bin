      "manual_judgment": {
        "index": 112,
        "recommendation": "SUPPORT_CONDITIONAL_CANONICAL_ROWS",
        "identity": "Actual TOGO2313 names Saccharomyces cerevisiae mannan0.2% with basis unspecified. Actual Sigma M7504 COA names same biological material and CAS9036-88-8; it does not assign Sigma product/alkaline extraction to recipe. CHEBI28808 is general mannan (different generic CAS52002-03-6), NCIT14271 is organism and CID870 is amylotetraose. Preserve source-material CAS plus broadMatch to mannan and RuleB1 sibling. Filtered raw qualifier preserves original processing context, not a new claim of extraction or sterilization protocol.",
        "evidence_ids": [
          "bio-primary-61217b46be42b027",
          "bio-primary-a7072f9a893aeec1",
          "bio-primary-5038a6f6a4d190c8",

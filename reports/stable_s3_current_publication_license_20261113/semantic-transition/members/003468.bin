        "holds": [
          "Preserve all source, occurrence, quantity, supplied-form, preparation, role, owner and export holds. Actual B application/generation/equality and positive admission remain pending."
        ],
        "comment": "Historical metadata/validation stamps do not clear current holds.",
        "all_tokens_assessment": [
          "SUPPORTED_SOURCE_QUALIFIED_MANNAN_NAMES",
          "Both material names retain yeast provenance; CAS is supported by applicable material COA without assigning that supplier to source recipe."
        ]
      },

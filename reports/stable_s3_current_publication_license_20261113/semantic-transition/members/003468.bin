      "manual_judgment": {
        "index": 23,
        "recommendation": "WITHHOLD_COMPLETE_ROW_LITERAL_ROMAN_I_TRACE",
        "identity": "The actual 2000/2001 primary reports establish the named ISK-1 bacteriocin as nukacin ISK-1; producer reidentification is resolved. No new assay, lot or peptide-sequence prerequisite is introduced for that named local association. The CHEBI204272 structure discrepancy concerns external promotion. Literal inherited ISK-I has only a historical related-synonym attribution in inspected bytes; the precise missing evidence is the original spelling or a source-based transcription correction, not general uniqueness of a synonym.",
        "evidence_ids": [
          "CHEM-CAP-c1084ee5b4d5a1d7",
          "CHEM-CAP-1cb0e6bf2d205d3f",
          "CHEM-CAP-5a950c17f8940801"
        ],
        "primary_locators": [
          "2001paperopeningreidentification andnukacinparagraph",
          "PMID11193411completeabstract:27matureresidues and57residueprecursor",
          "OLS204272label/systematicstructure scope"
        ],
        "aliases": {
          "bacteriocin ISK-1": [
            "SUPPORTED_HISTORICAL_SOURCE_NAME",
            "Typographiccase/hyphenvariant ofselectedsourceowner; notexternalstructureapproval."
          ],
          "nukacin ISK-1": [
            "SUPPORTED_NAMED_LOCAL_ASSOCIATION",
            "Both applicable original papers directly identify the ISK-1 product; external structure promotion remains held."
          ],
          "ISK-1 bacteriocin": [
            "SUPPORTED_NAME_ORDER",
            "Same independently established named bacteriocin."
          ],
          "bacteriocin ISK-I": [
            "UNRESOLVED_LITERAL_SOURCE_TRANSCRIPTION",
            "Need original literal spelling or source evidence correcting Roman I to numeral1; no new assay demanded."
          ]
        },
        "comment": "Blankcomment andUNKNOWN_TERMstampdo notcarrysourcepeptide/structuregap; preserveexplicitpublicationhold outsidecanonicalrow.",
        "holds": [
          "Retain original external-structure and source occurrence holds without treating them as proof that the named product association is false.",
          "No role or release approval."
        ]
      },

      "manual_judgment": {
        "index": 36,
        "recommendation": "WITHHOLD_COMPLETE_ROW_INHERITED_FRAGMENT_AND_REGISTRY_SCOPE",
        "identity": "Full officialNLM C017721 describes ordinary acid-hydrolyzed casein; manufacturer223050 andmanual distinguish ordinarycasamino acids, technicalgrade andvitaminassay. Thus namedmaterial/MeSHidentity andordinary supplier spellings are supported, notcaseinpeptoneenzymaticdigest. Inherited truncated0.01%rawfragment remains under#213claim-specifichold. The inspected descriptor/manufacturercaptures do not directly bind65072-00-6 to this ordinaryscope; that legacyCASclaim needs applicable registry/source evidence.",
        "evidence_ids": [
          "ma-direct-mesh-C017721",
          "ma-casein",
          "ma-bacto",
          "ma-jcm1445"
        ],
        "primary_locators": [
          "Actual citedcapture scientificdefinition/recipe/product/namefields read in this review; exacthashesresolvedthroughSOURCEindex."
        ],

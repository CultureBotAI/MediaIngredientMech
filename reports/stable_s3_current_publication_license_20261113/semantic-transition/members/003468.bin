      "manual_judgment": {
        "index": 127,
        "recommendation": "SUPPORT_CONDITIONAL_CANONICAL_ROW",
        "identity": "Actual86368 is MnIICl2.4H2O/CAS13446-34-9. JCM616 itself prints MnCl4 and no independent correction; those numerical-stoichiometry tokens remain rejected/case140 held. By contrast TOGO M2277 systematically substitutes capitalI for lowercase l across MnCI2,CoCI2,NiCI2,ZnCI2,NaCI, retaining each chloride count, while named annotations identify chlorides;3120/2367 repeat MnCI2 in A5+Co. This positive contextual typography supports the bounded raw alias, not an inspected original-article corrigendum or universal typo normalization. Other19 explicit tetrahydrate names/CAS preserve2chlorides/4waters.",
        "evidence_ids": [
          "c-chebi-86368",
          "c-jcm-616",
          "CHEM-CAP-178c00787726f6db",
          "CHEM-CAP-90c71e16ed3e36ea",
          "CHEM-CAP-b5d7e0a2820706b4"
        ],
        "all_tokens_assessment": [
          "SUPPORTED_EXPLICIT_MANGANESE_II_TETRAHYDRATE_NAMES",
          "Constitutional names, dot variants and CAS retain MnII dichloride with4waters."
        ],
        "aliases": {
          "MnCI2.4H2O": [
            "SUPPORTED_SOURCE_CONTEXT_GLYPH_NORMALIZATION",
            "TOGO M2277 repeatedCl→CI pattern in neighboringCo/Ni/Zn/Na chlorides and stable2-halide/4-water formula supports source-qualified interpretation; no original publication correction is claimed."
          ]
        },
        "holds": [
          "Preserve case140 and all other source,quantity,form,occurrence,role,owner/export holds. No B equality or native admission."
        ],
        "comment": "Historical metadata cannot override numericalCl4 source uncertainty."
      },

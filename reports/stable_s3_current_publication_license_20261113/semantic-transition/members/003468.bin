      "operation_id": "ORIGINAL-w09::ab-proposal-aburamycin-a",
      "manual_judgment": {
        "index": 4,
        "recommendation": "SUPPORT_COUPLED_REMOVAL_AND_REPLACEMENT",
        "identity": "BioAustralis BIA-C1518 actual product-sheet capture explicitly lists Aburamycin A as a synonym of Chromomycin A2, CAS6992-70-7/formulaC59H86O26, with historical isolation attribution. Actual CHEBI202873 term is Chromomycin A2 with matching formula and fully specified structure. Exact new202873 row preserves historical preferred name; removing oldlocal registry row is a coupled identity promotion, not deletion of source owner or loss of a different congener. Do not select A3 on a fuzzy query.",
        "evidence_ids": [
          "ab-primary-aburamycin",
          "ab-term-CHEBI-202873"
        ],
        "primary_locators": [
          "BioAustralis captured product PDF lines5–24",
          "OLS202873 label/formula/InChI/structure"
        ],
        "aliases": {},
        "comment": "Both empty comments assert no extra claim; removal of legacyUNKNOWN_TERM stamp is appropriate for new target and is not replaced with invented validation.",
        "holds": [
          "Supplier identity equivalence does not approve specific source-lot purity, biological role or every source occurrence.",
          "Historical imports/no-hit evidence retained; #1226 LITERATURE provenance and native method token do not certify human-only curation.",
          "Old-local removal is conditional on coupled new exact row and actualB owner/generator equality."
        ]
      },

      "operation_id": "ORIGINAL-w10::kg-aqds-dianion-alias",
      "manual_judgment": {
        "index": 3,
        "recommendation": "SUPPORT_CONDITIONAL_CANONICAL_ROW",
        "identity": "MediaDive ingredient521 explicitly names Na2-9,10-anthraquinone-2,6-disulfonate and CAS853-68-9. PubChemCID70070 independently shows disodium formulaC14H6Na2O8S2 and structure with two sodiums. CHEBI85112 describes the counterion-free dianion, so removal of unqualified anthraquinone-2,6-disulfonate resolvingalias preserves supplied salt. OwnCAS exact row is supported; AQDS is a contextual abbreviation, not a global dianion equivalence.",
        "evidence_ids": [
          "kg-md521",
          "kg-pc_aqds",
          "kg-CHEBI_85112"
        ],
        "primary_locators": [
          "MediaDive521 complete data",
          "PubChem70070 PropertyTable.Properties[0]",
          "OLS85112 full label/definition/charge-2/formula/synonyms"
        ],
        "alias_groups": [
          {
            "tokens": [
              "Na2-9,10-anthraquinone-2,6-disulfonate"
            ],
            "classification": "SUPPORTED_SALT_NAME",
            "reason": "Verbatim MediaDive521 ingredient name; PubChem disodium structure corroborates salt specificity."
          },
          {
            "tokens": [
              "CAS:853-68-9"
            ],
            "classification": "SUPPORTED_FORM_CAS",
            "reason": "MediaDive521 assigns this CAS to explicit Na2 salt; PubChem structure corroborates supplied salt rather than dianion."
          }
        ],
        "old_aliases": "Rejected unqualified anthraquinone-2,6-disulfonate is the CHEBI85112 dianion name; removing it is supported without reinterpreting historical raw source.",
        "comment": "Blank native comment remains bounded by source salt identity. Inherited none|UNKNOWN_TERM stamp is an honest absence of ontology validation, not negative evidence for registry identity.",
        "holds": [
          "No new ontology-parent assertion or positive registry export admission.",
          "Historical label AQDS is shared nomenclature; no counterion-free dianion/stock equivalence or electron-shuttle role approval."
        ]
      },

      "manual_judgment": {
        "index": 113,
        "recommendation": "SUPPORT_CONDITIONAL_CANONICAL_ROW",
        "identity": "Manufacturer-authored Difco manual printed351–352 explicitly distinguishes dry Marine Broth2216 from agar:5.9g MgCl2/3.24g MgSO4 versus8.8g MgCl2/3.24g Na2SO4. Broth37.4g/L and catalogue279110 are explicit. DSMZ514a and NBRC990/1306/1542 name Bacto/Difco Marine Broth with their own dilution/addition contexts. Six emitted aliases denote this supplied product family, not complete receiving media. Named local identity is supported; approximate formulation/adjustment language is retained and no lot assay or universal source-package match is inferred. Generic peptone dependency and unknown salt forms remain scoped; no merge of generic marine owners.",
        "evidence_ids": [
          "M1193-DIRECT-15",
          "b-primary-d83a3b0218",
          "b-primary-edb754e2bf",
          "b-primary-93bbadf7f8",

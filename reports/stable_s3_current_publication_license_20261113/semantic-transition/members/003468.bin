        ],
        "comment": "Historical native metadata/stamps are not fresh scientific or export acceptance.",
        "all_tokens_assessment": [
          "SUPPORTED_DIFCO_BROTH_PRODUCT_NAMES",
          "BD/Difco/Bacto spelling and explicit279110 preserve broth identity. Receiving dilution/supplements are not synonyms or new product formula."
        ]
      },

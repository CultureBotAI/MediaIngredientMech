initial=load(D/'native-inspection-v1.json')
for x in initial['source']['inputs']:assert h(M/x['path'])==x['sha256']
inputs={x['path'] for x in initial['source']['inputs']}|{x['path'] for x in load(D/'audit-inputs.json')}
inputs |= {str((P/f['path']).relative_to(M)) for f in manifest['files']}
inputs |= {str(p.relative_to(M)) for p in [P/'HANDOFF.json',P/'MANIFEST.json',D/'AUDIT.json',D/'exact-deltas.json',D/'origin-checks.json',D/'projection.json',D/'audit.py',D/'audit.stdout',D/'audit.stderr',D/'strict.stdout',D/'strict.stderr',D/'strict-failures.tsv',D/'author-packet-readback.json',D/'primary-readback/ontology-and-structure.json',Path(__file__)]}

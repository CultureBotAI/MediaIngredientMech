now=datetime.datetime.now(datetime.UTC);when=now.isoformat().replace('+00:00','Z');ids=[t['target_id'] for t in inspection['targets']];rid=now.strftime('%Y%m%dT%H%M%SZ')+'-three-method-successor-deltas-independent'
def ev(i,p,kind,summary,support='supports'):
 return {'evidence_id':i,'kind':kind,'reference':str(p),'locator':str(p.relative_to(M)),'accessed_at':when,'support':support,'summary':summary,'snapshot_sha256':h(p)}
evidence=[ev('selector',P/'SELECTOR.json','record_content','Three exact whole-owner candidates; original kinds/preimages and complete six published origins/eight cases retained.'),ev('independent-delta',D/'exact-deltas.json','validation','Independent inverse-field comparison: only method plus one new LLM evidence and one truthful history event; all prior ordered content exact.'),ev('independent-native',D/'AUDIT.json','validation','Independent schema, byte roundtrip, authentic committed beforeimages, actual native per-owner projection and protected source checks.'),ev('strict',D/'strict-failures.tsv','validation','Native strict closed-schema CLI: three target files, zero failure rows.'),ev('git-origins',D/'origin-checks.json','validation','Actual published Git proposal, payload and decision joins for all six origins/eight case hashes; no changed outcome or invented origin.'),ev('row-projection',D/'projection.json','validation','Separate actual-KG native per-owner differential: source, mapping_justification and confidence change; ten other cells and suppression behavior exact. Not actual full batch generation.'),ev('contract',A/'MAPPING_SEMANTICS.md','authority','Section0 distinguishes how grounding was established from the own-identifier predicate; Section3 retains supplied identity/form scope.'),ev('triage',Q/'ASSESSMENT.md','prior_review','Original method adjudication and Diarsenic genuine-lookup qualification; benzene-triol remains excluded.'),ev('issue-first',C/'preflight/w09-method-findings-publication-v1/readback-00.json','record_content','Actual filed1201 comment6724230173 precedes correction and binds the narrow method-only remedy.'),ev('primary-readback',D/'primary-readback/ontology-and-structure.json','primary_source','Inspected original official ChEBI/OLS/PubChem and manufacturer/IUCr cached captures; original locators/hashes/retrieval times retained.'),ev('recipe-readback',D/'primary-readback/index.json','primary_source','Independent actual pdftotext read of four original PDF captures: DSMZ1092/854/897 weighed sulfur, CCAP UCM oxide versus alkaline primary stock.'),ev('original-decision',Q/'original-author-decisions.json','record_content','Diarsenic original no-proposal draft documents representation uncertainty; final committed decision is independently joined by git-origins.'),ev('prior-W09',W/'science/materials/decisions.json','prior_review','W09 independent old conditional whole-row/owner inspection includes Sulfur eff9; this is scoped prior evidence, not acceptance of successor bytes or a valid replacement for its anchor-bearing native report.'),ev('prior-W09-handoff',W/'HANDOFF.json','prior_review','Preserves NEEDS_CURATION conditional verdict, field scopes, independence and pending actual generation; no inherited release approval.'),ev('author-evidence',D/'author-packet-readback.json','validation','All202 author members and genuine self_review native pair/91 inputs verified; preserved failures remain separate.'),ev('UW-dependencies',P/'coupled-dependencies.json','record_content','Three existing original UW correction proposals remain mandatory closure for the Borax identity; no new dependency approval.')]
science=[
('Sulfur','Material-versus-atom judgment is the recorded method','The preserved baseline #368 event and CURATOR_JUDGMENT establish bulk elemental sulfur CHEBI:33403 rather than sulfur atom/polysulfur. Cached official label and weighed DSMZ powders support this method rationale without selecting an allotrope or lot. MANUAL_CURATION is truthful method provenance; every rejected label, source alias, role/environment claim and history prefix is unchanged. A authored earlier G03 union, so the independent conclusion is confined to C\'s new method delta and preservation. W09 prior eff9 scope is separately attributed, and W09 must review the whole current successor.'),
('Na2b4o7_X_10_H2o','Primary borax formula accounting is the recorded method','The actual source history documents structural adjudication: conventional Na2B4O7·10H2O and hydroxylated Na2[B4O5(OH)4]·8H2O are explicitly associated by the captured IUCr crystal paper; official ChEBI38888 structure/mass and Sigma supplied form corroborate that bounded choice. This is not a primary-label match or a general hydrate-equivalence rule. The method-only successor retains CHEBI38888, CAS/structure, all source labels, DSMZ770 stock/MD196-routing hold and unreviewed role. Exact three existing UW dependencies remain required.'),
('Diarsenic_Trioxide','Representation adjudication is preserved alongside the genuine lookup','The actual OLS q=As2O3&exact=true query has seven results, including one chebi-ontology CHEBI30621 hit and imported copies; no missing-search claim is justified. The final source proposal positively resolved prior empirical As2O3 versus molecular As4O6 uncertainty using ChEBI\'s2:3 definition and PubChem empirical formula. MANUAL_CURATION describes that decisive documented adjudication, not LLM authorship alone. CCAP UCM supplies oxide separately from NaOH preparation. Same CHEBI30621 exact identity, As2O3 alias, original evidence, no molecular-weight/polymorph/lot claims and CultureMech283 quantity/stock hold remain.')]
assess=[]
for target,topic,detail in science:
 assess.append({'assessment_id':'method-'+target,'area':'grounding','topic':topic,'outcome':'supported','summary':'The exact new method delta is supported and the complete predecessor content is preserved.','details':detail,'target_ids':[target],'evidence_ids':['selector','independent-delta','primary-readback','recipe-readback','git-origins','contract','triage','issue-first']+(['prior-W09','prior-W09-handoff'] if target=='Sulfur' else []),'dimensions':[{'name':'review-authority','value':'Independent of C\'s new method correction; no role/export/whole-campaign authorization. Sulfur prior composition authorship explicitly excludes fresh whole-owner independent approval.','definition':'The byte-preservation check and scoped method decision do not create scientific approval for historical unrelated claims.','evidence_ids':['independent-delta','prior-W09-handoff']} ]})
assess += [{'assessment_id':'complete-preservation','area':'provenance','topic':'Every prior field, event and genuine origin is preserved','outcome':'supported','summary':'Resetting the method and removing exactly the appended evidence/event reconstructs each complete predecessor object; native serialization is exact.','details':'All six original published proposal objects and eight original case bindings verified against Git; Sulfur retains four origins. Create Diarsenic remains a real null-preimage create. This is not a new origin, changed source outcome or application decision. New MappingEvidence uses LLM_SUGGESTION; MANUAL_CURATION here is only mapping_quality.','target_ids':ids,'evidence_ids':['independent-delta','git-origins','author-evidence']},{'assessment_id':'native-output-scope','area':'consistency','topic':'The unchanged producer emits the expected method provenance without identity drift','outcome':'supported','summary':'Three actual-KG differential rows change only method, confidence and source. Own-identifier exact predicates, object IDs/labels, aliases, comments and suppression results remain exact.','details':'Confidence0.9 is the native method-grade heuristic, not measured probability. Repeated evidence-source tokens are native output, not distinct votes. The authentic2957-record bounded overlay requires the three original UW corrections; it does not constitute the full corrected-batch generation, prior-stamp replay or positive export admission.','target_ids':ids,'evidence_ids':['row-projection','independent-native','UW-dependencies','contract']}]
limits=["This is an independent assessment of three new method deltas with full payload-preservation checks, not fresh whole-owner or whole-campaign scientific approval. Root's separate W09 review of all four current corrective owners and three deferrals remains required.","Reviewer /root/next23_context authored an earlier Sulfur G03 union. Its old composition is not independently re-approved here; W09's old eff9 whole-row/owner support is separately attributed and limited. C authored the later Sulfur composition and these successors; its pair is self_review/scientific_review=false.","The three old W09 method findings are addressed in these private candidates at the assessed scope; original NEEDS_CURATION observations, unrelated findings and tracker state are not erased or declared closed.","No roles, occurrence applicability, chemical quantities, stocks, lot/allotrope/polymorph, environmental claims, canonical rows or supported export are promoted. Unknowns and all original holds persist. Benzene-triol is outside this correction.","Borax must retain the three exact original UW reference corrections; an isolated Borax installation leaves three pre-existing broken references. No new child identity or dependency approval is made.","Native row checking used authentic committed A842 inventory, three candidate replacements plus three existing UW corrections, actual read-only KG gzip and cached official labels. It is a per-owner diagnostic, not complete corrected-source generation or actual B/C row acceptance. No provider fetch or new research was run.","Private native pair is serialized, rendered, exclusively published and strictly parsed with actual M working-tree provenance using maintained APIs. It is not installed in the maintained review store and does not claim save_review publication there. No private Git root or fictional baseline was created.","Original C missing-parent refusal, isolated-overlay assertion and initial native target-kind refusal remain preserved. 
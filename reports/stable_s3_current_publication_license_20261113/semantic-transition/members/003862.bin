schema=A/'schema/record_review.yaml';h=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();load=lambda p:json.loads(p.read_text())
def save(p,o):
 with p.open('x') as f:json.dump(o,f,indent=2,ensure_ascii=False);f.write('\n')
assert h(P/'HANDOFF.json')=='be29c1a7a0deb53f729eb373f06ec2b2769e443f0f0222e8348110d8f427d986';assert h(P/'MANIFEST.json')=='d8d973a9814aa3c0ad6cead73bb418a83f51e354ee3e8cd6f426397ba1db3069'
manifest=load(P/'MANIFEST.json');assert len(manifest['files'])==202
for f in manifest['files']:
 p=P/f['path'];assert p.is_file() and not p.is_symlink();assert h(p)==f['sha256'] and p.stat().st_size==f['bytes']
author=load(P/'NATIVE-AUTHOR-RECEIPT.json');pair=author['pair'];root=Path(author['source_root']);y=Path(pair['yaml']);md=Path(pair['markdown']);assert h(y)==pair['yaml_sha256'] and h(md)==pair['markdown_sha256'];author_review=rr.read_review(root,str(y.relative_to(root)),schema);assert author_review['reviewer']['independence']=='self_review' and author_review['scientific_review'] is False;rr.assert_current_source(root,author_review)

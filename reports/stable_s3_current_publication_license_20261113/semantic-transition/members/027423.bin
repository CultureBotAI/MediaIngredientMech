  "ENVO:00001998": [
    {
      "stanza": "ENVO:00001998",
      "subject": "ENVO:00001998",
      "predicate": "IAO:0000115",
      "object": null,
      "value": "An environmental material which is primarily composed of minerals, varying proportions of sand, silt, and clay, organic material such as humus, interstitial gases, liquids, and a broad range of resident micro- and macroorganisms.",
      "datatype": null,
      "language": "en",
      "graph": null
    },
    {
      "stanza": "ENVO:00001998",
      "subject": "ENVO:00001998",
      "predicate": "IAO:0000116",
      "object": null,
      "value": "The various 'has part' and 'has quality' relations may not hold true for all soils; however, I have yet to find counter examples. Require input from a pedologist or similar. [pbuttigieg]",
      "datatype": null,
      "language": null,
      "graph": null
    },

      "variant_children": [
        {
          "id": "CultureMech:000643",
          "path": "data/normalized_yaml/archaea/methanobacterium_medium.yaml",
          "name": "methanobacterium_medium",
          "relationship": "UNCERTAIN",
          "notes": "Retain this existing family candidate as UNCERTAIN, not a proven direction of derivation or a bicarbonate-only variant. DSMZ 119 uses 4 g bicarbonate and H2/CO2 preparation; DSMZ 119c uses 0.5 g and N2 preparation. Both preserve distinct stock scopes; the old LB/tryptone assertion is withdrawn.",
          "evidence": [
            {
              "reference": "https://mediadive.dsmz.de/rest/medium/119",
              "supports": "SUPPORT",
              "snippet": "\"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 80% H2 and 20% CO2 gas mixture for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.5 and dispense medium under 80% H2 and 20% CO2 gas atmosphere into anoxic Hungate-type tubes or serum vials to 30% of their volume and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\"",
              "explanation": "variant_children: Retain this existing family candidate as UNCERTAIN, not a proven direction of derivation or a bicarbonate-only variant. DSMZ 119 uses 4 g bicarbonate and H2/CO2 preparation; DSMZ 119c uses 0.5 g and N2 preparation. Both preserve distinct stock scopes; the old LB/tryptone assertion is withdrawn. No unstated density, final volume, percent basis or chemical identifier is inferred. Locator=data.solutions[0].steps[0].step; accessed=2026-10-09T02:29:12.183202+00:00; capture SHA256=2ef0379b2f6f083499de9281386d962be27ba59fcba5135710f46288227d666e."
            }
          ]
        }
      ],

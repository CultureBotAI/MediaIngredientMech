tor.\", \"status\": \"correct\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119b\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 2,\\n                        \\\"compound\\\": \\\"Sludge\\\",\\n                        \\\"compound_id\\\": 2084,\\n                        \\\"amount\\\": 1000,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": \"ingredients[25].preferred_term\", \"field\": \"solutions[3].composition[1].preferred_term\", \"old\": \"Sludge\", \"new\": \"Sludge\", \"status\": \"correct\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119b\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 2,\\n                        \\\"compound\\\": \\\"Sludge\\\",\\n                        \\\"compound_id\\\": 2084,\\n                        \\\"amount\\\": 1000,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"solutions[3].composition[1].notes\", \"old\": null, \"new\": \"Preparation input: 1000 ml = 1 L. This is input volume, not a mass, stock dose or measured final-volume denominator.\", \"status\": \"evidence_only\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119b.pdf\", \"snippet\": \"Sludge                                                         1000.00         ml\"}, {\"old_field\": null, \"field\": \"solutions[3].preparation_notes\", \"old\": null, \"new\": \"Add 0.4% yeast extract to sludge from an anaerobic digester, and after gassing with nitrogen gas for a few minutes incubate it at 37\\u00b0C for 24 hours. Then centrifuge the sludge at 13000 g and autoclave the resulting, clear supernatant in screw-capped vessels under nitrogen gas. The sludge fluid can be stored at 8-12\\u00b0C in the dark.\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119b\", \"snippet\": \"\\\"Add 0.4% yeast extract to sludge from an anaerobic digester, and after gassing with nitrogen gas for a few minutes incubate it at 37\\\\u00b0C for 24 hours. Then centrifuge the sludge at 13000 g and autoclave the resulting, clear supernatant in screw-capped vessels under nitrogen gas. The sludge fluid can be stored at 8-12\\\\u00b0C in the dark.\\\"\"}, {\"old_field\": null, \"field\": \"solutions[4].concentration\", \"old\": null, \"new\": {\"value\": \"0.02\", \"unit\": \"L\"}, \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119b\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 14,\\n                        \\\"solution\\\": \\\"Fatty acid mixture\\\",\\n                        \\\"solution_id\\\": 209,\\n                        \\\"amount\\\": 20,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"solutions[4].notes\", \"old\": null, \"new\": \"Receiving-medium addition: 20 ml = 0.02 L of this prepared stock. This is an addition volume, not stock strength or final-medium concentration.\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119b\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 14,\\n                        \\\"solution\\\": \\\"Fatty acid mixture\\\",\\n                        \\\"solution_id\\\": 209,\\n                        \\\"amount\\\": 20,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"solutions[4].preferred_term\", \"old\": null, \"new\": \"Fatty acid mixture\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119b\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 14,\\n                        \\\"solution\\\": \\\"Fatty acid mixture\\\",\\n                  
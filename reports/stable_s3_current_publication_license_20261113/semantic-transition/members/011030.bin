                      \\\"compound_id\\\": 54,\\n                        \\\"amount\\\": 0.5,\\n                        \\\"unit\\\": \\\"g\\\",\\n                        \\\"g_l\\\": 0.498504,\\n                        \\\"mmol_l\\\": 2.07553,\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"ingredients[10].notes\", \"old\": null, \"new\": \"Direct basal input 0.5 g / explicit original final volume 1.003 L = 0.498504 g/L (six significant digits). Excludes stock preparation masses and applies only to base DSMZ 119.\", \"status\": \"evidence_only\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf\", \"snippet\": \"Na2S x 9 H2O                                                        0.50         g\"}, {\"old_field\": null, \"field\": \"ingredients[10].concentration\", \"old\": null, \"new\": {\"value\": \"0.498504\", \"unit\": \"G_PER_L\"}, \"status\": \"evidence_only\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf\", \"snippet\": \"Final volume: 1003 ml\"}, {\"old_field\": null, \"field\": \"ingredients[11].concentration\", \"old\": null, \"new\": {\"value\": \"0.93\", \"unit\": \"L\"}, \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 18,\\n                        \\\"compound\\\": \\\"Distilled water\\\",\\n                        \\\"compound_id\\\": 4,\\n                        \\\"amount\\\": 930,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"ingredients[11].notes\", \"old\": null, \"new\": \"Preparation input: 930 ml = 0.93 L. This is input volume, not a mass, stock dose or measured final-volume denominator.\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 18,\\n                        \\\"compound\\\": \\\"Distilled water\\\",\\n                        \\\"compound_id\\\": 4,\\n                        \\\"amount\\\": 930,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"ingredients[11].preferred_term\", \"old\": null, \"new\": \"Distilled water\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 18,\\n                        \\\"compound\\\": \\\"Distilled water\\\",\\n                        \\\"compound_id\\\": 4,\\n                        \\\"amount\\\": 930,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"ingredients[11].notes\", \"old\": null, \"new\": \"Preparation input: 930 ml = 0.93 L. This is input volume, not a mass, stock dose or measured final-volume denominator.\", \"status\": \"evidence_only\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf\", \"snippet\": \"Distilled water                                                  930.00         ml\"}, {\"old_field\": \"preparation_steps\", \"field\": \"preparation_steps\", \"old\": [{\"step_number\": 1, \"action\": \"AUTOCLAVE\", \"description\": \"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 80% H2 and 20% CO2 gas mixture for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.5 and dispense medium under 80% H2 and 20% CO2 gas atmosphere into anoxic Hungate-type tubes or serum vials to 30% of their volume and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\"}, {\"step_number\": 2, \"action\": \"MIX\", \"description\": \"Note: After growth has started and the culture is becoming turbid add sterile 80% H2 and 20% CO2 gas mixture to 0.5 - 1 bar overpressure.\"}, {\"step_number\": 3, \"action\": \"AUTOCLAVE\", \"description\": \"Add 0.4% yeast extract to sludge from an anaerobic digester, and after gassing with nitrogen gas for a few minutes incubate it at 37\\u00b0C for 24 hours. Then centrifuge the sludge at 13000 g and autoclave the resulting, clear supernatant in screw-capped vessels under nitrogen gas. The sludge fluid can be stored at 8-12\\u00b0C in the dark.\"}, {\"step_number\": 4, \"action\": \"ADJUST_PH\", \"description\": \"Adjust pH to 7.5 with concentrated NaOH.\"}, {\"step_number\": 5, \"action\": \"DISSOLVE\", \"description\": \"First dissolve FeCl2 in the HCl, then dilute in water, add and dissolve the other salts. Finally make up to 1000.00 ml.\"}, {\"step_number\": 6, \"action\": \"MIX\", \"description\": \"The ferrous sulfate solution is not stable and should be freshly prepared.\"}], \"new\": [{\"step_number\": 1, \"action\": \"AUTOCLAVE\", \"description\": \"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 80% H2 and 20% CO2 gas mixture for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.5 and dispense medium under 80% H2 and 20% CO2 gas atmosphere into anoxic Hungate-type tubes or serum vials to 30% of their volume and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\"}, {\"step_number\": 2, \"action\": \"MIX\", \"description\": \"Note: After growth has started and the culture is becoming turbid add sterile 80% H2 and 20% CO2 gas mixture to 0.5 - 1 bar overpressure.\"}], \"status\": \"correct\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119\", \"snippet\": \"\\\"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 80% H2 and 20% CO2 gas mixture for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.5 and dispense medium under 80% H2 and 20% CO2 gas atmosphere into anoxic Hungate-type tubes or serum vials to 30% of their volume and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\\\"\"}, {\"old_field\": \"preparation_steps\", \"field\": \"preparation_steps\", \"old\": [{\"step_number\": 1, \"action\": \"AUTOCLAVE\", \"description\": \"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 80% H2 and 20% CO2 gas mixture for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.5 and dispense medium under 80% H2 and 20% CO2 gas atmosphere into anoxic Hungate-type tubes or serum vials to 30% of their volume and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\"}, {\"step_number\": 2, \"action\": \"MIX\", \"description\": \"Note: After growth has started and the culture is becoming turbid add sterile 80% H2 and 20% CO2 gas mixture to 0.5 - 1 bar overpressure.\"}, {\"step_number\": 3, \"action\": \"AUTOCLAVE\", \"description\": \"Add 0.4% yeast extract to sludge from an anaerobic digester, and after gassing with nitrogen gas for a few minutes incubate it at 37\\u00b0C for 24 hours. Then centrifuge the sludge at 13000 g and autoclave the resulting, clear supernatant in screw-capped vessels under nitrogen gas. The sludge fluid can be stored at 8-12\\u00b0C in the dark.\"}, {\"step_number\": 4, \"action\": \"ADJUST_PH\", \"description\": \"Adjust pH to 7.5 with concentrated NaOH.\"}, {\"step_number\": 5, \"action\": \"DISSOLVE\", \"description\": \"First dissolve FeCl2 in the HCl, then dilute in water, add and dissolve the other salts. Finally make up to 1000.00 ml.\"}, {\"step_number\": 6, \"action\": \"MIX\", \"description\": \"The ferrous sulfate solution is not stable and should be freshly prepared.\"}], \"new\": [{\"step_number\": 1, \"action\": \"AUTOCLAVE\", \"description\": \"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 80% H2 and 20% CO2 gas mixture for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.5 and dispense medium under 80% H2 and 20% CO2 gas atmosphere into anoxic Hungate-type tubes or serum vials to 30% of their volume and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\"}, {\"step_number\": 2, \"action\": \"MIX\", \"description\": \"Note: After growth has started and the culture is becoming turbid add sterile 80% H2 and 20% CO2 gas mixture to 0.5 - 1 bar overpressure.\"}], \"status\": \"correct\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119\", \"snippet\": \"\\\"Note: After growth has started and the culture is becoming turbid add sterile 80% H2 and 20% CO2 gas mixture to 0.5 - 1 bar overpressure.\\\"\"}, {\"old_field\": null, \"field\": \"variants[0].name\", \"old\": null, \"new\": \"For DSM 1093, DSM 1125, DSM 11977, DSM 11978, DSM 11995, DSM 16643\", \"status\": \"add\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf\", \"snippet\": \"For DSM 1093, DSM 1125, DSM 11977, DSM 11978, DSM 11995, DSM 16643: Supplement\\nmedium after autoclaving with 1 ml/l Wolin's vitamin solution (10x, see medium 120), 0.30\\ng/l DL-dithiothreitol, and 0.15 g/l coenzyme M (2-mercaptoethanesulfonic acid) from anoxic\\nstock solutions sterilized by filtration. Omit Na2S x 9 H2O and L-Cysteine HCl x H2O.\"}, {\"old_field\": null, \"field\": \"variants[0].relationship\", \"old\": null, \"new\": \"STRAIN_SPECIFIC_VARIANT\", \"status\": \"add\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf\", \"snippet\": \"For DSM 1093, DSM 1125, DSM 11977, DSM 11978, DSM 11995, DSM 16643: Supplement\\nmedium after autoclaving with 1 ml/l Wolin's vitamin solution (10x, see medium 120), 0.30\\ng/l DL-dithiothreitol, and 0.15 g/l coenzyme M (2-mercaptoethanesulfonic acid) from anoxic\\nstock solutions sterilized by filtration. Omit Na2S x 9 H2O and L-Cysteine HCl x H2O.\"}, {\"old_field\": null, \"field\": \"variants[0].modifications\", \"old\": null, \"new\": [\"Supplement medium after autoclaving with 1 ml/l Wolin's vitamin solution (10x, see medium 120), 0.30 g/l DL-dithiothreitol, and 0.15 g/l coenzyme M (2-mercaptoethanesulfonic acid) from anoxic stock solutions sterilized by filtration. Omit Na2S x 9 H2O and L-Cysteine HCl x H2O.\"], \"status\": \"add\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf\", \"snippet\": \"For DSM 1093, DSM 1125, DSM 11977, DSM 11978, DSM 11995, DSM 16643: Supplement\\nmedium after autoclaving with 1 ml/l Wolin's vitamin solution (10x, see medium 120), 0.30\\ng/l DL-dithiothreitol, and 0.15 g/l coenzyme M (2-mercaptoethanesulfonic acid) from anoxic\\nstock solutions sterilized by filtration. Omit Na2S x 9 H2O and L-Cysteine HCl x H2O.\"}, {\"old_field\": null, \"field\": \"variants[1].name\", \"old\": null, \"new\": \"For DSM 1535\", \"status\": \"add\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf\", \"snippet\": \"For DSM 1535: Adjust pH of complete medium to 7.6.\"}, {\"old_field\": null, \"field\": \"variants[1].relationship\", \"old\": null, \"new\": \"STRAIN_SPECIFIC_VARIANT\", \"status\": \"add\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf\", \"snippet\": \"For DSM 1535: Adjust pH of complete medium to 7.6.\"}, {\"old_field\": null, \"field\": \"variants[1].modifications\", \"old\": null, \"new\": [\"Adjust pH of complete medium to 7.6.\"], \"status\": \
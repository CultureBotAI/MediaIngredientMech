"Na2S x 9 H2O\", \"status\": \"correct\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119c\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 17,\\n                        \\\"compound\\\": \\\"Na2S x 9 H2O\\\",\\n                        \\\"compound_id\\\": 54,\\n                        \\\"amount\\\": 0.5,\\n                        \\\"unit\\\": \\\"g\\\",\\n                        \\\"g_l\\\": 0.5,\\n                        \\\"mmol_l\\\": 2.08175,\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"ingredients[10].notes\", \"old\": null, \"new\": \"Source batch input: 0.5 g. Keep the mass in notes; neither input water nor API volume/g_l encoding establishes a measured final volume. No g/L concentration is asserted.\", \"status\": \"evidence_only\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119c.pdf\", \"snippet\": \"Na2S x 9 H2O                                                      0.50         g\"}, {\"old_field\": null, \"field\": \"ingredients[11].concentration\", \"old\": null, \"new\": {\"value\": \"0.93\", \"unit\": \"L\"}, \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119c\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 18,\\n                        \\\"compound\\\": \\\"Distilled water\\\",\\n                        \\\"compound_id\\\": 4,\\n                        \\\"amount\\\": 930,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"ingredients[11].notes\", \"old\": null, \"new\": \"Preparation input: 930 ml = 0.93 L. This is input volume, not a mass, stock dose or measured final-volume denominator.\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119c\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 18,\\n                        \\\"compound\\\": \\\"Distilled water\\\",\\n                        \\\"compound_id\\\": 4,\\n                        \\\"amount\\\": 930,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"ingredients[11].preferred_term\", \"old\": null, \"new\": \"Distilled water\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119c\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 18,\\n                        \\\"compound\\\": \\\"Distilled water\\\",\\n                        \\\"compound_id\\\": 4,\\n                        \\\"amount\\\": 930,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"ingredients[11].notes\", \"old\": null, \"new\": \"Preparation input: 930 ml = 0.93 L. This is input volume, not a mass, stock dose or measured final-volume denominator.\", \"status\": \"evidence_only\", \"reference\": \"https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119c.pdf\", \"snippet\": \"Distilled water                                                930.00         ml\"}, {\"old_field\": \"preparation_steps\", \"field\": \"preparation_steps\", \"old\": [{\"step_number\": 1, \"action\": \"AUTOCLAVE\", \"description\": \"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 100% N2 gas for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.8 and dispense medium under 100% N2 gas atmosphere into anoxic Hungate-type tubes or serum vials and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\"}, {\"step_number\": 2, \"action\": \"DISSOLVE\", \"description\": \"First dissolve FeCl2 in the HCl, then dilute in water, add and dissolve the other salts. Finally make up to 1000.00 ml.\"}, {\"step_number\": 3, \"action\": \"AUTOCLAVE\", \"description\": \"Add 0.4% yeast extract to sludge from an anaerobic digester, and after gassing with nitrogen gas for a few minutes incubate it at 37\\u00b0C for 24 hours. Then centrifuge the sludge at 13000 g and autoclave the resulting, clear supernatant in screw-capped vessels under nitrogen gas. The sludge fluid can be stored at 8-12\\u00b0C in the dark.\"}, {\"step_number\": 4, \"action\": \"ADJUST_PH\", \"description\": \"Adjust pH to 7.5 with concentrated NaOH.\"}, {\"step_number\": 5, \"action\": \"MIX\", \"description\": \"The ferrous sulfate solution is not stable and should be freshly prepared.\"}], \"new\": [{\"step_number\": 1, \"action\": \"AUTOCLAVE\", \"description\": \"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 100% N2 gas for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.8 and dispense medium under 100% N2 gas atmosphere into anoxic Hungate-type tubes or serum vials and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\"}], \"status\": \"correct\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119c\", \"snippet\": \"\\\"Dissolve ingredients except bicarbonate, cysteine and sulfide. Sparge medium with 100% N2 gas for 30 - 45 min to make it anoxic. Add and dissolve bicarbonate, adjust pH to 6.8 and dispense medium under 100% N2 gas atmosphere into anoxic Hungate-type tubes or serum vials and autoclave. Add cysteine and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas. Prior to use check pH of complete medium and adjust to 6.8 - 7.0, if necessary.\\\"\"}, {\"old_field\": \"ingredients\", \"field\": \"notes\", \"old\": [{\"preferred_term\": \"KH2PO4\", \"term\": {\"id\": \"CHEBI:63036\", \"label\": \"potassium dihydrogen phosphate\"}, \"concentration\": {\"value\": \"0.5\", \"unit\": \"G_PER_L\"}, \"mediaingredientmech_chebi_term\": {\"id\": \"CHEBI:63036\", \"label\": \"potassium dihydrogen phosphate\"}}, {\"preferred_term\": \"MgSO4 x 7 H2O\", \"term\": {\"id\": \"CHEBI:31795\", \"label\": \"magnesium sulfate heptahydrate\"}, \"concentration\": {\"value\": \"0.4\", \"unit\": \"G_PER_L\"}, \"mediaingredientmech_chebi_term\": {\"id\": \"CHEBI:31795\", \"label\": \"magnesium sulfate heptahydrate\"}}, {\"preferred_term\": \"NaCl\", \"term\": {\"id\": \"CHEBI:26710\", \"label\": \"sodium chloride\"}, \"concentration\": {\"value\": \"0.4\", \"unit\": \"G_PER_L\"}, \"mediaingredientmech_chebi_term\": {\"id\": \"CHEBI:26710\", \"label\": \"sodium chloride\"}}, {\"preferred_term\": \"NH4Cl\", \"term\": {\"id\": \"CHEBI:31206\", \"label\": \"ammonium chloride\"}, \"concentration\": {\"value\": \"0.4\", \"unit\": \"G_PER_L\"}, \"mediaingredientmech_chebi_term\": {\"id\": \"CHEBI:31206\", \"label\": \"ammonium chloride\"}}, {\"preferred_term\": \"CaCl2 x 2 H2O\", \"term\": {\"id\": \"CHEBI:86158\", \"label\": \"calcium chloride dihydrate\"}, \"concentration\": {\"value\": \"0.05\", \"unit\": \"G_PER_L\"}, \"mediaingredientmech_chebi_term\": {\"id\": \"CHEBI:86158\", \"label\": \"calcium chloride dihydrate\"}}, {\"preferred_term\": \"Yeast extract\", \"concentration\": {\"value\": \"5.0\", \"unit\": \"G_PER_L\"}, \"notes\": \" [Merged 2 duplicates: 1.0, 4.0]\"}, {\"preferred_term\": \"Na-acetate\", \"term\": {\"id\": \"CHEBI:32954\", \"label\": \"sodium acetate\"}, \"concentration\": {\"value\": \"1\", \"unit\": \"G_PER_L\"}, \"mediaingredientmech_chebi_term\": {\"id\": \"CHEBI:32954\", \"label\": \"sodium acetate\"}}, {\"preferred_term\": \"Na-formate\", \"term\": {\"id\": \"CHEBI:62965\", \"label\": \"sodium formate\"}, \"concentration\": {\"value\": \"2\", \"unit\": \"G_PER_L\"}, \"mediaingredientmech_chebi_term\": {\"id\": \"CHEBI:62965\", \"label\": \"sodium formate\"}}, {\"preferred_term\": \"Sodi
 {\"old_field\": null, \"field\": \"solutions[2].preparation_notes\", \"old\": null, \"new\": \"Add 0.4% yeast extract to sludge from an anaerobic digester, and after gassing with nitrogen gas for a few minutes incubate it at 37\\u00b0C for 24 hours. Then centrifuge the sludge at 13000 g and autoclave the resulting, clear supernatant in screw-capped vessels under nitrogen gas. The sludge fluid can be stored at 8-12\\u00b0C in the dark.\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119c\", \"snippet\": \"\\\"Add 0.4% yeast extract to sludge from an anaerobic digester, and after gassing with nitrogen gas for a few minutes incubate it at 37\\\\u00b0C for 24 hours. Then centrifuge the sludge at 13000 g and autoclave the resulting, clear supernatant in screw-capped vessels under nitrogen gas. The sludge fluid can be stored at 8-12\\\\u00b0C in the dark.\\\"\"}, {\"old_field\": null, \"field\": \"solutions[3].concentration\", \"old\": null, \"new\": {\"value\": \"0.02\", \"unit\": \"L\"}, \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119c\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 13,\\n                        \\\"solution\\\": \\\"Fatty acid mixture\\\",\\n                        \\\"solution_id\\\": 209,\\n                        \\\"amount\\\": 20,\\n                        \\\"unit\\\": \\\"ml\\\",\\n                        \\\"optional\\\": 0\\n                    }\"}, {\"old_field\": null, \"field\": \"solutions[3].notes\", \"old\": null, \"new\": \"Receiving-medium addition: 20 ml = 0.02 L of this prepared stock. This is an addition volume, not stock strength or final-medium concentration.\", \"status\": \"add\", \"reference\": \"https://mediadive.dsmz.de/rest/medium/119c\", \"snippet\": \"{\\n                        \\\"recipe_order\\\": 13,\\n                        \\\"solution\\\": \\\"Fatty acid mixture\\\",\\n                        \\\"solution_id\\\": 209,\\n           
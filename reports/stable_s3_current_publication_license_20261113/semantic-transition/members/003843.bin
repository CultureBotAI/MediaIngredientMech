  "comments": [
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 3,
      "comment": "Head space, 80:20 H2/CO2"
    },
    {
      "paragraph_index": 4,
      "comment": "Adjust pH to 7 – 7.5 with 2m HCl"
    },
    {
      "paragraph_index": 5,
      "comment": "Formate can be added to the medium at a final concentration of 10 to 20 mM for increased growth rate."
    },
    {
      "paragraph_index": 6,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": "Trace Elements: *Available from ATCC as a sterile ready-to-use liquid (Trace Mineral Supplement, catalog no. MD-TMS.)"
    },
    {
      "paragraph_index": 9,
      "comment": "Adjust final pH of Trace Elements Solution SL-6 to 3.4"
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 13,
      "comment": "Vitamins: Available from ATCC as a sterile ready-to-use liquid (Vitamin Supplement, catalog no. MD-VS)."
    }
  ]

              },
              {
                "evidence_type": "MANUAL_CURATION",
                "notes": "The source ingredient is desiccated ox bile, a dried bovine bile material. NBRC1004 and NBRC1390 independently name desiccated ox bile as a weighed dry ingredient; Sigma70168 confirms the material is produced by dehydrating fresh ox bile. This is neither fresh liquid bile nor an isolated bile salt, and no supplier-specific grade or constituent concentration is asserted. Generic ox-bile owners and Oxgall are recorded reconciliation candidates, not automatically merged or equated to this explicitly dried material.",
                "source": "https://www.sigmaaldrich.com/US/en/product/sial/70168"
              }
            ],

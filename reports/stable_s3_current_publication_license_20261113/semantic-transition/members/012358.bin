      "full_primary_scientific_assessment": {
        "support": "DSMZ29 p2 explicitly uses filter-sterilised1MNa2CO3 to adjust the receiving medium to6.8–7.1. DSMZ40 says add1%NaCl to medium29.",
        "carrier_boundary": "The complete two-page29body defines water in SolutionsA–F/SL10B and neutralizedsulfide; none is a carbonate-stock recipe. These waters and receiving-medium pH cannot transfer to the carbonate stock.",
        "unknowns": [
          "carbonate starting hydrate",
          "stock carrier identity/grade/quantity",
          "full stock preparation",
          "dissolved gas amount"
        ],
        "case_wording": "Keep both frozen29/40occurrences and receivingpH; explicitly retain missingcarrieridentity."
      },

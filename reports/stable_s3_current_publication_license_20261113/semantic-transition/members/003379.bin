ks=native.load_kgm_source_index(kgp);kl=native.load_kgm_labels(kgp);labels={'CHEBI:91248':new['ontology_mapping']['ontology_label']};owners=native.build_owner_index({native._mim_curie(Path(p).name):r for p,r in after.items() if '/mapped/' in p})
def project(r,feed):
 sup=[];rows=native._row_from_yaml(A/op['source_record'],{},ks,feed,labels,record=r,owners=owners,suppressions=sup);return rows,[vars(x) for x in sup]

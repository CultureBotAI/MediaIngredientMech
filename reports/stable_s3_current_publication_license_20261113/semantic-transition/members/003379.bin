plan=json.loads(read(C/'integration/final-native-intake-after-ancillary-v1/owner-plan.draft.json','cdff9ef796b6c2ecf112218be61843fc1928f442ff4a7ddd89758ea116be8cb2'))
op=next(r for r in plan['records'] if r['operation_id']=='ORIGINAL-w07::C-P04');assert op['after_capture']['sha256']==sha(oldraw)
authentic=git('show',BASE+':'+op['before_source_record']);assert sha(authentic)==op['before_yaml_sha256']=='ee8eca61baf20c28acd7bbf0409d44ea796fb33d988f6e81eb60b6fba67fc105';write(D/'inputs/authentic-before.yaml',authentic)
origin=json.loads(read(P/'TARGETS.json'))[0];assert origin['operation']==op if 'operation' in origin else op['origins'][0]['proposal_id']=='C-P04'
for n in ['PUBLISHED-JOINS.json','TARGETS.json','INPUT-PINS.json']:capture(P/n,'origin/'+n)
old=yaml.safe_load(oldraw);new=copy.deepcopy(old);assert old['ontology_mapping']['mapping_quality']=='CLOSE_MATCH'
new['ontology_mapping']['mapping_quality']='NARROW_MATCH'
note=('Claim-specific current form-of assessment under '+issue['html_url']+'. JCM680 (https://www.jcm.riken.jp/cgi-bin/jcm/jcm_grmd?GRMD=680; exact captured HTML SHA25616525b97d468855002dda4489f4b2030d28a9a1d332828cc27a0f2e15b5b07f0) explicitly names L-cysteine hydrochloride monohydrate solution. The active defining CHEBI:91248 term is L-cysteine hydrochloride hydrate, a monohydrate of L-cysteine hydrochloride (full OLS term capture SHA2567ef9e26cec1a5833d216a01df066c0b6a0bfba77bad16db354c690a7a814a683). This remains a local prepared stock, not the pure solute. Current MAPPING_SEMANTICS sections1/3 explicitly permit the solution-of broader-parent relation without is_a or identity equivalence; native NARROW_MATCH therefore publishes skos:broadMatch while retaining the local exact registry row. The historical #342/#321 rationale and evidence are preserved, but no longer justify CLOSE_MATCH under the current contract. The source10mL is an addition dose, not stock concentration; solvent, concentration, stock pH, complete formulation and quantity interpretation remain unknown. No solute CAS, structure, formula or role is assigned to the stock; rejected instruction and QSY9 labels, counts and all original source decisions remain unchanged.')
evidence={'evidence_type':'LLM_SUGGESTION','source':issue['html_url'],'notes':note};new['ontology_mapping']['evidence'].append(evidence)
record_curation_event(new,curator='Codex /root/step7d_science_c',action='CORRECTED_FORM_PARENT_PREDICATE',llm_assisted=True,llm_model='gpt-6',previous_status=old['mapping_status'],new_status=old['mapping_status'],changes='Private exact successor to selected0ca4e6c9 under '+issue['html_url']+': CLOSE_MATCH to NARROW_MATCH for the supported solution-of CHEBI91248 relation; truthful LLM evidence/history appended. Preserve the distinct local stock identity, parent ID/label, every old history/evidence object, W07 rejected labels, all source/stock/quantity unknowns, roles and counts. No source application or release approval.')
def inverse(v):
 x=copy.deepcopy(v);assert x['ontology_mapping']['mapping_quality']=='NARROW_MATCH';x['ontology_mapping']['mapping_quality']='CLOSE_MATCH';assert x['ontology_mapping']['evidence'].pop()==evidence;h=x['curation_history'].pop();assert h['llm_assisted'] and h['curator']=='Codex /root/step7d_science_c';assert x==old
inverse(new);assert not validate_ingredient(old) and not validate_ingredient(new)
checks=['complete native schema before/after','exact inverse delta and old evidence/history prefix']
for n,mutate in [('identity',lambda v:v.update(identifier='CHEBI:91248')),('stock concentration',lambda v:v.update(notes='10mL means1%')),('old author',lambda v:v['curation_history'][0].update(curator='invented-human')),('rejected label',lambda v:v['synonyms'][1].update(synonym_type='RAW_TEXT'))]:
 x=copy.deepcopy(new);mutate(x)
 try:inverse(x)
 except AssertionError:checks.append('refuses '+n+' mutation')
 else:raise AssertionError(n)
for p in [A/'MAPPING_SEMANTICS.md',A/'src/mediaingredientmech/curate/publication_guard.py',A/'src/mediaingredientmech/curate/curation_event.py',A/'src/mediaingredientmech/ingredient_bundle_refresh.py',A/'src/mediaingredientmech/validation/write_validated.py',A/'src/mediaingredientmech/validation/component_partonomy.py',A/'src/mediaingredientmech/synonym_policy.py',A/'scripts/record_review.py',A/'schema/record_review.yaml',Path(__file__)]+sorted((A/'src/mediaingredientmech/schema').glob('*.yaml')):read(p)
def recheck():
 for f in pins.values():f.verify()
 assert git('rev-parse','HEAD').decode().strip()==BASE and git('ls-files','--stage','-z')==index and git('status','--porcelain=v1','--untracked-files=no','-z')==status
 assert ownerpins=={str(p.relative_to(A)):sha(p.read_bytes()) for cat in ['mapped','unmapped'] for p in sorted((A/'data/ingredients'/cat).glob('*.yaml'))}
render=D/'native-render'/Path(op['source_record']).name;render.parent.mkdir();write_validated_ingredient(new,render);raw=render.read_bytes();assert yaml.safe_load(raw)==new
rt=render.with_name('roundtrip.yaml');write_validated_ingredient(new,rt);assert rt.read_bytes()==raw
candidate=D/'candidates'/Path(op['source_record']).name;candidate.parent.mkdir();publish_new_files([(candidate,raw)],recheck);recheck();checks.append('guarded native serialization/idempotence/private publication')
records={}
with tarfile.open(fileobj=io.BytesIO(git('archive',BASE,'data/ingredients'))) as tar:
 for m in tar.getmembers():
  if m.isfile() and m.name.endswith('.yaml'):records[m.name]=yaml.safe_load(tar.extractfile(m).read())
assert len(records)==2956
before=copy.deepcopy(records);after=copy.deepcopy(records);before[op['source_record']]=old;after[op['source_record']]=new
assert list(validate_component_partonomy(before.values()))==list(validate_component_partonomy(after.values()))==[];checks.append('whole2956 unchanged-context partonomy zero both overlays')

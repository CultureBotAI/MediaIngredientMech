BASE='84241993a278a7a413422ef89a52c0b47dc57831';pins={};maps=[]
def sha(b):return hashlib.sha256(b).hexdigest()
def write(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
def save(n,x):write(D/n,(json.dumps(x,indent=2,ensure_ascii=False)+'\n').encode())
def read(p,expected=None):
 p=Path(p).absolute();f=FrozenFile.capture(p)
 if expected:assert sha(f.content)==expected,str(p)
 pins[p]=f;return f.content
def capture(p,rel,expected=None):
 b=read(p,expected);q=D/'inputs'/rel;write(q,b);maps.append({'original_path':str(Path(p).absolute()),'captured_path':str(q.relative_to(D)),'sha256':sha(b),'bytes':len(b),'scope':'Exact original capture, unchanged source/acquisition context; not new source research.'});return b
def git(*args):return subprocess.check_output(['git','--no-optional-locks','-C',str(A),*args],env={**os.environ,'GIT_OPTIONAL_LOCKS':'0'})
assert git('rev-parse','HEAD').decode().strip()==BASE
index=git('ls-files','--stage','-z');status=git('status','--porcelain=v1','--untracked-files=no','-z')
ownerpins={str(p.relative_to(A)):sha(p.read_bytes()) for cat in ['mapped','unmapped'] for p in sorted((A/'data/ingredients'/cat).glob('*.yaml'))};assert len(ownerpins)==2956
for n in ['verified-manifest.json','readback-00.json','publication-00.json','body.md']:capture(ISS/n,'issue/'+n)
issue=json.loads((D/'inputs/issue/readback-00.json').read_bytes());assert issue['id']==6724895813
manifest=json.loads(read(S/'MANIFEST.json','2b89f861526fc90da5456e5f7df239877dc7b3b19b2ed86a55393c8f145242b1'))
for r in manifest['members']:capture(S/r['path'],'assessment/'+r['path'],r['sha256'])

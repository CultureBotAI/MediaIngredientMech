assert len(oldrows)==len(newrows)==2 and olds==news
parent=next(r for r in newrows if r['object_id']=='CHEBI:91248');reg=next(r for r in newrows if r['object_id']==new['identifier']);assert parent['predicate_id']=='skos:broadMatch' and reg['predicate_id']=='skos:exactMatch'

save('native-row-diagnostic.json',{'scope':'Exact native functions with full authentic2956 context and actualKG input, no provider or full generation; empty residual used deliberately, final production generation still required.','before':oldrows,'after':newrows,'changed_cells':changes,'suppression_before':olds,'suppression_after':news,'forced_rejection_control':True,'builder':{'path':str(builder),'sha256':sha(rawcode)},'kg':{'path':str(kgp),'sha256':sha(pins[kgp].content)},'producer_graph':{str(p):sha(b) for p,b in native._IMPORTED_PRODUCER_BYTES.items()}})

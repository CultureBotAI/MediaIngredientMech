{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/CHEBI_752954","ontology_name":"chebi","related_synonyms":["Beef bile","Bos bovis bile","Bos taurus bile","Bovine bile","Fel tauri","Ox bile extract","Ox bile","Purified oxgall","Sodium choleate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_752954","description":[],"label":"ox bile","obo_id":"CHEBI:752954","type":"class"},{"iri":"http://purl.obolibrary.org/obo/MICRO_0000610","ontology_name":"micro","ontology_prefix":"MICRO","short_form":"MICRO_0000610","description":[],"label":"ox bile","obo_id":"MICRO:0000610","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_138843","ontology_name":"chebi","related_synonyms":["a 3-oxo bile acid CoA"],"ontology_prefix":"CHEBI","short_form":"CHEBI_138843","description":["A steroidal acyl-CoA(4−) obtained by deprotonation of the phosphate and diphosphate OH groups of any 3-oxo bile acid; major species at pH 7.3."],"label":"3-oxo bile acid CoA thioester(4-)","obo_id":"CHEBI:138843","type":"class"},{"iri":"http://purl.obolibrary.org/obo/MICRO_0000609","ontology_name":"micro","ontology_prefix":"MICRO","short_form":"MICRO_0000609","description":[],"label":"ox bile salts","obo_id":"MICRO:0000609","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/D013654","ontology_name":"mesh","related_synonyms":["Taufon","Tauphon","Taurine Hydrochloride","Taurine Zinc Salt (2:1)","Taurine, Monopotassium Salt"],"ontology_prefix":"mesh","short_form":"mesh_D013654","description":["A conditionally essential nutrient, important during mammalian development. It is present in milk but is isolated mostly from ox bile and strongly conjugates bile acids."],"label":"Taurine","obo_id":"mesh:D013654","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_78605","ontology_name":"chebi","related_synonyms":["(3alpha,5beta)-3-hydroxy-7-oxocholan-24-oate","7-ketolithocholate","7-oxo-3alpha-hydroxy-5beta-cholan-24-oate","7-oxolithocholate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_78605","description":["A bile acid anion that is the conjugate base of 7-oxolithocholic acid, obtained by deprotonation of the carboxy group; major species at pH 7.3."],"label":"7-oxolithocholate","obo_id":"CHEBI:78605","type":"class","exact_synonyms":["(3alpha,5beta)-3-hydroxy-7-oxocholan-24-oate"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87734","ontology_name":"chebi","related_synonyms":["(5beta,12alpha)-12-hydroxy-3-oxocholan-24-oate","12alpha-hydroxy-3-oxo-5beta-cholan-24-oate","3-oxodeoxycholate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_87734","description":["A bile acid anion that is the conjugate base of 12α-hydroxy-3-oxo-5β-cholan-24-oic acid, obtained by deprotonation of the carboxy group; major species at pH 7.3."],"label":"12alpha-hydroxy-3-oxo-5beta-cholan-24-oate","obo_id":"CHEBI:87734","type":"class","exact_synonyms":["12alpha-hydroxy-3-oxo-5beta-cholan-24-oate"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C128275","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C128275","description":["A nuclear receptor family that binds oxysterols or bile acids and, after forming a heterodimer with a member of the retinoid X receptor (RXR) family, modulates the expression of genes that are involved in cholesterol, fatty acid, and glucose homeostasis. The members of this family include oxysterols receptor LXR-alpha (NR1H3), oxysterols receptor LXR-beta (NR1H2) and bile acid receptor (NR1H4)."],"label":"Liver X Receptor-Like Family","obo_id":"NCIT:C128275","type":"class","exact_synonyms":["LXR Family","LXR","Liver X Receptor-Like Family","NR1H","Nuclear Receptor Subfamily 1 Group H"]},{"iri":"http://id.nlm.nih.gov/mesh/C535443","ontology_name":"mesh","related_synonyms":["Cholestasis with delta(4)-3-oxosteroid 5-beta-reductase deficiency","Congenital Bile Acid Synthesis Defect Type 2 (CBAS2)"],"ontology_prefix":"mesh","short_form":"mesh_C535443","description":[],"label":"Bile acid synthesis defect, congenital, 2","obo_id":"mesh:C535443","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/C535442","ontology_name":"mesh","related_synonyms":["3-Beta-Hydroxy-Delta-5-C27-Steroid Oxidoreductase, Deficiency Of","3-beta-hydroxy-delta-5-C27-steroid oxidoreductase deficiency","Cholestasis, progressive familial intrahepatic 4","Congenital Bile Acid Synthesis Defect Type 1 (CBAS1)","PFIC4 Progressive familial intrahepatic cholestasis type 4","Progressive familial intrahepatic cholestasis 4"],"ontology_prefix":"mesh","short_form":"mesh_C535442","description":[],"label":"Bile acid synthesis defect, congenital, 1","obo_id":"mesh:C535442","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_82679","ontology_name":"chebi","related_synonyms":["(3alpha,5beta)-3-hydroxy-7-oxocholan-24-oic acid","3-alpha-Hydroxy-7-oxo-5-beta-cholan-24-oic acid","3alpha-Hydroxy-7-oxo-5beta-cholanic acid","3alpha-hydroxy-7-oxo-5beta-cholan-24-oic acid","7-Ketolithocholic acid","7-oxo-3alpha-hydroxycholan-24-oic acid","7-oxolithocholic acid","Nutriacholic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_82679","description":["A bile acid that is lithocholic acid carrying an additional oxo substituent at position 7."],"label":"7-oxolithocholic acid","obo_id":"CHEBI:82679","type":"class","exact_synonyms":["(3alpha,5beta)-3-hydroxy-7-oxocholan-24-oic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87731","ontology_name":"chebi","related_synonyms":["(5beta,7alpha)-7-hydroxy-3-oxocholan-24-oate","3-oxochenodeoxycholate","7alpha-hydroxy-3-oxo-5beta-cholan-24-oate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_87731","description":["A bile acid anion that is the conjugate base of 7α-hydroxy-3-oxo-5β-cholan-24-oic acid, obtained by deprotonation of the carboxy group; major species at pH 7.3."],"label":"7alpha-hydroxy-3-oxo-5beta-cholan-24-oate","obo_id":"CHEBI:87731","type":"class","exact_synonyms":["7alpha-hydroxy-3-oxo-5beta-cholan-24-oate"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87747","ontology_name":"chebi","related_synonyms":["7alpha-hydroxy-3-oxochol-4-en-24-oate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_87747","description":["A bile acid anion that is the conjugate base of 7α-hydroxy-3-oxochol-4-en-24-oic acid, obtained by deprotonation of the carboxy group; major species at pH 7.3."],"label":"7alpha-hydroxy-3-oxochol-4-en-24-oate","obo_id":"CHEBI:87747","type":"class","exact_synonyms":["7alpha-hydroxy-3-oxochol-4-en-24-oate"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C28929","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C28929","description":["An anion exchange resin with hypolipidemic activity. Cholestyramine resin adsorbs and combines with bile acids in the intestine to form an insoluble complex, which is then excreted in the feces, resulting in an increased oxidation of cholesterol to bile acids, a decrease in low density lipoprotein in the plasma, and a decrease in serum cholesterol levels."],"label":"Cholestyramine","obo_id":"NCIT:C28929","type":"class","exact_synonyms":["CHOLESTYRAMINE","Cholestyramine","Cholybar","Colestyramine","Duolite AP143 Resin","Questran Light","Questran"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87736","ontology_name":"chebi","related_synonyms":["(5beta,7alpha,12alpha)-7,12-dihydroxy-3-oxocholan-24-oate","3-oxocholate","7alpha,12alpha-dihydroxy-3-oxo-5beta-cholan-24-oate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_87736","description":["A bile acid anion that is the conjugate base of 7α,12α-dihydroxy-3-oxo-5β-cholan-24-oic acid, obtained by deprotonation of the carboxy group; major species at pH 7.3."],"label":"7alpha,12alpha-dihydroxy-3-oxo-5beta-cholan-24-oate","obo_id":"CHEBI:87736","type":"class","exact_synonyms":["7alpha,12alpha-dihydroxy-3-oxo-5beta-cholan-24-oate"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C96442","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C96442","description":["Human ACOX2 wild-type allele is located in the vicinity of 3p14.3 and is approximately 32 kb in length. This allele, which encodes peroxisomal acyl-coenzyme A oxidase 2 protein, plays a role in both bile acid biosynthesis and fatty acid oxidation."],"label":"ACOX2 wt Allele","obo_id":"NCIT:C96442","type":"class","exact_synonyms":["ACOX2 wt Allele","Acyl-CoA Oxidase 2, Branched Chain wt Allele","BCOX","BRCACOX","BRCOX","Peroxisomal Branched Chain Acyl-CoA Oxidase Gene","THCCox"]},{"iri":"http://id.nlm.nih.gov/mesh/C081193","ontology_name":"mesh","related_synonyms":["bile acid-inducible NADH-flavin oxidoreductase, eubacterium"],"ontology_prefix":"mesh","short_form":"mesh_C081193","description":[],"label":"baiH protein, Eubacterium","obo_id":"mesh:C081193","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_145760","ontology_name":"chebi","related_synonyms":["(5alpha,7beta)-7-hydroxy-3-oxo-cholan-24-oic acid","(5alpha,7beta)-7-hydroxy-3-oxo-cholanoic acid","7-hydroxy-3-oxo-(5alpha,7beta)-cholan-24-Oic acid","7-hydroxy-3-oxocholanoic acid","7beta-hydroxy-3-oxo-5alpha-cholan-24-oic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_145760","description":["A bile acid that is 5α-cholan-24-oic acid carrying an oxo group at position 3 and a hydroxy group at position 7β."],"label":"7beta-hydroxy-3-oxo-5alpha-cholan-24-oic acid","obo_id":"CHEBI:145760","type":"class","exact_synonyms":["7beta-hydroxy-3-oxo-5alpha-cholan-24-oic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_89929","ontology_name":"chebi","related_synonyms":["3alpha,7beta-dihydroxy-5beta-cholanoylglycine","GUDCA","Glycine ursodeoxycholic acid","Glycylursodeoxycholic acid","N-(3alpha,7beta-dihydroxy-5beta-cholan-24-oyl)glycine","N-[(3alpha,5beta,7beta)-3,7-dihydroxy-24-oxocholan-24-yl]glycine","Ursodeoxycholylglycine"],"ontology_prefix":"CHEBI","short_form":"CHEBI_89929","description":["A bile acid glycine conjugate derived from ursoodeoxycholic acid."],"label":"glycoursodeoxycholic acid","obo_id":"CHEBI:89929","type":"class","exact_synonyms":["N-(3alpha,7beta-dihydroxy-5beta-cholan-24-oyl)glycine"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_138384","ontology_name":"chebi","related_synonyms":["2-[(3alpha-hydroxy-7,24-dioxo-5beta-cholan-24-yl)amino]ethane-1-sulfonic acid","2-{[(3alpha,5beta)-3-hydroxy-7,24-dioxocholan-24-yl]amino}ethane-1-sulfonic acid","3-Hoct","3-Hydroxy-7-oxocholanoyltaurine","3alpha-Hydroxy-7-keto-5beta-cholanoyltaurine","7-ketotaurolithocholic acid","N-(3alpha-hydroxy-7-oxo-5beta-cholan-24-oyl)taurine","Tauro-3alpha-hydroxy-7-keto-5beta-cholanoic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_138384","description":["A bile acid taurine conjugate derived from 7-oxolithocholic acid."],"label":"7-oxotaurolithocholic acid","obo_id":"CHEBI:138384","type":"class","exact_synonyms":["2-[(3alpha-hydroxy-7,24-dioxo-5beta-cholan-24-yl)amino]ethane-1-sulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_138393","ontology_name":"chebi","related_synonyms":["2-{[(3alpha,5beta,12alpha)-3,12-dihydroxy-7,24-dioxocholan-24-yl]amino}ethane-1-sulfonic acid","2[(3alpha,12alpha-dihydroxy-7,24-dioxo-5beta-cholan-24-yl)amino]ethane-1-sulfonic acid","3,12-Dihydroxy-7-oxocholanoyltaurine","3,12-HOCT","3alpha,12alpha-Dihydroxy-7-keto-5beta-cholanoyltaurine","7-ketodeoxycholic acid-taurine conjugate","7-ketotaurodeoxycholic acid","7-oxodeoxycholic acid-glycine conjugate","N-(3alpha,12alpha-dihydroxy-7-oxo-5beta-cholan-24-oyl)taurine","Tauro-3alpha,12alpha-dihydroxy-7-keto-5-beta-cholanoic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_138393","description":["A bile acid taurine conjugate derived from 7-oxodeoxycholic acid."],"label":"7-oxotaurodeoxycholic acid","obo_id":"CHEBI:138393","type":"class","exact_synonyms":["2[(3alpha,12alpha-dihydroxy-7,24-dioxo-5beta-cholan-24-yl)amino]ethane-1-sulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C96443","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C96443","description":["Peroxisomal acyl-coenzyme A oxidase 2 (681 aa, ~77 kDa) is encoded by the human ACOX2 gene. This protein is involved in the mediation of fatty acid oxidation and the synthesis of bile acid."],"label":"Peroxisomal Acyl-Coenzyme A Oxidase 2","obo_id":"NCIT:C96443","type":"class","exact_synonyms":["3-Alpha,7-Alpha,12-Alpha-Trihydroxy-5-Beta-Cholestanoyl-CoA 24-Hydroxylase","3-Alpha,7-Alpha,12-Alpha-Trihydroxy-5-Beta-Cholestanoyl-CoA Oxidase","ACOX2","EC 1.17.99.3","Peroxisomal Acyl-Coenzyme A Oxidase 2","THCA-CoA Oxidase","THCCox","Trihydroxycoprostanoyl-CoA Oxidase"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_17687","ontology_name":"chebi","related_synonyms":["3alpha,7alpha,12alpha-Trihydroxy-5beta-cholan-24-oylglycine","3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-oylglycine","GLYCOCHOLIC ACID","Glycocholic acid","N-(3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-oyl)glycine","N-[(3alpha,5beta,7alpha,12alpha)-3,7,12-trihydroxy-24-oxocholan-24-yl]glycine","N-choloylglycine"],"ontology_prefix":"CHEBI","short_form":"CHEBI_17687","description":["A bile acid glycine conjugate having cholic acid as the bile acid component."],"label":"glycocholic acid","obo_id":"CHEBI:17687","type":"class","exact_synonyms":["N-(3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-oyl)glycine"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87818","ontology_name":"chebi","related_synonyms":["NSC 681056","Sodium glycylchenodeoxycholate","glycochenodeoxycholic acid sodium salt","sodium N-(3alpha,7alpha-dihydroxy-5beta-cholan-24-oyl)glycinate","sodium [(3alpha,7alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]acetate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_87818","description":["A bile acid salt that is the sodium salt of glycochenodeoxycholic acid."],"label":"sodium glycochenodeoxycholate","obo_id":"CHEBI:87818","type":"class","exact_synonyms":["sodium N-(3alpha,7alpha-dihydroxy-5beta-cholan-24-oyl)glycinate","sodium [(3alpha,7alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]acetate"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87819","ontology_name":"chebi","related_synonyms":["glycodeoxycholic acid sodium salt","sodium N-(3alpha,12alpha-dihydroxy-5beta-cholan-24-oyl)glycinate","sodium [(3alpha,12alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]acetate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_87819","description":["A bile acid salt that is the sodium salt of glycodeoxycholic acid."],"label":"sodium glycodeoxycholate","obo_id":"CHEBI:87819","type":"class","exact_synonyms":["sodium N-(3alpha,12alpha-dihydroxy-5beta-cholan-24-oyl)glycinate","sodium [(3alpha,12alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]acetate"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_61707","ontology_name":"chebi","related_synonyms":["(1S,2S,3S)-1-carboxy-3-(2-carboxyethyl)-12-ethyl-2,8,13,18-tetramethyl-17-vinyl-1,2,3,21-tetrahydro-5,7-ethanobilene-a-19(16H),5(1),5(2)-trione","(3S,4S,5E)-4-(2-carboxyethyl)-5-[2-({5-[(3-ethenyl-4-methyl-5-oxo-2,5-dihydro-1H-pyrrol-2-yl)methyl]-3-ethyl-4-methyl-1H-pyrrol-2-yl}methyl)-3-methyl-4,5-dioxo-4,5-dihydrocyclopenta[b]pyrrol-6(1H)-ylidene]-3-methyl-L-proline","oxidised dinoflagellate luciferin"],"ontology_prefix":"CHEBI","short_form":"CHEBI_61707","description":["A member of the class of bilenes that is 1,2,3,21-tetrahydro-5,7-ethanobilene-\u003cem\u003ea\u003c/em\u003e-19(16\u003cem\u003eH\u003c/em\u003e),5\u003csmall\u003e\u003csup\u003e1\u003c/small\u003e\u003c/sup\u003e,5\u003csmall\u003e\u003csup\u003e2\u003c/small\u003e\u003c/sup\u003e-trione which is substituted at positions 2, 8, 13 and 18 by methyl groups and at positions 1, 3, 12 and 17 by carboxy, 2-carboxyethyl, ethyl and vinyl groups, respectively (the 1\u003ci\u003eS\u003c/i\u003e,2\u003ci\u003eS\u003c/i\u003e,3\u003ci\u003eS\u003c/i\u003e diastereoisomer)."],"label":"oxidized dinoflagellate luciferin","obo_id":"CHEBI:61707","type":"class","exact_synonyms":["(1S,2S,3S)-1-carboxy-3-(2-carboxyethyl)-12-ethyl-2,8,13,18-tetramethyl-17-vinyl-1,2,3,21-tetrahydro-5,7-ethanobilene-a-19(16H),5(1),5(2)-trione"]},{"iri":"http://id.nlm.nih.gov/mesh/D014558","ontology_name":"mesh","ontology_prefix":"mesh","short_form":"mesh_D014558","description":["A colorless compound formed in the intestines by the reduction of bilirubin. Some is excreted in the feces where it is oxidized to urobilin. Some is reabsorbed and re-excreted in the bile as bilirubin. At times, it is re-excreted in the urine, where it may be later oxidized to urobilin."],"label":"Urobilinogen","obo_id":"mesh:D014558","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_138391","ontology_name":"chebi","related_synonyms":["7-ketoglycolithocholic acid","N-(3alpha-hydroxy-7-oxo-5beta-cholan-24-oyl)glycine","N-[(3alpha,5beta)-3-hydroxy-7,24-dioxocholan-24-yl]glycine","nutriaglycocholic acid","{[(3alpha,5beta)-3-hydroxy-7,24-dioxocholan-24-yl]amino}acetic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_138391","description":["A bile acid glycine conjugate that is glycolithocholic acid carrying an additional oxo substituent at postion 7."],"label":"7-oxoglycolithocholic acid","obo_id":"CHEBI:138391","type":"class","exact_synonyms":["N-[(3alpha,5beta)-3-hydroxy-7,24-dioxocholan-24-yl]glycine"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_138394","ontology_name":"chebi","related_synonyms":["7-ketodeoxycholic acid-glycine conjugate","7-ketoglycodeoxycholic acid","7-oxodeoxycholic acid-glycine conjugate","N-(3alpha,12alpha-dihydroxy-7-oxo-5beta-cholan-24-oyl)glycine","N-[(3alpha,5beta,12alpha)-3,12-dihydroxy-7,24-dioxocholan-24-yl]glycine","{[(3alpha,5beta,12alpha)-3,12-dihydroxy-7,24-dioxocholan-24-yl]amino}acetic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_138394","description":["A bile acid glycine conjugate that is glycodeoxycholic acid carrying an additional oxo substituent at position 7."],"label":"7-oxoglycodeoxycholic acid","obo_id":"CHEBI:138394","type":"class","exact_synonyms":["N-[(3alpha,5beta,12alpha)-3,12-dihydroxy-7,24-dioxocholan-24-yl]glycine"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_138389","ontology_name":"chebi","related_synonyms":["(3alpha,5beta)-3-hydroxy-7,12-dioxocholan-24-oic acid","3-Hydroxy-7,12-diketocholanoic acid","3alpha-Hydroxy-7,12-diketo-5beta-cholanoic acid","3alpha-hydroxy-7,12-dioxo-5beta-cholan-24-oic acid","7,12-diketolithocholic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_138389","description":["A bile acid that is lithocholic acid carrying two additional oxo substituents at positions 7 and 12."],"label":"7,12-dioxolithocholic acid","obo_id":"CHEBI:138389","type":"class","exact_synonyms":["3alpha-hydroxy-7,12-dioxo-5beta-cholan-24-oic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_133176","ontology_name":"chebi","related_synonyms":["N-(3alpha,6alpha,7alpha-trihydroxy-5beta-cholan-24-oyl)glycine","N-[(3alpha,5beta,6alpha,7alpha)-3,6,7-trihydroxy-24-oxocholan-24-yl]glycine","N-hyocholoylglycine","hyocholic acid-glycine conjugate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_133176","description":["A bile acid glycine conjugate having hyocholic acid as the bile acid component."],"label":"glycohyocholic acid","obo_id":"CHEBI:133176","type":"class","exact_synonyms":["N-(3alpha,6alpha,7alpha-trihydroxy-5beta-cholan-24-oyl)glycine"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_36259","ontology_name":"chebi","related_synonyms":["2-[(3alpha-hydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid","Taurolithocholate","Taurolithocholic acid","lithocholyltaurine"],"ontology_prefix":"CHEBI","short_form":"CHEBI_36259","description":["The bile acid taurine conjugate of lithocholic acid."],"label":"taurolithocholic acid","obo_id":"CHEBI:36259","type":"class","exact_synonyms":["2-[(3alpha-hydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_36274","ontology_name":"chebi","related_synonyms":["Chenodeoxyglycocholate","GCDCA","GLYCOCHENODEOXYCHOLIC ACID","Glycochenodeoxycholate","Glycochenodeoxycholic acid","N-(3alpha,7alpha-dihydroxy-5beta-cholan-24-oyl)glycine","[(3alpha,7alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]acetic acid","chenodeoxycholylglycine","chenodeoxyglycocholic acid","glycine chenodeoxycholate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_36274","description":["A bile acid glycine conjugate having 3α,7α-dihydroxy-5β-cholan-24-oyl as the bile acid component."],"label":"glycochenodeoxycholic acid","obo_id":"CHEBI:36274","type":"class","exact_synonyms":["N-(3alpha,7alpha-dihydroxy-5beta-cholan-24-oyl)glycine","[(3alpha,7alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]acetic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_133678","ontology_name":"chebi","related_synonyms":["N-[(3alpha,5beta,12alpha)-12-hydroxy-24-oxo-3-(sulfooxy)cholan-24-yl]glycine","N-[12alpha-hydroxy-24-oxo-3alpha-(sulfooxy)-5beta-cholan-24-yl]glycine","glycodeoxycholic acid sulfate","sulfoglycodeoxycholic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_133678","description":["A bile acid glycine conjugate that is glycodeoxycholic acid in which the hydroxy hydrogen at position 3 has been replaced by a sulfo group."],"label":"glycodeoxycholic acid 3-sulfate","obo_id":"CHEBI:133678","type":"class","exact_synonyms":["N-[12alpha-hydroxy-24-oxo-3alpha-(sulfooxy)-5beta-cholan-24-yl]glycine"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_83036","ontology_name":"chebi","related_synonyms":["7-Hoca","7alpha-hydroxy-3-oxocholest-4-en-26-oic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_83036","description":["A cholestanoid that is cholest-4-en-26-oic acid substituted by an α-hydroxy group at position 7 and an oxo group at position 3. It is an intermediate metabolite in the bile acid synthesis."],"label":"7alpha-hydroxy-3-oxo-4-cholestenoic acid","obo_id":"CHEBI:83036","type":"class","exact_synonyms":["7alpha-hydroxy-3-oxocholest-4-en-26-oic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_16525","ontology_name":"chebi","related_synonyms":["2-[(3alpha,7alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid","Chenodeoxycholoyltaurine","Taurochenodeoxycholic acid","taurine chenodeoxycholate","taurochenodeoxycholate","taurochenodeoxycholic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_16525","description":["A bile acid taurine conjugate of  chenodeoxycholic acid."],"label":"taurochenodeoxycholic acid","obo_id":"CHEBI:16525","type":"class","exact_synonyms":["2-[(3alpha,7alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_9410","ontology_name":"chebi","related_synonyms":["2-[(3alpha,12alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid","Deoxy cholate","HY-209","HY209","J339.140J","Taurodeoxycholate","taurodeoxycholic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_9410","description":["A bile acid taurine conjugate of deoxycholic acid."],"label":"taurodeoxycholic acid","obo_id":"CHEBI:9410","type":"class","exact_synonyms":["2-[(3alpha,12alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_145227","ontology_name":"chebi","related_synonyms":["2-[(3alpha,7beta,12alpha-trihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethane-1-sulfonic acid","2-[(3alpha,7beta,12alpha-trihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid","N-(3alpha,7beta,12alpha-trihydroxy-5beta-cholan-24-oyl)-taurine"],"ontology_prefix":"CHEBI","short_form":"CHEBI_145227","description":["A bile acid taurine conjugate of  ursocholic acid."],"label":"tauroursocholic acid","obo_id":"CHEBI:145227","type":"class","exact_synonyms":["2-[(3alpha,7beta,12alpha-trihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_61702","ontology_name":"chebi","related_synonyms":["(1S,2S,3S)-1-carboxy-3-(2-carboxyethyl)-12-ethyl-2,8,13,18-tetramethyl-17-vinyl-1,2,3,21-tetrahydro-5,7-ethanobilene-a-19(16H),5(2)-dione","(3S,4S,5Z)-4-(2-carboxyethyl)-5-[2-({5-[(3-ethenyl-4-methyl-5-oxo-2,5-dihydro-1H-pyrrol-2-yl)methyl]-3-ethyl-4-methyl-1H-pyrrol-2-yl}methyl)-3-methyl-4-oxo-4,5-dihydrocyclopenta[b]pyrrol-6(1H)-ylidene]-3-methyl-L-proline"],"ontology_prefix":"CHEBI","short_form":"CHEBI_61702","description":["A member of the class of bilenes that is 1,2,3,21-tetrahydro-5,7-ethanobilene-\u003cem\u003ea\u003c/em\u003e-19(16\u003cem\u003eH\u003c/em\u003e),5\u003csmall\u003e\u003csup\u003e2\u003c/small\u003e\u003c/sup\u003e-dione which is substituted at positions 2, 8, 13 and 18 by methyl groups and at positions 1, 3, 12 and 17 by carboxy, 2-carboxyethyl, ethyl and vinyl groups, respectively (the 1\u003ci\u003eS\u003c/i\u003e,2\u003ci\u003eS\u003c/i\u003e,3\u003ci\u003eS\u003c/i\u003e diastereoisomer)."],"label":"dinoflagellate luciferin","obo_id":"CHEBI:61702","type":"class","exact_synonyms":["(1S,2S,3S)-1-carboxy-3-(2-carboxyethyl)-12-ethyl-2,8,13,18-tetramethyl-17-vinyl-1,2,3,21-tetrahydro-5,7-ethanobilene-a-19(16H),5(2)-dione"]},{"iri":"http://id.nlm.nih.gov/mesh/D003577","ontology_name":"mesh","related_synonyms":["CYP450 Family","CYP450 Superfamily","Cytochrome P 450 Dependent Monooxygenase","Cytochrome P 450 Enzyme System","Cytochrome P 450 Enzyme","Cytochrome P 450 Enzymes","Cytochrome P 450 Families","Cytochrome P 450 Monooxygenase","Cytochrome P 450 Oxygenase","Cytochrome P 450 Superfamily","Cytochrome P 450","Cytochrome P-450 Enzyme","Cytochrome P-450 Enzymes","Cytochrome P-450 Families","Cytochrome P-450 Monooxygenase","Cytochrome P-450 Oxygenase","Cytochrome P-450 Superfamily","Cytochrome P-450","Cytochrome P-450-Dependent Monooxygenase","Cytochrome P450 Superfamily","Cytochrome P450","Cytochrome p450 Families","Enzyme, Cytochrome P-450","Enzyme, P-450","Enzyme, P450","Enzymes, Cytochrome P-450","Enzymes, P-450","Enzymes, P450","Monooxygenase, Cytochrome P-450","Monooxygenase, Cytochrome P-450-Dependent","P 450 Enzyme","P 450 Enzymes","P-450 Enzyme","P-450 Enzyme, Cytochrome","P-450 Enzymes","P-450 Enzymes, Cytochrome","P450 Enzyme","P450 Enzymes","Superfamily, CYP450","Superfamily, Cytochrome P-450","Superfamily, Cytochrome P450"],"ontology_prefix":"mesh","short_form":"mesh_D003577","description":["A superfamily of hundreds of closely related HEMEPROTEINS found throughout the phylogenetic spectrum, from animals, plants, fungi, to bacteria. They include numerous complex monooxygenases (MIXED FUNCTION OXYGENASES). In animals, these P-450 enzymes serve two major functions: (1) biosynthesis of steroids, fatty acids, and bile acids; (2) metabolism of endogenous and a wide variety of exogenous substrates, such as toxins and drugs (BIOTRANSFORMATION). They are classified, according to their sequence similarities rather than functions, into CYP gene families (\u003e40% homology) and subfamilies (\u003e59% homology). For example, enzymes from the CYP1, CYP2, and CYP3 gene families are responsible for most drug metabolism."],"label":"Cytochrome P-450 Enzyme System","obo_id":"mesh:D003577","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_47951","ontology_name":"chebi","related_synonyms":["(8(2)R,12S,13S)-12-(2-carboxyethyl)-3-ethyl-1-formyl-8(2)-(methoxycarbonyl)-2,7,13,17-tetramethyl-18-vinyl-12,13-dihydro-8,10-ethanobilene-b-8(1),19(16H)-dione","3-{(2Z,3S,4S)-5-[(4-ethenyl-3-methyl-5-oxo-2,5-dihydro-1H-pyrrol-2-yl)methyl]-2-[(5R)-2-[(3-ethyl-5-formyl-4-methyl-1H-pyrrol-2-yl)methyl]-5-methoxycarbonyl-3-methyl-4-oxo-4,5-dihydrocyclopenta[b]pyrrol-6(1H)-ylidene]-4-methyl-3,4-dihydro-2H-pyrrol-3-yl}propanoic acid","pFCC","primary FCC"],"ontology_prefix":"CHEBI","short_form":"CHEBI_47951","description":["A member of the class of  bilenes that is red chlorophyll catabolite in which a methylene group is introduced at position 1 via the reduction of a double bond. It is an intermediate of chlorophyll breakdown in plants."],"label":"primary fluorescent chlorophyll catabolite","obo_id":"CHEBI:47951","type":"class","exact_synonyms":["3-{(2Z,3S,4S)-5-[(4-ethenyl-3-methyl-5-oxo-2,5-dihydro-1H-pyrrol-2-yl)methyl]-2-[(5R)-2-[(3-ethyl-5-formyl-4-methyl-1H-pyrrol-2-yl)methyl]-5-methoxycarbonyl-3-methyl-4-oxo-4,5-dihydrocyclopenta[b]pyrrol-6(1H)-ylidene]-4-methyl-3,4-dihydro-2H-pyrrol-3-yl}propanoic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_232263","ontology_name":"chebi","related_synonyms":["(2S)-2-[(4R)-4-[(1R,3aS,3bR,4R,5aS,7R,9aS,9bS,11S,11aR)-4,7,11-trihydroxy-9a,11a-dimethyl-tetradecahydro-1H-cyclopenta[a]phenanthren-1-yl]pentanamido]-3-(1H-indol-3-yl)propanoic acid","L-tryptophan conjugated cholic acid","L-tryptophan-conjugated cholic acid","N-(3alpha,7alpha,12alpha-trihydroxy-5beta-cholan-24-oyl)-L-tryptophan","Nalpha-(24-oxo-3alpha,7alpha,12alpha-trihydroxy-5beta-cholane-24-yl)-L-tryptophan","Trp-CA","cholyl-tryptophan","cholyltryptophan","tryptophan conjugated cholic acid","tryptophan-conjugated cholic acid","tryptophanocholic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_232263","description":["A bile acid conjugate resulting from the formal condensation of the carboxy group of cholic acid with the amino group of \u003csmall\u003eL\u003c/small\u003e-tryptophan. It improves glucose tolerance in diabetic mice."],"label":"cholyl-L-tryptophan","obo_id":"CHEBI:232263","type":"class","exact_synonyms":["(2S)-2-[(4R)-4-[(1R,3aS,3bR,4R,5aS,7R,9aS,9bS,11S,11aR)-4,7,11-trihydroxy-9a,11a-dimethyl-tetradecahydro-1H-cyclopenta[a]phenanthren-1-yl]pentanamido]-3-(1H-indol-3-yl)propanoic acid"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C114943","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C114943","description":["25-hydroxycholesterol 7-alpha-hydroxylase (506 aa, ~58 kDa) is encoded by the human CYP7B1 gene. This protein plays a role in the conversion of cholesterol into bile acids."],"label":"25-Hydroxycholesterol 7-Alpha-Hydroxylase","obo_id":"NCIT:C114943","type":"class","exact_synonyms":["25-Hydroxycholesterol 7-Alpha-Hydroxylase","CYP7B1","Cytochrome P450 7B1","Cytochrome P450 Family 7 Subfamily B Polypeptide 1","EC 1.14.13.100","Oxysterol 7-Alpha-Hydroxylase 1","Oxysterol 7-Alpha-Hydroxylase","Oxysterol 7alpha-Hydroxylase"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_28865","ontology_name":"chebi","related_synonyms":["2-[(3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid","3alpha,7alpha,12alpha-trihydroxy-5beta-cholanic acid 24-taurine","Choloyl-taurine","Cholyltaurine","N-choloyltaurine","Taurocholate","Taurocholic acid","cholic acid taurine conjugate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_28865","description":["A bile acid taurine conjugate of  cholic acid that usually occurs as the sodium salt of bile in mammals."],"label":"taurocholic acid","obo_id":"CHEBI:28865","type":"class","exact_synonyms":["2-[(3alpha,7alpha,12alpha-trihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C114646","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C114646","description":["24-hydroxycholesterol 7-alpha-hydroxylase (469 aa, ~54 kDa) is encoded by the human CYP39A1 gene. This protein is involved in the conversion of cholesterol to bile acids."],"label":"24-Hydroxycholesterol 7-Alpha-Hydroxylase","obo_id":"NCIT:C114646","type":"class","exact_synonyms":["24-Hydroxycholesterol 7-Alpha-Hydroxylase","CYP39A1","Cytochrome P450 39A1","Cytochrome P450, Subfamily XXXIX Polypeptide 1","EC 1.14.13.99","Oxysterol 7-Alpha-Hydroxylase","hCYP39A1"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C28937","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C28937","description":["A hydrochloride salt form of colesevelam, a non-absorbed polymer that binds bile acids in the intestine and lowers serum lipids."],"label":"Colesevelam Hydrochloride","obo_id":"NCIT:C28937","type":"class","exact_synonyms":["1-Hexaminium, N,N,N-trimethyl-6-(2-propenylamino)-, Chloride, Polymer with (chloromethyl)oxirane, 2-propen-4-amine and N-2-propenyl-1-decanamine, Hydrochloride","COLESEVELAM HYDROCHLORIDE","CholestaGel","Colesevelam Hydrochloride","GT 31-104HB","Welchol"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_133057","ontology_name":"chebi","related_synonyms":["2-[(3alpha,6beta,7beta-trihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethane-1-sulfonic acid","2-{[(3alpha,5beta,6beta,7beta)-3,6,7-trihydroxy-24-oxocholan-24-yl]amino}ethane-1-sulfonic acid","N-(3alpha,6beta,7beta-trihydroxy-5beta-cholan-24-oyl)-taurine","Tauro-b-muricholic acid","Tauromuricholic acid","beta-tauromuricholic acid","tauro-beta-Muricholic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_133057","description":["A bile acid taurine conjugate derived from β-muricholic acid."],"label":"tauro-beta-muricholic acid","obo_id":"CHEBI:133057","type":"class","exact_synonyms":["2-[(3alpha,6beta,7beta-trihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethane-1-sulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_229978","ontology_name":"chebi","related_synonyms":["(1R,2R,4E)-1-[(2S,5S,11S,14S,17S,20S,23R,26S,29S,32S)-5-ethyl-1,7,10,16,20,23,25,28,31-nonamethyl-11,17,26,29-tetrakis(2-methylpropyl)-3,6,9,12,15,18,21,24,27,30,33-undecaoxo-14,32-di(propan-2-yl)-1,4,7,10,13,16,19,22,25,28,31-undecaazacyclotritriacontan-2-yl]-2-methylhex-4-en-1-yl sulfate","CsA-SO4","cyclosporin A sulfate (ester)","cyclosporin A sulphate","cyclosporine sulfate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_229978","description":["An organosulfate oxoanion that is the conjugate base of cyclosporin A hydrogen sulfate resulting from the deprotonation of the sulfooxy group. It is a metabolite of cyclosporin A found in human bile and plasma."],"label":"cyclosporin A sulfate","obo_id":"CHEBI:229978","type":"class","exact_synonyms":["(1R,2R,4E)-1-[(2S,5S,11S,14S,17S,20S,23R,26S,29S,32S)-5-ethyl-1,7,10,16,20,23,25,28,31-nonamethyl-11,17,26,29-tetrakis(2-methylpropyl)-3,6,9,12,15,18,21,24,27,30,33-undecaoxo-14,32-di(propan-2-yl)-1,4,7,10,13,16,19,22,25,28,31-undecaazacyclotritriacontan-2-yl]-2-methylhex-4-en-1-yl sulfate"]},{"iri":"http://id.nlm.nih.gov/mesh/D002790","ontology_name":"mesh","related_synonyms":["CYP 7","CYP 7A","CYP7","CYP7A","Cholesterol 7 Hydroxylase","Cholesterol 7 alpha Hydroxylase","Cholesterol 7 alpha Monooxygenase","Cholesterol 7-alpha-Monooxygenase","Cholesterol 7alpha Hydroxylase","Cholesterol 7alpha-Hydroxylase","Cholesterol-7-Hydroxylase","Cytochrome P 450 CYP7","Cytochrome P-450 CYP7","Cytochrome P450 7"],"ontology_prefix":"mesh","short_form":"mesh_D002790","description":["A membrane-bound cytochrome P450 enzyme that catalyzes the 7-alpha-hydroxylation of CHOLESTEROL in the presence of molecular oxygen and NADPH-FERRIHEMOPROTEIN REDUCTASE. This enzyme, encoded by CYP7, converts cholesterol to 7-alpha-hydroxycholesterol which is the first and rate-limiting step in the synthesis of BILE ACIDS."],"label":"Cholesterol 7-alpha-Hydroxylase","obo_id":"mesh:D002790","type":"class"},{"iri":"http://purl.obolibrary.org/obo/NCIT_C90865","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C90865","description":["A pyrrolidone non-competitive inhibitor of hydroxymethyl-glutaryl coenzyme A (HMG-CoA) reductase. Crilvastatin acts by stimulating LDL-cholesterol uptake by hepatocytes and also by stimulating bile cholesterol and bile salt secretion."],"label":"Crilvastatin","obo_id":"NCIT:C90865","type":"class","exact_synonyms":["5-Oxo-L-proline, (+-)-cis-3,3,5-trimethylcyclohexyl Ester","CRILVASTATIN","Crilvastatin","PMD-387"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C485","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C485","description":["An unsaturated ketone derivative of aryloxyacetic acid without a sulfonamide substituent belonging to the class of loop diuretics. Ethacrynic acid is extensively bound to plasma proteins; both ethacrynic acid in its unchanged form as well as its metabolites are excreted in bile and urine."],"label":"Ethacrynic Acid","obo_id":"NCIT:C485","type":"class","exact_synonyms":["EA","ETHACRYNIC ACID","Edecrin","Ethacrynic Acid","Ethacrynic acid","[2,3-Dichloro-4-(2-methylene-1-oxobutyl)phenoxy]acetic Acid"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C114644","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C114644","description":["Human CYP39A1 wild-type allele is located within 6p21.1-p11.2 and is approximately 103 kb in length. This allele, which encodes 24-hydroxycholesterol 7-alpha-hydroxylase protein, plays a role in the metabolism of both cholesterol and bile acids."],"label":"CYP39A1 wt Allele","obo_id":"NCIT:C114644","type":"class","exact_synonyms":["CYP39A1 wt Allele","Cytochrome P450, Family 39, Subfamily A, Polypeptide 1 wt Allele","Cytochrome P450, Subfamily XXXIX (Oxysterol 7 Alpha-Hydroxylase), Polypeptide 1 Gene"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C47703","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C47703","description":["A nonsulfonylurea insulin secretagogue belonging to the melgitinide class with hypoglycemic activity. Repaglinide is rapidly absorbed and has a rapid onset and short duration of action. This agent is metabolized in the liver by CYP2C8 and CYP3A4 and its metabolites are excreted in the bile. Repaglinide has a half-life of one hour."],"label":"Repaglinide","obo_id":"NCIT:C47703","type":"class","exact_synonyms":["(+)-2-Ethoxy-alpha-(((S)-alpha-isobutyl-o-piperidinobenzyl)carbamoyl)-p-toluic Acid","AG-EE 623 ZW","Benzoic Acid, 2-ethoxy-4-(2-((3-methyl-1-(2-(1-piperidinyl)phenyl)butyl)amino)-2-oxoethyl)-,(S)-","Prandin","REPAGLINIDE","Repaglinide"]},{"iri":"http://id.nlm.nih.gov/mesh/D013253","ontology_name":"mesh","related_synonyms":["12 alpha Hydroxylase","12 alpha-Hydroxylase, Sterol","12-alpha-Hydroxylase","12alpha Hydroxylase","12alpha-Hydroxylase","CYP8B1","Cytochrome P450 8B1","Cytochrome P450 CYP8B1","Steroid 12 Hydroxylase","Steroid 12 Monooxygenase","Steroid 12 alpha Hydroxylase","Steroid 12-Hydroxylase","Steroid 12-Monooxygenase","Steroid-12-Hydroxylase","Steroid-12-Monooxygenase","Sterol 12 alpha Hydroxylase","Sterol 12 alpha-Hydroxylase","Sterol 12-alpha-Hydroxylase","alpha-Hydroxylase, Sterol 12"],"ontology_prefix":"mesh","short_form":"mesh_D013253","description":["A liver microsomal cytochrome P450 enzyme that catalyzes the 12-alpha-hydroxylation of a broad spectrum of sterols in the presence of molecular oxygen and NADPH-FERRIHEMOPROTEIN REDUCTASE. This enzyme, encoded by CYP8B1gene, converts 7-alpha-hydroxy-4-cholesten-3-one to 7-alpha-12-alpha-dihydroxy-4-cholesten-3-one and is required in the synthesis of BILE ACIDS from cholesterol."],"label":"Steroid 12-alpha-Hydroxylase","obo_id":"mesh:D013253","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_80774","ontology_name":"chebi","related_synonyms":["2-(((3-alpha,5-beta,7-beta)-3,7-Dihydroxy-24-oxocholan-24-yl) amino)ethanesulfonic acid","2-[(3alpha,7beta-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid","2-{[(3alpha,5beta,7beta)-3,7-dihydroxy-24-oxocholan-24-yl]amino}ethane-1-sulfonic acid","3alpha,7beta-dihydroxy-5beta-cholanoyltaurine","N-(3-alpha,7-beta-Dihydroxy-5-beta-cholan-24-oyl)-Taurine","N-(3alpha,7beta-dihydroxy-5beta-cholan-24-oyl)taurine","N-ursodeoxycholoyltaurine","TUDCA","Taurolite","Tauroursodeoxycholic acid","Tauroursodesoxycholic acid","Taurursodiol component of relyvrio","Taurursodiol","UR 906","Ur-906","Ursodeoxy cholic acid","Ursodeoxycholyltaurine","Ursodoxicoltaurine","taurursodiol"],"ontology_prefix":"CHEBI","short_form":"CHEBI_80774","description":["A bile acid taurine conjugate derived from ursoodeoxycholic acid."],"label":"tauroursodeoxycholic acid","obo_id":"CHEBI:80774","type":"class","exact_synonyms":["2-[(3alpha,7beta-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]ethanesulfonic acid"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C114942","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C114942","description":["Human CYP7B1 wild-type allele is located in the vicinity of 8q21.3 and is approximately 211 kb in length. This allele, which encodes 25-hydroxycholesterol 7-alpha-hydroxylase enzyme, is involved in cholesterol catabolism. Mutation of the gene is associated with autosomal recessive spastic paraplegia 5A and congenital bile acid synthesis defect 3."],"label":"CYP7B1 wt Allele","obo_id":"NCIT:C114942","type":"class","exact_synonyms":["CBAS3","CP7B","CYP7B1 wt Allele","Cytochrome P450, Family 7, Subfamily B, Polypeptide 1 wt Allele","Cytochrome P450, Subfamily VIIB (Oxysterol 7 Alpha-Hydroxylase), Polypeptide 1 Gene","SPG5A","Spastic Paraplegia 5A (Autosomal Recessive) Gene"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C47719","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C47719","description":["A synthetic C-terminal octapeptide identical to the sequences of the endogenous cholecystokinin hormone. Mimic action of cholecystokinin, sincalide induces gallbladder smooth muscle contraction directly, thereby reducing gallbladder size, inducing bile evacuation, and secretion of pancreatic enzymes. In addition, this agent decreases esophageal sphincter tone and delays gastric emptying via cholinergic signaling."],"label":"Sincalide","obo_id":"NCIT:C47719","type":"class","exact_synonyms":["1-De(5-oxo-L-proline)-2-de-L-glutamine-5-L-methioninecaerulein","Kinevac","L-Aspartyl-L-tyrosyl-L-methionylglycyl-L-tryptophyl-L-methionyl-L-aspartylphenyl-L-alaninamide Hydrogen Sulfate(ester)","L-alpha-Aspartyl-O-sulfo-L-tyrosyl-L-methionylglycyl-L-tryptophyl-L-methionyl-L-alpha-aspartyl-L-phenylalaninamide","SINCALIDE","Sincalide"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_131631","ontology_name":"chebi","related_synonyms":["1-(4,6-dimethoxy-1,3-benzodioxol-5-yl)-2-(2-hydroxyphenyl)prop-2-en-1-one","2-[2-(2-hydroxyphenyl)-3-oxoprop-1-en-3-yl]-1,3-dimethoxy-4,5-methylenedioxybenzene"],"ontology_prefix":"CHEBI","short_form":"CHEBI_131631","description":["A member of the class of benzodioxoles that is 1,3-benzodioxole which is substituted at positions 5 by  a 2-(2-hydroxyphenyl)-3-oxoprop-1-en-3-yl group and at positions 4 and 6 by methoxy groups. A very rare type of isoflavonoid-related 1,2-diaryl-2-propenone found in \u003cem\u003eDysphania glomulifera\u003c/em\u003e (red crumbweed) and \u003cem\u003eD. littoralis\u003c/em\u003e, the enone moiety is particularly reactive, undergoing ready Michael addition of water and methanol. Biliatresone has been found to cause extrahepatic biliary atresia (obliteration or discontinuity of the extrahepatic biliary system, resulting in obstruction to bile flow) in a zebrafish model."],"label":"biliatresone","obo_id":"CHEBI:131631","type":"class","exact_synonyms":["1-(4,6-dimethoxy-1,3-benzodioxol-5-yl)-2-(2-hydroxyphenyl)prop-2-en-1-one"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C77547","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C77547","description":["A gadolinium-based paramagnetic contrast agent. When placed in a magnetic field, gadobenate dimeglumine produces a large magnetic moment and so a large local magnetic field, which can enhance the relaxation rate of nearby protons; as a result, the signal intensity of tissue images observed with magnetic resonance imaging (MRI) may be enhanced. Because this agent is preferentially taken up by normal functioning hepatocytes, normal hepatic tissue is enhanced with MRI while tumor tissue is unenhanced. In addition, because gadobenate dimeglumine is excreted in the bile, it may be used to visualize the biliary system using MRI."],"label":"Gadobenate Dimeglumine","obo_id":"NCIT:C77547","type":"class","exact_synonyms":["(4RS)-[4-carboxy-5,8,11-tris(carboxymethyl)-1-phenyl-2-oxa-5,8,11-triazatridecan-13-oato(5-)] gadolinate(2-) dihydrogen compound with 1-deoxy-1-(methylamino)-D-glucitol (1:2)","GADOBENATE DIMEGLUMINE","Gadobenate Dimeglumine","Gd-BOPTA","MultiHance","gadobenate dimeglumine"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87818","ontology_name":"micro","related_synonyms":["NSC 681056","Sodium glycylchenodeoxycholate","glycochenodeoxycholic acid sodium salt"],"ontology_prefix":"MICRO","short_form":"CHEBI_87818","description":["A bile acid salt that is the sodium salt of glycochenodeoxycholic acid."],"label":"sodium glycochenodeoxycholate","obo_id":"CHEBI:87818","type":"class","exact_synonyms":["sodium N-(3alpha,7alpha-dihydroxy-5beta-cholan-24-oyl)glycinate","sodium [(3alpha,7alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]acetate"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_87819","ontology_name":"micro","related_synonyms":["glycodeoxycholic acid sodium salt"],"ontology_prefix":"MICRO","short_form":"CHEBI_87819","description":["A bile acid salt that is the sodium salt of glycodeoxycholic acid."],"label":"sodium glycodeoxycholate","obo_id":"CHEBI:87819","type":"class","exact_synonyms":["sodium N-(3alpha,12alpha-dihydroxy-5beta-cholan-24-oyl)glycinate","sodium [(3alpha,12alpha-dihydroxy-24-oxo-5beta-cholan-24-yl)amino]acetate"]}],"numFound":61,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["CHEBI","35","NCIT","14","mesh","8","MICRO","4"],"isDefiningOntology":["true","59","false","2"],"ontologyId":["chebi","35","slm","35","ncit","14","dron","14","efo","13","mesh","8","cmo","8","medgen","8","pride","7","ec","6","mondo","5","go","5","opmi","4","micro","4","hra","3","doid","3","cl","3","exmo","3","mco","3","rexo","3","ordo","3","upheno","3","hp","3","gexo","3","cco","3","reto","3","ons","3","snomed","2","bao","1","pcl","1","txpo","1","xco","1","vo","1","gsso","1","oba","1"],"ontologyIri":["http://purl.obolibrary.org/obo/chebi.owl","35","http://purl.obolibrary.org/obo/ncit.owl","14","https://w3id.org/biopragmatics/resources/mesh/mesh.ofn","8","http://purl.obolibrary.org/obo/MicrO.owl","4"],"isObsolete":["false","61"],"type":["class","61"]}}}
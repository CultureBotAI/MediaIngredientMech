            </owl:Class>
        </owl:equivalentClass>
        <obo:has_exact_synonym>taper</obo:has_exact_synonym>
        <obo:definition>A heteropolar trichome that is tapered (has a larger cell diameter at one end of the filament than the other).</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>tapering</obo:has_exact_synonym>
        <oboInOwl:hasRelatedSynonym>cells tapered</oboInOwl:hasRelatedSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000427 -->

    <owl:Class rdf:about="&obo;MICRO_0000427">
        <rdfs:label>pleomorphic cell</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000333"/>

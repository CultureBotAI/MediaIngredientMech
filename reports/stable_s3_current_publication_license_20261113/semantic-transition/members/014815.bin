    <owl:Class rdf:about="&obo;MICRO_0001709">
        <rdfs:label>calf serum</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0001236"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001431"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&obo;NCBITaxon_9913"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&obo;MICRO_0001431"/>
                                        <owl:someValuesFrom rdf:resource="&obo;UBERON_0007021"/>
                                    </owl:Restriction>

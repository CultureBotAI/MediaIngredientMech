                <owl:someValuesFrom rdf:resource="&obo;PATO_0002400"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasBroadSynonym>attenuated trichome ends</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>trichomes attenuated towards the ends</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>trichomes attenuated toward both ends</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>continually attenuated to the ends</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>trichomes attenuated at the ends of developed trichomes </oboInOwl:hasBroadSynonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasBroadSynonym>tapering to the ends</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>cells narrowed at both ends</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>trichomes narrowed to the ends</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>attenuated toward the ends</oboInOwl:hasBroadSynonym>
        <obo:definition>Tapered trichome quality where the trichome is narrower at the apical and basal ends, and widened toward the center of the trichome (fusiform-shaped).</obo:definition>
        <oboInOwl:hasBroadSynonym>trichomes narrows towards the ends</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>trichomes attenuated to the ends</oboInOwl:hasBroadSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000060 -->

    <owl:Class rdf:about="&obo;MICRO_0000060">
        <rdfs:label>widened spaces between thylakoids</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000048"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="&obo;PATO_0000374"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasBroadSynonym>intrathylakoidal spaces</oboInOwl:hasBroadSynonym>
        <obo:definition>Thylakoid-containing cell where there are widened spaces between the thylakoid membranes.  Function is not clear and are likely influenced by environmental factors.  Frequency and location are taxa-specific.</obo:definition>
    </owl:Class>
    



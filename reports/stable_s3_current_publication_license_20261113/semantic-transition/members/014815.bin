        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001465"/>
                <owl:someValuesFrom rdf:resource="&obo;PATO_0000616"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="&obo;MICRO_0000009"/>
        <obo:has_exact_synonym>irregularly branched</obo:has_exact_synonym>
        <obo:has_exact_synonym>branches solitary</obo:has_exact_synonym>
        <obo:definition>Filament branch spatial pattern where the filament exhibits branching (either false or true branching).  Filaments occur singularly (solitary), and do not occur in pairs (are offset from one another).</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>filaments irregularly branched</obo:has_exact_synonym>
    </owl:Class>
    



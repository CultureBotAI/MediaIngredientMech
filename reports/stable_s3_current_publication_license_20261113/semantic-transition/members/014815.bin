                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_17015"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_27470"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_30411"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_30753"/>
                    </owl:Restriction>

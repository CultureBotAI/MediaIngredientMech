        <obo:IAO_0000119>Wikipedia:Voges–Proskauer_test</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym>v-p</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>acetylmethylcarbinol</oboInOwl:hasRelatedSynonym>
        <obo:has_exact_synonym>VP</obo:has_exact_synonym>
        <oboInOwl:hasRelatedSynonym>acetoin</oboInOwl:hasRelatedSynonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasRelatedSynonym>Voges-Proskauer</oboInOwl:hasRelatedSynonym>
        <obo:definition>An assay used to test for the production of acetoin by a microorganism as a product of glucose metabolism.  Voges-Proskauer broth (containing alpha-naphthol and KOH) is inoculated with the test strain.  A red color indicates a positive result for acetoin; absence of acetoin yields a yellow-brown color and indicates a negative result.</obo:definition>
        <oboInOwl:hasRelatedSynonym>acetoin production</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym>Voges-Proskauer test</oboInOwl:hasExactSynonym>
    </owl:Class>
    



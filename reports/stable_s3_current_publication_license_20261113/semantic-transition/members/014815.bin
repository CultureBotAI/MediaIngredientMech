        </owl:equivalentClass>
        <obo:has_exact_synonym>Magnesium required</obo:has_exact_synonym>
        <obo:has_exact_synonym>Magnesium is required</obo:has_exact_synonym>
        <obo:has_exact_synonym>Mg2+ required</obo:has_exact_synonym>
        <obo:definition>Magnesium (II) ions are required to be present in order for growth of a particular microorganism to occur.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000487 -->


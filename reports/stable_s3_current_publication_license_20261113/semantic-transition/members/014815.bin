    <!-- http://purl.obolibrary.org/obo/MICRO_0000097 -->

    <owl:Class rdf:about="&obo;MICRO_0000097">
        <rdfs:label>slant culture medium</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000070"/>
        <obo:definition>A slant culture is where liquified (melted) solid medium has been added to a sterile test tube and allowed to solidify (cool) at an angle with respect to the horizontal, such that the solid medium surface is at an angle with respect to the sides of the test tube.  The slant culture allows for a larger surface of the agar to be exposed to oxygen.</obo:definition>
    </owl:Class>
    



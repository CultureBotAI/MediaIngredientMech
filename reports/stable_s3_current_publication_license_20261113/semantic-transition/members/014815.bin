        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000167"/>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>Undefined mixture of complex organic compounds derived from animal, fish, plant materials or soil, produced by the process of aqueous extraction (extraction using water, such as hot water).  Used in the cultivation of microorganisms.
</obo:definition>
    </owl:Class>
    



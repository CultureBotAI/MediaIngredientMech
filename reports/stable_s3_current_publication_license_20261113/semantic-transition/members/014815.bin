        <obo:has_exact_synonym>facultative anaerobe
</obo:has_exact_synonym>
        <obo:has_exact_synonym>facultatively anaerobic</obo:has_exact_synonym>
        <obo:has_exact_synonym>facultatively aerobic</obo:has_exact_synonym>
        <obo:IAO_0000119>Wikipedia:facultative_anaerobic_organism

A facultative anaerobic organism is an organism, usually a bacterium, that makes ATP by aerobic respiration if oxygen is present but is also capable of switching to fermentation.  In contrast, obligate anaerobes die in the presence of oxygen.</obo:IAO_0000119>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasRelatedSynonym>facultative anaerobe</oboInOwl:hasRelatedSynonym>
        <obo:definition>A prokaryotic metabolic quality where the organism grows in the presence of oxygen or in the absence of oxygen.</obo:definition>
        <obo:has_exact_synonym>facultative aerobe</obo:has_exact_synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000504 -->

    <owl:Class rdf:about="&obo;MICRO_0000504">
        <rdfs:label>obligately anaerobic</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000495"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001522"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001519"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001523"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001530"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000495"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001523"/>

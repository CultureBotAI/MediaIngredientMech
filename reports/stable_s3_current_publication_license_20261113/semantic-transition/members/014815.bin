        </rdfs:subClassOf>
        <oboInOwl:hasRelatedSynonym>hamadsorption</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>haemadsorb</oboInOwl:hasRelatedSynonym>
        <obo:definition>A microbiological assay for binding to blood cells, where the cell of a microorganism adheres to red blood cells.</obo:definition>
        <oboInOwl:hasRelatedSynonym>hemadsorb</oboInOwl:hasRelatedSynonym>
        <obo:has_exact_synonym>HAd</obo:has_exact_synonym>
        <oboInOwl:hasRelatedSynonym>haemadsorption</oboInOwl:hasRelatedSynonym>
        <obo:IAO_0000119>http://medical-dictionary.thefreedictionary.com/hemadsorption\

hemadsorption /he·mad·sorp·tion/ (hem″ad-sorp´shun) the adherence of red cells to other cells, particles, or surfaces.hemadsor´bent</obo:IAO_0000119>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    



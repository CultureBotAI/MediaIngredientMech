    <!-- http://purl.obolibrary.org/obo/MICRO_0000317 -->

    <owl:Class rdf:about="&obo;MICRO_0000317">
        <rdfs:label>chymotrypsin assay using BTEE</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000672"/>
                    <owl:Restriction>

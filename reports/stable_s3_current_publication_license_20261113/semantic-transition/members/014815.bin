                        <owl:someValuesFrom rdf:resource="&obo;GO_0051301"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:definition>A part of a trichome where rapid cell division occurs.  Meristematic zones, which arise terminally or subterminally, are found in the trichomes of Scytonemataceae, Rivulariaceae, and Microchaetaceae.  Zone involves several cells along the trichome.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    



        </owl:equivalentClass>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>A Berkefeld filterable cell size that is small enough to pass through a Berkefeld filter candle with a smaller pore size V (for Viel).  Pore sizes average 0.38 microns in diameter.  This is the most common filter size used to study the filterability of microorganisms.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MicrO.owl/MICRO_0002544 -->

    <owl:Class rdf:about="&obo;MicrO.owl/MICRO_0002544">
        <rdfs:label xml:lang="en">Berkefeld filterable cell size</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MicrO.owl/MICRO_0002541"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;RO_0000080"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0000601"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>Cell size quality, where the cell has a filterable cell size that is small enough to pass through a Berkefeld filter candle with a defined pore size (e.g. V, N, or W), the largest of which is 0.45 microns.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MicrO.owl/MICRO_0002545 -->

    <owl:Class rdf:about="&obo;MicrO.owl/MICRO_0002545">
        <rdfs:label xml:lang="en">Berkefeld W filterable cell size</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MicrO.owl/MICRO_0002544"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;RO_0000080"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0000604"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:definition>A Berkefeld filterable cell size that is small enough to pass through a Berkefeld filter candle with a wider pore size W (for Wenig).  Pore sizes average 0.45 microns in diameter.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    



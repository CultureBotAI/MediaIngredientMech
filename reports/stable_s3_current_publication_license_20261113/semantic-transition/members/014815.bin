    <owl:Class rdf:about="&obo;MICRO_0000161">
        <rdfs:label>trace elements solution TES</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000455"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>

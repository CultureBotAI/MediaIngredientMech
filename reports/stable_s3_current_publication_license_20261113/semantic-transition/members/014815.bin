        <obo:definition>An assay to determine if a particular microbial taxon or isolate has reactivity towards blood, blood plasma, or blood cells (including clotting).</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    



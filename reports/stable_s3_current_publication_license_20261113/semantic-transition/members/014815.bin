        <obo:definition>An organic-rich, liquid microbiological culture medium containing yeast extract, peptone, and glucose.  Supplemented with Tween 80 (0.02%, aka polysorbate 80).  Used for the cultivation of Bacteroides spp.</obo:definition>
        <obo:has_exact_synonym>PYG-Tween</obo:has_exact_synonym>

        <rdfs:label>sludge fluid for DSMZ Medium 119</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000521"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_17997"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0000201"/>
                    </owl:Restriction>

    <owl:Class rdf:about="&obo;MICRO_0000667">
        <rdfs:label>beta-glucuronidase assay with naphthol AS-BI</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000819"/>

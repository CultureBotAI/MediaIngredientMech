        <obo:definition>An L-arabinofuranosidase assay for the activity of alpha-L-arabinofuranosidase in a microorganism using various chromogenic substrates which carries out the hydrolysis of terminal alpha-L-arabinoside residues in alpha-L-arabinosides.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasRelatedSynonym>alpha-L-arabinofuranosidase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>a-arabinosidase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>alpha-N-arabinofuranosidase</oboInOwl:hasRelatedSynonym>
        <obo:database_cross_reference>Wikipedia:Alpha-N-arabinofuranosidase</obo:database_cross_reference>

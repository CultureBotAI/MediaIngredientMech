        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0000032"/>
                <owl:someValuesFrom rdf:resource="&obo;PATO_0002436"/>

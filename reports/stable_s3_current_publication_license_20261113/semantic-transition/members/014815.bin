        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_131361"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_32145"/>

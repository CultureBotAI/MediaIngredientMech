            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>An assay for the ability of a microorganism to make collagenase.  Collagenase ia a protease enzyme that hydrolyzes peptide bonds in collagen (a protein in connective tissues of animals).  Are secreted enzymes by some pathogens.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001000 -->

    <owl:Class rdf:about="&obo;MICRO_0001000">
        <rdfs:label>L-cysteine arylamidase assay</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0001020"/>
                    <owl:Restriction>

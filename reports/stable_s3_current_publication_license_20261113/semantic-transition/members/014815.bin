        <obo:has_exact_synonym>APH medium</obo:has_exact_synonym>
        <obo:definition>A minerals-salts, liquid culture medium comprised of ammonium sulfate, potassium phosphate, magnesium sulfate, potassium chloride, calcium nitrate, and ferrous sulfate.</obo:definition>
    </owl:Class>
    



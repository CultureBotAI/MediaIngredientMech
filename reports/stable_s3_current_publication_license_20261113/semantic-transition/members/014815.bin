            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>A prokaryotic quality relating the optimal physiological preference (pressure, salinity, temperature) of a particular strain of prokaryotes.  When these preferred conditions are met, the organism will exhibit cell division.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000485 -->

    <owl:Class rdf:about="&obo;MICRO_0000485">
        <rdfs:label>barophilic</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0001317"/>

    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000062 -->

    <owl:Class rdf:about="&obo;MICRO_0000062">
        <rdfs:label>Berkefeld N filter</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000104"/>

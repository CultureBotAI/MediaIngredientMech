                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001465"/>
                        <owl:someValuesFrom rdf:resource="&obo;PATO_0000616"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;RO_0002180"/>
                        <owl:onClass rdf:resource="&obo;GO_0009288"/>

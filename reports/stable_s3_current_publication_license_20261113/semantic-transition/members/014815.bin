                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_50385"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0001168"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0000065"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_50385"/>

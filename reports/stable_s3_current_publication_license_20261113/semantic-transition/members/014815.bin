                                                            <rdfs:Datatype>
                                                                <owl:onDatatype rdf:resource="&xsd;float"/>
                                                                <owl:withRestrictions rdf:parseType="Collection">
                                                                    <rdf:Description>
                                                                        <xsd:maxInclusive rdf:datatype="&xsd;float">0.38</xsd:maxInclusive>
                                                                    </rdf:Description>
                                                                </owl:withRestrictions>
                                                            </rdfs:Datatype>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>

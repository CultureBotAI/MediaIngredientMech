                                                <owl:complementOf rdf:resource="&obo;PATO_0002259"/>
                                            </owl:Class>
                                        </owl:allValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0001543"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0000032"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&obo;PATO_0001234"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&obo;MICRO_0000032"/>
                                <owl:allValuesFrom>
                                    <owl:Class>
                                        <owl:complementOf rdf:resource="&obo;PATO_0002259"/>
                                    </owl:Class>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>apoheterocytic</obo:has_exact_synonym>
        <obo:definition>An akinete that isdistally located from the heterocytes.  May occur multiply in chains that, in the absence of combined nitrogen, are initiated at a site that is equidistant from two intercalary or terminal heterocysts.</obo:definition>
        <obo:has_exact_synonym>akinetes distant from heterocysts</obo:has_exact_synonym>
        <obo:IAO_0000119>Rippka, Castenholz &amp; Herdman, 2001, in Bergeys Manual of Systematic Bacteriology, v. 1, 2nd ed., pg 563.</obo:IAO_0000119>
    </owl:Class>
    



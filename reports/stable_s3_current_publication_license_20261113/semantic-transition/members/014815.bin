</obo:definition>
        <obo:has_exact_synonym>sarcinoid</obo:has_exact_synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000372 -->

    <owl:Class rdf:about="&obo;MICRO_0000372">
        <rdfs:label>cell cluster</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&obo;MICRO_0000523"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&obo;RO_0000086"/>
                                <owl:someValuesFrom rdf:resource="&obo;PATO_0001629"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;RO_0002354"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&obo;MICRO_0001297"/>
                                    <rdf:Description rdf:about="&obo;MICRO_0001298"/>

            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000523"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;RO_0002354"/>
                <owl:someValuesFrom rdf:resource="&obo;MICRO_0001295"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:createdBy>Carrine Blank
</obo:createdBy>
        <oboInOwl:hasBroadSynonym>chains</oboInOwl:hasBroadSynonym>
        <obo:definition>A multicellular relationship of prokaryotic cells where cells are attached to one another end-to-end to form chains.  Forms when cell division occurs in one plane and cells become detached after cell division takes place.</obo:definition>
        <obo:has_exact_synonym>short chains
</obo:has_exact_synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000374 -->

    <owl:Class rdf:about="&obo;MICRO_0000374">
        <rdfs:label>tetrad</rdfs:label>

        <oboInOwl:hasRelatedSynonym>gamma-glutamic acid arylamidase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>g-glutamyltranferase</oboInOwl:hasRelatedSynonym>

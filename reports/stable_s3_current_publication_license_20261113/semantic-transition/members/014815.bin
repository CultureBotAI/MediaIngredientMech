                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_16836"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <oboInOwl:hasRelatedSynonym>p-nitrophenyl-b-D-mannopyranoside</oboInOwl:hasRelatedSynonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>bMAN</obo:has_exact_synonym>
        <oboInOwl:hasRelatedSynonym>4-nitrophenyl-beta-D-mannoside</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4-nitrophenyl-beta-D-mannopyranoside</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4-nitrophenyl-b-D-mannoside</oboInOwl:hasRelatedSynonym>
        <obo:definition>A carbohydrate hydrolysis assay for the activity of beta-mannosidase in a microorganism using the substrate 4-nitrophenyl-beta-D-mannopyranoside.  beta-Mannosidase activity (catalyzing the hydrolysis of terminal non-reducing beta-D-mannose residues in beta-D-mannosides) will cleave the substrate, producing 4-nitrophenol which is yellow.  

A positive result is yellow; a negative result is colorless.</obo:definition>
        <oboInOwl:hasRelatedSynonym>4-nitrophenyl-b-D-mannopyranoside</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>p-nitrophenyl-beta-D-mannopyranoside</oboInOwl:hasRelatedSynonym>
    </owl:Class>
    



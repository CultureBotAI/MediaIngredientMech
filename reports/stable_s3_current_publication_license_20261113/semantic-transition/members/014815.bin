                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001531"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000491"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001523"/>
                <owl:someValuesFrom rdf:resource="&obo;MICRO_0001531"/>

    <!-- http://purl.obolibrary.org/obo/MICRO_0000055 -->

    <owl:Class rdf:about="&obo;MICRO_0000055">
        <rdfs:label>calyptra</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000134"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;BFO_0000050"/>

    <!-- http://purl.obolibrary.org/obo/MICRO_0000969 -->

    <owl:Class rdf:about="&obo;MICRO_0000969">
        <rdfs:label>Ellmans assay</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;OBI_0000070"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0000065"/>
                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_86228"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001215"/>
                        <owl:someValuesFrom rdf:resource="&obo;GO_0006750"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001391"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001591"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasRelatedSynonym>Ellman</oboInOwl:hasRelatedSynonym>
        <obo:definition>An assay for measuring the presence of low molecular weight thiols (such as glutatione) in liquid solutions, blood, or microbiological cultures.  Uses Ellman&apos;s reagent (5-5&apos;-dithiobis-(2-nitrobenzoic acid); DTNB) -  a chromogenic agent containing a disulfide bond.  The substrate reacts with small molecule thiols (e.g. glutathione) and reduce the disulfide bonds, releasing 3-thio-6-nitrobenzoate.  At neutral or alkaline pH the product spontaneously ionizes, resulting in a yellow color.

A positive result is yellow; a negative result is colorless.</obo:definition>
        <obo:has_exact_synonym>ELLM</obo:has_exact_synonym>
        <obo:IAO_0000119>Wikipedia:Ellman&apos;s_reagent</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym>Ellman&apos;s reagent</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasExactSynonym>Ellman&apos;s assay</oboInOwl:hasExactSynonym>
    </owl:Class>
    



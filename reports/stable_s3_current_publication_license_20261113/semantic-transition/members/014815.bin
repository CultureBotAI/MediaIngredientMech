    <!-- http://purl.obolibrary.org/obo/MICRO_0000998 -->

    <owl:Class rdf:about="&obo;MICRO_0000998">
        <rdfs:label>milk coagulation upon boiling assay</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_000997"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0000940"/>

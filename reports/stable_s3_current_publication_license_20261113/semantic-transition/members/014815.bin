    <!-- http://purl.obolibrary.org/obo/MicrO.owl/MICRO_0003612 -->

    <owl:Class rdf:about="&obo;MicrO.owl/MICRO_0003612">
        <rdfs:label>N-acetyl-beta-glucosaminidase assay with BrNaphthol</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000820"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001197"/>
                        <owl:someValuesFrom rdf:resource="&obo;MicrO.owl/temp_0000211"/>
                    </owl:Restriction>

    <owl:Class rdf:about="&obo;MICRO_0001008">
        <rdfs:label>glutamyl glycine arylamidase assay</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000846"/>
                    <owl:Restriction>

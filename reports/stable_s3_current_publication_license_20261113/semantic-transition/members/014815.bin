                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001658"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&obo;CHEBI_17997"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="&obo;MICRO_0001244"/>
                                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_16526"/>
                                    </owl:Restriction>

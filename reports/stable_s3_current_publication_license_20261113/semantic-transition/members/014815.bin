    <owl:Class rdf:about="&obo;MICRO_0000512">
        <rdfs:label>chemolithoheterotrophy</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">

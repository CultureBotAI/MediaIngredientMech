    <!-- http://purl.obolibrary.org/obo/MICRO_0001295 -->

    <owl:Class rdf:about="&obo;MICRO_0001295">
        <rdfs:label>cell division in one plane</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;GO_0051301"/>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>A cell division pattern where the plane of cell division is always parallel to the previous plane of cell division.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001296 -->

    <owl:Class rdf:about="&obo;MICRO_0001296">
        <rdfs:label>cell division in two planes</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;GO_0051301"/>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>A cell division pattern where the plane of cell division can occur in two planes, both at right angles to one another.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001297 -->

    <owl:Class rdf:about="&obo;MICRO_0001297">
        <rdfs:label>cell division in three planes</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;GO_0051301"/>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>A cell division pattern where the plane of cell division can occur in three planes, all three being orthogonal (at right angles) to each other.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001298 -->

    <owl:Class rdf:about="&obo;MICRO_0001298">
        <rdfs:label>cell division in random planes</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;GO_0051301"/>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>A cell division pattern where the plane of cell division can occur in random planes.</obo:definition>
    </owl:Class>
    



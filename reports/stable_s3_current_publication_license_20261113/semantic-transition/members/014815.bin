        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001595 -->

    <owl:Class rdf:about="&obo;MICRO_0001595">
        <rdfs:label>prokaryotic clonal liquid culture</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0001591"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0000069"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001593"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:definition>A prokaryotic cultured clonal cell population housed in a test tube which uses a culture tube with liquid culture medium as a substrate to support growth.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    



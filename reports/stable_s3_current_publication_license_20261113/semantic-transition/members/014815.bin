        </owl:equivalentClass>
        <obo:createdBy>Carrine Blank
</obo:createdBy>
        <obo:definition>A colony having distinct physical quality that manifests in the electromagnetic (EM) radiation appearance of the colony.</obo:definition>
    </owl:Class>
    



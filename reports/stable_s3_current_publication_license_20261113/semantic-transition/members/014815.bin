                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:has_exact_synonym>cell clusters</obo:has_exact_synonym>
        <obo:definition>A multicellular relationship of prokaryotic cells where cells are attached to one another end-to-end and side-to-side to form clumps or sheets after dividing.  This morphology forms as a result of cell division taking place in multiple planes.</obo:definition>
        <obo:has_exact_synonym>clusters</obo:has_exact_synonym>
        <obo:has_exact_synonym>packet-like</obo:has_exact_synonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>packets</obo:has_exact_synonym>
        <obo:has_exact_synonym>clumps</obo:has_exact_synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000373 -->

    <owl:Class rdf:about="&obo;MICRO_0000373">
        <rdfs:label>cell chain</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000523"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;RO_0002354"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001295"/>

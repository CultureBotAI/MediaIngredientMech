        <obo:definition>RapID™ ANA II System, a set of specialized identification kits that contain 32 reagents designed to identify particular types of microorganisms.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001597 -->

    <owl:Class rdf:about="&obo;MICRO_0001597">
        <rdfs:label>fildes enrichment</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0001233"/>
        <rdfs:subClassOf>

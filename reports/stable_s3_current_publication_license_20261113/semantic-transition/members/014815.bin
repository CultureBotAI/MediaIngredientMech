    <owl:Class rdf:about="&obo;MICRO_0000629">
        <rdfs:label>citrate fermentation/oxidation assay</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000689"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0000735"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001190"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <oboInOwl:hasNarrowSynonym>citrate utilization test</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>Simmons citrate test</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>citrate test</oboInOwl:hasNarrowSynonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasNarrowSynonym>Simmons&apos; citrate test</oboInOwl:hasNarrowSynonym>
        <obo:definition>Uses Simmons&apos; citrate agar containing citrate.  Microorganisms able to metabolize citrate change the pH of the medium through the production of sodium bicarbonate and ammonia, resulting in an alkaline pH (resulting in a change in the pH indicator, bromthymol blue).  

A positive reaction (alkaline pH) results in a blue (or blue-green) color; a negative reaction (neutral pH) results in a green (or pale green/yellow) color.</obo:definition>
        <obo:has_exact_synonym>CIT</obo:has_exact_synonym>
        <obo:database_cross_reference>Wikipedia:Citrate_test</obo:database_cross_reference>
        <oboInOwl:hasBroadSynonym>citrate utilization</oboInOwl:hasBroadSynonym>
    </owl:Class>
    



    <owl:NamedIndividual rdf:about="&obo;MICRO_0001553">
        <rdfs:label>percent</rdfs:label>
        <obo:definition>A measurement of concentration of solution in weight per 100 g (w/w), or in weight per 100 mL (w/v).</obo:definition>
        <oboInOwl:created_by>Carrine Blank</oboInOwl:created_by>
    </owl:NamedIndividual>
    



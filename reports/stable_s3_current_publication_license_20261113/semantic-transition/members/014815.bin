        <obo:has_exact_synonym>produce CH4</obo:has_exact_synonym>
        <obo:has_exact_synonym>methane produced</obo:has_exact_synonym>
        <obo:has_exact_synonym>CH4 produced</obo:has_exact_synonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>forming methane</obo:has_exact_synonym>

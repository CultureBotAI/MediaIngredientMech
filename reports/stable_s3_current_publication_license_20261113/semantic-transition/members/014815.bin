                <owl:someValuesFrom rdf:resource="&obo;MICRO_0001359"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="&obo;MICRO_0000489"/>
        <obo:IAO_0000119>Wikipedia:piezophile

Barophilic microorganisms grow at high pressures.  They are typically isolated from deep subsurface or deep sea habitats.</obo:IAO_0000119>
        <obo:definition>Pressure optimum quality, where growth rates at elevated pressures are higher than growth rates at atmospheric pressure.  Generally a characteristic of prokaryotic microorganisms that grow in the deep oceans.</obo:definition>
        <obo:has_exact_synonym>piezophile</obo:has_exact_synonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>piezophilic</obo:has_exact_synonym>
        <obo:has_exact_synonym>barophile</obo:has_exact_synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000486 -->

    <owl:Class rdf:about="&obo;MICRO_0000486">
        <rdfs:label>requires magnesium for growth</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000690"/>

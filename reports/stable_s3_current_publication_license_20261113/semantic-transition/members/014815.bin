            </owl:Class>
        </owl:equivalentClass>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>An extract made from cellular paste from the culture of Chlorella spp., used for the culturing of microorganisms.  Chlorella is a microscopic green alga in the Trebouxiophyceae.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000195 -->


    <owl:Class rdf:about="&obo;MICRO_0000251">
        <rdfs:label>yeast extract tryptone medium</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">

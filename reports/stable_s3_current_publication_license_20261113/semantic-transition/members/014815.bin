    <!-- http://purl.obolibrary.org/obo/MICRO_0001453 -->

    <owl:Class rdf:about="&obo;MICRO_0001453">
        <rdfs:label>lithotrophy</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000496"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001461"/>

    <!-- http://purl.obolibrary.org/obo/MICRO_0000459 -->

    <owl:Class rdf:about="&obo;MICRO_0000459">
        <rdfs:label>microbiological gelling agent</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;CHEBI_33232"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001245"/>
                <owl:someValuesFrom rdf:resource="&obo;MICRO_0000070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:definition>A polymeric organic compound or mix of organic compounds which are liquid under autoclave conditions but solidify under the growth conditions used to cultivate a microorganism.  Used to make solid microbiological culture media.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000460 -->

    <owl:Class rdf:about="&obo;MICRO_0000460">

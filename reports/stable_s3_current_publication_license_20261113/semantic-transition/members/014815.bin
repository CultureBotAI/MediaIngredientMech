    <!-- http://purl.obolibrary.org/obo/MICRO_0000822 -->

    <owl:Class rdf:about="&obo;MICRO_0000822">
        <rdfs:label>hippurate assay</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;OBI_0000070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001199"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_18089"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001391"/>
                <owl:someValuesFrom rdf:resource="&obo;MICRO_0001591"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0000065"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_86374"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001200"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_15428"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasRelatedSynonym>hippuric acid</oboInOwl:hasRelatedSynonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>HIP</obo:has_exact_synonym>
        <oboInOwl:hasRelatedSynonym>hippurate hydrolysed</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hippuric acid test</oboInOwl:hasRelatedSynonym>
        <obo:has_exact_synonym>hippurate test</obo:has_exact_synonym>
        <obo:definition>An assay for the hydrolysis of hippuric acid (benzoylaminoethanoic acid; N-benzoylglycine) in a microorganism.  The test uses ninhydrin as a color indicator.  Hippuric acid hydrolysis releases glycine, which reacts with ninhydrin (colorless) to form a purple color.

A positive test result is dark blue/violet; a negative test result is colorless/pale blue/blueish-grey.</obo:definition>
        <oboInOwl:hasRelatedSynonym>hippurate hydrolysis</oboInOwl:hasRelatedSynonym>
    </owl:Class>
    



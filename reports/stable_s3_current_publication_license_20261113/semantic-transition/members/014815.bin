                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&obo;GO_0031176"/>
                                    <rdf:Description rdf:about="&obo;GO_0033905"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000850"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001197"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_37166"/>
            </owl:Restriction>
        </rdfs:subClassOf>

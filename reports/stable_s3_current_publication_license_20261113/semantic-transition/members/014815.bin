                <owl:onProperty rdf:resource="&obo;MICRO_0001522"/>
                <owl:someValuesFrom rdf:resource="&obo;MICRO_0001514"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:IAO_0000119>Wikipedia:aerobic organism

An aerobic organism or aerobe is an organism that can survive and grow in an oxygenated environment.  Facultative anaerobes grow and survive in an oxygenated environment and so do aerotolerant anaerobes.</obo:IAO_0000119>
        <obo:has_exact_synonym>aerobic</obo:has_exact_synonym>
        <obo:definition>A prokaryotic metabolic quality where the organism grows in the presence of oxygen.</obo:definition>
        <obo:has_exact_synonym>aerobically</obo:has_exact_synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000495 -->

    <owl:Class rdf:about="&obo;MICRO_0000495">
        <rdfs:label>anaerobic</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000491"/>
                    <owl:Restriction>

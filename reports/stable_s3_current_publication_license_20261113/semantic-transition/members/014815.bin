    <!-- http://purl.obolibrary.org/obo/MicrO.owl/MICRO_0002073 -->

    <owl:Class rdf:about="&obo;MicrO.owl/MICRO_0002073">
        <rdfs:label>DSMZ Medium 215c.2</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000067"/>
                    <owl:Restriction>

        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001522"/>
                <owl:someValuesFrom rdf:resource="&obo;MICRO_0001519"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:has_exact_synonym>obligate anaerobic</obo:has_exact_synonym>
        <obo:IAO_0000119>Wikipedia:obligate_anaerobe

Obligate anaerobes are microorganisms that live and grow in the absence of molecular oxygen; some of these are killed by oxygen.</obo:IAO_0000119>
        <obo:has_exact_synonym>strictly anoxic</obo:has_exact_synonym>
        <obo:has_exact_synonym>strictly anaerobic</obo:has_exact_synonym>
        <obo:has_exact_synonym>obligately anaerobic</obo:has_exact_synonym>
        <obo:definition>A prokaryotic metabolic quality where the organism grows in the absence of oxygen.  Cannot grow or live in the presence of oxygen.</obo:definition>
        <obo:has_exact_synonym>obligatory anaerobic</obo:has_exact_synonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000505 -->

    <owl:Class rdf:about="&obo;MICRO_0000505">
        <rdfs:label>chemolithotrophy</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000496"/>
                    <owl:Restriction>

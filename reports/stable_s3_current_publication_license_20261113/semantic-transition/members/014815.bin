                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0000323"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000846"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001206"/>
                <owl:someValuesFrom rdf:resource="&obo;MICRO_0000323"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001198"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_88330"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001197"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_90728"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasRelatedSynonym>glutamyl glycine arylamidase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>glutamyl glycine aminopeptidase</oboInOwl:hasRelatedSynonym>
        <obo:definition>An amino acid arylamidase assay that assays for glutamyl glycine arylamidase activity.  Uses the substrate L-glutamyl-glycine-2-naphthylamide at pH 7.5.  Glutamyl glycine arylamidase activity (which could be from glutamyl glycine aminopeptidase as well as other dipeptidase enzymes) will cleave the substrate, releasing 2-naphthylamide.  When reacted with Fast Blue BB it forms a colored insoluble precipitate that is orange in color.

A positive reaction is orange; a negative reaction is colorless.

</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    



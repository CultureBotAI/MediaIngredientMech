        <obo:IAO_0000119>From: http://www.hopebiol.com/medium/p13HB0398.htm

Formula:(g/L)
peptone    20.0g
glucose    5.0g
Baptist yeast powder    10.0g
NaCl    0.08g
Cysteine hydrochloride    0.5g
Calcium chloride    0.008g
MgSO4    0.008g
K2HPO4    0.04g
KH2PO4    0.04g
sodium bicarbonate    0.4g
PH  7.1-7.3 </obo:IAO_0000119>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:has_exact_synonym>PYG</obo:has_exact_synonym>
        <obo:has_exact_synonym>PYG broth base</obo:has_exact_synonym>
        <obo:definition>An organic-rich, liquid microbiological culture medium containing peptone, glucose, and yeast powder.  Also contains minerals salts.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001574 -->

    <owl:Class rdf:about="&obo;MICRO_0001574">
        <rdfs:label>yeast powder</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000167"/>
                    <owl:Restriction>

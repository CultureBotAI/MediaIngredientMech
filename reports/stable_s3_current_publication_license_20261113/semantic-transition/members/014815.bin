                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&obo;CHEBI_15741"/>
                            <rdf:Description rdf:about="&obo;CHEBI_30031"/>
                            <rdf:Description rdf:about="&obo;CHEBI_30779"/>

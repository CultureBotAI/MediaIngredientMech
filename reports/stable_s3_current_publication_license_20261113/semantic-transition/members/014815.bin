    <!-- http://purl.obolibrary.org/obo/MICRO_0000233 -->

    <owl:Class rdf:about="&obo;MICRO_0000233">
        <rdfs:label>polyphosphate granule</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000228"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_16838"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>

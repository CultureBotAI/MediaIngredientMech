                        <owl:someValuesFrom rdf:resource="&obo;CHEBI_90091"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:definition>Chymotrypsin assay that uses the substrate N-Benzoyl-L-tyrosine ethyl ester (BTEE).  Chymotrypsin activity will cleave the substrate, releasing N-Benzoyl-L-tyrosine.  The presence of this produce is measured by recording the increase in absorbance at 256 nm.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000318 -->

    <owl:Class rdf:about="&obo;MICRO_0000318">
        <rdfs:label>chymotrypsin assay using N-benzoyl-Phe-pNA</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000672"/>
                    <owl:Restriction>

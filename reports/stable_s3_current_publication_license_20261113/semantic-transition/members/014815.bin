    <!-- http://purl.obolibrary.org/obo/MICRO_0001365 -->

    <owl:Class rdf:about="&obo;MICRO_0001365">
        <rdfs:label>lactalbumin hydrolysate</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000465"/>
        <oboInOwl:hasRelatedSynonym>edamin</oboInOwl:hasRelatedSynonym>
        <obo:definition>An enzymatic hydrolysate of lactalbumin (a milk protein from cow&apos;s milk, Bos taurus) made using hydrolytic enzymes, used for the culturing of microorganisms.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasRelatedSynonym>http://www.neogen.com/Acumedia/pdf/ProdInfo/7465_PI.pdf

Intended Use
Lactalbumin Hydrolysate is an enzymatic digest of lactalbumin for use in preparing microbiological culture media.

Principles of the Procedure
Lactalbumin Hydrolysate provides nitrogen, amino acids, vitamins, and carbon in microbiological culture media.</oboInOwl:hasRelatedSynonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001366 -->

    <owl:Class rdf:about="&obo;MICRO_0001366">
        <rdfs:label>casein hydrolysate</rdfs:label>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000465"/>
        <obo:definition>Microbiological medium ingredient, derived from enzymatic hydrolysis of milk protein.  An enzymatic hydrolysate of casein (a milk protein from cow&apos;s milk, Bos taurus), used for the culturing of microorganisms.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    



                        <owl:someValuesFrom rdf:resource="&obo;MicrO.owl/temp_0000202"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <obo:has_exact_synonym>GGT</obo:has_exact_synonym>
        <oboInOwl:hasRelatedSynonym>L-glutamic acid gamma-(4-nitroanilide)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gamma-L-glutamate-p-nitroanilide</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>γ-Glutamyl ρ-nitroanilide</oboInOwl:hasRelatedSynonym>
        <obo:definition>An amino acid arylamidase assay that measures the activity of gamma glutamyl transferase using  L-glutamic acid gamma-(4-nitroanilide).  Gamma-glutamyl transferase activity cleaves the substrate, releasing p-nitroaniline which is bright yellow in color.

A positive test is yellow; a negative test is colorless.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    



    <owl:Class rdf:about="&obo;MICRO_0001020">
        <rdfs:label>alpha-amino acid arylamidase assay</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000846"/>

        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0000208"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0000940"/>
                <owl:someValuesFrom rdf:resource="&obo;PATO_0002277"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasBroadSynonym>irridescent</oboInOwl:hasBroadSynonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasBroadSynonym>irridescence</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>opalescence</oboInOwl:hasBroadSynonym>
        <obo:definition>The optical quality of a liquid culture of clonal prokaryotic organisms, which exhibits opalescent turbidity (refracting different wavelengths of light under white light illumination, or iridescence) after gentle shaking.</obo:definition>
    </owl:Class>
    



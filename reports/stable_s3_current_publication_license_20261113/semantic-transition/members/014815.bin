                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&obo;MICRO_0001002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001198"/>
                <owl:someValuesFrom rdf:resource="&obo;CHEBI_17224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&obo;MICRO_0001206"/>
                <owl:someValuesFrom rdf:resource="&obo;GO_0031217"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasRelatedSynonym> 4-methylumbelliferylcellobiopyranoside</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cellulose 1,4-beta-cellobiosidase</oboInOwl:hasRelatedSynonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasRelatedSynonym>4-methylumbelliferyl-cellobiopyranoside</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>exo-1,4-beta-D-glucanase</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1,4-beta-bellobiohydrolase</oboInOwl:hasRelatedSynonym>
        <obo:definition>Test for the presence of exocellulase.  Exocellulase is a hydrolytic enzyme that cleaves two or four units from the ends of exposed chains of beta-D-glucan (such as cellulose).  Uses  4-methylumbelliferyl beta-D-glucopyranoside as a substrate.  Results in the formation of tetra-, or di-saccharides and 4-methylumbelliferone.</obo:definition>
    </owl:Class>
    



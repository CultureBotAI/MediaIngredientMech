            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:hasBroadSynonym>transparent</oboInOwl:hasBroadSynonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <oboInOwl:hasBroadSynonym>clear</oboInOwl:hasBroadSynonym>
        <obo:has_exact_synonym>transparent colony</obo:has_exact_synonym>

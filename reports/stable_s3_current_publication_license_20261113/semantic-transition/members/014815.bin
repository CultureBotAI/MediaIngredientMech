                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="&obo;PATO_0000921"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="&obo;MICRO_0001469"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="&obo;IAO_0000039"/>
                                                <owl:hasValue rdf:resource="&obo;MICRO_0000428"/>
                                            </owl:Restriction>

        </rdfs:subClassOf>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>A gravity-driven water filter made by the British Berkefeld® company, with a narrow pore size V (for Viel).  Pore sizes average 0.38 microns in diameter.  This is the most common filter size used to study the filterability of microorganisms.</obo:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000443 -->

    <owl:Class rdf:about="&obo;MICRO_0000443">
        <rdfs:label>intracellular storage of carbon</rdfs:label>

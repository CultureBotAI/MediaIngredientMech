    <!-- http://purl.obolibrary.org/obo/MICRO_0000408 -->

    <owl:Class rdf:about="&obo;MICRO_0000408">
        <rdfs:label>prosthecate cell</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000400"/>
                    <owl:Restriction>

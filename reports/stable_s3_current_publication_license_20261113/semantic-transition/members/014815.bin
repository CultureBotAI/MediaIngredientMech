                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0001371"/>
                        <owl:someValuesFrom rdf:resource="&obo;UBERON_0010228"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;RO_0002354"/>
                        <owl:someValuesFrom>

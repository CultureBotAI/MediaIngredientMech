                                    <rdf:Description rdf:about="&obo;NCBITaxon_1161"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0000035"/>
                        <owl:someValuesFrom>

    <!-- http://purl.obolibrary.org/obo/MICRO_0001363 -->

    <owl:Class rdf:about="&obo;MICRO_0001363">
        <rdfs:label>liver extract</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">

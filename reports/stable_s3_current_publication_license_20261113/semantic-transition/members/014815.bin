    <owl:Class rdf:about="&obo;MICRO_0000449">
        <rdfs:label>alpha-hemolysis assay</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">

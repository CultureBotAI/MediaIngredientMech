            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&obo;MICRO_0000392"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;BFO_0000050"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&obo;NCBITaxon_1182"/>
                                    <rdf:Description rdf:about="&obo;NCBITaxon_1185"/>
                                    <rdf:Description rdf:about="&obo;NCBITaxon_119859"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;MICRO_0000032"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="&obo;PATO_0002475"/>
                                    <rdf:Description rdf:about="&obo;PATO_0002476"/>

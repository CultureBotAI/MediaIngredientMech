                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&obo;BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="&obo;MICRO_0001191"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:has_exact_synonym>MNT</obo:has_exact_synonym>
        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>Assays for the ability of a microorganism to utilize malonate.</obo:definition>
    </owl:Class>
    



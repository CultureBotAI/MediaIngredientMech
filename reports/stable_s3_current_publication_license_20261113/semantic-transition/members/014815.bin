        <obo:createdBy>Carrine Blank</obo:createdBy>
        <obo:definition>Micrometers (or microns), a measurement of length, 10^-6 of a meter.</obo:definition>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0001473 -->

    <owl:NamedIndividual rdf:about="&obo;MICRO_0001473">
        <rdfs:label>Carrine Blank</rdfs:label>
    </owl:NamedIndividual>
    



        <obo:has_exact_synonym>striated steath</obo:has_exact_synonym>
        <obo:has_exact_synonym>lamillated sheath</obo:has_exact_synonym>
        <obo:definition>A sheath having a layered, laminated (i.e., laminar) structure.</obo:definition>
        <obo:has_exact_synonym>striated sheathed structure</obo:has_exact_synonym>

        <owl:disjointWith rdf:resource="&obo;MICRO_0000365"/>
        <obo:definition>A lipase that hydrolyzes C14 compounds.  Assayed using the chromogenic substrate 2-naphthyl myristate.</obo:definition>
        <obo:createdBy>Carrine Blank</obo:createdBy>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MICRO_0000365 -->


  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Adjust pH to 7.0 -- 7.2. Autoclave at 115C for 20 min. Separately sterilize Solution B by filtration and add to the medium aseptically."
    },
    {
      "paragraph_index": 5,
      "comment": "Mix and filter-sterilize just before addition to the medium."
    },
    {
      "paragraph_index": 7,
      "comment": "Prepare just before use."
    }
  ]

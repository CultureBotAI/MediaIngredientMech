from pathlib import Path
import copy,datetime,hashlib,json,subprocess
R=Path.cwd();C=R.parents[2];O=R/'.temp/gyps-native-origin-v1';S=O/'lineage-review';P=R/'reports/all_unmatched_20261107/worker-03/successors/issue1176-dependencies-v1';W=C/'workers/w05/worktree';CID='KG_CASE:ba039f9e4a33baf69eb111ceb979cf6c9ad8fe788c13488f256336508ce94151';PID='W03-DEP-1176-GYPS';W03HEAD='784ee2541506c914b4c34f091de688d39784d548';OLD='108e213e96f7d423ee345ce265d692e79063127c';CURRENT='a43ada344e30ddf5843dd3dddc3b3fafbe29cedd'
def require(v,m):
 if not v: raise ValueError(m)
def sha(b):return hashlib.sha256(b).hexdigest()
def canon(x):return json.dumps(x,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()
def git(w,*args):return subprocess.check_output(['git','-C',str(w),*args])
def pin(p):return {'path':str(p.relative_to(R)) if p.is_relative_to(R) else str(p),'sha256':sha(p.read_bytes())}
proof=json.loads((S/'lineage-proof-v1.json').read_bytes());original_prop=json.loads((S/'original-W05-parent-proposal.json').read_bytes());original_dec=json.loads((S/'original-W05-parent-decision.json').read_bytes());old_sidecar=json.loads((S/'original-W03-GYPS-sidecar-object.json').read_bytes());fullcase=json.loads((S/'global-causal-case.json').read_bytes());globalcases=json.loads((C/'queue/preliminary-v5/union-ledger.json').read_bytes());case=next(x for x in globalcases if x['case_id']==CID);require(canon(case)==canon(fullcase),'globalcase capture drift');casehash=sha(canon(case))
expected_before=(P/'inputs/before/GYPS.yaml').read_bytes();expected_after=(P/'payloads-v2/GYPS.yaml').read_bytes();require(git(R,'show',W03HEAD+':'+str((P/'payloads-v2/GYPS.yaml').relative_to(R)))==expected_after,'published GYPS drift')
require((O/'payloads/GYPS.yaml').read_bytes()==expected_after,'candidate scientific bytes differ')
require((R/'data/ingredients/mapped/GYPS.yaml').read_bytes()==expected_before,'maintainedbefore differs')
shard03=json.loads((C/'queue/preliminary-v5/shards/shard-03.json').read_bytes());shard05=json.loads((C/'queue/preliminary-v5/shards/shard-05.json').read_bytes());s3={c['case_id'] for c in shard03['cases']};s5={c['case_id'] for c in shard05['cases']};require(CID not in s3 and CID in s5,'wrongcausalshard')
def verify(doc,context,payload=expected_after):
 require(isinstance(doc,dict) and len(doc.get('proposals',[]))==1,'one authentic GYPS proposal required');p=doc['proposals'][0]
 require(p['proposal_id']==PID,'proposal identity differs');require(p['kind']=='edit_existing_owner','existing-owner kind required');require(p['owner_path']=='data/ingredients/mapped/GYPS.yaml','owner differs');require(p['before_sha256']==sha(expected_before),'real maintained preimage differs');require(p['after_capture']=={'root':'artifact','path':'payloads/GYPS.yaml','sha256':sha(expected_after)},'reviewed payload binding differs');require(sha(payload)==sha(expected_after),'actual payload bytes differ')
 require(p['case_ids']==[CID],'case_ids not exact realcausalparent');rel=p['case_relationships'];require(len(rel)==1,'case relationship cardinality');rel=rel[0]
 require(rel['case_id']==CID and rel['case_input_sha256']==casehash,'causalcase hash differs');require(rel['relationship']=='causal_parent_identity_transition_only','false case relationship');require(rel['assigned_worker_slot']=='worker-05' and rel['is_assigned_W03_case'] is False,'foreigncase falsely claimed W03assigned');require(rel['is_GYPS_recipe_observation'] is False and rel['adds_occurrence'] is False,'false child observation/occurrence')
 require(p['native_source_core_member'] is False,'false originalcore membership')
 for k in ['assigned_W03_case_ids','observed_GYPS_case_ids','added_source_case_ids','added_occurrence_ids']:require(p[k]==[],'invented assignment/observation: '+k)
 cp=p['causal_parent_provenance'];require(cp['complete_original_proposal']==original_prop and cp['proposal_object_sha256']==sha(canon(original_prop)),'complete foreign proposal altered');require(cp['original_published_head']==OLD and cp['worker_slot']=='worker-05','foreign source head/owner erased');require(cp['original_authors']=={k:original_prop[k] for k in ['primary_author','parent_successor_author','direct_term_successor_author']},'foreign authors altered');require(cp['case_id']==CID and cp['case_input_sha256']==casehash,'foreign case hash differs');require(cp['source_decision_object_sha256']==sha(canon(original_dec)),'foreign decision digest differs');require(cp['original_proposal_backlinks']==original_dec['proposal_ids'],'foreign decisionbacklink altered');require(cp['new_GYPS_backlink_in_foreign_decision_claimed'] is False,'fabricated originalbacklink')
 capture=cp['complete_source_decision_capture'];require(sha((O/capture['path']).read_bytes())==capture['sha256'] and json.loads((O/capture['path']).read_bytes())==original_dec,'foreign source decision capture differs')
 for label,b in cp['current_unchanged_head_bridge'].items():
  require(b['old_head']==OLD and b['observed_current_local_head']==CURRENT and b['byte_identical'] is True,'headbridge altered')
  a=git(W,'show',OLD+':'+b['published_path']);z=git(W,'show',CURRENT+':'+b['published_path']);require(a==z and sha(a)==b['old_sha256']==b['current_sha256'],'head bridge not byte exact')
 old=p['predecessor_sidecar'];require(old['published_head']==W03HEAD and old['dependency_id']==PID and old['complete_dependency_object_sha256']==sha(canon(old_sidecar)),'originalGYPS sidecar altered');require('not retirement' in old['relationship'],'retirement ambiguity')
 require(p['scientific_payload_changes'] is False and p['history_changes'] is False and p['source_scope_additions']==0,'scientific/history scope falsely changed');require(p['source_and_application_holds']==old_sidecar['application_conditions'],'original holds lost');require('conditionally' in p['conditional_Bacto_requirement'] and 'never generic mesh:D010461' in p['conditional_Bacto_requirement'],'conditionalBacto boundary lost');require(p['application_authorized'] is False and p['whole_owner_role_export_approved'] is False,'ungrantedapproval')
 require(context['case_hashes']=={CID:casehash},'origin-context source hashes differ');require(context['proposal_object_sha256']==sha(canon(p)),'origin-context completeproposal hash differs');require(context['publication_binding_pending_actual_commit'] is True,'future publication falsely asserted');require(context['no_retirement'] is True and context['all_case_ids_causal_only'] is True,'false origin retirement/scope');require(context['origin_id']=='w03::'+PID and context['prospective_worker_slot']=='worker-03','wrong origin identity')
 for k in ['new_assigned_source_cases','new_observed_recipe_cases','new_occurrences']:require(doc[k]==0,'denominator inflated')
 return True
raw=(O/'proposals.json').read_bytes();doc=json.loads(raw);ctx=json.loads((O/'origin-binding-context.json').read_bytes());require(sha(raw)=='582ea36dd479b8ecd244d996a6eb772569eb232b1631f87ef5f4aa143a20ce67','inputledgerchanged');require(verify(doc,ctx),'positive rejected')
controls=[]
def bad(name,fn,payload=expected_after):
 x=copy.deepcopy(doc);y=copy.deepcopy(ctx);fn(x,y)
 try:verify(x,y,payload)
 except ValueError as e: controls.append({'control':name,'status':'REFUSED','reason':str(e),'writes':0})
 else:raise AssertionError('unsafeaccepted:'+name)
bad('wrong_causal_hash',lambda d,c:d['proposals'][0]['case_relationships'][0].update(case_input_sha256='0'*64))
bad('wrong_preimage',lambda d,c:d['proposals'][0].update(before_sha256='0'*64))
bad('wrong_payload_hash',lambda d,c:d['proposals'][0]['after_capture'].update(sha256='0'*64))
bad('wrong_actual_payload',lambda d,c:None,payload=expected_after+b'\n# wrongbytes\n')
bad('foreign_case_claimed_assigned',lambda d,c:d['proposals'][0]['case_relationships'][0].update(assigned_worker_slot='worker-03',is_assigned_W03_case=True))
bad('foreign_case_in_assigned_array',lambda d,c:d['proposals'][0]['assigned_W03_case_ids'].append(CID))
bad('causal_case_as_GYPS_observation',lambda d,c:d['proposals'][0]['case_relationships'][0].update(is_GYPS_recipe_observation=True))
bad('invented_GYPS_backlink',lambda d,c:d['proposals'][0]['causal_parent_provenance']['original_proposal_backlinks'].append(PID))
bad('foreign_author_relabelled',lambda d,c:d['proposals'][0]['causal_parent_provenance']['complete_original_proposal'].update(primary_author='codex-worker03 /root'))
bad('false_native_core_membership',lambda d,c:d['proposals'][0].update(native_source_core_member=True))
bad('duplicate_Marine_origin',lambda d,c:d['proposals'].append(copy.deepcopy(d['proposals'][0])))
bad('false_retirement',lambda d,c:c.update(no_retirement=False))
bad('Bacto_hold_removed',lambda d,c:d['proposals'][0].update(conditional_Bacto_requirement='Approve generic Peptone'))
bad('future_head_asserted',lambda d,c:c.update(publication_binding_pending_actual_commit=False))
cores=[]
for row in doc['source_core_preservation']:
 path=R/row['path'];b=path.read_bytes();require(sha(b)==row['sha256'],'sourcecore hash drift');require(git(R,'show',W03HEAD+':'+row['path'])==b,'sourcecore differs from committed784');cores.append(row)
old_manifest=json.loads((P/'MANIFEST.json').read_bytes());oldcount=0
for x in old_manifest['members']:require(sha((P/x['path']).read_bytes())==x['sha256'],'prior sidecar seal member changed');oldcount+=1
output={'reviewer':'/root/gyps_native_lineage','at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'status':'PASS_EXACT_NATIVE_LEDGER_LINEAGE_WITH_CAUSAL_SCOPE_LIMITS','independence':'Reviewer did not author native proposal ledger, payload, root publication guard or technical prepare fixtures. Initial independent lineage proof was an input; this review separately checks the full new authored ledger against committed original objects and adversarial semantic mutations.','inputs':[pin(O/'proposals.json'),pin(O/'origin-binding-context.json'),pin(O/'payloads/GYPS.yaml'),pin(S/'lineage-proof-v1.json')],'proposal_object_sha256':sha(canon(doc['proposals'][0])),'reviewed_native_proposal_count':1,'exact_GYPS_yaml_unchanged_from784':True,'exact_history_unchanged':True,'conditional_Bacto_requirement_retained':True,'foreign_origin':{'original_W05_head':OLD,'unchanged_current_head':CURRENT,'case_id':CID,'case_hash':casehash,'full_original_proposal_sha256':sha(canon(original_prop)),'full_original_source_decision_sha256':sha(canon(original_dec)),'original_authors_and_backlinks_exact':True,'new_GYPS_backlink_claimed':False},'case_scope':{'global_ledger_population':len(globalcases),'realcase_occurrences':sum(x['case_id']==CID for x in globalcases),'W05_assigned':CID in s5,'W03_assigned':CID in s3,'new_assigned_cases':0,'new_recipe_observation_cases':0,'new_occurrences':0},'preserved_W03_core':cores,'prior784_sidecar_manifest_members_rehashed':oldcount,'independent_semantic_negative_controls':controls,'negative_count':len(controls),'native_operator_boundary':'Native prepare verifies global hashes and binding shape but does not interpret assignment/causality provenance fields. These controls independently test truthful semantic lineage and must not be described as nativeoperator assignment refusal. Separate technical agent owns realprepare fixture proof.','crosswalk_requirement':'Complete new nativeproposal object/hash and actual eventual publishedledger/payload head/path/hash must be bound. Nofuturehead or retirement record is fabricated; actual final publication must be verified byroot.','new_findings':[],'application_and_release_approval':False,'remaining_holds':['Exactreviewed conditionalBacto payload only; no genericredirect or wholeBacto/owner/role/exportapproval.','No newPYGS/Marine origins; retain genuineW06/W04 origins separately.','Root distinctfinalhead review and fullcampaign nativeprepare/crosswalk remain separate.','Original188/74/868W03core and allold784sidecar members unchanged.']}
p=S/'final-lineage-review-v1.json';require(not p.exists(),'immutableoutputexists');p.write_text(json.dumps(output,indent=2)+'\n');print('PASS',sha(p.read_bytes()),'negativecontrols',len(controls),'priorseal',oldcount)

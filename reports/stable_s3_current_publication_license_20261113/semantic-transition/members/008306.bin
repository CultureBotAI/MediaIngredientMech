      ]
    },
    {
      "case_id": "CM_NAME:1bd8d675450108231a5a447707552676245f24c975891b217f1caa5f8170262b",
      "case_input_sha256": "251ed8d8d89bc8325c62976e9f16a93fd8a7c457b0d6bfdb1e6ad3adfe78ab44",
      "decision_canonical_sha256": "d75935cf0d590b2087e9831930f792923d6a970f992d90450b6a10a075e13610",
      "status": "approve",
      "reasoning": "TOGO M1094/M940 and independent JCM1030/899 primary bytes explicitly give the six-water salt, at 78.4 mg and 784 mg within separate trace stocks. The decision preserves the frozen G_PER_L discrepancy and declines receiving-medium concentration approval while supporting the precise hydrate alias.",
      "inspected_evidence_ids": [
        "a-case-20-input",

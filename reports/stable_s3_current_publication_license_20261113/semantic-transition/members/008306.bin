      ]
    },
    {
      "case_id": "CM_NAME:664ea49b4baffce477446f17556f93e233f5535d0abfdec29fbb8f7384caf80c",
      "case_input_sha256": "79697f0d9ab3be6acce017ccfefa873ecdd3c4a9ab5081d28868f83891ab9332",
      "decision_canonical_sha256": "92c4f5123bf883a3378bad53eb9ca854c869db908f5b397a9804b726663649a7",
      "status": "approve",
      "reasoning": "TOGO M3164 explicitly records Fe(SO4)2(NH4)2·6H2O in a trace-element stock and identifies the hexahydrate. Group reordering does not remove waters or add a species. CHEBI:76181 and M2716 corroborate the source spelling; no whole-stock equivalence follows.",
      "inspected_evidence_ids": [
        "a-case-62-input",
        "a-case-62-occ-00",
        "a-primary-togo-M3164",

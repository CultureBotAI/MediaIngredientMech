    <meta name="journal_id" content="12934"/>
    <meta name="dc.title" content="A reduction in growth rate of Pseudomonas putida KT2442 counteracts productivity advances in medium-chain-length polyhydroxyalkanoate production from gluconate"/>
    <meta name="dc.source" content="Microbial Cell Factories 2011 10:1"/>
    <meta name="dc.format" content="text/html"/>
    <meta name="dc.publisher" content="BioMed Central"/>
    <meta name="dc.date" content="2011-04-22"/>
    <meta name="dc.type" content="OriginalPaper"/>
    <meta name="dc.language" content="En"/>

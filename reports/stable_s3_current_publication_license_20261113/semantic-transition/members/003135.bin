"""Save a real private native review of the exact sealed Menadione successor."""
from pathlib import Path
import datetime, hashlib, json, os, subprocess, sys, types
import yaml

D=Path(__file__).absolute().parent;C=D.parents[1];R=C.parents[1]
P=C/'integration/menadione718-hemodal-successor-v1'
W=C/'workers/w02/worktree/.temp/menadione-inherited-brands-research-v1'
J=C/'integration/curation-worktree';F=D/'native-review-fixture'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def put(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
def js(p,v):put(p,(json.dumps(v,indent=2,ensure_ascii=False)+'\n').encode())
def module(name,p):
 m=types.ModuleType(name);m.__file__=str(p);sys.modules[name]=m;exec(compile(p.read_bytes(),str(p),'exec'),m.__dict__);return m
assert sha(P/'candidates/Menadione.yaml')=='4fe793abcf278200df7d1f2572922e410e81a8220dd8ebb6c25b3d88c66de591'
assert not F.exists()
manifest=json.loads((P/'MANIFEST.json').read_bytes());members=[]
for e in manifest['members']:
 p=P/e['path'];assert not p.is_symlink() and p.is_file() and sha(p)==e['sha256'] and p.stat().st_size==e['bytes'];members.append(e)
actual={p.relative_to(P).as_posix() for p in P.rglob('*') if p.is_file() and '.git' not in p.relative_to(P).parts}
assert actual=={e['path'] for e in members}|{'MANIFEST.json','HANDOFF.json'}
js(D/'AUTHOR-MANIFEST-READBACK.json',{'manifest_sha256':sha(P/'MANIFEST.json'),'handoff_sha256':sha(P/'HANDOFF.json'),'members':members,'all_members_and_ignored_inclusive_membership_verified':True})
rr=module('menadione_peer_native',J/'scripts/record_review.py')
ar=json.loads((P/'NATIVE-AUTHOR-RECEIPT.json').read_bytes());af=Path(ar['source_root']);ap=Path(ar['pair']['yaml'])
ad=rr.read_review(af,ap.relative_to(af).as_posix(),af/'schema/record_review.yaml');rr.assert_current_source(af,ad)
assert ad['reviewer']['independence']=='self_review' and ad['scientific_review'] is False
readbacks=[]
for label,root,p in [('author',af,ap),('original_W02',C/'workers/w02/worktree',next((W/'native/private-overlay/reviews/structured').glob('*/review.yaml')))]:
 doc=rr.read_review(root,p.relative_to(root).as_posix(),J/'schema/record_review.yaml');rr.assert_current_source(root,doc)
 refs=[]
 for e in doc['source']['inputs']:
  q=root/e['path'];assert sha(q)==e['sha256'];refs.append({'path':str(q),'sha256':sha(q),'bytes':q.stat().st_size,'role':e['role']})
 readbacks.append({'scope':label,'yaml':str(p),'yaml_sha256':sha(p),'markdown':str(p.with_name('review.md')),'markdown_sha256':sha(p.with_name('review.md')),'verdict':doc['verdict'],'reviewer':doc['reviewer'],'scientific_review':doc['scientific_review'],'inputs':refs})
js(D/'PRIOR-NATIVE-READBACK.json',readbacks)
new=yaml.safe_load((P/'candidates/Menadione.yaml').read_bytes());old=yaml.safe_load((W/'inputs/selected-owner.yaml').read_bytes())
reasons={
 'identifier':'CHEBI:28869 is the neutral menadione substance, independently corroborated by the actual official ChEBI and NIST captures; unchanged.',
 'preferred_term':'Menadione is the supported neutral chemical name; unchanged.',
 'ontology_mapping':'Own-ID exact identity, canonical lowercase label, original CultureMech DIRECT_MATCH provenance and grade remain. One correctly typed LLM_SUGGESTION provides claim-specific negative evidence; no matching-method reinterpretation.',
 'synonyms':'All 21 entries read. Only bare inherited Hemodal changes applicability. Both neutral and bisulfite official products affirmatively use the name; positive neutral use is not denied. Other chemical-name senses, raw metadata and ATCC solute label remain exact; native non-name filters remain operative.',
 'mapping_status':'MAPPED continues to describe the grounded record; it is not a source, role, row or release approval.',
 'occurrence_statistics':'Historical 107/107 statistics and their derivation are preserved; no current full occurrence recount or new exported count approval.',
 'curation_history':'All 16 old events remain ordered and exact, including historical inaccurate/truncated values. One truthful LLM-assisted C-authored alias correction appended; no attribution or history rewrite.',
 'chemical_properties':'CAS58-27-5, C11H8O2, complete InChI and SMILES match actual official neutral-menadione captures. Earlier PubChem retrieval metadata remains attributable. No product purity, stock or bisulfite identity imported.',
 'ingredient_type':'SINGLE_INGREDIENT is consistent with this chemical owner; separate ethanol/water stock is not the owner.',
 'nutritional_roles':'Imported VITAMIN_SOURCE confidence1.0 and DATABASE_ENTRY attribution remain exact. This record review does not independently approve the role, confidence or supported export.',
 'notes':'ATCC1257 prints 50mg menadione plus 50mL95%ethanol and 50mLwater for a separate stock; the frozen flattened50G_PER_L is explicitly unvalidated. No final volume, whole-stock identity or final-medium concentration inferred.'}
assert set(reasons)==set(new) and len(old['curation_history'])==16
fields=[{'field':k,'old_sha256':hashlib.sha256(json.dumps(old[k],sort_keys=True,ensure_ascii=False).encode()).hexdigest(),'new_sha256':hashlib.sha256(json.dumps(v,sort_keys=True,ensure_ascii=False).encode()).hexdigest(),'unchanged':old[k]==v,'assessment':reasons[k]} for k,v in new.items()]
js(D/'WHOLE-OWNER-FIELD-ASSESSMENT.json',fields)
transport=[];byoriginal={}
def capture(p,rel):
 p=Path(p);raw=p.read_bytes();put(F/rel,raw);assert (F/rel).read_bytes()==raw
 entry={'original_path':str(p),'fixture_path':rel,'sha256':sha(p),'bytes':len(raw)};transport.append(entry);byoriginal[str(p)]=rel
for rel in ['scripts/record_review.py','schema/record_review.yaml','MAPPING_SEMANTICS.md','docs/record-review-profile.md']:
 capture(J/rel,rel)
for rel in ['candidates/Menadione.yaml','SELECTOR.json','origin-proof.json','field-delta.json','CAPTURE-MAP.json','input-pins.json','verification.json','native-row-diagnostic.json','NATIVE-AUTHOR-RECEIPT.json','MANIFEST.json','HANDOFF.json','author-checks.json']:
 capture(P/rel,'evidence/author/'+rel)
for item in readbacks:
 for key in ['yaml','markdown']:capture(Path(item[key]),'evidence/prior-pairs/'+item['scope']+'/'+Path(item[key]).name)
for rel in ['HANDOFF.json','MANIFEST.json','assessment-v2.json','findings-ready-for-root.json','inputs/selected-owner.yaml','inputs/authentic-before.yaml','inputs/atcc1257-original-capture.pdf','inputs/atcc1257-original-capture.txt','inputs/ontology-capture.json','inputs/original-proposal-case-context.json','inputs/w08-selected-git-context.json','inputs/before-current-head-binding.json','research/c/search-07.json','research/c/captures/coimbra-194502.body','research/c/captures/coimbra-194502.receipt.json','research/c/captures/coimbra-p22.png','skeptic/captures-v2/nist-menadione.body','skeptic/captures-v2/nist-menadione.text.txt','skeptic/captures-v2/nist-menadione.receipt.json','skeptic/captures-v2/kegg-drug.text.txt','skeptic/captures-v3/sangon-vitamin-k3.text.txt']:
 capture(W/rel,'evidence/original-research/'+rel)
for rel in ['publication-00.json','readback-00.json','body.md']:
 capture(C/'preflight/menadione-hemodal-finding-publication-v1'/rel,'evidence/issue/'+rel)
for rel in ['INDEPENDENT-CHECKS.json','INDEPENDENT-PROJECTION.json','VERIFY-RECEIPT.json','verify.stdout','verify.stderr','verify_successor.py','AUTHOR-MANIFEST-READBACK.json','PRIOR-NATIVE-READBACK.json','WHOLE-OWNER-FIELD-ASSESSMENT.json','ORIGINAL-CONTEXT-READBACK.json','W02-MANIFEST-READBACK.json','authentic-before.yaml','label-index-before.csv','label-index-after.csv']:
 capture(D/rel,'evidence/independent/'+rel)
capture(Path(__file__),'evidence/independent/save_independent_review.py')
js(D/'INPUT-TRANSPORT.json',transport);put(F/'INPUT-TRANSPORT.json',(D/'INPUT-TRANSPORT.json').read_bytes())
commands=[['git','init','-b','private-menadione-independent-review'],['git','remote','add','origin','https://github.com/CultureBotAI/MediaIngredientMech.git'],['git','add','--all'],['git','-c','user.name=Codex independent review fixture','-c','user.email=review-fixture@invalid','-c','commit.gpgsign=false','commit','-m','Capture exact Menadione independent-review inputs; not a campaign source commit']]
command_results=[]
for cmd in commands:
 p=subprocess.run(cmd,cwd=F,capture_output=True,env={**os.environ,'GIT_OPTIONAL_LOCKS':'0'});command_results.append({'command':cmd,'exit_code':p.returncode,'stdout':p.stdout.decode(),'stderr':p.stderr.decode()});assert p.returncode==0
js(D/'FIXTURE-CREATION.json',{'root':str(F),'scope':'Genuine private review-only Git provenance, never a worker/campaign head, remote push or source application.','commands':command_results})
tid='menadione-hemodal';targets=[{'target_id':tid,'kind':'source','path':'evidence/author/candidates/Menadione.yaml','label':'Complete neutral Menadione owner with qualified inherited Hemodal','record_class':'IngredientRecord','ownership_note':'Whole private C-authored successor4fe; original W08 vm-prop-menadione/A842 preimage and current original context bound. Reviewer authored infrastructure, not this owner.'}]

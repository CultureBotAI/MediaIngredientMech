ins=rr.inspect_source(F,targets,inputs);js(D/'NATIVE-INSPECTION.json',ins)
now=datetime.datetime.now(datetime.timezone.utc);at=now.isoformat().replace('+00:00','Z');rid=now.strftime('%Y%m%dT%H%M%SZ')+'-menadione-hemodal-whole-owner-independent'
evidence=[]
def ev(eid,p,kind,summary):
 rel=byoriginal[str(p)];evidence.append({'evidence_id':eid,'kind':kind,'reference':rel,'snapshot_sha256':sha(F/rel),'accessed_at':at,'support':'supports','summary':summary})

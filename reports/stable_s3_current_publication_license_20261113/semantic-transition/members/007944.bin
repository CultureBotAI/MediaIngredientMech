            <div class="page-title" style="">
    <div class="page-title-inner">
        <h1 class="hdg-lv1">
            <small>細菌の細胞壁合成阻害およびアラニンラセマーゼ阻害作用のある化合物</small>
            <span><i>O</i>-Carbamyl-D-serine（OCDS）</span>
        </h1>
    </div><!-- /.page-title-inner -->
</div><!-- /.title-area -->

            <!-- ================ ▲ main top ▲ ================ -->
            <div class="str-inner">
                <!-- ================ ▼ main ▼ ================ -->

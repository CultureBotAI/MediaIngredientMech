<script>
    (function () {
        if (window.fnkSearchPostLinksInitialized) {
            return;
        }

        window.fnkSearchPostLinksInitialized = true;

        function closestSearchLink(element) {
            while (element && element !== document) {
                if (element.matches && element.matches('a[data-search-post="true"]')) {
                    return element;
                }
                element = element.parentNode;
            }

            return null;
        }

        function decodeQueryPart(value) {
            try {
                return decodeURIComponent(value.replace(/\+/g, ' '));
            } catch (e) {
                return value;
            }
        }

        function forEachQueryParam(query, callback) {
            var pairs = (query || '').replace(/^\?/, '').split('&');
            for (var i = 0; i < pairs.length; i++) {
                if (!pairs[i]) {
                    continue;
                }

                var separatorIndex = pairs[i].indexOf('=');
                var name = separatorIndex >= 0 ? pairs[i].slice(0, separatorIndex) : pairs[i];
                var value = separatorIndex >= 0 ? pairs[i].slice(separatorIndex + 1) : '';
                callback(decodeQueryPart(name), decodeQueryPart(value));
            }
        }

        function normalizeSearchType(searchType) {
            var value = (searchType || '').toLowerCase();
            if (value === 'searchcode') {
                return 'searchCode';
            }

            if (value === 'searchproduct') {
                return 'searchProduct';
            }

            return '';
        }

        function mapSearchFieldName(searchType, name) {
            if (searchType === 'searchCode') {
                if (name === 'targeted' || name === 'completed' || name === 'status') {
                    return 'codesearch.' + name;
                }

                if (/^codes\[\d+\]\[[^\]]+\]$/.test(name)) {
                    return 'codesearch.' + name;
                }
            }

            if (searchType === 'searchProduct') {
                if (name === 'keywords' || name === 'productcode' || name === 'product_code' || name === 'abbr' || name === 'code' || name === 'targeted' || name === 'status') {
                    return name === 'product_code'
                        ? 'productsearch.productcode'
                        : 'productsearch.' + name;
                }
            }

            return '';
        }

        function setHiddenInput(form, name, value) {
            var inputs = form.getElementsByTagName('input');
            for (var i = 0; i < inputs.length; i++) {
                if (inputs[i].name === name) {
                    inputs[i].value = value;
                    return;
                }
            }

            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
        }

        function appendDefaultFields(form, searchType) {
            if (searchType === 'searchCode') {
                setHiddenInput(form, 'codesearch.targeted', '0');
                setHiddenInput(form, 'codesearch.completed', '2');
                setHiddenInput(form, 'codesearch.status', '0');
            }

            if (searchType === 'searchProduct') {
                setHiddenInput(form, 'productsearch.targeted', '0');
                setHiddenInput(form, 'productsearch.status', '0');
            }
        }

        function submitSearch(link) {
            var action = link.getAttribute('data-search-action');
            var searchType = normalizeSearchType(link.getAttribute('data-search-type'));
            if (!action || !searchType) {
                return;
            }

            var form = document.createElement('form');
            var hasSearchCondition = false;
            form.method = 'post';
            form.action = action;
            form.style.display = 'none';

            var target = link.getAttribute('target');
            if (target) {
                form.target = target;
            }

            appendDefaultFields(form, searchType);

            forEachQueryParam(link.getAttribute('data-search-query'), function (name, value) {
                var fieldName = mapSearchFieldName(searchType, name);
                if (!fieldName) {
                    return;
                }

                hasSearchCondition = true;
                setHiddenInput(form, fieldName, value);
            });

            if (!hasSearchCondition) {
                return;
            }

            document.body.appendChild(form);
            form.submit();

            setTimeout(function () {
                if (form.parentNode) {
                    form.parentNode.removeChild(form);
                }
            }, 0);
        }

        document.addEventListener('click', function (event) {
            var link = closestSearchLink(event.target);
            if (!link) {
                return;
            }

            event.preventDefault();
            submitSearch(link);
        });
    })();
</script>


                

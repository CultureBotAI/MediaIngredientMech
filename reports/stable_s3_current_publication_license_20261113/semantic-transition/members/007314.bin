<TR><TD WIDTH=75%> Pyridoxine-HCl                                         </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;50.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> mg  </TD></TR>

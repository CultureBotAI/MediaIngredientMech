  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Add components, except vitamin B solution, to distilled waterand bring volume to 990 ml. Adjust pH to 7.2. After autoclaving,aseptically add filter--sterilized vitamin B solution."
    }
  ]

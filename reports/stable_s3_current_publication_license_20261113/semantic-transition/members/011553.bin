{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/MICRO_0000179","ontology_name":"micro","ontology_prefix":"MICRO","short_form":"MICRO_0000179","description":[],"label":"polypeptone","obo_id":"MICRO:0000179","type":"class"},{"iri":"http://purl.obolibrary.org/obo/FYPO_0002865","ontology_name":"fypo","related_synonyms":["sensitive to polypeptone during mitotic cell cycle"],"ontology_prefix":"FYPO","short_form":"FYPO_0002865","description":["A phenotype observed in the vegetative growth phase of the life cycle in which cells show increased sensitivity to polypeptone. Cells stop growing (and may die) at a concentration of polypeptone that allows wild type cells to grow. Polypeptone is a mixture of peptones made up of equal parts of pancreatic digest of casein and peptic digest of animal used in media."],"label":"sensitive to polypeptone","obo_id":"FYPO:0002865","type":"class","exact_synonyms":["hypersensitive to polypeptone","sensitive to polypeptone during vegetative growth"]},{"iri":"http://purl.obolibrary.org/obo/MICRO_0001357","ontology_name":"micro","related_synonyms":["PY broth"],"ontology_prefix":"MICRO","short_form":"MICRO_0001357","description":["An organic-rich, liquid culture medium comprised of polypeptone, yeast extract, sodium chloride, magnesium chloride, calcium chloride, sodium molybdate, copper chloride, and ferric chloride."],"label":"DSMZ Medium 1071","obo_id":"MICRO:0001357","type":"class","exact_synonyms":["PY medium","peptone yeast broth"]},{"iri":"http://purl.obolibrary.org/obo/FYPO_0002865","ontology_name":"upheno","related_synonyms":["sensitive to polypeptone during mitotic cell cycle"],"ontology_prefix":"UPHENO","short_form":"FYPO_0002865","description":["A phenotype observed in the vegetative growth phase of the life cycle in which cells show increased sensitivity to polypeptone. Cells stop growing (and may die) at a concentration of polypeptone that allows wild type cells to grow. Polypeptone is a mixture of peptones made up of equal parts of pancreatic digest of casein and peptic digest of animal used in media."],"label":"sensitive to polypeptone","obo_id":"FYPO:0002865","type":"class","exact_synonyms":["hypersensitive to polypeptone","sensitive to polypeptone during vegetative growth"]}],"numFound":4,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["MICRO","2","UPHENO","1","FYPO","1"],"isDefiningOntology":["true","3","false","1"],"ontologyId":["micro","2","upheno","1","fypo","1"],"ontologyIri":["http://purl.obolibrary.org/obo/MicrO.owl","2","http://purl.obolibrary.org/obo/fypo.owl","1","http://purl.obolibrary.org/obo/upheno.owl","1"],"isObsolete":["false","4"],"type":["class","4"]}}}
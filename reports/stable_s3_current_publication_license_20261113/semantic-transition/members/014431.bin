<TR><TD WIDTH=75%> MgCl<sub>2</sub>&#183;6H<sub>2</sub>O                                  </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;0.2&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>
<TR><TD WIDTH=75%> CaCl<sub>2</sub>&#183;2H<sub>2</sub>O                                  </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;0.05&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>
<TR><TD WIDTH=75%> Trace element solution SL8 (see Medium No. <a href="/cgi-bin/jcm/jcm_grmd?GRMD=190">190</a>)       </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;1.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> ml  </TD></TR>
<TR><TD WIDTH=75%> Sodium DL-malate                                        </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;3.6&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>
<TR><TD WIDTH=75%> Yeast extract                                           </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;1.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>
<TR><TD WIDTH=75%> Na<sub>2</sub>S<sub>2</sub>O<sub>3</sub>&#183;5H<sub>2</sub>O                          </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;0.5&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>

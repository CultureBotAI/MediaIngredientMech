  "findings": [
    {
      "finding_id": "MA-SR-01",
      "severity": "scientific_revision_required",
      "proposal_id": "ma-casamino-distinct",
      "initial_finding": "Ordinary Casamino Acids was proposed as kgmicrobe.ingredient plus broad FOODON parent without evaluating an existing exact ontology term. Official active MeSH C017721 defines acid-hydrolyzed casein. MAPPING_SEMANTICS Step1 must be evaluated before registry fallback.",
      "independent_evidence": [
        "nlm-C017721.json",
        "nlm-C017721.metadata.json",
        "mesh-C017721.json",
        "mesh-C017721.metadata.json",
        "casamino-primary-check.json"
      ],
      "author_response": "Author independently captured official NLM term and agreed exact material identity supersedes the unnecessarily broad registry proposal. Separate vitamin-assay and tryptone identities remain unchanged.",
      "resolution": "Changed ordinary owner proposal to identifier mesh:C017721 with exact ontology mapping; source aliases, original history and withheld whole-row obligations retained. CAS65072-00-6 is retained as sourced metadata, not used as exact-form evidence or a demand to mint CAS identity: independent FDA capture shows that CAS spans more than one casein hydrolysate description.",
      "reviewer_rereview": "Inspected revised proposal and all nine ordinary Casamino decisions; direct NLM scope, exact label and existing separate vitamin-assay owner are coherent.",
      "status": "resolved"
    },
    {
      "finding_id": "MA-SR-02",
      "severity": "scientific_revision_required",
      "proposal_id": "ma-casamino-distinct",
      "initial_finding": "New REJECTED_LABEL classification for inherited Casamino Acids (0.01 % was justified as preventing stock-to-dry-digest equivalence without claim-specific evidence that the fragment denotes a separately supplied stock. A percent suffix can express final-medium dose. Current owner history explicitly records prior #213 same-ingredient parsing disposition. MAPPING_SEMANTICS requires claim-specific evidence for new rejection.",
      "author_response": "Author first clarified that text was preserved, then accepted that raw-text preservation and scientifically rejecting identity are different. No recovered primary occurrence proves the concentration fragment false as an ordinary digest name.",
      "resolution": "Restored original RAW_TEXT synonym and provenance. Added explicit deferred source-specific review and retained whole-row hold. Carbocerate, metadata nonname and vitamin-assay-grade fragment rejections remain separately supported rather than lumped with the concentration fragment.",
      "reviewer_rereview": "Inspected revised Casamino after YAML, original #213 curation event, new curation event and revised ordinary decisions. The concentration fragment is again RAW_TEXT and source cases remain byte-preserved.",
      "status": "resolved"
    }
  ],
  "open_findings": [],
  "proposal_reviews": [
    {
      "proposal_id": "ma-new-rr_butane_2_3_diol",
      "assessment": "Exact source R,R stereochemistry and active CHEBI16982 agree. New owner preserves raw source label and records proposal history; no generic/meso/S,S identity substitution. Accept."
    },
    {
      "proposal_id": "ma-new-methyl_cellulose",
      "assessment": "CHEBI53448 is the named polymer, and the source occurrence is the solute inside a nested stock. No substitution pattern, degree of polymerization or carrier composition is added. Accept as solute owner only."
    },
    {
      "proposal_id": "ma-new-sodium_syringate",
      "assessment": "CHEBI132110 is sodium syringate; live OLS capture and independent read-only local label agree. Archived source explicitly names sodium material. Exact solute identity does not authorize normalizing the whole6% stock to it. Accept."
    },
    {
      "proposal_id": "ma-alias-tryptone",
      "assessment": "Three added spellings are compatible with pancreatic casein digest in their frozen source contexts and manufacturer evidence. Existing broader/related aliases and held rows are not globally approved. Cross-shard worker03 Pancreatic digest of casein overlap requires coordinator review before whole-owner publication. Accept with existing holds/dependency retained."
    },
    {
      "proposal_id": "ma-alias-casamino_acids_vitamin_assay",
      "assessment": "Explicit Difco Vitamin Assay source material belongs to the separate grade owner with broad relation to generic Casamino acids. Do not merge with ordinary MeSH-exact owner. Existing history/provenance preserved; accept bounded alias addition."
    },
    {
      "proposal_id": "ma-alias-lecithin",
      "assessment": "French-style Lecithine spelling is supported by NBRC1498 source. Target CHEBI61995 denotes lipid mixture, not one phosphatidylcholine structure. Accept bounded alias addition; no unrelated inherited row release."
    },
    {
      "proposal_id": "ma-alias-n-_2-acetamido-2-aminoethanesulfonic_acid",
      "assessment": "Expanded source name specifies acid CHEBI39060; generic ACES CHEBI39061 is broader tautomer grouping. Existing exact owner and original history are preserved; rejected Aces duplicate stays separate. Accept."
    },
    {
      "proposal_id": "ma-casamino-distinct",
      "assessment": "Initial registry+FOODON proposal corrected under MA-SR-01 to exact active MeSHC017721. MA-SR-02 restored concentration-fragment RAW_TEXT pending source-specific review. Final payload preserves original history, separates vitamin-assay grade, rejects only supported false/non-name/grade tokens and retains whole-row holds. Rereview accepted."
    },
    {
      "proposal_id": "ma-stock-jcm_226_czapek_concentrate",
      "assessment": "Independently checked all seven source constituents, exact hydrated salt labels and stated batch masses against official JCM226.100 mL is water addition, not verified final volume;10 mL dose remains source context. No global ambiguous Czapek alias or whole-medium equivalence. Complete constituent assertion is justified."
    },
    {
      "proposal_id": "ma-stock-jcm_629_artificial_saltwater",
      "assessment": "Independently checked all nine constituents and batch masses against official JCM629. Exact CaCl2dihydrate CHEBI86158 is valid; ungrounded named MgCl2hexahydrate does not reduce completeness of disclosed constituent list. Frozen150 G_PER_L merged amount is not imported into composition; no whole-medium equivalence. Accept source-specific stock."
    }
  ],

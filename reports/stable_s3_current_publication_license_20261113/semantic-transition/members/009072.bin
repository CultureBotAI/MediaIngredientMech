from pathlib import Path
import hashlib,json,subprocess,datetime
R=Path.cwd();C=R.parents[2];O=R/'.temp/gyps-native-origin-v1/lineage-review';W=C/'workers/w05/worktree';OLD='108e213e96f7d423ee345ce265d692e79063127c';CURRENT=subprocess.check_output(['git','-C',str(W),'rev-parse','HEAD'],text=True).strip();W03='784ee2541506c914b4c34f091de688d39784d548';CID='KG_CASE:ba039f9e4a33baf69eb111ceb979cf6c9ad8fe788c13488f256336508ce94151';PID='W05-FINAL-MAT-039';P=R/'reports/all_unmatched_20261107/worker-03/successors/issue1176-dependencies-v1'
def sha(b):return hashlib.sha256(b).hexdigest()
def canon(v):return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()
def git(w,*args):return subprocess.check_output(['git','-C',str(w),*args])
def pin(p):return {'path':str(p),'sha256':sha(p.read_bytes()),'bytes':p.stat().st_size}
def dump(n,v):p=O/n;assert not p.exists();p.write_text(json.dumps(v,indent=2)+'\n');return {'path':str(p.relative_to(R)),'sha256':sha(p.read_bytes())}
route=R/'.temp/gyps-native-origin-v1/inputs/issue1176-route-comment.json';assert sha(route.read_bytes())=='e16e0a3bcb0f3c541437fdd363b5a684aa132dece0766de2467bffd11271eec7'
review=C/'preflight/w03-peptone-final-head-independent-v1/HANDOFF.json';assert sha(review.read_bytes())=='2d97691f4c83391fcd0d83abc97e3139654b57606e9610ddb018131f6b5ea328'
selection=json.loads((P/'dependency-selection.json').read_bytes());gyps=next(x for x in selection['dependency_proposals'] if x['dependency_id']=='W03-DEP-1176-GYPS')
for b in [gyps['payload'],gyps['maintained_before']]:
 p=P/b['path'];assert sha(p.read_bytes())==b['sha256'];assert git(R,'show',W03+':'+str(p.relative_to(R)))==p.read_bytes()
assert (R/gyps['owner_path']).read_bytes()==(P/gyps['maintained_before']['path']).read_bytes()
ledger=C/'queue/preliminary-v5/union-ledger.json';allcases=json.loads(ledger.read_bytes());matching=[c for c in allcases if c['case_id']==CID];assert len(matching)==1;case=matching[0];case_sha=sha(canon(case));assert case_sha=='d42806e437d2e4c72f3e148314c5ef72e8c21f08c78b7b70eebe3d32c83b67d6'
shards={n:json.loads((C/f'queue/preliminary-v5/shards/shard-{n:02}.json').read_bytes()) for n in [3,5]}
assert CID in {c['case_id'] for c in shards[5]['cases']} and CID not in {c['case_id'] for c in shards[3]['cases']}
assert canon(next(c for c in shards[5]['cases'] if c['case_id']==CID))==canon(case)
paths={'proposal_ledger':'reports/all_unmatched_20261107/worker-05/buffer-parts-v1/core/proposals.json','decision_ledger':'reports/all_unmatched_20261107/worker-05/buffer-parts-v1/core/decisions.json','parent_payload':'reports/all_unmatched_20261107/worker-05/buffer-parts-v1/parents-direct-v1/proposed/Peptone.yaml'};bridge={};oldbytes={}
for label,path in paths.items():
 a,b=git(W,'show',OLD+':'+path),git(W,'show',CURRENT+':'+path);assert a==b==(W/path).read_bytes();bridge[label]={'published_path':path,'old_head':OLD,'observed_current_local_head':CURRENT,'old_sha256':sha(a),'current_sha256':sha(b),'byte_identical':True};oldbytes[label]=a
prop=next(x for x in json.loads(oldbytes['proposal_ledger'])['proposals'] if x['proposal_id']==PID);decision=next(x for x in json.loads(oldbytes['decision_ledger'])['decisions'] if x['case_id']==CID)
assert prop['case_ids']==[CID] and PID in decision['proposal_ids'] and decision['case_input_sha256']==case_sha
assert prop['after_capture']['sha256']==sha(oldbytes['parent_payload'])=='c083794668a362203de6430eaa2609c34cd8ef78574a1230aa25b4a64fb55fd7'
assert prop['owner_path']=='data/ingredients/mapped/Peptone.yaml'
cores=[]
for name,key in [('decisions.json','decisions'),('proposals.json','proposals'),('evidence.json','evidence')]:
 p=R/'reports/all_unmatched_20261107/worker-03/successors/issue1226-v1'/name;b=p.read_bytes();assert git(R,'show',W03+':'+str(p.relative_to(R)))==b;cores.append({'path':str(p.relative_to(R)),'sha256':sha(b),'count':len(json.loads(b)[key])})
case_capture=dump('global-causal-case.json',case);proposal_capture=dump('original-W05-parent-proposal.json',prop);decision_capture=dump('original-W05-parent-decision.json',decision);gyps_capture=dump('original-W03-GYPS-sidecar-object.json',gyps)
contract=C/'integration/worktree/src/mediaingredientmech/curate/campaign_owner_apply.py';cross=C/'integration/final-application-accounting-v3/crosswalk.py';doc=C/'integration/final-application-accounting-v3/historical-v2/README.md'
proof={'reviewer':'/root/gyps_native_lineage','at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'status':'LINEAGE_CONTRACT_AND_CURRENT_HEAD_BRIDGE_VERIFIED_AWAITING_NEW_LEDGER','read_only_inputs':True,'route':pin(route),'distinct_published_head_review':pin(review),'original_W03_head':W03,'original_GYPS_sidecar':gyps_capture,'exact_GYPS_before':{'path':str(P/gyps['maintained_before']['path']),'sha256':gyps['maintained_before']['sha256'],'maintained_bytes_equal':True},'exact_GYPS_payload':{'path':str(P/gyps['payload']['path']),'sha256':gyps['payload']['sha256'],'published_git_blob_equal':True},'foreign_causal_origin':{'worker_slot':5,'original_published_head':OLD,'current_local_head_observation':CURRENT,'remote_observation':'Parent coordinator performs remote check separately; not inferred from localGit.','proposal_id':PID,'proposal_object_sha256':sha(canon(prop)),'complete_proposal':proposal_capture,'primary_author':prop['primary_author'],'parent_successor_author':prop['parent_successor_author'],'direct_term_successor_author':prop['direct_term_successor_author'],'case_id':CID,'case_input_sha256':case_sha,'complete_frozen_case':case_capture,'decision_object_sha256':sha(canon(decision)),'complete_source_decision':decision_capture,'original_proposal_backlinks':decision['proposal_ids'],'new_W03_GYPS_backlink_claimed':False,'unchanged_head_bridge':bridge},'membership_proof':{'global_ledger':pin(ledger),'global_cases':len(allcases),'case_present_once':True,'W05_shard':pin(C/'queue/preliminary-v5/shards/shard-05.json'),'W05_member':True,'W03_shard':pin(C/'queue/preliminary-v5/shards/shard-03.json'),'W03_member':False,'new_source_cases_or_occurrences':0},'preserved_W03_core':cores,'contract':{'operator':pin(contract),'crosswalk':pin(cross),'closed_contract_document':pin(doc),'native_rule':'prepare requires nonempty proposal.case_ids exactly equal origin.case_hashes keys and each canonical case hash matches the bound full global case ledger. It does not equate case_ids with this worker assigned shard. Original proposal is open to explicit metadata; after_capture is closed root/path/sha256.','truthful_representation':'One additive W03-authored edit_existing_owner proposal may use this real W05 case as explicitly labelled causal-parent context only. Preserve empty assigned_W03_case_ids/observed_GYPS_case_ids and zero new occurrences. Do not mutate or claim original W05 decision backlinks include newGYPS.','crosswalk_rule':'Native and crosswalk must bind complete new W03 proposal object/hash, published ledger path/head/hash, exact published GYPS payload path/head/hash, global case_hashes and finaloperation; no normalizedretirement or native sourcecore migration required.'},'science_boundary':'Exact reviewed conditionalBactoGYPS payload only. No new scientific assertions, no genericmeshredirect, no wholeBacto/owner/role/exportapproval. PYGS/Marine retain foreign origins and must not be emitted as newW03origins.'}
dump('lineage-proof-v1.json',proof)

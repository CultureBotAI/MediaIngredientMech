from pathlib import Path
import concurrent.futures, datetime, hashlib, json, urllib.parse, urllib.request
D=Path(__file__).absolute().parent
base='https://www.ebi.ac.uk/ols4/api/'
requests={
 'all-exact-dihydrate':base+'search?'+urllib.parse.urlencode({'q':'sodium dihydrogenphosphate dihydrate','exact':'true','rows':100}),
 'all-monobasic-dihydrate':base+'search?'+urllib.parse.urlencode({'q':'sodium phosphate monobasic dihydrate','rows':100}),
 'all-cysteine-solution':base+'search?'+urllib.parse.urlencode({'q':'cysteine hydrochloride solution','rows':100}),
 'chebi-cysteine-family':base+'search?'+urllib.parse.urlencode({'q':'cysteine hydrochloride','ontology':'chebi','rows':100}),
}

def fetch(x):
 name,url=x;at=datetime.datetime.now(datetime.UTC).isoformat()
 try:
  with urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'MIM-readonly-source-review/1.0'}),timeout=35) as r:
   b=r.read();status=r.status;headers=dict(r.headers);resolved=r.url
  with (D/'captures'/f'{name}.json').open('xb') as f:f.write(b)
  return {'name':name,'requested_url':url,'resolved_url':resolved,'accessed_at':at,'http_status':status,'headers':headers,'path':f'captures/{name}.json','sha256':hashlib.sha256(b).hexdigest(),'bytes':len(b)}
 except Exception as e:return {'name':name,'requested_url':url,'accessed_at':at,'error':repr(e)}
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:results=list(pool.map(fetch,requests.items()))
with (D/'ontology-search-broader-receipts.json').open('x') as f:json.dump(results,f,indent=2);f.write('\n')
print(json.dumps([{k:x[k] for k in ['name','http_status','sha256','error'] if k in x} for x in results],indent=2))

<TABLE BORDER>
<TR><TD WIDTH=75%> KCl                                                     </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;0.355&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>

{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/CHEBI_22909","ontology_name":"chebi","related_synonyms":["borate anions","borate ion","borate ions"],"ontology_prefix":"CHEBI","short_form":"CHEBI_22909","description":["Any inorganic anion that is formally derived from boric acid. The term includes polymeric anions containing chains of BO\u003csmall\u003e\u003csub\u003e3\u003c/sub\u003e\u003c/small\u003e structural units sharing one oxygen atom (e.g. di-, tri-, and tetraborates) as well as chains or rings sharing two oxygen atoms (e.g. metaborates)."],"label":"borate ion","obo_id":"CHEBI:22909","type":"class"}],"numFound":1,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["CHEBI","1"],"isDefiningOntology":["true","1"],"ontologyId":["fbcv","1","slm","1","peco","1","chebi","1","dron","1"],"ontologyIri":["http://purl.obolibrary.org/obo/chebi.owl","1"],"isObsolete":["false","1"],"type":["class","1"]}}}
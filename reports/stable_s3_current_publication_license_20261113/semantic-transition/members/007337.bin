<!-- End Google Tag Manager (noscript) --><div style="background-color:#FFFFFF;background-position:center center;background-size:auto;background-repeat:repeat;"><section style="background-color:#E8E8E8;background-position:center center;background-size:auto;background-repeat:no-repeat;width:100%;"><div align="center"><div style="background:#FFFFFF;background-color:#FFFFFF;Margin:0px auto;max-width:1000px;"><div style="border:none;border-bottom:1px none #000000;border-left:1px none #000000;border-right:1px none #000000;border-top:1px none #000000;direction:ltr;font-size:0px;padding:0;text-align:center;vertical-align:top;" class="block-grid"><div style="border:none;"><div class="mj-column-per-100" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="background-color:transparent;border-radius:0px;vertical-align:top;padding:0px 0px 0px 0px;"><div width="100%"><div class="img-container" style="font-size:0px;padding:10px 10px 14px 20px;word-break:break-word;text-align:left;"><div class="mktoText" id="image-g6jwoo2r2"><a href="https://www.cytivalifesciences.com/" target="_blank" style="text-decoration: none; color: #079DFF;"><img alt="Cytiva Life Sciences" height="auto" src="https://info.cytivalifesciences.com/rs/614-VFU-334/images/CytivaLogo.png?version=0" style="border:none;outline:none;text-decoration:none;height:auto;width:100%;max-width:145px;font-size:13px;margin:0 auto 0 0;display:block;"></a></div></div></div></div></div></div></div></div></div></section><section style="background-color:#E8E8E8;background-position:center center;background-size:contain;background-repeat:no-repeat;width:100%;"><div align="center"><div style="background:#FFFFFF;background-color:#FFFFFF;Margin:0px auto;max-width:1000px;"><div style="border:none;direction:ltr;font-size:0px;padding:0px 0px 0px 0px;text-align:center;vertical-align:top;" class="block-grid"><div style="border:none;"><div class="mj-column-per-100" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0px 0px 0px 0px;"><div width="100%"><div class="img-container" style="font-size:0px;padding:0px 0px 0px 0px;word-break:break-word;text-align:center;"><div class="mktoText" id="image-cjpt0pkja"><img alt="Whatman cellulose filter paper products" height="auto" src="https://info.cytivalifesciences.com/rs/614-VFU-334/images/LP-CY24004-cellulose-filter-paper-banner.jpg?version=0" style="border:none;outline:none;text-decoration:none;height:auto;width:100%;max-width:1000px;font-size:13px;margin:0 auto;display:block;" class="img-full-width"></div></div></div></div></div></div></div></div></div></section><section style="background-color:#E8E8E8;background-position:center center;background-size:auto;background-repeat:no-repeat;width:100%;"><div align="center"><div style="background:#FFFFFF;background-color:#FFFFFF;Margin:0px auto;max-width:1000px;"><div style="border:none;direction:ltr;font-size:0px;padding:0;text-align:center;vertical-align:top;" class="block-grid"><div style="border:none;"><div class="mj-column-per-100" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="background-color:transparent;border-radius:0px;vertical-align:top;padding:5px 0px 5px 0px;"><div width="100%"><div class="text-container" style="font-size:0px;padding:10px 25px 0px 25px;word-break:break-word;text-align:left;"><div class="mktoText" id="text-r12j3p2eh"><div class="links-00886F-underline"><div style="font-family:'CytivaAktiv', Arial, sans-serif;font-size:15px;letter-spacing:0px;line-height:1.2;text-align:left;color:#000000;"><p style="margin: 0 0;">In laboratories across the globe, Whatman™ cellulose filter papers are synonymous with quality, reliability, and ease of use.&nbsp;</p><p style="margin: 0 0;">&nbsp;</p><p style="margin: 0 0;">Our product portfolio offers cellulose papers with various purity, chemical resistances, retention, and flow rate combinations to suit numerous laboratory applications.</p></div></div></div></div></div></div></div></div></div></div></div></section><section style="background-color:#E8E8E8;background-position:center center;background-size:contain;background-repeat:no-repeat;width:100%;"><div align="center"><div style="background:#FFFFFF;background-color:#FFFFFF;Margin:0px auto;max-width:1000px;"><div style="border:none;direction:ltr;font-size:0px;padding:0px 0px 10px 0px;text-align:center;vertical-align:top;" class="block-grid"><div style="border:none;"><div class="mj-column-per-55" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><section style="width:100%;"><div style="border:none;direction:ltr;font-size:0px;text-align:center;vertical-align:top;padding:0px;"><div style="border:none;"><div class="mj-column-per-100" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="text-container" style="font-size:0px;padding:10px 25px 10px 25px;word-break:break-word;text-align:left;"><div class="mktoText" id="text-ehowu657f"><div class="links-079DFF-underline"><div style="font-family:'CytivaAktiv', Arial, sans-serif;font-size:15px;letter-spacing:none;line-height:1.2;text-align:left;color:#000000;"><p style="margin: 0 0;">It only takes a minute—request your free sample and we will be in touch so you can experience the difference.</p></div></div></div></div></div></div></div></div></div></section><section style="width:100%;"><div style="border:none;direction:ltr;font-size:0px;text-align:center;vertical-align:top;padding:0px;"><div style="border:none;"><div class="mj-column-per-26" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="img-container" style="font-size:0px;padding:0px 0px 0px 15px;word-break:break-word;text-align:center;"><div class="mktoText" id="image-mnl0xli8z"><img alt="Qualitative filter papers" height="auto" src="https://info.cytivalifesciences.com/rs/614-VFU-334/images/Qualitative-filter-papers.jpg?version=0" style="border:none;outline:none;text-decoration:none;height:auto;width:100%;max-width:102px;font-size:13px;margin:0 auto;display:block;"></div></div></div></div></div><div class="mj-column-per-74" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="text-container" style="font-size:0px;padding:20px 25px 5px 25px;word-break:break-word;text-align:left;"><div class="mktoText" id="text-6u3fkru33"><div class="links-079DFF-underline"><div style="font-family:'CytivaAktiv', Arial, sans-serif;font-size:15px;letter-spacing:none;line-height:1.2;text-align:left;color:#000000;"><p style="margin: 0 0;"><strong>Qualitative filter papers</strong> are the most widely used standard grade of cellulose filter paper commonly used for general filtration. Popular options include Grade 1, Grade 2 and Grade 4.</p></div></div></div></div></div></div></div></div></div></section><section style="width:100%;"><div style="border:none;direction:ltr;font-size:0px;text-align:center;vertical-align:top;padding:5px 0px 0px 0px;"><div style="border:none;"><div class="mj-column-per-26" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="img-container" style="font-size:0px;padding:16px 0px 0px 15px;word-break:break-word;text-align:center;"><div class="mktoText" id="image-sx3wniwu9"><img alt="Quantitative ashless filter papers" height="auto" src="https://info.cytivalifesciences.com/rs/614-VFU-334/images/Quantitative-ashless-filter-papers.png?version=0" style="border:none;outline:none;text-decoration:none;height:auto;width:100%;max-width:89px;font-size:13px;margin:0 auto;display:block;"></div></div></div></div></div><div class="mj-column-per-74" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="text-container" style="font-size:0px;padding:20px 25px 5px 25px;word-break:break-word;text-align:left;"><div class="mktoText" id="text-iep694s20"><div class="links-079DFF-underline"><div style="font-family:'CytivaAktiv', Arial, sans-serif;font-size:15px;letter-spacing:none;line-height:1.2;text-align:left;color:#000000;"><p style="margin: 0 0;"><strong>Quantitative ashless filter papers</strong> are high purity cellulose papers with very low ash content. Designed for gravimetric analysis procedures. Popular options include Grade 40, Grade 42 and Grade 589.</p></div></div></div></div></div></div></div></div></div></section><section style="width:100%;"><div style="border:none;direction:ltr;font-size:0px;text-align:center;vertical-align:top;padding:20px 0px 0px 0px;"><div style="border:none;"><div class="mj-column-per-26" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="img-container" style="font-size:0px;padding:0px 0px 0px 15px;word-break:break-word;text-align:center;"><div class="mktoText" id="image-ndttl6a4l"><img alt="Quantitative hardened ashless filter papers" height="auto" src="https://info.cytivalifesciences.com/rs/614-VFU-334/images/Quantitative-hardened-ashless-filter-papers.jpg?version=0" style="border:none;outline:none;text-decoration:none;height:auto;width:100%;max-width:102px;font-size:13px;margin:0 auto;display:block;"></div></div></div></div></div><div class="mj-column-per-74" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="text-container" style="font-size:0px;padding:0px 25px 5px 25px;word-break:break-word;text-align:left;"><div class="mktoText" id="text-f02d31t12"><div class="links-079DFF-underline"><div style="font-family:'CytivaAktiv', Arial, sans-serif;font-size:15px;letter-spacing:none;line-height:1.2;text-align:left;color:#000000;"><p style="margin: 0 0;"><strong>Quantitative hardened ashless filter papers</strong> are high purity cellulose papers designed for critical gravimetric analytical procedures. They have very low ash content and high chemical resistance. Popular options include Grade 50 and Grade 540.</p></div></div></div></div></div></div></div></div></div></section><section style="width:100%;"><div style="border:none;direction:ltr;font-size:0px;text-align:center;vertical-align:top;padding:5px 0px 0px 0px;"><div style="border:none;"><div class="mj-column-per-26" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="img-container" style="font-size:0px;padding:5px 0px 0px 24px;word-break:break-word;text-align:center;"><div class="mktoText" id="image-l91labszl"><img alt="Prefolded filter papers" height="auto" src="https://info.cytivalifesciences.com/rs/614-VFU-334/images/Prefolded-filter-papers.jpg?version=0" style="border:none;outline:none;text-decoration:none;height:auto;width:100%;max-width:101px;font-size:13px;margin:0 auto;display:block;"></div></div></div></div></div><div class="mj-column-per-74" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="text-container" style="font-size:0px;padding:20px 25px 5px 25px;word-break:break-word;text-align:left;"><div class="mktoText" id="text-4tn6fgiie"><div class="links-079DFF-underline"><div style="font-family:'CytivaAktiv', Arial, sans-serif;font-size:15px;letter-spacing:none;line-height:1.2;text-align:left;color:#000000;"><p style="margin: 0 0;"><strong>Prefolded filter papers</strong> are available across our range of qualitative and quantitative grades. Save time and streamline operations in your busy lab. Options include pleated, cone, pyramid and flat quadrant formats.</p></div></div></div></div></div></div></div></div></div></section><section style="width:100%;"><div style="border:none;direction:ltr;font-size:0px;text-align:center;vertical-align:top;padding:20px 0px 0px 0px;"><div style="border:none;"><div class="mj-column-per-26" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="img-container" style="font-size:0px;padding:5px 0px 0px 15px;word-break:break-word;text-align:center;"><div class="mktoText" id="image-0fuijbw0y"><img alt="Wet strengthened filter papers" height="auto" src="https://info.cytivalifesciences.com/rs/614-VFU-334/images/Wet-strengthened-filter-papers.png?version=0" style="border:none;outline:none;text-decoration:none;height:auto;width:100%;max-width:102px;font-size:13px;margin:0 auto;display:block;"></div></div></div></div></div><div class="mj-column-per-74" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="text-container" style="font-size:0px;padding:0px 25px 15px 25px;word-break:break-word;text-align:left;"><div class="mktoText" id="text-a1ggl76a4"><div class="links-079DFF-underline"><div style="font-family:'CytivaAktiv', Arial, sans-serif;font-size:15px;letter-spacing:none;line-height:1.2;text-align:left;color:#000000;"><p style="margin: 0 0;"><strong>Wet strengthened filter papers</strong> extremely strong filter papers that have a high wet strength and a smooth surface making it easy to scrape or wash off precipitate. Popular options include Grade 1573.</p></div></div></div></div></div></div></div></div></div></section><section style="width:100%;"><div style="border:none;direction:ltr;font-size:0px;text-align:center;vertical-align:top;padding:20px 0px 0px 0px;"><div style="border:none;"><div class="mj-column-per-26" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="img-container" style="font-size:0px;padding:5px 0px 0px 15px;word-break:break-word;text-align:center;"><div class="mktoText" id="image-6ha3kj09j"><img alt="Cellulose extraction thimbles" height="auto" src="https://info.cytivalifesciences.com/rs/614-VFU-334/images/Cellulose-extraction-thimbles.webp?version=0" style="border:none;outline:none;text-decoration:none;height:auto;width:100%;max-width:102px;font-size:13px;margin:0 auto;display:block;"></div></div></div></div></div><div class="mj-column-per-74" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div class="text-container" style="font-size:0px;padding:0px 25px 15px 25px;word-break:break-word;text-align:left;"><div class="mktoText" id="text-0diimvrf0"><div class="links-079DFF-underline"><div style="font-family:'CytivaAktiv', Arial, sans-serif;font-size:15px;letter-spacing:none;line-height:1.2;text-align:left;color:#000000;"><p style="margin: 0 0;"><strong>Cellulose extraction thimbles</strong> are for use in automated Soxhlet extractor systems. Applications include solid-liquid extraction studies including lipid and pesticide analyses.</p></div></div></div></div></div></div></div></div></div></section></div></div></div><div class="mj-column-per-45" style="font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;"><div style="border-radius:0px;vertical-align:top;padding:0 0 0 0;"><div width="100%"><div align="center" style="font-size:0px;padding:10px 10px 10px 10px;word-break:break-word;"><div style="max-width:100%;background-color:#00886F;border-radius:0px;width:100%;;"><div style="padding:10px;font-size:1rem;display:flex;flex-direction:column;align-items:center;font-family:'CytivaAktiv', Arial, sans-serif;"><script>arrayify = getSelection.call.bind([].slice);

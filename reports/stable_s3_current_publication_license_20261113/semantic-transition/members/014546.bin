    {
      "paragraph_index": 2,
      "comment": "pH 6.8-7.0"
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 4,
      "comment": "*Heat inactivated at 56℃ for 30 min."
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "**Sterilized by filtration."
    },
    {
      "paragraph_index": 7,
      "comment": "Dissolve 21 g of PPLO broth, 3 g of L-arginine, and 0.02 g of phenol red in 900 ml of water (adjusted pH to 6.8-7.0. sterilized by autoclave at 121℃ for 15 min).  Aseptically add 100 ml of horse serum and 5 ml of Penicillin G (200,000 U/ml, sterilized by filtration) to the cooled broth."
    }
  ]

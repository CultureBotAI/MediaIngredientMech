ation":true,"chemical_role":false,"chebi_accession":"CHEBI:176497","name":"geroprotector","definition":"Any compound that supports healthy aging, slows the biological aging process, or extends lifespan.","id":176497,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:77746","name":"human metabolite","definition":"Any mammalian metabolite  produced during a metabolic reaction in humans (<em>Homo sapiens</em>).","id":77746,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:83056","name":"Daphnia magna metabolite","definition":"A <em>Daphnia</em> metabolite produced by the species <em>Daphnia magna</em>.","id":83056,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:75771","name":"mouse metabolite","definition":"Any mammalian metabolite produced during a metabolic reaction in a mouse (<em>Mus musculus</em>).","id":75771,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:62872","name":"EC 1.2.3.1 (aldehyde oxidase) inhibitor","definition":"An EC 1.2.3.* (oxidoreductase acting on donor aldehyde/oxo group with oxygen as acceptor) inhibitor which interferes with the action of aldehyde oxidase (EC 1.2.3.1).","id":62872,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:50114","name":"estrogen","definition":"A hormone that stimulates or controls the development and maintenance of female sex characteristics in mammals by binding to oestrogen receptors. The oestrogens are named for their importance in the oestrous cycle. The oestrogens that occur naturally in the body, notably estrone, estradiol, estriol, and estetrol are steroids. Other compounds with oestrogenic activity are produced by plants (phytoestrogens) and fungi (mycoestrogens); synthetic compounds with oestrogenic activity are known as xenoestrogens.","id":50114,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:77746","name":"human metabolite","definition":"Any mammalian metabolite  produced during a metabolic reaction in humans (<em>Homo sapiens</em>).","id":77746,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:50114","name":"estrogen","definition":"A hormone that stimulates or controls the development and maintenance of female sex characteristics in mammals by binding to oestrogen receptors. The oestrogens are named for their importance in the oestrous cycle. The oestrogens that occur naturally in the body, notably estrone, estradiol, estriol, and estetrol are steroids. Other compounds with oestrogenic activity are produced by plants (phytoestrogens) and fungi (mycoestrogens); synthetic compounds with oestrogenic activity are known as xenoestrogens.","id":50114,"biological_role":true}],"is_released":true}
<h3 class="mt-md-0" id="title-recipe">Culture medium recipe</h3>
<div class="d-flex justify-content-between">
    <form action="" method="get" class="mw-full w-350">
                    <div class="input-group m-0 mb-5">
                                    <select name="ccno" id="ccno-select" class="form-control">
                        <option value="" disabled selected>
                            Select a strain (optional)                        </option>
                        <option value="">Standard medium</option>
                                                    <option value="JCM 23202" >Pelagicoccus albus JCM 23202</option>
                                                    <option value="JCM 23203" >Pelagicoccus mobilis JCM 23203</option>
                                            </select>
                                <div class="input-group-append">
                    <button class="btn" type="submit" title="Show strain-specific medium">
                        <i class="ph ph-flask-bacterium text-danger"></i>
                    </button>
                </div>
            </div>
            </form>
    <div>
        <div id="volume-adjustment" class="input-group mw-full w-150">
            <div class="input-group-prepend">
                <span class="input-group-text text-decoration-none" data-toggle="tooltip" data-title="Adjust final volume on this page by factor." data-placement="bottom">
                    Vol.
                </span>
            </div>
            <input class="form-control" type="number" name="volume" value="1" onchange="adjustVolume(this)" autocomplete="off">
            <div class="input-group-append">
                <span class="input-group-text">&times;</span>
            </div>
        </div>
    </div>
</div>




<div class="solution-container" id="recipe-container">
    <script type="application/ld+json">{
    "@type": "labProtocol",
    "http://purl.org/dc/terms/conformsTo": "https://bioschemas.org/profiles/LabProtocol/0.6-DRAFT-2020_12_08",

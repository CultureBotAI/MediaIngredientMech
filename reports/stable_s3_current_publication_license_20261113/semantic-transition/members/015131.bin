  "manual_metadata_assessments": [
    {
      "topic": "Four HCl current assertion scope",
      "assessment": "The complete payload diff retains all component objects, assertion evidence and original fields except completeness/notes and appended history. Active proposal phrasing now states unknown list completeness; one closure-dependent publication-hold sentence is updated with identical substantive limits. Original percentages, basis/carrier/grade uncertainty, unresolved relations and receiving-dose conflicts remain unchanged."
    },
    {
      "topic": "Difco qualified scope",
      "assessment": "The exact new assertion says CURATED_INTERPRETATION and COMPLETE only for the already declared nominal2009 seven-immediate-name list. It expressly excludes molecular composition, historical JCM lot closure, quantitative recipe or dry-mass ratio inference; adjustment/supplementation and mixed-owner partition limits remain. No component or quantity was added. This is a metadata/allowed-delta conclusion, not this reviewer’s fresh scientific endorsement."
    },
    {
      "topic": "Historical HCl reassessment",
      "assessment": "All five HCl source cases already contain successor_v3_reassessment.old_completion_reassessment_is_historical=true at frozen S5. S6 preserves those entire reassessments and adds an explicit current UNKNOWN marker. Earlier PARTIAL text is historical; it is not the selected current ComponentAssertion completeness."
    },
    {
      "topic": "Attribution and review reset",
      "assessment": "Five proposals and six cases reset only the changed scope to pending exact review while preserving prior independent_review objects inside the new lineage marker. No earlier source/owner/role/export review is treated as acceptance of this correction."
    }
  ],

"""One guarded private Hemodal applicability successor; no maintained application."""
from pathlib import Path
import copy, datetime, difflib, hashlib, importlib.util, io, json, os, subprocess, sys, tarfile
sys.dont_write_bytecode = True
D=Path(__file__).absolute().parent; C=D.parents[1]; A=C/'integration/ancillary1258-worktree';T=C.parent/'kgm-unmapped-20261107'
W=C/'workers/w02/worktree/.temp/menadione-inherited-brands-research-v1'
TR=C/'preflight/w02-menadione-research-root-collection-v1'
ISSUES=C/'preflight/menadione-hemodal-finding-publication-v1'

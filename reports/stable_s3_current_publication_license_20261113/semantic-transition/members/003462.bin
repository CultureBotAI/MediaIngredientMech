producer=R/'.temp/kgm-unmapped-20261107/claw/scripts/build_mim_ingredient_sssom.py';assert sha(producer.read_bytes())=='38d59f42953305f6fc51e4fc24dfc59ee1919bfb961595b67a8afe9f8a46a1bc'
os.environ.update(OPENCLAW_WORKSPACE=str(D/'projection-workspace'),MEDIAINGREDIENTMECH_ROOT=str(A),KGMICROBE_ROOT=str(kg.parents[1]))
native=types.ModuleType('independent_four_projection');native.__file__=str(producer);sys.modules[native.__name__]=native;exec(compile(producer.read_bytes(),str(producer),'exec'),native.__dict__)
ks=native.load_kgm_source_index(kg);kl=native.load_kgm_labels(kg)
labels={new[x['source_record']]['ontology_mapping']['ontology_id']:new[x['source_record']]['ontology_mapping']['ontology_label'] for x in check['records']}

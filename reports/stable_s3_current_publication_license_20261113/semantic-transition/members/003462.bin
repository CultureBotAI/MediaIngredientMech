rows=[]
for x in check['records']:
 p=x['source_record'];result=[]
 for i,dat in enumerate([old,new]):result.append(native._row_from_yaml(A/p,{},ks,kl,labels,record=dat[p],owners=owners[i],suppressions=[]))
 assert len(result[0])==len(result[1])==1;before,after=result[0][0],result[1][0];delta={k:{'before':before[k],'after':after[k]} for k in before if before[k]!=after[k]}
 if p.endswith('/Na2seo3.yaml'):
  assert set(delta)<={'other','source','mapping_date'};assert set(before['other'].split('|'))-set(after['other'].split('|'))=={'Na2Se2O3'};assert set(after['other'].split('|'))-set(before['other'].split('|'))==set();assert 'Na2SeO3 (anhydrous)' in after['other'].split('|')
 else:
  assert set(delta)<={'mapping_justification','confidence','source','mapping_date'};assert after['mapping_justification']=='semapv:ManualMappingCuration';assert before['mapping_justification']=='semapv:LexicalMatching';assert before['confidence']=='0.99' and after['confidence']=='0.9'
 assert after['predicate_id']=='skos:exactMatch';rows.append({'operation_id':x['operation_id'],'before':before,'after':after,'delta':delta})
out={'status':'PASS','scope':'Actual native per-owner projection with full authentic A plus four owners and three unchanged UW dependencies. Real KG gzip; official captured labels. No network providers, global generation, canonical publication, stamp/override replay or final row approval.','producer':{'path':str(producer),'sha256':sha(producer.read_bytes())},'kg':{'path':str(kg),'sha256':sha(kg.read_bytes())},'rows':rows}
(D/'independent-native-rows.json').write_text(json.dumps(out,indent=2)+'\n');print(json.dumps({'status':'PASS','rows':len(rows),'diffs':{x['operation_id']:list(x['delta']) for x in rows}},indent=2))

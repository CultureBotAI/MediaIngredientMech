            {
                "id": 2618,
                "name": "Clarified rumen fluid",
                "volume": 1000,
                "steps": [
                    {
                        "step": "Rumen fluid from cow or sheep (obtained from fistulated animals or abattoir refuse) is filtered through muslin, autoclaved at 121\u00b0C for 15 min and then centrifuged at 27,000 g for 20 min. The supernatant is made anoxic by sparging with 100% N2 gas for 15 min, dispensed under same gas atmosphere into anoxic serum vials to 30% of volume and then stored frozen at -20\u00b0C."
                    }
                ]
            },

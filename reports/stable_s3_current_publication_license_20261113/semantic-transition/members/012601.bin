<TABLE BORDER>
<TR><TD WIDTH=75%> Nitrilotriacetic acid   </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;12.8&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>

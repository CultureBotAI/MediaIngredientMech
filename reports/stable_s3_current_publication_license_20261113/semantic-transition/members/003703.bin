  "comments": [
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 3,
      "comment": "Add approximately 0.18 g powdered sulfur per test tube."
    },
    {
      "paragraph_index": 4,
      "comment": "Prior to inoculation, reduce the medium with a sterile neutral solution of sodium sulfide to 0.5 g/L final concentration. Final pH of complete medium is 6.5."
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 8,
      "comment": "Dissolve remaining ingredients, except sodium sulfide, in seawater. Adjust solution to pH 6.4 +/- 0.1."
    },
    {
      "paragraph_index": 9,
      "comment": "Under 100% N2 gas, boil, cool and dispense 6.0 ml aliquots anaerobically into tubes containing the powdered sulfur. Autoclave medium at 100C for 30 minutes on 3 consecutive days."
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 12,
      "comment": "Available from ATCC as a sterile ready-to-use liquid (Trace Mineral Supplement, catalog no. MD-TMS.)"
    },
    {
      "paragraph_index": 13,
      "comment": "Add nitrilotriacetic acid to approximately 500 ml of water and adjust to pH 6.5 with KOH to dissolve the compound."
    },
    {
      "paragraph_index": 14,
      "comment": "Bring volume to 1.0 L with remaining water and add remaining compounds one at a time."
    }
  ]
}
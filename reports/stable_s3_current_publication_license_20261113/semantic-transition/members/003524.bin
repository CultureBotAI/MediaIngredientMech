def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def put(p,b):
    p.parent.mkdir(parents=True,exist_ok=True)
    with p.open('xb') as f:f.write(b)
def js(p,v):put(p,(json.dumps(v,indent=2,ensure_ascii=False)+'\n').encode())
transport=[];by={}
def capture(p,rel):
    p=Path(p);assert p.is_file() and not p.is_symlink();b=p.read_bytes();put(F/rel,b)
    transport.append({'original_path':str(p),'fixture_path':rel,'sha256':sha(p),'bytes':len(b)});by[str(p)]=rel
F.mkdir()
for rel in ['scripts/record_review.py','schema/record_review.yaml','MAPPING_SEMANTICS.md','docs/record-reviews.md','docs/record-review-profile.md']:

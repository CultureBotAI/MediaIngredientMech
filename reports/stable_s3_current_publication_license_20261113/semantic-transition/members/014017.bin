        "component_path": "solutions/4/solutions/13/composition/0",
        "component": {
          "concentration": {
            "unit": "G_PER_L",
            "value": "20.4"
          },
          "evidence": [
            {
              "explanation": "solutions[4].composition[16].concentration -> solutions[4].solutions[13].composition[0].concentration: Move Methyl-cellulose from a flattened mix contribution into its single stock. Source 1.0200 g/50ml = 20.4 g/L stock. 0.00227 L stock / 0.05 L mix explains the former 0.92616 g/L direct contribution. NNM carrier constituents, where present, are separate and not included in this solute-only rate. Exact excerpt: \"Methyl-cellulose (See notes below) 1.0200 g/50ml - -\"; locator=sol-0 / recipe-33; table headings=['Compound', 'Amount', 'Unit', 'Conc. [g/L]', 'Conc. [mM]']. Exact excerpt: \"Add 2.27 ml of each carbon source\"; locator=sol-0 preparation step 9. Exact excerpt: \"Fill to 50 ml with NNM.\"; locator=sol-0 preparation step 9. User-contributed MediaDive P5 page, accessed 2026-10-07; source_type=user_contributed_dataset_page; page_sha256=fe4448ec7332d8e7ec8313b49ffa8e03b0c26ca54522d83fa802a19bbb25f5c7; figure_sha256=e90144dbb695abd6ac4279e294fe7b6b8a1b3d28dce4a26346fd14d78aa28917. Numeric evidence is the page text, not OCR of the inspected diagram. No journal validation or growth claim is implied.",
              "reference": "https://mediadive.dsmz.de/medium/P5",
              "snippet": "Methyl-cellulose (See notes below) 1.0200 g/50ml - -",
              "supports": "SUPPORT"
            }
          ],
          "notes": "Move Methyl-cellulose from a flattened mix contribution into its single stock. Source 1.0200 g/50ml = 20.4 g/L stock. 0.00227 L stock / 0.05 L mix explains the former 0.92616 g/L direct contribution. NNM carrier constituents, where present, are separate and not included in this solute-only rate.",
          "preferred_term": "Methyl-cellulose",
          "source": "MediaDive public Medium P5"
        },
        "notes": "RS NM preserves five 50 ml mix stages and the final 150 ml assembly. Individual source stocks, their NNM or water carriers, and exact batch additions are now explicit. Makeup-fluid quantities are unquantified rather than inferred by volume subtraction. Mix 5 has unresolved D-Mannose/L-mannose and D-Xylose/Xylan conflicts; neither alternative nor its dose is selected. No complete final-medium composition is claimed while these conflicts remain.",
        "preparation": [
          {
            "step_number": 1,
            "action": "MIX",
            "description": "Prepare the printed single stocks in purified H2O or NNM and sterilize each stock by autoclaving or 0.22 um filtration as specified."
          },
          {
            "step_number": 2,
            "action": "MIX",
            "description": "Prepare the methyl-cellulose stock in cold H2O overnight before autoclaving; prepare the pectin stock in H2O with hot-plate stirring for 20 min before autoclaving."
          },
          {
            "step_number": 3,
            "action": "MIX",
            "description": "Prepare 50 ml Mix solution 1 from the Si and Fe/EDTA stocks, fill with NNM, syringe-filter through 0.22 um, and store at 4 C."
          },
          {
            "step_number": 4,
            "action": "MIX",
            "description": "Prepare 50 ml Mix solution 2 from the nitrate-phosphate stocks, fill with NNM, syringe-filter through 0.22 um, and prepare fresh each time."
          },
          {
            "step_number": 5,
            "action": "MIX",
            "description": "Prepare 50 ml Mix solution 3 from the vitamin stocks, fill with NNM, syringe-filter through 0.22 um, and store at 4 C."
          },
          {
            "step_number": 6,
            "action": "MIX",
            "description": "Prepare 50 ml Mix solution 4 from MEM 50X amino acids, MEM 100X amino acids, and the glutamine stock; fill with NNM, syringe-filter through 0.22 um, and store at 4 C."
          },
          {
            "step_number": 7,
            "action": "MIX",
            "description": "Prepare 50 ml Mix solution 5 from glycerol and the carbon-source stocks, fill with NNM, vacuum-filter through 0.22 um, and store at 4 C."
          },
          {

            "source": "/Users/marcin/Documents/VIMSS/ontology/Mechs/MediaIngredientMech/.temp/all-unmatched-20261107/integration/final-campaign-planning-v1/observed-inputs-v1/snapshot/w01/reports/all_unmatched_20261107/worker-01/successor-1226-1237-v1/cores/final/decisions.json",

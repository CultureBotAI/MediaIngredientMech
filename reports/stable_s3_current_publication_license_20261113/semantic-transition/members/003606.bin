              }
            ],
            "issue_refs": [
              "https://github.com/CultureBotAI/MediaIngredientMech/issues/1241"
            ],
            "independent_review": {
              "status": "complete",
              "evidence_ids": [
                "w02-final-exact-independent-review-v1"
              ]
            },
            "final_correction_notes": [
              {
                "proposal_id": "a-proposal-chrome-alum",
                "finding_ids": [
                  "W02-F-CHROME-ALUM-RELATION"
                ],
                "assessment": "Use exact active MeSH concept mesh:M0314280 chrome alum, dodecahydrate, supported by NLM narrower-concept/registry context and the supplier KCr(SO4)2·12H2O/CAS7788-99-0 identity. Preserve CAS7788-99-0 as chemical property. This potassium/chromium double sulfate differs from CHEBI53471 Cr2(SO4)3 in potassium and sulfate stoichiometry as well as water; retire the old active hydrate-only CLOSE_MATCH rationale instead of substituting NARROW_MATCH. Full prior evidence and all history remain preserved. The JCM1033 Nothing-found capture is not original recipe proof; use separately inspected TOGO/MediaDive captures at their stated source/version scope. No quantity normalization or whole-owner release is approved."
              }
            ],
            "primary_author": "/root/research_b"
          }
        },

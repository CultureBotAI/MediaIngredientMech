            "media_component_reassessment": {
              "author": "/root",
              "at": "2026-11-08T09:30:56.384212+00:00",
              "issue_ref": "https://github.com/CultureBotAI/MediaIngredientMech/issues/1193#issuecomment-6719577911",
              "proposal_id": "M1193-P-RCM-182",
              "assessment": "Under the filed COMBINED37-COMPONENT-GROUNDING-001 follow-up, each printed component was assessed separately. Supported existing MIM material references are added for Sodium chloride, Agar. All literal names, nominal amounts and units are retained. Other entries remain UNMAPPED for the specific form, processing or product prerequisites recorded in the source ledger; there is no blanket unspecified-salt rule or whole-owner approval. The manufacturer describes an approximate formula per litre, adjusted and/or supplemented to meet performance criteria. COMPLETE refers to all nine nominal printed inputs, not every lot or molecular closure. Reconstitution water remains outside the dry product.",
              "whole_source_holds_unchanged": true,
              "rcm_specific_rereview": {
                "author": "/root",
                "at": "2026-11-08T09:36:52.125256+00:00",
                "assessment": "The complete Difco RCM manufacturer formula explicitly names generic Peptone at10 g per litre of standard reconstitution. This supports the named generic protein-digest part without inventing a supplier, substrate, enzyme or Bacto identity. The final reviewed generic Peptone proposal W05-FINAL-MAT-039 supplies the conditional exact target. Its target acceptance/application is a separate dependency, not a missing supplier fact about this generic named input. The earlier attribution to the20-claim #1176 consumer ledger was incorrect: that ledger contains no RCM claim. Marine Broth's separately directed peptone withdrawal is preserved. All nominal quantities, COMPLETE nine printed inputs, approximate/performance-adjustment footnote and unknown lot formulation remain unchanged.",
                "conditional_parent": "W05-FINAL-MAT-039"
              },
              "direct_parent_continuity": {
                "author": "/root",
                "at": "2026-11-08T09:48:36.209182+00:00",
                "predecessor_capture": {
                  "root": "artifact",
                  "path": "buffer-parts-v1/media/proposed-v2/Reinforced_Clostridial_Medium.yaml",
                  "sha256": "0417c3d7b1e28b8b94ee7b74fcc320ce0cc93bb3dec549447c23b03a4d11e88d"
                },
                "parent_capture": {
                  "root": "artifact",
                  "path": "buffer-parts-v1/parents-direct-v1/proposed/Peptone.yaml",
                  "sha256": "c083794668a362203de6430eaa2609c34cd8ef78574a1230aa25b4a64fb55fd7"
                },
                "assessment": "RCM printed generic Peptone input remains10 g per litre of standard reconstitution. Bind this one previously supported generic material component to the selected actual generic owner mesh:D010461, following exact reviewed W05-FINAL-MAT-039. Native section3 direct unspecified-sense priority supersedes the provisional local parent; no supplier, lot assay, substrate or enzyme inference is added. No other RCM part, quantity, nine-input COMPLETE scope or approximate/performance-adjustment qualification changes. Parent application remains conditional; no global old-ID redirect, named-product equivalence or source/role/export approval."
              }
            },

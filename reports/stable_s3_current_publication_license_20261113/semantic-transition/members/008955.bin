      "annotation" : {
        "createdBy" : [ "Carrine Blank" ],
        "definition" : [ "A mineral-salts, liquid microbiological culture medium comprised mainly of sodium bicarbonate.  Used to cultivate autotrophic microorganisms from lakes." ],
        "definition source" : [ "From:  Lindstrom, K. 1983. Selenium as a growth factor for plankton algae in laboratory experiments and in some Swedish lakes.  Hydrobiologia 101:35-48.\n\nMacronutrients (all values mg per L)\nNaHCO3                   84.00\nNaNO3                     12.75\nCaCl2x2H2O            14.70\nMgSO4x7H2O          12.32\nK2HPO4                   1.74\nNa2SiO3x9H2O       1.14\nMicronutrients\nFeCl3x6H2O            0.108\nNa2MoO4x2H2O     0.048\nZnCl2                       0.027\nMnCl2x4H2O           0.010\nCoCl2x6H2O           0.0096\nNa2SeO3x5H2O      0.000184\nEDTA                       0.558\npH 8.1" ],
        "has_exact_synonym" : [ "L 16", "L-medium No. 16", "Lindstrom media" ]
      },

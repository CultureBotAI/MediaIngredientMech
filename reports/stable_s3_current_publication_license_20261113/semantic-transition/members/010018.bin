identifier: kgmicrobe.ingredient:p1_washed_bacto_agar
preferred_term: Washed Bacto agar (MediaDive P1 preparation)
mapping_status: MAPPED
ingredient_type: UNDEFINED_MIXTURE
ontology_mapping:
  ontology_id: kgmicrobe.ingredient:p1_washed_bacto_agar
  ontology_label: Washed Bacto agar (MediaDive P1 preparation)
  ontology_source: kgmicrobe.ingredient
  mapping_quality: FALLBACK_REGISTRY
  evidence:
  - evidence_type: LLM_SUGGESTION
    source: https://www.bacmedia.dsmz.de/medium/P1
    notes: MediaDive publicP1 HaHa agar explicitly uses washed Bacto agar. Its linked
      washed-agar preparation starts with12.6g Bacto agar, adds600ml ultrapure water,
      settles/removes overlay, and repeats washing twice; final wet preparation volume
      is less than300ml. This processing-qualified material is distinct from untouched
      commercial Bacto agar. These are preparation inputs, not a final mass fraction
      or a has-part relation among grades; no dry-grade component edge or washing-water
      retention is invented.

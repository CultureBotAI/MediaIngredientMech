  ],
  "comments": [
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 3,
      "comment": "For liquid medium:"
    },
    {
      "paragraph_index": 4,
      "comment": "Add ingredients through resazurin one at a time to distilled water and mix well. Dispense medium anaerobically under a stream of 100% N2 and autoclave at 121C for 15 minutes."
    },
    {
      "paragraph_index": 5,
      "comment": "Cool to room temperature and adjust to pH 10 with filter-sterilized 10% Na2CO3."
    },
    {
      "paragraph_index": 6,
      "comment": "Reduce medium prior to inoculation by adding 1.0 ml of neutralized titanium (III) citrate per liter of medium."
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": "Add titanium chloride and sodium citrate to approximately 30-ml distilled water."
    },
    {
      "paragraph_index": 10,
      "comment": "Neutralize solution to pH 7.0 with sodium carbonate. Bring final volume to 50-ml with additional distilled water."
    }
  ]
}
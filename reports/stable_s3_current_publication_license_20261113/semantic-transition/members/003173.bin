from pathlib import Path
import datetime, hashlib, importlib.util, json, os, subprocess, sys
sys.dont_write_bytecode = True
D=Path(__file__).absolute().parent; C=D.parents[1]
O=C/'preflight/cysteine-stock-predicate-assessment-v1'; assert O.is_dir()
F=O/'native-review-fixture'; assert F.is_dir()
def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def write(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
def dump(p,x):write(p,(json.dumps(x,indent=2,ensure_ascii=False)+'\n').encode())

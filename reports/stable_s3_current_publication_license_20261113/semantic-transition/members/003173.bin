  p=F/'evidence'/rel;ev.append({'evidence_id':eid,'kind':'record_content','reference':str(p.relative_to(F)),'snapshot_sha256':sha(p),'accessed_at':at,'support':'supports','summary':summary})
review={'schema_version':'1.0.0','review_id':now.strftime('%Y%m%dT%H%M%SZ')+'-c-cysteine-stock-predicate','kind':'record','repository':ins['repository'],'title':'Cysteine stock: current solution-of predicate, preserved identity and unknowns','started_at':start,'finished_at':at,'reviewer':{'identity':'Codex /root/step7d_science_c','kind':'agent','independence':'independent','independence_basis':'C did not author W07 C-P04. C has coordinator integration/transport authorship; review is restricted to this source payload relation and original source context, not self-approval of future successors or whole plan.'},'skill':'review-yaml-record','completion':'completed','verdict':'needs_curation','scientific_review':True,'summary':'Confirmed inherited relation-grade defect: NARROW_MATCH/broadMatch is supported for the existing local stock→CHEBI91248 solution-of relation. Preserve every identity/source/unknown/history field. No payload authored or applied.','source':ins['source'],'targets':targets,'scope':{'description':'One exact selected complete source owner, with claim-specific form relation review.','selection':'C-P04 after0ca4e6c9 against authentic beforeee8eca61 and JCM680.','coverage':'full','population_size':1,'reviewed_target_ids':[tid],'exclusions':[{'target':'Phosphate #758, roles/counts and final application/export','reason':'Separate scopes; no new approval or state change.'}]},'checks':[{'check_id':'C-SOURCE','name':'Full source/term/semantics/provenance readback','status':'passed','required':True,'target_ids':[tid],'evidence_ids':['E-PRIMARY','E-TERM','E-RULE','E-CODE','E-ORIGIN'],'summary':'Exact source bytes and current active ontology form independently read. No native generation or mutation executed.'}],'evidence':ev,'assessments':[{'assessment_id':'A-IDENTITY','area':'identity','topic':'Local prepared stock versus pure monohydrate','outcome':'supported','target_ids':[tid],'evidence_ids':['E-PRIMARY','E-TERM','E-OWNER','E-SEARCH'],'summary':'Local stock remains distinct; CHEBI91248 is the supported nearest solute form. Unknown stock details remain.'},{'assessment_id':'A-PREDICATE','area':'grounding','topic':'Current solution-of relation','outcome':'concern','target_ids':[tid],'evidence_ids':['E-RULE','E-CODE','E-OLD','E-HISTORY'],'summary':'Historical CLOSE_MATCH rationale conflicts with current form-of broadMatch contract; use native NARROW_MATCH with exact registry sibling.'}],'findings':[{'finding_id':'CYS-PRED-001','issue_key':'MIM-cysteine-stock-current-form-predicate','title':'Current solution-of predicate needs NARROW_MATCH','category':'grounding','severity':'major','status':'open','certainty':'confirmed','target_ids':[tid],'ownership_note':'Per-record maintained owner data/ingredients/mapped/L-Cysteine_X_HCl_X_H2O_Solution.yaml; no mutation authorized by this review.','field_paths':['ontology_mapping.mapping_quality'],'evidence_ids':['E-PRIMARY','E-TERM','E-RULE','E-CODE','E-OLD','E-HISTORY','E-DEDUP'],'description':'Current CLOSE_MATCH obscures the explicitly supported solution-of relation. Change only the grade to NARROW_MATCH and append truthful evidence/history after issue-first authorization; preserve all original fields and unknowns.'}],'actions':[],'limitations':['The first two native save attempts refused review-metadata schema/owner-scope fields before any pair was saved; original script and stderr preserved. The corrected metadata leaves source conclusions and target bytes unchanged.','Preliminary W01 trigger was not a final full-review seal at collection.','Bounded ontology searches do not prove universal absence; no exact source-specific stock term was supported by inspected results.','No new record/schema/generator/SSSOM validation or source application was run; there are no new candidate bytes. A later actual successor needs native checks and distinct review.','Old history is evidence of historical decisions, not an error to rewrite. No pure-solute CAS/properties, source-dose concentration, role/count or export approval.','Private genuine Git fixture identifies review inputs only; production baseline remains separately pinned A842.']}
rr.validate_review(review);yp=rr.save_review(F,review);assert rr.read_review(F,str(yp.relative_to(F)))==review
mp=yp.with_name('review.md');receipt={'status':'NATIVE_SAVED_STRICT_READBACK_NEEDS_CURATION','source_root':str(F),'fixture_git_revision':ins['source']['git_revision'],'pair':{'yaml':str(yp),'yaml_sha256':sha(yp),'markdown':str(mp),'markdown_sha256':sha(mp)},'inputs':len(ins['source']['inputs']),'application_authorized':False}
dump(O/'NATIVE-REVIEW-RECEIPT.json',receipt);dump(O/'INPUT-TRANSPORT.json',transport)
members=[]
for p in sorted(O.rglob('*')):
 if p.is_file() and '.git' not in p.relative_to(O).parts:members.append({'path':str(p.relative_to(O)),'sha256':sha(p),'bytes':p.stat().st_size})
dump(O/'MANIFEST.json',{'members':members,'scope':'Exact bounded one-record assessment, no source changes; Git administrative files excluded.'})
handoff={'status':'SEALED_READ_ONLY_CYSTEINE_PREDICATE_ASSESSMENT','manifest':{'path':'MANIFEST.json','sha256':sha(O/'MANIFEST.json'),'members':len(members)},'assessment':{'path':'ASSESSMENT.md','sha256':sha(O/'ASSESSMENT.md')},'native':receipt,'selected_payload_sha256':sha(D/'inputs/cysteine-stock.yaml'),'proposed_grade':'NARROW_MATCH','proposed_predicate':'skos:broadMatch','application_authorized':False}
dump(O/'HANDOFF.json',handoff);print(json.dumps({'handoff':str(O/'HANDOFF.json'),'sha256':sha(O/'HANDOFF.json'),**handoff},indent=2))

    "recipes": [
      {
        "path": "/Users/marcin/Documents/VIMSS/ontology/Mechs/MediaIngredientMech/.temp/all-unmatched-20261107/queue/preliminary-v5/inputs/culturemech/data/normalized_yaml/bacterial/JCM_J714_HEMIN_MEDIUM_FOR_MYCOBACTERIUM.yaml",
        "sha256": "c5e9f35cc71349e809a675d003ac1427d568b4e220232349515f9bb4e06f1e2d",
        "text": "id: CultureMech:003061\nname: hemin_medium_for_mycobacterium\noriginal_name: HEMIN MEDIUM FOR MYCOBACTERIUM\ncategory: bacterial\nmedium_type: COMPLEX\ncomposition_type: UNDEFINED\nphysical_state: SOLID_AGAR\nmedia_term:\n  preferred_term: JCM Medium J714\n  term:\n    id: mediadive.medium:J714\n    label: HEMIN MEDIUM FOR MYCOBACTERIUM\nnotes: 'Source: JCM Medium 714 | Link: https://www.jcm.riken.jp/cgi-bin/jcm/jcm_grmd?GRMD=714\n\n\n  JCM Medium 714 supplements JCM Medium 386 with 60 micromol/L hemin solubilized in\n  1 N NaOH.'\ningredients:\n- preferred_term: Middlebrook 7H10 agar (BD-Difco)\n  concentration:\n    value: '19'\n    unit: G_PER_L\n  notes: JCM Medium 386 lists this commercial BD-Difco medium base as supplied.\n- preferred_term: Glycerol\n  concentration:\n    value: '5'\n    unit: ML_PER_L\n  term:\n    id: CHEBI:17754\n    label: glycerol\n  mediaingredientmech_chebi_term:\n    id: CHEBI:17754\n    label: glycerol\n  notes: JCM Medium 386 lists glycerol as 5 ml/L.\n- preferred_term: Distilled water\n  concentration:\n    value: '895'\n    unit: ML_PER_L\n  term:\n    id: CHEBI:15377\n    label: water\n  mediaingredientmech_chebi_term:\n    id: CHEBI:15377\n    label: water\n  notes: JCM Medium 386 uses 895 ml/L distilled water before OADC addition.\n- preferred_term: Middlebrook OADC Enrichment (BD-BBL)\n  concentration:\n    value: '100'\n    unit: ML_PER_L\n  notes: JCM Medium 386 aseptically adds this commercial BD-BBL enrichment.\n- preferred_term: Hemin\n  concentration:\n    value: '60'\n    unit: MICROMOLAR\n  term:\n    id: CHEBI:50385\n    label: hemin\n  mediaingredientmech_chebi_term:\n    id: CHEBI:50385\n    label: hemin\n  notes: JCM Medium 714 adds 60 micromol/L hemin solubilized with 1 N NaOH.\npreparation_steps:\n- step_number: 1\n  action: AUTOCLAVE\n  description: Sterilize the Middlebrook 7H10 agar, glycerol, and distilled water\n    at 121 C for 10 min.\n- step_number: 2\n  action: COOL\n  description: Cool to 50-55 C.\n- step_number: 3\n  action: MIX\n  description: Aseptically add 100 ml/L Middlebrook OADC Enrichment (BD-BBL), add\n    hemin to 60 micromol/L after solubilizing it with 1 N NaOH, and mix thoroughly.\nparent_media:\n  path: data/normalized_yaml/bacterial/middlebrook_7h10_agar_with_oadc_enrichment.yaml\n  relationship: SUPPLEMENTED_VARIANT\n  id: CultureMech:002743\n  name: middlebrook_7h10_agar_with_oadc_enrichment\n  notes: Parent JCM Medium 386 for the hemin-supplemented JCM Medium 714 recipe.\nvariant_relationship: SUPPLEMENTED_VARIANT\napplications:\n- Microbial cultivation\ncuration_history:\n- timestamp: '2026-01-26T17:53:17.377838Z'\n  curator: mediadive-import\n  action: Imported from MediaDive\n  notes: 'Source: JCM, ID: J714'\n- timestamp: '2026-02-03T11:26:55.834670'\n  curator: quality-tagger-v1.0\n  action: Added data quality flag\n  notes: Marked as incomplete_composition due to placeholder ingredients\n- timestamp: '2026-03-13T06:19:17.505081Z'\n  curator: culturemech-id-assigner-v1.0\n  action: Assigned CultureMech ID\n  notes: 'Assigned stable identifier: CultureMech:003061'\n- timestamp: '2026-03-17T19:45:31.222452+00:00'\n  curator: normalize_media_names_to_snake_case.py\n  action: NAME_NORMALIZED\n  notes: Normalized name from \"HEMIN MEDIUM FOR MYCOBACTERIUM\" to \"hemin_medium_for_mycobacterium\"\n    for consistent matching\n- timestamp: '2026-04-04T21:48:41.473924'\n  curator: resolve_option_c_references\n  action: RESOLVED_REFERENCE\n  changes: Copied composition from referenced medium (2 ingredients)\n  source: CultureMech:002743\n  notes: Resolved reference by copying from middlebrook_7h10_agar_with_oadc_enrichment\n    (CultureMech:002743)\n- timestamp: '2026-04-04T22:05:44.144884'\n  curator: resolve_option_c_references\n  action: RESOLVED_REFERENCE\n  changes: Copied composition from referenced medium (2 ingredients)\n  source: CultureMech:002743\n  notes: Resolved reference by copying from middlebrook_7h10_agar_with_oadc_enrichment\n    (CultureMech:002743)\n- timestamp: '2026-05-16T08:57:04.817533+00:00'\n  curator: migrate_data_quality_flags.py\n  action: MIGRATED_DATA_QUALITY_FLAGS\n  notes: dict(2 keys) -> list(1 entries)\n- timestamp: '2026-06-05T07:40:17.624995+00:00'\n  curator: mim-legacy-to-chebi-migration-v1.0\n  action: Refreshed legacy MediaIngredientMech links to CHEBI keying\n  notes: 'Replaced 2 legacy mediaingredientmech_term link(s) with mediaingredientmech_chebi_term\n    (id-safe: ingredient''s own CHEBI + label). MIM deprecated the MediaIngredientMech:NNNNNN\n    id scheme.'\n- timestamp: '2026-09-10T00:00:00-07:00'\n  curator: repair_jcm_middlebrook_hemin_score20.py\n  action: RESOLVED_JCM_MIDDLEBROOK_HEMIN_SCORE20\n  changes: Resolved JCM Medium 386/714 Middlebrook-hemin composition\n  source: https://www.jcm.riken.jp/cgi-bin/jcm/jcm_grmd?GRMD=714; https://www.jcm.riken.jp/cgi-bin/jcm/jcm_grmd?GRMD=386\n  notes: Rebuilt the recipe from live JCM Medium 386 and 714 pages.\ndata_quality_flags:\n- resolved_reference\n- ingredients_curated\n- has_ontology_mappings\n- has_unmapped_ingredients\nreferences:\n- reference: https://www.jcm.riken.jp/cgi-bin/jcm/jcm_grmd?GRMD=714\n- reference: https://www.jcm.riken.jp/cgi-bin/jcm/jcm_grmd?GRMD=386\n"

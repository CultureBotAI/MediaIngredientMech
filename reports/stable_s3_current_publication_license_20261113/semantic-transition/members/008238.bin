isted for the FE EDTA stock.\n- preferred_term: Minor Nutrients\n  concentration:\n    value: '10'\n    unit: ML_PER_L\n  composition:\n  - preferred_term: dH2O\n    concentration:\n      value: '1000'\n      unit: ML_PER_L\n    term:\n      id: CHEBI:15377\n      label: water\n    mediaingredientmech_chebi_term:\n      id: CHEBI:15377\n      label: water\n    notes: UTEX starts Minor Nutrients with approximately 950 mL dH2O.\n  - preferred_term: H3BO3\n    concentration:\n      value: '0.248'\n      unit: G_PER_L\n    term:\n      id: CHEBI:33118\n      label: boric acid\n    mediaingredientmech_chebi_term:\n      id: CHEBI:33118\n      label: boric acid\n    supplier_catalog:\n      supplier_name: Baker\n      catalog_number: 0084\n    notes: UTEX lists 0.248 g/L H3BO3, for 1.01 mM final in the stock.\n    nutritional_roles:\n    - TRACE_ELEMENT\n  - preferred_term: MnSO4 x H2O\n    concentration:\n      value: '0.184'\n      unit: G_PER_L\n    term:\n      id: CHEBI:86364\n      label: manganese(II) sulfate monohydrate\n    mediaingredientmech_chebi_term:\n      id: CHEBI:86364\n      label: manganese(II) sulfate monohydrate\n    supplier_catalog:\n      supplier_name: Sigma\n      catalog_number: M8179\n    notes: UTEX lists 0.184 g/L MnSO4 x H2O, for 1.01 mM final in the stock.\n    nutritional_roles:\n    - TRACE_ELEMENT\n  - preferred_term: ZnSO4 x 7 H2O\n    concentration:\n      value: '0.023'\n      unit: G_PER_L\n    term:\n      id: CHEBI:32312\n      label: zinc sulfate heptahydrate\n    mediaingredientmech_chebi_term:\n      id: CHEBI:32312\n      label: zinc sulfate heptahydrate\n    supplier_catalog:\n      supplier_name: Sigma\n      catalog_number: Z 0251\n    notes: UTEX lists 0.023 g/L ZnSO4 x 7 H2O, for 0.08 mM final in the stock.\n    nutritional_roles:\n    - TRACE_ELEMENT\n  - preferred_term: (NH4)6Mo7O24 x 4 H2O\n    concentration:\n      value: '0.007'\n      unit: G_PER_L\n    term:\n      id: CHEBI:86244\n      label: hexaammonium heptamo
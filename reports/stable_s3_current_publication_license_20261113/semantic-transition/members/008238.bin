      {
        "path": "/Users/marcin/Documents/VIMSS/ontology/Mechs/MediaIngredientMech/.temp/all-unmatched-20261107/queue/preliminary-v5/inputs/culturemech/data/normalized_yaml/bacterial/leptospira_medium.yaml",
        "sha256": "beffa88b7364367af7c75fb67c284c698dcfd0abe93928126880c756452ff464",
        "text": "id: CultureMech:000549\nname: leptospira_medium\noriginal_name: LEPTOSPIRA-MEDIUM\ncategory: bacterial\nmedium_type: COMPLEX\ncomposition_type: UNDEFINED\nphysical_state: SOLID_AGAR\nph_value: 7.5\nmedia_term:\n  preferred_term: DSMZ Medium 1113\n  term:\n    id: mediadive.medium:1113\n    label: LEPTOSPIRA-MEDIUM\nnotes: 'Source: DSMZ | Link: https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium1113.pdf'\ningredients:\n- preferred_term: Leptospira Medium Base EMJH\n  concentration:\n    value: '2.3'\n    unit: G_PER_L\n- preferred_term: Agarose\n  term:\n    id: CHEBI:2511\n    label: agarose\n  concentration:\n    value: '1.5'\n    unit: G_PER_L\n  mediaingredientmech_chebi_term:\n    id: CHEBI:2511\n    label: agarose\n- preferred_term: Leptospira Enrichment EMJH\n  concentration:\n    value: '100'\n    unit: G_PER_L\npreparation_steps:\n- step_number: 1\n  action: AUTOCLAVE\n  description: Dissolve the agarose in water by boiling. Add the Leptospira base and\n    dissolve completely. Autoclave at 121°C for 15 min. Allow the medium to cool to\n    50-55°C. Warm the Leptospira Enrichment to approximately 25°C and add to the warm\n    medium. Mix uniformly and dispense aseptically into sterile tubes as requested.\n    Final pH is 7.5 at 25°C.\napplications:\n- Microbial cultivation\ncuration_history:\n- timestamp: '2026-01-26T17:53:13.420464Z'\n  curator: mediadive-import\n  action: Imported from MediaDive\n  notes: 'Source: DSMZ, ID: 1113'\n- timestamp: '2026-03-13T06:18:56.296779Z'\n  curator: culturemech-id-assigner-v1.0\n  action: Assigned CultureMech ID\n  notes: 'Assigned stable identifier: CultureMech:000549'\n- timestamp: '2026-03-17T06:30:30.000000Z'\n  curator: mediaingredientmech-enrichment-v1.0\n  action: Added MediaIngredientMech links\n  notes: Linked ingredients to MediaIngredientMech identifiers\n- timestamp: '2026-03-17T19:45:07.358462+00:00'\n  curator: normalize_media_names_to_snake_case.py\n  action: NAME_NORMALIZED\n  notes: Normalized name from \"LEPTOSPIRA-MEDIUM\" to \"leptospira_medium\" for consistent\n    matching\n- timestamp: '2026-06-05T07:41:11.099876+00:00'\n  curator: mim-legacy-to-chebi-migration-v1.0\n  action: Refreshed legacy MediaIngredientMech links to CHEBI keying\n  notes: 'Replaced 1 legacy mediaingredientmech_term link(s) with mediaingredientmech_chebi_term\n    (id-safe: ingredient''s own CHEBI + label). MIM deprecated the MediaIngredientMech:NNNNNN\n    id scheme.'\n- timestamp: '2026-09-13T00:00:00-07:00'\n  curator: repair_remaining_score10_grounding_batch9.py\n  action: RESOLVED_REMAINING_SCORE10_GROUNDING_BATCH9\n  changes: marked reviewed opaque ingredients\n  source: official catalogue recipe and local exact label index\n  notes: 'Reviewed remaining score-10 grounding rows: Leptospira Medium Base EMJH,\n    Leptospira Enrichment EMJH.'\nkg_microbe_match: mediadive.medium:1113\ndata_quality_flags:\n- ingredients_curated\n- has_unmapped_ingredients\n"
      },
      {

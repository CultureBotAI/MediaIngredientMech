lue\": \"0.001261\"}},\n    {\"field\": \"ingredients[13].term\", \"new\": {\"id\": \"CHEBI:53503\", \"label\": \"cobalt\n    chloride hexahydrate\"}, \"old\": {\"id\": \"CHEBI:35696\", \"label\": \"cobalt dichloride\"}},\n    {\"field\": \"ingredients[14].preferred_term\", \"new\": \"zinc sulfate heptahydrate\",\n    \"old\": \"Zinc sulfate\"}, {\"field\": \"ingredients[14].concentration\", \"new\": {\"unit\":\n    \"MG_PER_L\", \"value\": \"4.5\"}, \"old\": {\"unit\": \"MILLIMOLAR\", \"value\": \"0.01565\"}},\n    {\"field\": \"ingredients[14].term\", \"new\": {\"id\": \"CHEBI:32312\", \"label\": \"zinc\n    sulfate heptahydrate\"}, \"old\": {\"id\": \"CHEBI:35176\", \"label\": \"zinc sulfate\"}},\n    {\"field\": \"ingredients[14].mediaingredientmech_chebi_term\", \"new\": {\"id\": \"CHEBI:32312\",\n    \"label\": \"zinc sulfate heptahydrate\"}, \"old\": {\"id\": \"CHEBI:35176\", \"label\": \"zinc\n    sulfate\"}}, {\"field\": \"ingredients[15].preferred_term\", \"new\": \"Sodium molybdate\n    hydrate (source formula unresolved)\", \"old\": \"Sodium molybdate\"}, {\"field\": \"ingredients[15].term\",\n    \"new\": null, \"old\": {\"id\": \"CHEBI:75215\", \"label\": \"sodium molybdate (anhydrous)\"}},\n    {\"field\": \"ingredients[16].preferred_term\", \"new\": \"copper(II) sulfate pentahydrate\",\n    \"old\": \"Cupric sulfate\"}, {\"field\": \"ingredients[16].concentration\", \"new\": {\"unit\":\n    \"MG_PER_L\", \"value\": \"0.3\"}, \"old\": {\"unit\": \"MILLIMOLAR\", \"value\": \"0.001201\"}},\n    {\"field\": \"ingredients[16].term\", \"new\": {\"id\": \"CHEBI:31440\", \"label\": \"copper(II)\n    sulfate pentahydrate\"}, \"old\": {\"id\": \"CHEBI:23414\", \"label\": \"copper(II) sulfate\"}},\n    {\"field\": \"ingredients[17].preferred_term\", \"new\": \"magnesium sulfate heptahydrate\",\n    \"old\": \"Magnesium sulfate\"}, {\"field\": \"ingredients[17].concentration\", \"new\":\n    {\"unit\": \"G_PER_L\", \"value\": \"0.5\"}, \"old\": {\"unit\": \"MILLIMOLAR\", \"value\": \"2.029\"}},\n    {\"field\": \"ingredients[17].term\", \"new\": {\"id\": \"CHEBI:31795\", \"label\": \"magnesium\n    sulfate heptahydrate\"}, \"old\": {\"id\": \"CHEBI:32599\", \"label\": \"magnesium sulfate\"}},\n    {\"field\": \"ingredients[17].mediaingredientmech_chebi_term\", \"new\": {\"id\": \"CHEBI:31795\",\n    \"label\": \"magnesium sulfate heptahydrate\"}, \"old\": {\"id\": \"CHEBI:32599\", \"label\":\n    \"magnesium sulfate\"}}, {\"field\": \"ingredients[18].preferred_term\", \"new\": \"iron(2+)\n    sulfate heptahydrate\", \"old\": \"Ferrous sulfate\"}, {\"field\": \"ingredients[18].concentration\",\n    \"new\": {\"unit\": \"MG_PER_L\", \"value\": \"3\"}, \"old\": {\"unit\": \"MILLIMOLAR\", \"value\":\n    \"0.01079\"}}, {\"field\": \"ingredients[18].term\", \"new\": {\"id\": \"CHEBI:75836\", \"label\":\n    \"iron(2+) sulfate heptahydrate\"}, \"old\": {\"id\": \"CHEBI:75832\", \"label\": \"iron(2+)\n    sulfate (anhydrous)\"}}, {\"field\": \"ingredients[19].concentration\", \"new\": {\"unit\":\n    \"MG_PER_L\", \"value\": \"1\"}, \"old\": {\"unit\": \"MILLIMOLAR\", \"value\": \"0.002965\"}},\n    {\"field\": \"ingredients[20].concentration\", \"new\": {\"unit\": \"G_PER_L\", \"value\":\n    \"3\"}, \"old\": {\"unit\": \"MILLIMOLAR\", \"value\": \"22.04\"}}], \"ingredient_notes\": \"Qualify\n    each original ingredient amount and source basis; preserve imported cross-references\n    as historical database annotations.\", \"preparation_steps\": {\"after\": [{\"action\":\n    \"DISSOLVE\", \"description\": \"Prepare the mineral-medium base with the source-specific\n    mineral inputs; add the vitamins separately after heat sterilization.\", \"step_number\":\n    1}, {\"action\": \"ADJUST_PH\", \"description\": \"Adjust pH if specified in original\n    formulation\", \"step_number\": 2}, {\"action\": \"HEAT\", \"description\": \"Heat-sterilize\n    the mineral medium at 120 C before adding the filter-sterilized vitamins. The\n    inspected source passage does not specify hold time or pressure.\", \"step_number\":\n    3}, {\"action\": \"MIX\", \"description\": \"Add the filter-sterilized vitamins after\n    heat sterilization, at the source-stated final vitamin concentrations. Filtration\n    pore size and addition temperature are not specified.\", \"step_number\": 4}], \"before\":\n    [{\"action\": \"DISSOLVE\", \"description\": \"Dissolve all ingredients in distilled\n    water to specified concentrations\", \"step_number\": 1}, {\"action\": \"ADJUST_PH\",\n    \"description\": \"Adjust pH if specified in original formulation\", \"step_number\":\n    2}, {\"action\": \"FILTER_STERILIZE\", \"description\": \"Sterilize by filtration (0.22\n    \\u03bcm) to preserve heat-sensitive components\", \"step_number\": 3}]}, \"references_added\":\n    [\"doi:10.1002/yea.320080703\", \"https://mediadb.systemsbiology.net/defined_media/media/398/\",\n    \"https://www.ebi.ac.uk/chebi/CHEBI%3A15940\", \"https://www.ebi.ac.uk/chebi/CHEBI%3A86158\",\n    \"https://www.ebi.ac.uk/chebi/CHEBI%3A30753\", \"https://www.ebi.ac.uk/chebi/CHEBI%3A86368\",\n    \"https://www.ebi.ac.uk/chebi/CHEBI%3A53503\", \"https://www.ebi.ac.uk/chebi/CHEBI%3A32312\",\n    \"https://www.ebi.ac.uk/chebi/CHEBI%3A75213\", \"https://www.ebi.ac.uk/chebi/CHEBI%3A31440\",\n    \"https://www.ebi.ac.uk/chebi/CHEBI%3A31795\", \"https://www.ebi.ac.uk/chebi/CHEBI%3A75836\",\n    \"doi:10.1002/(SICI)1097-0061(19960315)12:3<247::AID-YEA911>3.0.CO;2-I\"], \"relationship_descriptions\":\n    {\"variant_children\": {\"after\": [{\"id\": \"CultureMech:010558\", \"name\": \"yeast_mineral_medium_7_9_g_l_ethanol\",\n    \"notes\": \"Related mineral-media formulations from different primary studies: Verduyn\n    1992 uses 7.5 g/L ethanol in chemostat medium and reports 0.025 mL antifoam per\n    liter medium; Flikweert 1996 uses 7.9 g/L initial ethanol in batch culture and\n    reports 0.05 mL antifoam per liter demineralized-water input. They are not asserted\n    identical except for ethanol; no conversion between water-input and final-medium\n    doses is inferred.\", \"path\": \"data/normalized_yaml/fungal/yeast_mineral_medium_7_9_g_l_ethanol.yaml\",\n    \"relationship\": \"CONCENTRATION_VARIANT\"}], \"before\": [{\"id\": \"CultureMech:010558\",\n    \"name\": \"yeast_mineral_medium_7_9_g_l_ethanol\", \"notes\": \"Ethanol increased from\n    162.8 mM to 171.5 mM while the yeast mineral medium formulation remains unchanged.\",\n    \"path\": \"data/normalized_yaml/fungal/yeast_mineral_medium_7_9_g_l_ethanol.yaml\",\n    \"relationship\": \"CONCENTRATION_VARIANT\"}]}}}'\n- timestamp: '2026-10-10T06:24:13+00:00'\n  curator: codex\n  action: CORRECTED_CHEBI_REFERENCE_URL_ENCODING\n  notes: Encoded-colon paths returned HTTP 404; canonical colon paths returned HTTP\n    200. Official page titles and molecular-formula snippets match the cited identities.\n    Only live reference URLs change; prior history, amounts, identities, snippets\n    and claim wording are unchanged. ChEBI is identity evidence, not an amount source.\n  source: https://www.ebi.ac.uk/chebi/CHEBI:15940; https://www.ebi.ac.uk/chebi/CHEBI:30753;\n    https://www.ebi.ac.uk/chebi/CHEBI:31440; https://www.ebi.ac.uk/chebi/CHEBI:31795;\n    https://www.ebi.ac.uk/chebi/CHEBI:32312; https://www.ebi.ac.uk/chebi/CHEBI:53503;\n    https://www.ebi.ac.uk/chebi/CHEBI:75213; https://www.ebi.ac.uk/chebi/CHEBI:75836;\n    https://www.ebi.ac.uk/chebi/CHEBI:86158; https://www.ebi.ac.uk/chebi/CHEBI:86368\n  changes: '[{\"kind\": \"evidence_reference_urls_corrected\", \"locator\": \"Official ChEBI\n    entry; molecular formula field; matching page title\", \"new\": \"https://www.ebi.ac.uk/chebi/CHEBI:15940\",\n    \"old\": \"https://www.ebi.ac.uk/chebi/CHEBI%3A15940\", \"pointer\": [\"ingredients\",\n    2, \"evidence\", 2, \"reference\"], \"snippet\": \"C6H5NO2\"}, {\"kind\": \"evidence_reference_urls_corrected\",\n    \"locator\": \"Official ChEBI entry; molecula
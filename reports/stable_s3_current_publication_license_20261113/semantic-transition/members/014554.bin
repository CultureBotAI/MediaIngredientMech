    {
      "paragraph_index": 3,
      "comment": "Autoclave basal medium at 121C for 15 minutes. Add Na2CO3 solution. Adjust medium, if necessary, to a final pH of 9.0."
    },
    {
      "paragraph_index": 4,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "Adjust final pH of Trace Elements Solution SL-6 to 3.4."
    }
  ]

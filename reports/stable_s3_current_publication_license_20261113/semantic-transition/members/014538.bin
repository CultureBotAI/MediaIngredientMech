  "comments": [
    {
      "paragraph_index": 1,
      "comment": "The marine picocyanobacteria Synechococcus strains RS9917, WH8018, RCC307 and WH8102 were grown in PCR-S11 medium [PMID: 11034495] in polystyrene culture flasks at 22 ± 1 °C and 25 μmol photons m− 2 s− 1 white light, provided by fluorescent tubes (Sylvania Daylight)."
    },
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 4,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "To 250mL of H2O, add gradually 119,15g of Hepes. Adjust pH at 7,5 and complete the volume at 500mL. Store in refrigerator. 1M."
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": ""
    },
    {
      "paragraph_index": 11,
      "comment": "Make an equimolar mixture of this two solutions and adjust the pH at 7.5. 50mM."
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 13,
      "comment": "Prepare two solutions :"
    },
    {
      "paragraph_index": 15,
      "comment": "-Monosodium dihydrogen phosphate (NaH2PO4) at 50mM (6g in 1L)"
    },
    {
      "paragraph_index": 16,
      "comment": ""
    },
    {
      "paragraph_index": 18,
      "comment": "-Disodium hydrogen phosphate (Na2HPo4) at 50mM (3,55g in 500mL)"
    },
    {
      "paragraph_index": 19,
      "comment": ""
    },
    {
      "paragraph_index": 21,
      "comment": "Mix both solutions"
    },
    {
      "paragraph_index": 22,
      "comment": "Complete final volume to 2L of sterile water"
    },
    {
      "paragraph_index": 23,
      "comment": "Store in refrigerator"
    },
    {
      "paragraph_index": 24,
      "comment": ""
    },
    {
      "paragraph_index": 26,
      "comment": "To 40mL of HCl 0,1N, add gradually 1,080g of FeCl3"
    },
    {
      "paragraph_index": 27,
      "comment": ""
    },
    {
      "paragraph_index": 29,
      "comment": "To 40mL of NaOH 0,1N, add gradually 1,488g of Na2-EDTA"
    }
  ]
}

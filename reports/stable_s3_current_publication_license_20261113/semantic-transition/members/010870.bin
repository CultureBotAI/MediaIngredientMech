{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/CHEBI_131730","ontology_name":"micro","related_synonyms":["(7R)-7-(alpha-D-4-hydroxyphenylglycylamino)-3-(1H-1,2,3-triazol-4-ylthiomethyl)-3-cephem-4-carboxylic acid","BL-S 640","BL-S640","BLS 640","SKF 60771","antibiotic BL-S 640","cefatrizina","cefatrizine","cefatrizinum"],"ontology_prefix":"MICRO","short_form":"CHEBI_131730","description":["A cephalosporin compound having (1H-1,2,3-triazol-4-ylsulfanyl)methyl and [(2R)-2-amino-2-(4-hydroxyphenyl)]acetamido side-groups. An antibacterial drug first prepared in the 1970s, it has more recently been found to be an inhibitor of eukaryotic elongation factor-2 kinase (eEF2K), which is known to regulate apoptosis, autophagy and ER stress in many types of human cancers."],"label":"cefatrizine","obo_id":"CHEBI:131730","type":"class","exact_synonyms":["(6R,7R)-7-{[(2R)-2-amino-2-(4-hydroxyphenyl)acetyl]amino}-8-oxo-3-[(1H-1,2,3-triazol-4-ylsulfanyl)methyl]-5-thia-1-azabicyclo[4.2.0]oct-2-ene-2-carboxylic acid"]}],"numFound":1,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["MICRO","1"],"isDefiningOntology":["false","1"],"ontologyId":["ncbitaxon","690","pr","313","cco","124","gexo","104","rexo","100","reto","96","mesh","55","ncit","51","omit","50","hgnc","48","efo","32","oba","26","pride","26","cido","17","upheno","14","txpo","12","chebi","11","slm","10","tfo","6","go","5","fypo","4","medgen","4","xpo","4","ordo","4","ictv","4","enm","3","fbbt","3","dron","3","ado","2","zp","2","mod","2","cl","2","chiro","2","ror","2","bao","2","hgnc.genegroup","2","idomal","2","fbdv","1","micro","1","wbphenotype","1","clao","1","clo","1","hao","1","peco","1","fbcv","1","dpo","1"],"ontologyIri":["http://purl.obolibrary.org/obo/MicrO.owl","1"],"isObsolete":["false","1"],"type":["class","1"]}}}
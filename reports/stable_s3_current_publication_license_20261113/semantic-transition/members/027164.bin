    "2610": {
      "row_sha256": "59ebab5665b5691ff39bb9aeb89ab641392e9b64e19d8938a7cf9500f32741dd",
      "owner_record": "data/ingredients/mapped/Sodium_Perchlorate_Monohydrate.yaml",
      "owner_record_sha256": "8d177236510aa2186d3e43e53c095a80c596e804c97d09a4f45fed234c03522c",
      "disposition": "SUPPORTED",
      "review_reason": "The actual sodium perchlorate monohydrate row is supported as a form-of skos:broadMatch to CHEBI:132103 sodium perchlorate. Archived PubChem CID516899 has one water component in addition to the sodium/perchlorate structure represented by the water-free ChEBI parent. The parent row has empty other and validation_method cells, resolving the old hydrate-CAS alias leakage and providing an explicit asymmetric relation instead of inherited closeMatch approval. This supports the bounded relation, not global exhaustion of exact ontology alternatives.",

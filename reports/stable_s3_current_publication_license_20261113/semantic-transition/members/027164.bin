    "2146": {
      "row_sha256": "343b603e7147b8addd60aa20bd1298142a594d8f3988b06b358fb854c5392ea7",
      "owner_record": "data/ingredients/mapped/Nutrient_Broth_No_2.yaml",
      "owner_record_sha256": "71bc906774a133ae4b557a18d3704c8c8fec34be8277d5e6d0aab71b19f5fbe4",
      "disposition": "WITHHOLD",
      "review_reason": "The EXACT_MATCH source-grade guard does not catch this row. Its approved historical report assumes Nutrient Broth No. 2 and BD 234000 are catalog aliases of one nutrient-broth subject, but primary recipes distinguish them: NBRC 1559/Oxoid CM0067B uses Lab-Lemco 10 g/L, peptone 10 g/L and NaCl 5 g/L; ATCC Medium 3 identifies BD 234000 at 8 g/L, equivalent to beef extract 3 g/L and peptone 5 g/L, with no added NaCl. The manufacturer also explicitly distinguishes No. 2 from standard Oxoid nutrient broth. Preserve the source labels but withhold their equivalence until the product identities and generic superclass mapping are separated.",
      "identity_projection": {
        "kind": "mim-inherited-identity-projection/v1",
        "manifest": "reports/stable_ids_1265_20261108/migration.json",

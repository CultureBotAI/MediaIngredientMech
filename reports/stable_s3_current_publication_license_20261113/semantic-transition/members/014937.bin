{"response":{"docs":[{"iri":"http://snomed.info/id/711087009","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_711087009","description":[],"label":"Swine serum albumin","obo_id":"","type":"class"},{"iri":"http://snomed.info/id/388350002","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_388350002","description":[],"label":"Swine serum albumin specific immunoglobulin E","obo_id":"","type":"class"},{"iri":"http://snomed.info/id/392452003","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_392452003","description":[],"label":"Swine serum albumin specific IgE antibody measurement","obo_id":"","type":"class"},{"iri":"http://snomed.info/id/411611007","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_411611007","description":[],"label":"Swine serum albumin diagnostic allergen extract","obo_id":"","type":"class"},{"iri":"http://purl.obolibrary.org/obo/VO_0009052","ontology_name":"vo","ontology_prefix":"VO","short_form":"VO_0009052","description":["Combination vaccine using live attenuated Brucella abortus BCSP31 salmonella chi 4064 vector vaccine. Orally immunized swine developed serum and intestinal antibody responses to BCSP31 and salmonella endotoxin. Effective stimulation of mucosal and systemic antibody-mediated immunity was observed after oral immunization with recombinant s. Typhimurium expressing bcsp31, but no antigen-specific delayed-type hypersensitivity or blastogenic response was induced by this route."],"label":"live attenuated Brucella abortus BCSP31 Salmonella chi 4064 vector vaccine","obo_id":"VO:0009052","type":"class"},{"iri":"http://purl.obolibrary.org/obo/VO_0009101","ontology_name":"vo","ontology_prefix":"VO","short_form":"VO_0009101","description":["Combination vaccine using live attenuated salmonella choleraesuis chi 3781 mutant carrying recombinant plasmid pba31-r7 expressing Brucella abortus BCSP31 protein. Recombinant salmonella choleraesuis vaccine colonized gut mucosa and deep tissues in mice and swine. Mice developed serum antibodies to BCSP31 and salmonella endotoxin and local intestinal antibody response to salmonella endotoxin but not BCSP31."],"label":"live attenuated Brucella abortus BCSP31 Salmonella chi 3781 vector vaccine","obo_id":"VO:0009101","type":"class"}],"numFound":6,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["","4","VO","2"],"isDefiningOntology":["true","6"],"ontologyId":["snomed","4","vo","2"],"ontologyIri":["","4","http://purl.obolibrary.org/obo/vo.owl","2"],"isObsolete":["false","6"],"type":["class","6"]}}}
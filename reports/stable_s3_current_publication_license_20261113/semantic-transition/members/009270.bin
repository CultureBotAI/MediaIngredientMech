  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Add and mix all components except for OADC. Autoclave at 121ºC, cool to room temperature and aseptically add OADC."
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": "OADC is available from BD (237510) or can be made following the formulation above."
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": "*Note: Mycobactin J is stored dehydrated in 2 mg quantities unless otherwise specified. Rehydrate w/ 2mL ethanol or 1mL/mg. (Available from Allied Laboratories, Inc., 2520 Hunt St. Ames, IA 50010)."
    }
  ]
}
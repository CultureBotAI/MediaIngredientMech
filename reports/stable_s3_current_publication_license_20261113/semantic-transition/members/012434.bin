  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Adjust pH to 7.0 -- 7.5."
    },
    {
      "paragraph_index": 3,
      "comment": "For preparation of solid medium, add 15.0 g/L agar."
    },
    {
      "paragraph_index": 5,
      "comment": "Dissolve and neutralized nitrilotriacetic acid in 500.0 ml distilled water with the addition of KOH. Add the remaining chemicals in order listed. Adjust pH to 6.8 and bring volume to 1.0 L with distilled water."
    }
  ]

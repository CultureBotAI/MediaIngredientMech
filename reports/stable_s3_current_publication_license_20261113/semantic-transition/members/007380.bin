  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Add ingredients through vitamins and adjust to pH 5.5. Add NaHCO3, boil, degas and dispense anaerobically under 100% CO2."
    },
    {
      "paragraph_index": 3,
      "comment": "Autoclave at 121C for 15 minutes. Add fructose and reducing agents from sterile anaerobic stock solutions prepared under 100% N2. Final pH is 5.9."
    },
    {
      "paragraph_index": 4,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "Add nitrilotriacetic acid to water and adjust to pH 6.0 with KOH. Add remainder of ingredients."
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": "Available from ATCC as a sterile ready-to-use liquid (Vitamin Supplement, catalog no. MD-VS)."
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 12,
      "comment": "Boil NaOH and water under 100% N2. Add cysteine; then Na2S."
    },
    {
      "paragraph_index": 13,
      "comment": "Tube anaerobically with same gas phase and autoclave."
    }
  ]
}
{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/DRON_00027596","ontology_name":"dron","ontology_prefix":"DRON","short_form":"DRON_00027596","description":[],"label":"ammonium phosphate / DISODIUM PYROPHOSPHATE / Sodium Phosphate, Monobasic Oral Tablet","obo_id":"DRON:00027596","type":"class"},{"iri":"http://purl.obolibrary.org/obo/DRON_00027597","ontology_name":"dron","ontology_prefix":"DRON","short_form":"DRON_00027597","description":[],"label":"ammonium phosphate / DISODIUM PYROPHOSPHATE / Sodium Phosphate, Monobasic Delayed Release Oral Tablet","obo_id":"DRON:00027597","type":"class"},{"iri":"http://purl.obolibrary.org/obo/DRON_00043882","ontology_name":"dron","ontology_prefix":"DRON","short_form":"DRON_00043882","description":[],"label":"ammonium phosphate 95 MG / DISODIUM PYROPHOSPHATE 55 MG / Sodium Phosphate, Monobasic 100 MG Oral Tablet","obo_id":"DRON:00043882","type":"class"},{"iri":"http://purl.obolibrary.org/obo/DRON_00043883","ontology_name":"dron","ontology_prefix":"DRON","short_form":"DRON_00043883","description":[],"label":"ammonium phosphate 95 MG / DISODIUM PYROPHOSPHATE 55 MG / Sodium Phosphate, Monobasic 100 MG Delayed Release Oral Tablet","obo_id":"DRON:00043883","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/C007377","ontology_name":"mesh","related_synonyms":["di(2-ethylhexyl)phosphate","di-2-(ethylhexyl)phosphoric acid, ammonium salt","di-2-(ethylhexyl)phosphoric acid, potassium salt","di-2-(ethylhexyl)phosphoric acid, sodium salt","sodium bis(2-ethylhexyl)phosphate"],"ontology_prefix":"mesh","short_form":"mesh_C007377","description":[],"label":"di-2-(ethylhexyl)phosphoric acid","obo_id":"mesh:C007377","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/C031599","ontology_name":"mesh","related_synonyms":["1,2-dipalmitoyl-sn-glycero-3-phosphate","dipalmitoyl phosphatidic acid","dipalmitoylphosphatidic acid, (+-)-isomer","dipalmitoylphosphatidic acid, (R)-isomer","dipalmitoylphosphatidic acid, ammonium salt","dipalmitoylphosphatidic acid, calcium salt","dipalmitoylphosphatidic acid, sodium salt"],"ontology_prefix":"mesh","short_form":"mesh_C031599","description":[],"label":"dipalmitoylphosphatidic acid","obo_id":"mesh:C031599","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/C065087","ontology_name":"mesh","related_synonyms":["di-n-butylphosphoric acid, ammonium salt","di-n-butylphosphoric acid, potassium salt","di-n-butylphosphoric acid, sodium salt","di-n-butylphosphoric acid, vanadium salt","dibutyl phosphate","dibutylphosphoric acid"],"ontology_prefix":"mesh","short_form":"mesh_C065087","description":[],"label":"di-n-butylphosphoric acid","obo_id":"mesh:C065087","type":"class"},{"iri":"http://purl.obolibrary.org/obo/NCIT_C29288","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C29288","description":["A combination preparation containing potassium phosphate and sodium phosphate used for electrolyte-replacement purposes, dietary supplementation and to acidify urine. Phosphate, a predominant intracellular anion, plays an important role in energy storage, osteoblastic and osteoclastic activities, regulating serum calcium concentrations and numerous cellular phosphate-transfer reactions. Potassium phosphate and sodium phosphate are used to acidify the urine and lower the urinary calcium concentration. This may reduce rash and odor caused by ammonium in the urine."],"label":"Potassium Phosphate/Sodium Phosphate","obo_id":"NCIT:C29288","type":"class","exact_synonyms":["Neutra-Phos","PHOS-NaK","Potassium Phosphate/Sodium Phosphate"]},{"iri":"http://id.nlm.nih.gov/mesh/D016718","ontology_name":"mesh","related_synonyms":["(all-Z)-5,8,11,14-Eicosatetraenoic acid","Arachidonate, Sodium","Arachidonic Acid, (all-Z)-Isomer, 1-(14)C-Labeled","Arachidonic Acid, (all-Z)-isomer, 3H-Labeled","Arachidonic Acid, Ammonium Salt, (all-Z)-Isomer","Arachidonic Acid, Cerium Salt, (all-Z)-Isomer","Arachidonic Acid, Cesium Salt, (all-Z)-Isomer","Arachidonic Acid, Lithium Salt, (all-Z)-Isomer","Arachidonic Acid, Potassium Salt, (all-Z)-Isomer","Arachidonic Acid, Sodium Salt","Arachidonic Acid, Sodium Salt, (all-Z)-Isomer","Arachidonic Acid, Zinc Salt, (all-Z)-Isomer","Sodium Arachidonate","Vitamin F"],"ontology_prefix":"mesh","short_form":"mesh_D016718","description":["An unsaturated, essential fatty acid. It is found in animal and human fat as well as in the liver, brain, and glandular organs, and is a constituent of animal phosphatides. It is formed by the synthesis from dietary linoleic acid and is a precursor in the biosynthesis of prostaglandins, thromboxanes, and leukotrienes."],"label":"Arachidonic Acid","obo_id":"mesh:D016718","type":"class"}],"numFound":9,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["DRON","4","mesh","4","NCIT","1"],"isDefiningOntology":["true","9"],"ontologyId":["dron","4","mesh","4","ncit","1"],"ontologyIri":["http://purl.obolibrary.org/obo/dron.owl","4","https://w3id.org/biopragmatics/resources/mesh/mesh.ofn","4","http://purl.obolibrary.org/obo/ncit.owl","1"],"isObsolete":["false","9","true","2"],"type":["class","9"]}}}
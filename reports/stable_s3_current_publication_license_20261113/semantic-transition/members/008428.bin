              }
            ],
            "roles": []
          },
          {
            "component_name": "Nitrogen gas",
            "gmo": "http://purl.jp/bio/10/gmo/GMO_002261",
            "gmo_id": "GMO_002261",
            "label": "Nitrogen gas",
            "properties": [
              {
                "id": "GMO_000077",

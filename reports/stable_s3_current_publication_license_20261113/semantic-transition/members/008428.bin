        "comments": [
          {
            "paragraph_index": 2,
            "comment": ""
          },
          {
            "paragraph_index": 4,
            "comment": "Adjust pH to 7.2 -- 7.4."
          },
          {
            "paragraph_index": 5,
            "comment": "Prepare the medium anaerobically, dispense its 5 ml each in anaerobic tubes under a N2--CO2 atmosphere (80:20) and autoclave. Add the following solutions via injection from sterile anaerobic stock solutions per 5 ml:"
          },
          {
            "paragraph_index": 6,
            "comment": ""
          },
          {
            "paragraph_index": 10,
            "comment": "Adjust pH to 7.0 with 1 N NaOH and filter--sterilize."
          }
        ],

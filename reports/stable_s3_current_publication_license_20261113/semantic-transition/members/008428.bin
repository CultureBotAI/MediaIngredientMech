        "excluded_from_preparation": [
          {
            "component_name": "Carbon dioxide gas",
            "gmo": "http://purl.jp/bio/10/gmo/GMO_002260",
            "gmo_id": "GMO_002260",
            "label": "Carbon dioxide gas",
            "properties": [
              {
                "id": "GMO_000077",

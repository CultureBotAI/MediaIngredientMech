                "id": "GMO_000077",
                "uri": "http://purl.jp/bio/10/gmo/GMO_000077",
                "label": "ガス"
              }
            ],
            "roles": []
          }
        ],
        "comments": [
          {
            "paragraph_index": 2,
            "comment": "Distribute the medium into appropriate culture vessels (e.g., 10 ml in Hungate tubes) under the same gas mixture. Then, add per liter the following solution (filter-sterilized, freshly prepared):"
          },
          {
            "paragraph_index": 4,
            "comment": ""
          },
          {
            "paragraph_index": 6,
            "comment": "Mix components thoroughly and autoclave under a N2-CO2 (4:1, v/v) atmosphere. After cooling, aseptically and anaerobically add the following solutions (autoclaved or *filtersterilized):"
          },
          {
            "paragraph_index": 7,
            "comment": ""
          },
          {
            "paragraph_index": 8,
            "comment": "Trace element solution: Use trace element solution of Medium No. 243 without Na2SeO3·5H2O."
          },
          {
            "paragraph_index": 10,
            "comment": "Dissolve nitrilotriacetic acid first in 200 ml of distilled water,and adjust pH to 6.5 with KOH. Then add the remaining salts and adjust volume to 1.0 L. Readjust pH to 7.0 with KOH."
          },
          {
            "paragraph_index": 11,
            "comment": ""
          }
        ],

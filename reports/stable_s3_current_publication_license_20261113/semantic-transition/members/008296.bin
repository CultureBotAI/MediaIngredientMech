  "findings": [
    {
      "finding_id": "c2-b-carbonate-component-owner-collision",
      "status": "retained_integration_dependency",
      "description": "CHEBI29377 is used by both active Na2co3.yaml and Sodium_Carbonate_Solution.yaml. The new8%w/v stock has sodium carbonate as a part, not a part identical to that pre-existing ambiguous whole-solution owner. Exact owner bytes are captured in the component manifest. Reconcile inherited duplicate/whole-versus-part ownership before release; no merge or existing owner correction is authorized by this review."

  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Adjust pH of complete medium to 6.0."
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 4,
      "comment": "Dissolve ingredients (except Trypticase peptone, yeast extract, sodium thiosulfate and sulfide), adjust pH to 6.0 and sparge medium with 100% N2 gas for at least 30 min to remove dissolved oxygen"
    },
    {
      "paragraph_index": 5,
      "comment": "After autoclaving add peptone, yeast extract, thiosulfate and sulfide from sterile anoxic stock solutions prepared under 100% N2 gas."
    },
    {
      "paragraph_index": 6,
      "comment": "Stock solutions of substrates can be autoclaved with the exception of sodium thiosulfate which should be sterilized by filtration."
    },
    {
      "paragraph_index": 7,
      "comment": "Prior to inoculation adjust pH of final medium to 6.0."
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": "Adjust pH of final solution to 2 with 1 N HCl."
    }
  ]
}
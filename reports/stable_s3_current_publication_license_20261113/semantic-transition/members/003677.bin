context=[C/'preflight/final-central-reconciliation-inventory-v1/central-action-ledger.json',C/'preflight/final-central-reconciliation-inventory-v1/family-independent-coverage-67.json',C/'preflight/central24-25-nominal-decisions-v1/decisions.json',C/'preflight/family-nominal-candidates-independent-v2/HANDOFF.json',C/'integration/final-operation-admissibility-v3/per-operation-admissibility.json',C/'integration/final-operation-admissibility-v3/per-origin-scientific-review-chains.json',C/'preflight/w03-published-head-review-v1/proposal-assessments.json',C/'preflight/w09-chemical-findings-publication-v1/issue-1237-comment.md',C/'preflight/phosphate758-cancelled-root-status-correction-v1/receipt.json',C.parents[1]/'MAPPING_SEMANTICS.md']

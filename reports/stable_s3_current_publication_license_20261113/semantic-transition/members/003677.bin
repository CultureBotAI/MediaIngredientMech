from pathlib import Path
import json,hashlib,datetime,re
C=Path(__file__).resolve().parents[2];D=Path(__file__).resolve().parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def pin(p):
 b=p.read_bytes();return {'path':str(p),'sha256':sha(b),'bytes':len(b)}
def save(n,o):
 with (D/n).open('x') as f:json.dump(o,f,indent=2,ensure_ascii=False);f.write('\n')
inv=json.loads((D/'ORIGINAL-PROPOSAL-INVENTORY.json').read_bytes());ten=json.loads((D/'TEN-OPERATION-DISPOSITION-JOINS.json').read_bytes());groups=json.loads((D/'CONDITION-TEXT-GROUPS.json').read_bytes())
names={x['origin']['proposal_id'] for x in ten['rows']}
known={'if-reject-monohydrate-on-dihydrate','if-add-mono-source-spelling','NSV4-PROP-NBRC_1020_Se_W_Solution','NSV4-PROP-JCM_317_Se_W_Solution','CS-PROP-NBRC1321_CO2_BICARBONATE_STOCK'}
nominal={'R1193-P-wolfe470','R1193-P-wolfe1190','R1193-P-wolfe221','R1193-P-wolfe792','CHEM-C1193-HEPES-1221','CHEM-C1193-HEPES-1474','CHEM-C1193-ethanol95-atcc_1490','CHEM-C1193-ethanol95-atcc_1257','CHEM-C1193-ethanol95-atcc_1524','CHEM-C1193-ethanol95-dsmz_78','A-PROPOSAL-DSM590_Hutner_Basal_Salts','B-PROPOSAL-dsmz_1144_hutner_basal_salts','W07-COMBINED-JCM900-JCM979-Hutner'}
coupled={'FREV-MEDIA-P-media-followup-oxoid_cm0331_columbia_blood_agar_base','sv1-bio-columbia_blood_agar_oxoid_m2224','sv3-hm-difco-columbia1270','sv7-dependent-columbia-unmapped0118-partition','b2-proposal-Ferric_ammonium_EDTA','b2-proposal-ferric_ammonium_edta_4mgml_dsmz1132'}
qualified={'RS-003-BASE-IDENTITY','A-P-ATCC-MDTMS','b-proposal-pplo-255420','b-proposal-pplo-211458','b-proposal-bd238400','FREV-MEDIA-P-I1201-MEDIA-P-gibco_042_1545_cmrl_1066','A-P-JCM576-SL12','A-P-PCRS11-FE-EDTA-2019','C-P-ROSCOFF2019-GAFFRON-SE','ab-proposal-angustmycin'}
rows=[]
for r in inv['records']:
 p=r['proposal_id']
 cl=('ROOT_SELECTED_ADDITIONAL_DEFERRAL_EXPLICIT_UNSATISFIED_CONDITION' if p in names else 'KNOWN_PREEXISTING_ROOT_ROUTED_STOCK_OR_758_HOLD' if p in known else 'CURRENT_SELECTION_COALESCES_ORIGINS_INTO_REVIEWED_NOMINAL_SCOPE' if p in nominal else 'NAMED_DEPENDENCY_OR_COMPOSITION_PRESENT_IN_CURRENT_SELECTION' if p in coupled else 'QUALIFIED_REVIEW_OR_ROUTING_LIMIT_NOT_AUTOMATIC_SOURCE_BLOCK' if p in qualified else 'PREVIOUSLY_NONSELECTED_ORIGIN_UNCHANGED' if not r['selected_operations'] else 'NO_ADDITIONAL_CONCRETE_APPLICATION_BLOCK_IDENTIFIED_IN_THIS_BOUNDED_AUDIT')
 rows.append({'worker_slot':r['worker_slot'],'proposal_id':p,'original_proposal_sha256':r['proposal_object_sha256'],'core':r['proposal_core'],'selector':r['selector'],'case_ids':r['case_ids'],'selected_operations':r['selected_operations'],'audit_classification':cl,'approval_granted':False})
assert len(rows)==1022
save('ALL-1022-DISPOSITION-INVENTORY.json',{'scope':'Complete mechanical inventory and explicit-condition triage. Classification is not fresh full scientific review, approval, or permission to ignore source/role/export holds. Only named manual dispositions recommend deferral; no keyword-driven deletion.', 'rows':rows})
pat1=re.compile(r'before (?:app|co-|integr|owner)|beforeapp|beforeintegr|beforeapply|only after|blocked as|application.?hold|application/export|before simultaneous|must be reconciled|must reconcile|apply only|co-install',re.I)
pat2=re.compile(r'(?:do not|cannot|must not|require|depend|block|conditional|unless|only if|until).{0,110}(?:install|appli|integrat|simultaneous)|(?:install|appli|integrat).{0,100}(?:block|unless|depend|must not|require)',re.I)
leads=[x for x in groups if pat1.search(x['text']) or pat2.search(x['text'])]
save('CONDITION-DISCOVERY-LEADS.json',{'scope':'Discovery only, not an automatic blocker classifier. Manual conclusions are in ASSESSMENT and ten-operation join.', 'groups':leads,'count':len(leads)})
W=C/'workers/w01/worktree/.temp/conditional-full-row-review-v1';wd=json.loads((W/'DECISIONS-v2.json').read_bytes())['decisions'];w09=C/'workers/w09/worktree/.temp/conditional-full-row-review-v1/DECISIONS.json';d9=json.loads(w09.read_bytes())['requests']
operation_ids={r['native_operation']['operation_id'] for r in ten['rows']}
reviewrows=[r for r in wd if r['operation_id'] in operation_ids or any(s in r['owner'] for s in ['PPLO','Mycoplasma','atcc_md_tms','CMRL','Middlebrook'])]
reviewrows9=[r for r in d9 if r['owner'] in ['data/ingredients/mapped/ATCC_173_Middlebrook_7H10_Agar_Base.yaml','data/ingredients/mapped/Wards_Cerophyll_Cereal_Grass_Leaves.yaml']]

                <p><a href="text/glossary#citation-of-names-and-authors" class="helper" target="_blank"></a> <b>Classification:</b>&nbsp;
                </p>
            </div>
            <div class="classification">
                                    <a href="/domain/bacteria" class=" color-domain"><STRONG><I>Bacteria</I></STRONG></a>                                    <a href="/kingdom/bacillati" class=" color-kingdom"><STRONG><I>Bacillati</I></STRONG></a>                                    <a href="/phylum/actinomycetota" class=" color-phylum"><STRONG><I>Actinomycetota</I></STRONG></a>                                    <a href="/class/actinomycetes" class=" color-class"><STRONG><I>Actinomycetes</I></STRONG></a>                                    <a href="/order/kitasatosporales" class=" color-order"><STRONG><I>Kitasatosporales</I></STRONG></a>                                    <a href="/family/streptomycetaceae" class=" color-family"><STRONG><I>Streptomycetaceae</I></STRONG></a>                                    <a href="/genus/streptomyces" class=" color-genus"><STRONG><I>Streptomyces</I></STRONG></a>                                    <a href="/species/streptomyces-canarius" class=" color-species"><STRONG><I>Streptomyces</I> <I>canarius</I></STRONG></a>                            </div>
        </div>
    

    <p><a href="text/glossary#citation-of-names-and-authors" class="helper" target="_blank"></a>
        <b>Name:</b> <I>Streptomyces</I> <I>canarius</I> Vavra and Dietz 1965 (Approved Lists 1980)</p>

    <!--    <p><a href="text/glossary#taxonomic-categories" class="helper" target="_blank"></a>
        <b>Category:</b> <? /*= ucfirst($data['category']) */ ?></p>
-->
    <p>
                    <a href="text/glossary#abbreviations-in-proposals" class="helper" target="_blank"></a>
                <b>Category, proposed as:</b> species, sp. nov.    </p>


    

            <p>
            <a href="text/glossary#abbreviations-in-etymologies" class="helper" target="_blank"></a>
            <b>Etymology:</b>
            <span class="checked">ca.na’ri.us.</span> <span class="checked">L. masc. adj.</span> <i><abbr title="canarius - canaria - canarium">canarius</abbr></i>, of or belonging to the Canary Islands, intended to refer to production of a bright canary yellow pigment on a variety of media        </p>
    

                                        <p>
                    <a href="text/glossary#pronunciation" class="helper" target="_blank"></a>
                    <b>Pronunciation (Latin), gender:</b>
                    strep-TO-my-kes ka-NA-ri-us, masculine                </p>
                        

    

            <p>
            <a href="text/glossary#nomenclatural-type" class="helper" target="_blank"></a>
                                                <b>Type strain:</b>
                                        <a href="https://www.atcc.org/products/27423" target="_blank">ATCC 27423</a>; <a href="https://catalog.bcrc.firdi.org.tw/BcrcContent?bid=11621" target="_blank">BCRC 11621</a>; <a href="https://wi.knaw.nl/NCCB/CBS%20732.72" target="_blank">CBS 732.72</a>; <a href="https://catalog.bcrc.firdi.org.tw/BcrcContent?bid=11621" target="_blank">CCRC 11621</a>; <a href="https://cgmcc.net/english/search?stn=4.1581" target="_blank">CGMCC 4.1581</a>; <a href="https://www.dsmz.de/collection/catalogue/details/culture/DSM-40528" target="_blank">DSM 40528</a>; <a href="https://kotka.luomus.fi/culture/bac" target="_blank">HAMBI</a> 1014; <a href="https://www.nite.go.jp/nbrc/catalogue/NBRCCatalogueDetailServlet?ID=IFO&CAT=00013431" target="_blank">IFO 13431</a>; IMET 43539; <a href="https://www.jcm.riken.jp/cgi-bin/jcm/jcm_number?JCM=4549" target="_blank">JCM 4549</a>; <a href="https://www.jcm.riken.jp/cgi-bin/jcm/jcm_number?JCM=4733" target="_blank">JCM 4733</a>; <a href="https://www.nite.go.jp/nbrc/catalogue/NBRCCatalogueDetailServlet?ID=NBRC&CAT=00013431" target="_blank">NBRC 13431</a>; NCIB 9468; <a href="https://store.ncimb.com/NCIMB/NCIMB%209468" target="_blank">NCIMB 9468</a>; <a href="https://nrrl.ncaur.usda.gov/cgi-bin/usda/prokaryote/report.html?nrrlcodes=2976" target="_blank">NRRL 2976</a>; <a href="https://nrrl.ncaur.usda.gov/cgi-bin/usda/prokaryote/report.html?nrrlcodes=ISP-5528" target="_blank">NRRL ISP-5528</a>; RIA 1392        </p>
    
            <p class="bacdive-link">
            <a href="text/glossary#bacidivei" class="helper" target="_blank"></a>
            See detailed strain information at
            <a href="https://bacdive.dsmz.de/strain/15064" target="_blank">
                <img src="img/logos/bacdive_small.svg" width="100" height="25" alt="bacdive-logo">
            </a>
        </p>
    

            <p class="tygs-link">

  "comments": [
    {
      "paragraph_index": 2,
      "comment": "This medium has problems with precipitate. Add chemicals in the order as listed."
    },
    {
      "paragraph_index": 3,
      "comment": "Make mg/ml solution for Fe(NH4)2(SO4)2 x 6H20, Resazurin, and Na2S x 9H20."
    },
    {
      "paragraph_index": 4,
      "comment": "Gas under 80% N2 and 20% CO2 for 45 minutes. Check pH and lower to 7.0. Dispense, then autoclave."
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": "Filter Sterilize"
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": "Filter Sterilize"
    }
  ]

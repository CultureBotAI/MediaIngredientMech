{"response":{"docs":[{"iri":"http://id.nlm.nih.gov/mesh/D005083","ontology_name":"mesh","related_synonyms":["Dermolysins","Epidermolysins","Epidermolytic Toxins","Exfoliatin Toxin A","Exfoliative Toxin B","Exfoliative Toxin, Staphylococcal","Exfoliative Toxins","Staphylococcal Exfoliative Toxin","Toxin A, Exfoliatin","Toxin B, Exfoliative","Toxin, Staphylococcal Exfoliative","Toxins, Epidermolytic","Toxins, Exfoliative"],"ontology_prefix":"mesh","short_form":"mesh_D005083","description":["Protein exotoxins from Staphylococcus aureus, phage type II, which cause epidermal necrolysis. They are proteins with a molecular weight of 26,000 to 32,000. They cause a condition variously called scaled skin, Lyell or Ritter syndrome, epidermal exfoliative disease, toxic epidermal necrolysis, etc."],"label":"Exfoliatins","obo_id":"mesh:D005083","type":"class"},{"iri":"http://purl.obolibrary.org/obo/OMIT_0006307","ontology_name":"omit","ontology_prefix":"OMIT","short_form":"OMIT_0006307","description":[],"label":"Exfoliatins","obo_id":"OMIT:0006307","type":"class"}],"numFound":2,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["OMIT","1","mesh","1"],"isDefiningOntology":["true","2"],"ontologyId":["omit","1","mesh","1"],"ontologyIri":["http://purl.obolibrary.org/obo/omit.owl","1","https://w3id.org/biopragmatics/resources/mesh/mesh.ofn","1"],"isObsolete":["false","2"],"type":["class","2"]}}}
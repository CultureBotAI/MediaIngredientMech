        "medium": {
            "id": 1894,
            "name": "Mannitol soya flour medium (MS, SFM, SF&M)",
            "complex_medium": "yes",
            "source": "DSMZ",
            "description": "General culture medium for growth and sporulation of streptomycetes. Culture medium of choice for intergenic conjugation of plasmids with Escherichia coli as donor. Original recipe published in \"Hobbs, Frazer, Gardner, Cullum, Oliver. \u201cDispersed Growth of Streptomyces in Liquid Culture.\u201d Applied Microbiology and Biotechnology 31, no. 3 (September 1, 1989): 272\u201377. https://doi.org/10.1007/BF00258408\". Most common recipe and that described here, published in\r\n\"Kieser,  Bibb, Buttner, Chater, Hopwood. Practical Streptomyces Genetics. Norwich: The John Innes Foundation, 2000.\" https://www.dsmz.de/research/publications/41184"
        },
        "solutions": [
            {
                "id": 6633,
                "name": "Main sol. 1894",
                "volume": 1000,
                "recipe": [
                    {
                        "recipe_order": 2,
                        "compound": "Soya flour",
                        "compound_id": 2443,
                        "attribute": "from supermarket",
                        "amount": 20,
                        "unit": "g",
                        "g_l": 20,
                        "optional": 0
                    },
                    {
                        "recipe_order": 3,
                        "compound": "Mannitol",

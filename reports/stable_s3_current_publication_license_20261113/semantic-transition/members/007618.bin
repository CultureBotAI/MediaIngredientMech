  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Adjust pH to 1.3 with H2SO4."
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 4,
      "comment": "In aerobic condition, H2 is necessary for autotrophic growth as an electron donor. In anaerobic condition, H2 and Fe3+ are necessary for autotrophic growth as an electron donor and acceptor, respectively."
    }
  ]
}
  "comments": [
    {
      "paragraph_index": 1,
      "comment": "ATCC Medium 1490 (see below) with 0.4% glucose, 0.1% cellobiose, 0.1% maltose, 0.1% starch and 15% filtered rumen fluid."
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 5,
      "comment": "Mix meat, water and NaOH and bring to a boil with stirring. Cool to room temperature, skim fat from surface, and filter, retaining both meat particles and filtrate."
    },
    {
      "paragraph_index": 6,
      "comment": "To filtrate, add sufficient distilled water to restore volume to 1 L."
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 8,
      "comment": "To this filtrate, add:"
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 11,
      "comment": "Boil and cool medium under 80% N2, 10% H2, 10% CO2, and add:"
    },
    {
      "paragraph_index": 13,
      "comment": ""
    },
    {
      "paragraph_index": 14,
      "comment": "Adjust medium for final pH 7.0. Anaerobically dispense 7 ml into tubes containing meat particles (1 part meat to 5 parts fluid) under the same gas phase."
    },
    {
      "paragraph_index": 15,
      "comment": ""
    },
    {
      "paragraph_index": 17,
      "comment": "Store solution in brown bottle under refrigeration. Discard after one month."
    },
    {
      "paragraph_index": 18,
      "comment": ""
    },
    {
      "paragraph_index": 20,
      "comment": "Autoclave at 121C for 15 minutes."
    }
  ]
}
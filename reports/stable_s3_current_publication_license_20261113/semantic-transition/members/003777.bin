from pathlib import Path
import json,hashlib,importlib.util,sys
M=Path(__file__).resolve().parents[4];C=M/'.temp/all-unmatched-20261107';A=C/'integration/ancillary1258-worktree';D=Path(__file__).resolve().parent;P=C/'integration/w09-method-successors-v1';Q=C/'preflight/w09-method-findings-triage-v1';W=C/'workers/w09/worktree/.temp/conditional-full-row-review-v1'
sp=importlib.util.spec_from_file_location('native_review',A/'scripts/record_review.py');rr=importlib.util.module_from_spec(sp);sys.modules[sp.name]=rr;sp.loader.exec_module(rr)
h=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()

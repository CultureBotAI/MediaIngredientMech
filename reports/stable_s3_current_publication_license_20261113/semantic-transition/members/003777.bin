out=rr.inspect_source(M,targets,[str(p.relative_to(M)) for p in inputs]);(D/'native-inspection-v1.json').write_text(json.dumps(out,indent=2)+'\n');(D/'native-targets.json').write_text(json.dumps({'targets':targets},indent=2)+'\n');print(len(targets),'targets',len(out['source']['inputs']),'inputs',out['source']['git_revision'])

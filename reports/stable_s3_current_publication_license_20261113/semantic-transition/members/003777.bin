 p=P/'candidates'/n;assert h(p)==digest;targets.append({'target_id':p.stem,'path':str(p.relative_to(M)),'kind':'source','label':p.stem,'record_class':'IngredientRecord','ownership_note':'Private C-authored whole-owner method successor. This reviewer did not author the new delta. Sulfur earlier union authorship limits this review to new method and full preservation, not fresh whole-Sulfur approval.'})

  "comments": [
    {
      "paragraph_index": 2,
      "comment": "pH 7.8"
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 4,
      "comment": "Sterilized by autoclaving (121℃ for 20 min)."
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": "Aseptically add 200 ml of horse serum (heat inactivated, 56℃ for 30 minutes), 100 ml of fresh yeast extract (25% solution)*, 12 ml of calf thymus DNA (Sigma, Type I) (0.2% (w/v) solution), 10 ml of thallium acetate (1% (w/v) solution), 25 ml of Penicillin G (20,000 IU/ml)."
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 11,
      "comment": "*Boil 250 g of dried baker's yeast suspended in 1 L of distilled water for 30 min, remove yeast cells by centrifugation, and sterilize by filtration."
    }
  ]
}
      "synonyms" : [ "Trypticase" ],
      "annotation" : {
        "createdBy" : [ "Carrine Blank" ],
        "definition" : [ "Trademarked commercial name for pancreatic digest of casein (milk protein from cow's milk, Bos taurus), used for the culturing of microorganisms." ],
        "definition source" : [ "From BD Bionutrients Technical Manual (3rd edition revised): \n\nBBL™ Trypticase™ Peptone is a pancreatic digest of casein and is the primary nitrogen source in Trypticase Soy Broth and Agar.\n\nAsh content is 5.7%\nNaCl content is 0.1%", "Reference for Bio-trypticase: \"Rapport de Mission au Centre National de l'Elevage et de Recherches Veterinaires de Nouakchott du 12/07 au 02/08/1999\"; Institute Senegalais de Recherches Agricoles.\n\nRetired name for \"peptone pancreatique du caseine\"; produced by Bio-Merieux (www.biomerieux.com) or Oxoid (www.remel.com/Microbiology)." ],
        "has_exact_synonym" : [ "Biotrypticase", "TrypticaseTM Peptone ", "bio-trypticase" ]
      },

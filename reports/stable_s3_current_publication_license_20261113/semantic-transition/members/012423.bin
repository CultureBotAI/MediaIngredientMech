  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Prepare medium anaerobically under 100% N2. Adjust medium for final pH 7.5. Autoclave at 121C for 15 minutes."
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 5,
      "comment": "Dispense reducing solution anaerobically into tubes under nitrogen. Autoclave at 121C for 15 minutes."
    },
    {
      "paragraph_index": 6,
      "comment": ""
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": "Available from ATCC as a sterile ready-to-use liquid (Trace Mineral Supplement, catalog no. MD-TMS)."
    },
    {
      "paragraph_index": 11,
      "comment": "Add nitrilotriacetic acid to approximately 500 ml of water and adjust to pH 6.5 with KOH to dissolve the compound."
    },
    {
      "paragraph_index": 12,
      "comment": "Bring volume to 1.0 L with remaining water and add remaining compounds one at a time."
    }
  ]
}
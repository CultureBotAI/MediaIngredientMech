{
  "UBERON:0000178": [
    {
      "stanza": "UBERON:0000178",
      "subject": "UBERON:0000178",
      "predicate": "IAO:0000115",
      "object": null,
      "value": "A fluid that is composed of blood plasma and erythrocytes.",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0000178",
      "subject": "UBERON:0000178",
      "predicate": "IAO:0000232",
      "object": null,
      "value": "This class excludes blood analogues, such as the insect analog of blood. See UBERON:0000179 haemolymphatic fluid.",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0000178",
      "subject": "UBERON:0000178",
      "predicate": "dcterms:contributor",
      "object": "orcid:0000-0002-6601-2165",
      "value": null,
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0000178",
      "subject": "UBERON:0000178",
      "predicate": "dcterms:contributor",
      "object": "orcid:0000-0003-1980-3228",
      "value": null,
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0000178",
      "subject": "UBERON:0000178",
      "predicate": "obo:UBPROP_0000001",
      "object": null,
      "value": "A complex mixture of cells suspended in a liquid matrix that delivers nutrients to cells and removes wastes. (Source: BioGlossary, www.Biology-Text.com)[TAO]",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0000178",
      "subject": "UBERON:0000178",
      "predicate": "obo:UBPROP_0000001",
      "object": null,
      "value": "Highly specialized circulating tissue consisting of several types of cells suspended in a fluid medium known as plasma.[AAO]",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0000178",
      "subject": "UBERON:0000178",
      "predicate": "obo:UBPROP_0000002",
      "object": null,
      "value": "relationship loss: subclass specialized connective tissue (AAO:0000571)[AAO]",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0000178",
      "subject": "UBERON:0000178",
      "predicate": "obo:UBPROP_0000003",
      "object": null,
      "value": "Recent findings strongly suggest that the molecular pathways involved in the development and function of blood cells are highly conserved among vertebrates and various invertebrates phyla. (...) There is now good reason to believe that, in vertebrates and invertebrates alike, blood cell lineages diverge from a common type of progenitor cell, the hemocytoblast.[well established][VHOG]",
      "datatype": null,
      "language": null,
      "graph": null
    },

  "UBERON:0001913": [
    {
      "stanza": "UBERON:0001913",
      "subject": "UBERON:0001913",
      "predicate": "IAO:0000115",
      "object": null,
      "value": "An emulsion of fat globules within a fluid that is secreted by the mammary gland during lactation.",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0001913",
      "subject": "UBERON:0001913",
      "predicate": "IAO:0000116",
      "object": null,
      "value": "to axiomatize the different forms of mammary gland secretion an ontology of the phases of pregnancy/lactation is required. Using the existing GO def of lactation is circular.",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0001913",
      "subject": "UBERON:0001913",
      "predicate": "obo:UBPROP_0000003",
      "object": null,
      "value": "The detailed similarities of mammary glands in living monotremes, marsupials, and eutherians argue for a monophyletic origin of these glands, perhaps by the combination of parts of preexisting sebaceous and sweat glands.[well established][VHOG]",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {
      "stanza": "UBERON:0001913",
      "subject": "UBERON:0001913",
      "predicate": "obo:UBPROP_0000012",
      "object": null,
      "value": "ncit:Milk refers specifically to cow milk",
      "datatype": null,
      "language": null,
      "graph": null
    },
    {

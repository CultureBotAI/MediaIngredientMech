<h3 class="mt-md-0" id="title-recipe">Culture medium recipe</h3>
<div class="d-flex justify-content-between">
    <form action="" method="get" class="mw-full w-350">
                    <div class="input-group m-0 mb-5">
                                    <select name="ccno" id="ccno-select" class="form-control">
                        <option value="" disabled selected>
                            Select a strain (optional)                        </option>
                        <option value="">Standard medium</option>
                                                    <option value="DSM 3379" >Desulfobacter curvatus DSM 3379</option>
                                                    <option value="DSM 11383" >Desulfobacter halotolerans DSM 11383</option>
                                                    <option value="DSM 3380" >Desulfobacter hydrogenophilus DSM 3380</option>
                                                    <option value="DSM 3381" >Desulfobacter latus DSM 3381</option>
                                                    <option value="DSM 17155" >Desulfobacter psychrotolerans DSM 17155</option>
                                                    <option value="DSM 13037" >Desulfobacter sp. DSM 13037</option>
                                                    <option value="DSM 2035" >Desulfobacter sp. DSM 2035</option>
                                                    <option value="DSM 2057" >Desulfobacter sp. DSM 2057</option>
                                                    <option value="DSM 8776" >Desulfobacter vibrioformis DSM 8776</option>
                                                    <option value="DSM 16918" >Halodesulfovibrio sp. DSM 16918</option>

    "owner_grounding": {
      "ontology_id": "CHEBI:3508",
      "ontology_label": "ceftazidime",
      "ontology_source": "CHEBI",
      "mapping_quality": "CLOSE_MATCH",
      "evidence": [
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "CultureBotHT",
          "notes": "Imported from CultureBotHT. CAS-RN 120618-65-7 present, but no CHEBI entry exists (checked OAK CHEBI sqlite + PubChem CID synonyms). FEBA/Hans80 panels: Hans80metals, FEBA_stress. Curator can promote to a CHEBI primary if/when CHEBI adds the term."
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "anchor_cas_hydrate_records",
          "notes": "Ceftazidime hydrate is a hydrate/salt with its own CAS and no exact ChEBI term; anchored to the parent CHEBI:3508 'ceftazidime' by narrowMatch per MAPPING_SEMANTICS.md Section 3 step 2. unspecified hydrate of ceftazidime; CHEBI:3509 is specifically the pentahydrate, which the label does not claim"
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#342)",
          "notes": "mapping_quality NARROW_MATCH -> CLOSE_MATCH, predicate skos:narrowMatch -> skos:closeMatch. narrowMatch asserts this record is *narrower in meaning* than CHEBI:3508 ('ceftazidime') — a subsumption ChEBI itself denies: it files hydrates under CHEBI:35505 'hydrate', never under the anhydrous compound, which is not an ancestor even transitively. A hydrate is a distinct substance containing the anhydrous form, not a specialization of it. closeMatch claims similarity without subsumption. The ontology_id and the record's own identifier are unchanged."
        }
      ]
    },

    "owner_sha256": "b4a8cbd3f6a1be6e2fcc3bbf8ee6c70b81a1d98e12817c048204ae05cd263cfb",
    "owner_mim_id": "MIM:0001863",
    "owner_primary_identifier": "kgmicrobe.compound:neomycin_trisulfate_salt_hydrate",
    "owner_grounding": {
      "ontology_id": "CHEBI:31635",
      "ontology_label": "neomycin sulfate",
      "ontology_source": "CHEBI",
      "mapping_quality": "CLOSE_MATCH",
      "evidence": [
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "CultureBotHT",
          "notes": "Imported from CultureBotHT. CAS-RN→CHEBI mapping resolved via OAK CHEBI sqlite (cas xref). FEBA/Hans80 panels: FEBA_stress."
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#322)",
          "notes": "mapping_quality EXACT_MATCH -> NARROW_MATCH. CHEBI:31635 carries no structural definition, so it is a class rather than an individual, and the record's label 'Neomycin trisulfate salt hydrate' does not equal the term label 'neomycin sulfate'. EXACT_MATCH therefore asserted an identity the pair does not have. Re-graded because a specific salt/hydrate form of the term."
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#342)",
          "notes": "mapping_quality NARROW_MATCH -> CLOSE_MATCH, predicate skos:narrowMatch -> skos:closeMatch. narrowMatch asserts this record is *narrower in meaning* than CHEBI:31635 ('neomycin sulfate') — a subsumption ChEBI itself denies: it files hydrates under CHEBI:35505 'hydrate', never under the anhydrous compound, which is not an ancestor even transitively. A hydrate is a distinct substance containing the anhydrous form, not a specialization of it. closeMatch claims similarity without subsumption. The ontology_id and the record's own identifier are unchanged."
        }
      ]
    },

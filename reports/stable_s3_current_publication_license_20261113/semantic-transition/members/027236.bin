        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#321)",
          "notes": "Promoted from CHEBI:4853 ('esculin') to the exact ChEBI hydrate term CHEBI:73111 ('esculin hydrate'). The label names a hydrate and ChEBI has a term for that hydrate, so MAPPING_SEMANTICS.md Section 3 step 1 applies."
        }
      ]
    },

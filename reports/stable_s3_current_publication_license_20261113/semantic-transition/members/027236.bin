    "owner_grounding": {
      "ontology_id": "CHEBI:16708",
      "ontology_label": "adenine",
      "ontology_source": "CHEBI",
      "mapping_quality": "CLOSE_MATCH",
      "evidence": [
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "CultureBotHT",
          "notes": "Imported from CultureBotHT. CAS-RN 2922-28-3 present, but no CHEBI entry exists (checked OAK CHEBI sqlite + PubChem CID synonyms). FEBA/Hans80 panels: FEBA_carbon, FEBA_nitrogen. Used in 31 CultureBot media; samples: ZMB ALS GHP, ZMB ALS GLCMD, NLDM_defined_no_iron…. Curator can promote to a CHEBI primary if/when CHEBI adds the term."
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "anchor_cas_hydrate_records",
          "notes": "Adenine hydrochloride hydrate is a hydrate/salt with its own CAS and no exact ChEBI term; anchored to the parent CHEBI:16708 'adenine' by narrowMatch per MAPPING_SEMANTICS.md Section 3 step 2. hydrochloride hydrate of adenine"
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#342)",
          "notes": "mapping_quality NARROW_MATCH -> CLOSE_MATCH, predicate skos:narrowMatch -> skos:closeMatch. narrowMatch asserts this record is *narrower in meaning* than CHEBI:16708 ('adenine') — a subsumption ChEBI itself denies: it files hydrates under CHEBI:35505 'hydrate', never under the anhydrous compound, which is not an ancestor even transitively. A hydrate is a distinct substance containing the anhydrous form, not a specialization of it. closeMatch claims similarity without subsumption. The ontology_id and the record's own identifier are unchanged."
        }
      ]
    },
    "owner_unchanged_from_old_review": true,

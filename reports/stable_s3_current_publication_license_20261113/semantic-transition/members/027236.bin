    "owner_grounding": {
      "ontology_id": "CHEBI:34683",
      "ontology_label": "disodium hydrogenphosphate",
      "ontology_source": "CHEBI",
      "mapping_quality": "CLOSE_MATCH",
      "evidence": [
        {
          "evidence_type": "LEXICAL_MATCH",
          "source": "culturemech-pending",
          "notes": "Imported from culturemech-pending via source-preset. source_id=culturemech.solution_ingredient:Disodium_phosphate_heptahydrate_(0.02_M_stock); "
        },
        {
          "evidence_type": "CURATOR_JUDGMENT",
          "source": "sssom_synonym_enrich_review_2026_05_10",
          "notes": "Previous CHEBI:131825 mapping resolved to an unrelated deoxyadenosine term. OLS/OAK finds disodium hydrogenphosphate but no exact heptahydrate stock solution term, so the stock solution retains a kgmicrobe.ingredient identity with CHEBI:34683 as a broader solute parent."
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#342)",
          "notes": "mapping_quality NARROW_MATCH -> CLOSE_MATCH, predicate skos:narrowMatch -> skos:closeMatch. narrowMatch asserts this record is *narrower in meaning* than CHEBI:34683 ('disodium hydrogenphosphate') — a subsumption ChEBI itself denies: it files hydrates under CHEBI:35505 'hydrate', never under the anhydrous compound, which is not an ancestor even transitively. A hydrate is a distinct substance containing the anhydrous form, not a specialization of it. closeMatch claims similarity without subsumption. The ontology_id and the record's own identifier are unchanged."
        }
      ]
    },

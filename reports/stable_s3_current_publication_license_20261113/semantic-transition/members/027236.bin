    "owner_sha256": "b4a93e063ae332cec73c3d77fc409a8d622eac2a82a570ca4e668fb2b5d03c86",
    "owner_mim_id": "MIM:0001674",
    "owner_primary_identifier": "kgmicrobe.compound:mgcl2_x_7_h2o",
    "owner_grounding": {
      "ontology_id": "CHEBI:6636",
      "ontology_label": "magnesium dichloride",
      "ontology_source": "CHEBI",
      "mapping_quality": "CLOSE_MATCH",
      "evidence": [
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "CultureMech",
          "notes": "[HISTORICAL — superseded by the #321 re-grade below: this record is a hydrate of CHEBI:6636, not an exact match to it] Imported from CultureMech pipeline, quality=DIRECT_MATCH"
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#321/#334)",
          "notes": "identifier CHEBI:6636 -> kgmicrobe.compound:mgcl2_x_7_h2o; mapping_quality SYNONYM_MATCH -> NARROW_MATCH. The record is a hydrate of CHEBI:6636 ('magnesium dichloride') and was sharing that term's identifier — the identity collapse MAPPING_SEMANTICS §3 forbids, which made a distinct substance indistinguishable from its anhydrous parent downstream. ChEBI has no term for this hydrate and the record carries no verified CAS, so steps 1 and 2 are unavailable and step 3 applies."
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#321)",
          "notes": "molecular_formula '2Cl.Mg' -> '2Cl.Mg.7H2O'. The recorded value described the anhydrous salt while the label names a hydrate, understating the mass by 18 g/mol per water. Corrected because the label states 7 water(s) of hydration, and the recorded formula was byte-identical to the anhydrous parent CHEBI:6636's ChEBI formula ('2Cl.Mg') — the mark of a value inherited from the parent rather than measured for this record. Water appended in ChEBI's own dot-separated notation."
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#342)",
          "notes": "mapping_quality NARROW_MATCH -> CLOSE_MATCH, predicate skos:narrowMatch -> skos:closeMatch. narrowMatch asserts this record is *narrower in meaning* than CHEBI:6636 ('magnesium dichloride') — a subsumption ChEBI itself denies: it files hydrates under CHEBI:35505 'hydrate', never under the anhydrous compound, which is not an ancestor even transitively. A hydrate is a distinct substance containing the anhydrous form, not a specialization of it. closeMatch claims similarity without subsumption. The ontology_id and the record's own identifier are unchanged."
        },
        {
          "evidence_type": "CURATOR_JUDGMENT",
          "source": "MIM curation (#344)",
          "notes": "mediadive.compound:632 still carries the source label 'MgCl2 x 7 H2O', but no exact ontology term or CAS has been verified for that stated hydration count. CHEBI:6636 (magnesium dichloride) is retained only as the closest anhydrous parent while the source label keeps its local kgmicrobe.compound identity."
        }
      ]
    },

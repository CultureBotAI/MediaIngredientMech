      "mapping_quality": "CLOSE_MATCH",
      "evidence": [
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "CultureBotHT",
          "notes": "Imported from CultureBotHT. CAS-RN 10039-56-2 present, but no CHEBI entry exists (checked OAK CHEBI sqlite + PubChem CID synonyms). FEBA/Hans80 panels: Hans80metals. Curator can promote to a CHEBI primary if/when CHEBI adds the term."
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "CHEBI via OLS (stem-substring)",
          "notes": "Parent class identified via stem-substring; matched_via='Sodium hypophosphite monohydrate'"
        },
        {
          "evidence_type": "DATABASE_MATCH",
          "source": "MIM curation (#342)",
          "notes": "mapping_quality NARROW_MATCH -> CLOSE_MATCH, predicate skos:narrowMatch -> skos:closeMatch. narrowMatch asserts this record is *narrower in meaning* than CHEBI:234148 ('sodium hypophosphite') — a subsumption ChEBI itself denies: it files hydrates under CHEBI:35505 'hydrate', never under the anhydrous compound, which is not an ancestor even transitively. A hydrate is a distinct substance containing the anhydrous form, not a specialization of it. closeMatch claims similarity without subsumption. The ontology_id and the record's own identifier are unchanged."
        }
      ]
    },

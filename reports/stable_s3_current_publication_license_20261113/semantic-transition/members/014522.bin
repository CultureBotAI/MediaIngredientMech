,"url":"https://bioregistry.io/metacyc.compound:RIBOFLAVIN","prefix":"metacyc.compound"},{"id":707847,"accession_number":"US2807611","type":"MANUAL_X_REF","source_name":"Patent","url":"https://worldwide.espacenet.com/patent/search?q=US2807611","prefix":"patent"},{"id":707848,"accession_number":"US2876169","type":"MANUAL_X_REF","source_name":"Patent","url":"https://worldwide.espacenet.com/patent/search?q=US2876169","prefix":"patent"}],"CAS":[{"id":28322,"accession_number":"83-88-5","type":"CAS","source_name":"KEGG COMPOUND","url":null,"prefix":"kegg.compound"},{"id":81435,"accession_number":"83-88-5","type":"CAS","source_name":"NIST Chemistry WebBook","url":"http://webbook.nist.gov/cgi/cbook.cgi?ID=83-88-5","prefix":"nist"},{"id":100419,"accession_number":"83-88-5","type":"CAS","source_name":"ChemIDplus","url":"https://bioregistry.io/chemidplus:83-88-5","prefix":"chemidplus"}],"REGISTRY_NUMBER":[{"id":822937,"accession_number":"97831","type":"REGISTRY_NUMBER","source_name":"Reaxys","url":null,"prefix":"reaxys"}]},"roles_classification":[{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:84087","name":"human urinary metabolite","definition":"Any metabolite (endogenous or exogenous) found in human urine samples.","id":84087,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:78675","name":"fundamental metabolite","definition":"Any metabolite produced by all living cells.","id":78675,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:76971","name":"Escherichia coli metabolite","definition":"Any bacterial metabolite produced during a metabolic reaction in <em>Escherichia coli</em>.","id":76971,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:49201","name":"anti-ulcer drug","definition":"One of various classes of drugs with different action mechanisms used to treat or ameliorate peptic ulcer or irritation of the gastrointestinal tract.","id":49201,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:47868","name":"photosensitizing agent","definition":"A chemical compound that can be excited by light of a specific wavelength and subsequently transfer energy to a chosen reactant. This is commonly molecular oxygen within a cancer tissue, which is converted to (highly rective) singlet state oxygen. This rapidly reacts with any nearby biomolecules, ultimately killing the cancer cells.","id":47868,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:66981","name":"ophthalmology drug","definition":"Any compound used for the treatment of eye conditions or eye diseases.","id":66981,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35554","name":"cardiovascular drug","definition":"A drug that affects the rate or intensity of cardiac contraction, blood vessel diameter or blood volume.","id":35554,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:23357","name":"cofactor","definition":"An organic molecule or ion (usually a metal ion) that is required by an enzyme for its activity. It may be attached either loosely (coenzyme) or tightly (prosthetic group).","id":23357,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:231911","name":"renoprotective agent","definition":"Any compound that is able to prevent damage to the kidneys.","id":231911,"biological_role":false},{"application":false,"chemical_role":true,"chebi_accession":"CHEBI:22586","name":"antioxidant","definition":"A substance that opposes oxidation or inhibits reactions brought about by dioxygen or peroxides.","id":22586,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50748","name":"antipsoriatic","definition":"A drug used to treat psoriasis.","id":50748,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35480","name":"analgesic","definition":"An agent capable of relieving pain without the loss of consciousness or without producing anaesthesia. In addition, analgesic is a role played by a compound which is exhibited by a capability to cause a reduction of pain symptoms.","id":35480,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:75835","name":"anti-anaemic agent","definition":"A compound which increases either the number of red cells or the amount of haemoglobin in the blood.","id":75835,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35610","name":"antineoplastic agent","definition":"A substance that inhibits or prevents the proliferation of neoplasms.","id":35610,"biological_role":false},{"application":true,"chemical_role":true,"chebi_accession":"CHEBI:77182","name":"food colouring","definition":"A food additive that imparts colour to food. In European countries, E-numbers for permitted food colours are from E 100 to E 199, divided into yellows (E 100-109), oranges (E 110-119), reds (E 120-129), blues and violets (E 130-139), greens (E 140-149), browns and blacks (E 150-159), and others (E 160-199).","id":77182,"biological_role":true},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:75771","name":"mouse metabolite","definition":"Any mammalian metabolite produced during a metabolic reaction in a mouse (<em>Mus musculus</em>).","id":75771,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35705","name":"immunosuppressive agent","definition":"An agent that suppresses immune function by one of several mechanisms of action. Classical cytotoxic immunosuppressants act by inhibiting DNA synthesis. Others may act through activation of T-cells or by inhibiting the activation of helper cells. In addition, an immunosuppressive agent is a role played by a compound which is exhibited by a capability to diminish the extent and/or voracity of an immune response.","id":35705,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:67079","name":"anti-inflammatory agent","definition":"Any compound that has anti-inflammatory effects.","id":67079,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:76924","name":"plant metabolite","definition":"Any eukaryotic metabolite produced during a metabolic reaction in plants, the kingdom that include flowering plants, conifers and other gymnosperms.","id":76924,"biological_role":true},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50733","name":"nutraceutical","definition":"A product in capsule, tablet or liquid form that provide essential nutrients, such as a vitamin, an essential mineral, a protein, an herb, or similar nutritional substance.","id":50733,"biological_role":false},{"application":false,"chemical_role":false,"chebi_accession":"CHEBI:27314","name":"water-soluble vitamin (role)","definition":"Any vitamin that dissolves in water and readily absorbed into tissues for immediate use. Unlike the fat-soluble vitamins, they are not stored in the body and need to be replenished regularly in the diet and will rarely accumulate to toxic levels since they are quickly excreted from the body via urine.","id":27314,"biological_role":true}],"is_released":true}
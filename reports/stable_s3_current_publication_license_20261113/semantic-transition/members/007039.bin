          "matching_recipe_contexts": [
            {
              "solution_id": 1476,
              "name": "Main sol. 727",
              "volume": 1003,
              "row": {
                "recipe_order": 11,
                "compound": "Lab Lemco powder",
                "compound_id": 2136,
                "attribute": "Oxoid",
                "amount": 5,
                "unit": "g",
                "g_l": 4.98504,
                "optional": 0
              },
              "steps": [
                {
                  "step": "Dissolve ingredients except carbonate, vitamins and sulfide, then sparge medium with 80% N2 and 20% CO2 gas mixture for 30 - 45 min to make it anoxic. Dispense medium under same gas atmosphere into anoxic Hungate-type tubes or serum vials and autoclave. Prior to inoculation add vitamins and sulfide from sterile\r\nanoxic stock solutions prepared under 100% N2 gas and carbonate from a sterile anoxic stock solution prepared under 80% N2 and 20% CO2 gas mixture. Stock solutions of vitamins should be sterilized by filtration. Adjust pH of complete medium to 7.0, if necessay."
                }
              ]
            }
          ]
        },
        {
          "medium_id": "C23",
          "capture": "shard/root_substances/captures/primary/frozen-medium-C23.json",

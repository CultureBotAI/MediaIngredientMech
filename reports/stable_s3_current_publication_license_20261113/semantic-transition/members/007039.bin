              "row": {
                "recipe_order": 10,
                "compound": "84 g/L NaHCO3 solution",
                "compound_id": 1764,
                "attribute": "autoclaved under CO2 atmosphere",
                "amount": 30,
                "unit": "ml",
                "optional": 0
              },
              "steps": [
                {
                  "step": "Use sodium acetate instead of 17 beta-estradiol donor. The former can be added prior to autoclaving. After autoclaving and cooling under N2-CO2 (80:20, v/v), add the following components to the medium: "
                },
                {
                  "step": "The final pH of the medium should be about 7.2. All culture vessels with estradiol as substrate are incubated at 28C in the dark for 8 - 10 days. The culture with estradiol should be briefly shaken once a day."
                }
              ]
            }
          ]
        }
      ],

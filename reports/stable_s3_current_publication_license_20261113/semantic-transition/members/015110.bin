                "changes": "[{\"old_field\": \"ingredients[0].concentration\", \"field\": \"ingredients[0].concentration\", \"old\": {\"value\": \"6.88889\", \"unit\": \"G_PER_L\"}, \"new\": {\"value\": \"4.96\", \"unit\": \"G_PER_L\"}, \"status\": \"correct\", \"reference\": \"https://komodo.modelseed.org/komodo/servlet/KomodoTomcatServerSideUtilitiesModelSeed?MediaInfo=1021\", \"snippet\": \"Yeast extract Yeast extract rich-peptone# 4.96 null\"}, {\"old_field\": \"ingredients[0].notes\", \"field\": \"ingredients[0].notes\", \"old\": null, \"new\": \"The KOMODO table explicitly reports Gram Amount per liter of medium. Retain the exact source precision at medium scope, not the previously copied DSMZ stock rate. The separate rounded Mol Amount column is not used for conversion.\", \"status\": \"evidence_only\", \"reference\": \"https://komodo.modelseed.org/komodo/servlet/KomodoTomcatServerSideUtilitiesModelSeed?MediaInfo=1021\", \"snippet\": \"Yeast extract Yeast extract rich-peptone# 4.96 null\"}, {\"old_field\": null, \"field\": \"ingredients[0].notes\", \"old\": null, \"new\": \"The KOMODO table explicitly reports Gram Amount per liter of medium. Retain the exact source precision at medium scope, not the previously copied DSMZ stock rate. The separate rounded Mol Amount column is not used for conversion.\", \"status\": \"evidence_only\", \"reference\": \"https://komodo.modelseed.org/komodo/servlet/KomodoTomcatServerSideUtilitiesModelSeed?MediaInfo=1021\", \"snippet\": \"Gram & Mol amounts are per Liter of medium.\"}, {\"old_field\": \"ingredients[4].concentration\", \"field\": \"ingredients[1].concentration\", \"old\": {\"value\": \"5.55556\", \"unit\": \"G_PER_L\"}, \"new\": {\"value\": \"4.00\", \"unit\": \"G_PER_L\"}, \"status\": \"correct\", \"reference\": \"https://komodo.modelseed.org/komodo/servlet/KomodoTomcatServerSideUtilitiesModelSeed?MediaInfo=1021\", \"snippet\": \"D-Glucose D-Glucose SEED-cpd00027### 4.00 0.02\"}, {\"old_field\": \"ingredients[4].not
              },
              {
                "step_number": 2,
                "action": "AUTOCLAVE",
                "description": "For the solid preparation, sterilize Solution A and Solution B separately at 121 C for 20 min. Do not autoclave the serum-supplemented mixture."
              },
              {
                "step_number": 3,
                "action": "COOL",
                "description": "Cool the separately sterilized solutions to 50 C, then combine A and B."

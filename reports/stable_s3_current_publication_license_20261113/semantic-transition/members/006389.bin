  "comments": [
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 3,
      "comment": "After autoclaving of agar solution, aseptically mix 10xM9, MgSO4 and CaCl2 solutions. After cooling to 65°C, aseptically add phenanthrene solution, mix by sonication for approximately 30 seconds and pour into the plates."
    },
    {
      "paragraph_index": 4,
      "comment": ""
    },
    {
      "paragraph_index": 5,
      "comment": "Dissolve 15 g of agar in 900 ml of distilled water and sterilize by autoclaving."
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": "Sterilize separately by autoclaving."
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 11,
      "comment": "***Dissolve in distilled water and sterilize by autoclaving."
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 14,
      "comment": "****Sterilized by filtration. The use of DMSO-safe filters is recommended."
    }
  ]
}
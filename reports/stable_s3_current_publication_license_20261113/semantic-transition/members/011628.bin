<TABLE BORDER>
<TR><TD WIDTH=75%> Biotin                                                  </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;2.5&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> mg  </TD></TR>
<TR><TD WIDTH=75%> Nicotinic acid                                         </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;25.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> mg  </TD></TR>

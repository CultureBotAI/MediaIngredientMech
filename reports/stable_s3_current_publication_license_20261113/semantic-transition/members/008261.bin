                        "attribute": "gassed with N2",
                        "amount": 30,
                        "unit": "ml/l",
                        "optional": 0
                    }
                ],
                "steps": [
                    {
                        "recipe_order": 12,
                        "step": "Sparge medium with 100% N2 gas mixture for 20 min to make it anoxic."
                    },
                    {
                        "recipe_order": 13,
                        "step": "Adjust pH to 6.5-6.8 with 1N H2SO4."
                    },
                    {
                        "recipe_order": 14,
                        "step": "Fill 10 ml of medium in serum bottles (100 ml) under a protective H2/CO2 atmosphere and tightly stopper."
                    },
                    {
                        "recipe_order": 15,
                        "step": "Autoclave at 121 \u00b0C for 15 min."
                    },
                    {
                        "recipe_order": 16,
                        "step": "after autoclaving add the following filter-sterilized solutions."
                    },
                    {
                        "step": "apply xx bar H2/CO2 (80%/20%) + yy % O2 \r\n(Note: strain specific conditions need to be applied)"
                    },
                    {
                        "step": "For more details on the medium see the original description (Huber et al. System. Appl. Microbiol. 15:340-351 (1992))."
                    }
                ],

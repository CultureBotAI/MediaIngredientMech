      "soy_continuity_reassessment": {
        "author": "/root/buffer_hepes",
        "at": "2026-11-08T09:39:35.518271+00:00",
        "status": "bounded authentic dependent proposal prepared; exact independent review pending",
        "proposal_id": "W05-PARENTS-BACTO-SOYTONE-CONTINUITY",
        "source_trigger_proposal_id": "W05-FINAL-MAT-032",
        "source_case_ownership_unchanged": true,
        "new_source_cases": 0,
        "before_representative": "FOODON:03315720",

    {
      "case_id": "CM_NAME:8ba1df295abb60b7fb8cd7e12f80b861e3d2e7634dd64e3bfb7e88df0db0fd08",
      "case_input_sha256": "3169035f5758959cc47bcb4f25b9646a9b7b077b20366107afded801efbdceae",
      "source": {
        "source": "culturemech",
        "source_case_id": "Bovine albumin, Fraction V",
        "source_label": "Bovine albumin, Fraction V",
        "raw_source_label": "Bovine albumin, Fraction V"
      },
      "occurrence_ids": [
        "CM_OCC:553f0c2bb6a0ed4037dcdff9eb7e97c2cbcd332c9d0ee7c301545ead26ab2f85"
      ],
      "disposition": "supplied_form_correction",
      "reasoning": "TOGO M194 is BSK Medium with original-source metadata JCM201. Its complete component table explicitly lists Bovine albumin, Fraction V, 50 g, as a main batch input. The recipe has 900 ml water, a 200 ml 7% gelatin input, 100 ml CMRL product and later final 6% rabbit-serum supplementation; these do not establish an exact final preparation volume. Correct only the irrelevant ADC/OADC wording to BSK context. Retain Fraction V, 50 g, unknown manufacturer/catalogue and unknown final volume; do not assert 50 g/L. The pinned JCM201 response says Nothing found, so it supplies no original-page corroboration.",
      "applicability": "Bound to CultureMech:008529, TOGO M194 BSK, occurrence CM_OCC:553f0c2bb6a0ed4037dcdff9eb7e97c2cbcd332c9d0ee7c301545ead26ab2f85 at ingredients/6. TOGO M194 is BSK Medium with original-source metadata JCM201. Its complete component table explicitly lists Bovine albumin, Fraction V, 50 g, as a main batch input. The recipe has 900 ml water, a 200 ml 7% gelatin input, 100 ml CMRL product and later final 6% rabbit-serum supplementation; these do not establish an exact final preparation volume. Correct only the irrelevant ADC/OADC wording to BSK context. Retain Fraction V, 50 g, unknown manufacturer/catalogue and unknown final volume; do not assert 50 g/L. The pinned JCM201 response says Nothing found, so it supplies no original-page corroboration.",

  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Aseptically and anaerobically dispense under N2:H2:CO2 (80:10:10)."
    },
    {
      "paragraph_index": 3,
      "comment": "Note: the formate/fumarate solution should achieve a final concentration of 4.76% v./v"
    },
    {
      "paragraph_index": 4,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "Mix meat, water and NaOH and bring to a boil while stirring."
    },
    {
      "paragraph_index": 7,
      "comment": "Cool to room temperature, skim fat from surface, and filter, retaining both meat particles and filtrate."
    },
    {
      "paragraph_index": 8,
      "comment": "To filtrate, add sufficient distilled water to filtrate to restore volume to 1.0 L."
    },
    {
      "paragraph_index": 9,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": "To this filtrate, add:"
    },
    {
      "paragraph_index": 12,
      "comment": "Boil and cool medium under 80% N2, 10% H2, 10% CO2, and add:"
    },
    {
      "paragraph_index": 13,
      "comment": ""
    },
    {
      "paragraph_index": 15,
      "comment": "Adjust medium for final pH 7.0. Anaerobically dispense 7 ml into tubes containing meat particles (1 part meat to 5 parts fluid) under the same gas phase."
    },
    {
      "paragraph_index": 16,
      "comment": ""
    },
    {
      "paragraph_index": 18,
      "comment": "Store solution in brown bottle under refrigeration. Discard after one month."
    },
    {
      "paragraph_index": 19,
      "comment": ""
    },
    {
      "paragraph_index": 21,
      "comment": "Autoclave at 121C for 15 minutes."
    },
    {
      "paragraph_index": 22,
      "comment": ""
    },
    {
      "paragraph_index": 24,
      "comment": "Adjust pH to 7.0 and filter-sterilize. Aseptically add to chopped meat medium."
    }
  ]
}
identifier: kgmicrobe.ingredient:fatty_acid_mixture_see_medium_no_266
preferred_term: Fatty acid mixture (see Medium No. 266)
ontology_mapping:
  ontology_id: kgmicrobe.ingredient:fatty_acid_mixture_see_medium_no_266
  ontology_label: Fatty acid mixture (see Medium No. 266)
  ontology_source: kgmicrobe.ingredient
  mapping_quality: FALLBACK_REGISTRY
  evidence:
  - evidence_type: LLM_SUGGESTION
    source: https://www.jcm.riken.jp/cgi-bin/jcm/jcm_grmd?GRMD=266
    notes: JCM266 defines a neutralized multicomponent fatty-acid stock. CHEBI35366
      is not its whole identity; registry identity preserves this recipe-specific
      preparation without a part-to-whole parent mapping.
  - evidence_type: LLM_SUGGESTION
    source: https://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium119.pdf
    notes: 'JCM 266 specifies four acids at 0.5 g each, 20 ml water and NaOH adjustment
      to pH 7.5. DSMZ 119 uses the same generic mixture name for a different 23/27/27/27
      ml acid input specification with 896 ml water. Therefore the generic labels
      cannot globally select this JCM 266 stock. Retire these two active resolver
      aliases without classifying the authentic source strings as chemically false.
      Preserve their full structured provenance in the alias-disposition ledger and
      here: [{"synonym_text": "Fatty acid mixture", "synonym_type": "RAW_TEXT", "source":
      "culturemech:output/ingredient_occurrences.tsv"}, {"synonym_text": "Fatty acid
      mixture (see below)", "synonym_type": "RAW_TEXT", "source": "culturemech:output/ingredient_occurrences.tsv"}].
      The original history is unchanged. All WITHHOLD and source/export obligations
      remain.'

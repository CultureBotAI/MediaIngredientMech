  "comments": [
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 3,
      "comment": "Mix ingredients except for HEPES buffer, NaHCO3 buffer, KH2PO4 solution, FeNaEDTA solution, trace element solution, NH4Cl solution and alpha-ketoglutamate solution, and autoclave at 121°C for 20 min. HEPES buffer, and KH2PO4, FeNaEDTA, trace element, and NH4Cl solutions are sterilized separately by autoclaving and added just before inoculation. NaHCO3 buffer and alpha-ketoglutamate sollution are also added just before inoculation after filter-sterile. Final pH should be 7.4-7.6."
    },
    {
      "paragraph_index": 4,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": "Dissolve NaOH, and then add HEPES slowly. Adjust pH to 7.6 with NaOH solution. Sterilize by autoclaving."
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 11,
      "comment": "Dissolve NaHCO3, and sterilize by filter."
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 14,
      "comment": ""
    },
    {
      "paragraph_index": 15,
      "comment": "Dissolve KH2PO4 (0.4 g/L=2.93 mM), and sterilize by autoclaving."
    },
    {
      "paragraph_index": 16,
      "comment": ""
    },
    {
      "paragraph_index": 18,
      "comment": ""
    },
    {
      "paragraph_index": 19,
      "comment": "Dissolve FeNaEDTA (578 mg/L=1.5 mM), and sterilized by autoclaving. Store at 4°C."
    },
    {
      "paragraph_index": 20,
      "comment": ""
    },
    {
      "paragraph_index": 22,
      "comment": ""
    },
    {
      "paragraph_index": 23,
      "comment": "Add HCl, dissolve trace elements, and sterilize by autoclaving. Store at 4°C."
    },
    {
      "paragraph_index": 24,
      "comment": ""
    },
    {
      "paragraph_index": 26,
      "comment": ""
    },
    {
      "paragraph_index": 27,
      "comment": "Dissolve NH4Cl (0.4 M), and sterilize by autoclaving."
    },
    {
      "paragraph_index": 28,
      "comment": ""
    },
    {
      "paragraph_index": 30,
      "comment": ""
    },
    {
      "paragraph_index": 31,
      "comment": "Dissolve alpha-ketoglutamate (20 mM), and sterilize by filter. Store at 4°C."
    }
  ]
}
from pathlib import Path
import datetime,hashlib,importlib.util,json,os,subprocess,sys
sys.dont_write_bytecode=True
D=Path(__file__).absolute().parent;C=D.parents[1];A=C/'integration/ancillary1258-worktree';F=D/'native-author-fixture';F.mkdir()
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def write(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
def save(p,x):write(p,(json.dumps(x,indent=2,ensure_ascii=False)+'\n').encode())
items=[p for p in D.rglob('*') if p.is_file() and 'native-author-fixture' not in p.relative_to(D).parts]
transport=[]
for p in items:
 q=F/'evidence'/p.relative_to(D);write(q,p.read_bytes());transport.append({'original_path':str(p),'fixture_path':str(q.relative_to(F)),'sha256':sha(p),'bytes':p.stat().st_size})
for n in ['scripts/record_review.py','schema/record_review.yaml','conf/record_review.yaml']:
 p=A/n;write(F/n,p.read_bytes());transport.append({'original_path':str(p),'fixture_path':n,'sha256':sha(p),'bytes':p.stat().st_size})
save(F/'evidence/NATIVE-INPUT-TRANSPORT.json',transport)
env={**os.environ,'GIT_OPTIONAL_LOCKS':'0','PYTHONDONTWRITEBYTECODE':'1'}
def git(*args):return subprocess.run(['git','-C',str(F),*args],env=env,capture_output=True,text=True,check=True).stdout.strip()
git('init');git('remote','add','origin','https://github.com/CultureBotAI/MediaIngredientMech.git');git('add','.');git('-c','user.name=Codex private review fixture','-c','user.email=codex-review@invalid.local','commit','-m','Private cysteine author evidence snapshot')
spec=importlib.util.spec_from_file_location('cys_author_review',F/'scripts/record_review.py');rr=importlib.util.module_from_spec(spec);spec.loader.exec_module(rr)
sel=json.loads((D/'SELECTOR.json').read_text());tid=sel['operation_id'];targets=[{'target_id':tid,'path':'evidence/candidates/L-Cysteine_X_HCl_X_H2O_Solution.yaml','label':'Private cysteine stock predicate successor','kind':'source','ownership_note':'C-authored private successor of genuine W07 C-P04. Maintained owner data/ingredients/mapped/L-Cysteine_X_HCl_X_H2O_Solution.yaml unchanged.'}]
ins=rr.inspect_source(F,targets,[str(p.relative_to(F)) for p in F.rglob('*') if p.is_file() and '.git' not in p.relative_to(F).parts]);now=datetime.datetime.now(datetime.UTC);at=now.isoformat().replace('+00:00','Z')
ev=[]
for eid,n,kind,summary in [('E-DELTA','field-delta.json','record_content','Only mapping quality plus truthful new evidence/history; original complete objects preserved.'),('E-ORIGIN','origin-proof.json','record_content','Exact original source operation/case/proposal and A842 preimage.'),('E-VERIFY','verification.json','validation','11 actual author controls, schema/inverse/guarded render/full2956 partonomy and native row diagnostic.'),('E-ROWS','native-row-diagnostic.json','validation','ActualKG native2row relation diagnostic, local identity preserved, no full generation.'),('E-ISSUE','inputs/issue/readback-00.json','record_content','Filed901 comment6724895813 before change.'),('E-SCIENCE','inputs/assessment/ASSESSMENT.md','record_content','Bounded primary-backed current form relation; all original stock unknowns retained.')]:
 p=F/'evidence'/n;ev.append({'evidence_id':eid,'kind':kind,'reference':str(p.relative_to(F)),'snapshot_sha256':sha(p),'accessed_at':at,'support':'supports','summary':summary})
r={'schema_version':'1.0.0','review_id':now.strftime('%Y%m%dT%H%M%SZ')+'-c-cysteine-stock-author-response','kind':'record','repository':ins['repository'],'title':'Author response: cysteine stock broader-parent grade','started_at':json.loads((D/'field-delta.json').read_text())['new_history']['timestamp'].replace('+00:00','Z'),'finished_at':at,'reviewer':{'identity':'Codex /root/step7d_science_c','kind':'agent','independence':'self_review','independence_basis':'C authored this exact candidate. This is an author response/integrity record, not a distinct scientific or whole-owner vote. B is assigned separate whole-payload review.'},'skill':'curate-yaml-record','completion':'completed','verdict':'pass_with_limitations','scientific_review':False,'summary':'Private grade-only response with appended truthful evidence/history; authentic local stock identity, W07 source/rejection work and all unknowns persist. Exact native checks pass; independent review/application remain separate.','source':ins['source'],'targets':targets,'scope':{'description':'One exact complete private successor and its bounded author checks.','selection':'Selected0ca4→private1e82 under filed901.','coverage':'full','population_size':1,'reviewed_target_ids':[tid],'exclusions':[{'target':'Independent source/whole-owner/final-row scientific review and application','reason':'Self-authored candidate; no approval transferred.'}]},'checks':[{'check_id':'C-11','name':'Actual native bounded author checks','status':'passed','required':True,'target_ids':[tid],'evidence_ids':['E-VERIFY','E-ROWS','E-DELTA'],'command':'Python3.13 -B author.py in this private packet','exit_code':0,'summary':'11 checks pass: exact inverse, native schema/guarded serialization,2956 partonomy and2rows; no providers or full generation.'}],'evidence':ev,'assessments':[{'assessment_id':'A-DELTA','area':'provenance','topic':'Exact preservation and truthful new attribution','outcome':'supported','target_ids':[tid],'evidence_ids':['E-DELTA','E-ORIGIN','E-ISSUE'],'summary':'Only specified grade/evidence/history change; genuine source authorship and all old objects remain.'},{'assessment_id':'A-NATIVE','area':'consistency','topic':'Native broader relation with distinct local identity','outcome':'supported','target_ids':[tid],'evidence_ids':['E-ROWS','E-VERIFY','E-SCIENCE'],'summary':'Native parent row becomes broadMatch; local exact registry row persists. Old rejected labels cannot return through KG aliases; unknown stock facts stay unasserted.'}],'findings':[],'actions':[],'limitations':['Author self-review only. Distinct full successor review required.','Primary relation assessment does not resolve stock concentration, solvent, pH, dose interpretation, roles/counts or export.','ActualKG function projection deliberately uses empty residual and does not invoke full generation/providers/current final candidate rows.','No maintained/source/plan/config/GitHub edits or source application. Private review fixture Git snapshot is not production baseline.']}
rr.validate_review(r);yp=rr.save_review(F,r);assert rr.read_review(F,str(yp.relative_to(F)))==r;mp=yp.with_name('review.md')
receipt={'status':'NATIVE_AUTHOR_SELF_REVIEW_SAVED_STRICT_READBACK','source_root':str(F),'fixture_git_revision':ins['source']['git_revision'],'pair':{'yaml':str(yp),'yaml_sha256':sha(yp),'markdown':str(mp),'markdown_sha256':sha(mp)},'inputs':len(ins['source']['inputs']),'independent_approval':False,'application_authorized':False}
save(D/'NATIVE-AUTHOR-RECEIPT.json',receipt);save(D/'NATIVE-INPUT-TRANSPORT.json',transport)
for p in json.loads((D/'input-pins.json').read_text()):assert sha(p['path'])==p['sha256']
members=[{'path':str(p.relative_to(D)),'sha256':sha(p),'bytes':p.stat().st_size} for p in sorted(D.rglob('*')) if p.is_file() and '.git' not in p.relative_to(D).parts and p.name not in ['save-author.stdout','save-author.stderr']]
save(D/'MANIFEST.json',{'members':members,'exclusions':['Private Git administrative metadata','outer HANDOFF/MANIFEST to avoid self-hash','live save-author stdout/stderr; native receipt and actual author stdout/stderr are selected']})
h={'status':'SEALED_PRIVATE_CYSTEINE_SUCCESSOR_PENDING_DISTINCT_REVIEW','manifest':{'path':'MANIFEST.json','sha256':sha(D/'MANIFEST.json'),'members':len(members)},'selector':{'path':'SELECTOR.json','sha256':sha(D/'SELECTOR.json')},'payload':sel['payload'],'original_operation':sel['operation_id'],'native_author':receipt,'checks':json.loads((D/'verification.json').read_text()),'application_authorized':False}
save(D/'HANDOFF.json',h);print(json.dumps({'handoff_sha256':sha(D/'HANDOFF.json'),**h},indent=2))

{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/CHEBI_32954","ontology_name":"chebi","related_synonyms":["Acetic acid, sodium salt (1:1)","E-262(I)","E262","FEMA NO. 3024","INS NO.262(I)","INS-262(I)","NSC-77459","Natriumazetat","Sodium acetate (3h2o)","Sodium acetate component of procalamine","Sodium acetate hydrate","Sodium acetate, anhydrous","Sodium acetate,anhydrous","acetic acid, sodium salt","anhydrous sodium acetate","sodium acetate anhydrous","sodium acetate"],"ontology_prefix":"CHEBI","short_form":"CHEBI_32954","description":[],"label":"sodium acetate","obo_id":"CHEBI:32954","type":"class","exact_synonyms":["sodium acetate"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C47720","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C47720","description":["The trihydrate sodium salt of acetic acid with alkalinizing, diuretic and electrolyte replacement properties. Following absorption, sodium acetate generates sodium bicarbonate, thereby raising blood and urine pH. In addition, this agent may increase serum sodium concentration."],"label":"Sodium Acetate","obo_id":"NCIT:C47720","type":"class","exact_synonyms":["Acetic Acid, Sodium Salt","SODIUM ACETATE","Sodium Acetate"]},{"iri":"http://snomed.info/id/108951007","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_108951007","description":[],"label":"Sodium acetate","obo_id":"","type":"class"},{"iri":"http://id.nlm.nih.gov/mesh/D019346","ontology_name":"mesh","related_synonyms":["Sodium Acetate Trihydrate","Sodium Acetate, Anhydrous"],"ontology_prefix":"mesh","short_form":"mesh_D019346","description":["The trihydrate sodium salt of acetic acid, which is used as a source of sodium ions in solutions for dialysis and as a systemic and urinary alkalizer, diuretic, and expectorant."],"label":"Sodium Acetate","obo_id":"mesh:D019346","type":"class"},{"iri":"http://nmrML.org/nmrCV#NMR:1000028","ontology_name":"nmrcv","ontology_prefix":"NMR","short_form":"NMR__1000028","des
sodium bicarbonate - sodium citrate","sodium acetylsalicylate, sodium bicarbonate, and sodium citrate drug combination"],"ontology_prefix":"mesh","short_form":"mesh_C002931","description":[],"label":"sodium acetylsalicylate, sodium bicarbonate, sodium citrate drug combination","obo_id":"mesh:C002931","type":"class"},{"iri":"http://snomed.info/id/32836007","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_32836007","description":[],"label":"Sodium acetrizoate (substance)","obo_id":"","type":"class"},{"iri":"http://purl.obolibrary.org/obo/DRON_00752102","ontology_name":"dron","ontology_prefix":"DRON","short_form":"DRON_00752102","description":[],"label":"calcium chloride / magnesium chloride / potassium acetate / sodium acetate / sodium chloride Injectable Solution","obo_id":"DRON:00752102","type":"class"},{"iri":"http://purl.obolibrary.org/obo/NCIT_C48017","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C48017","description":["The anhydrous, sodium salt form of acetic acid. Sodium acetate anhydrous disassociates in water to form sodium ions (Na+) and acetate ions. Sodium is the principal cation of the extracellular fluid and plays a large part in fluid and electrolyte replacement therapies. Sodium acetate anhydrous is used as an electrolyte replenisher in isosmotic solution for parenteral replacement of acute losses of extracellular fluid without disturbing normal electrolyte balance."],"label":"Sodium Acetate Anhydrous","obo_id":"NCIT:C48017","type":"class","exact_synonyms":["SODIUM ACETATE ANHYDROUS","Sodium Acetate Anhydrous"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_31163","ontology_name":"chebi","related_synonyms":["Acetazolamide sodium salt","Diamox","N-(5-Sulfamoyl-1,3,4-thiadiazol-2-yl)acetamide monosodium salt","Sodium acetazolamide","Vetamox","sodium [(5-acetamido-1,3,4-thiadiazol-2-yl)sulfonyl]azanide"],"ontology_prefix":"CHEBI","short_form":"CHEBI_31163","description":[],"label":"acetazolamide sodium","obo_id":"CHEBI:31163","type":"class","exact_synonyms":["sodium [(5-acetamido-1,3,4-thiadiazol-2-yl)sulfonyl]azanide"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_749360","ontology_name":"chebi","related_synonyms":["Acetrizoate sodium salt","Acetrizoic acid sodium salt","Salpix","acetrizoate de sodium","acetrizoato de sodio"],"ontology_prefix":"CHEBI","short_form":"CHEBI_749360","description":[],"label":"acetrizoate sodium","obo_id":"CHEBI:749360","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_32138","ontology_name":"chebi","related_synonyms":["Sodium acetate trihydrate","sodium acetate--water (1/3)"],"ontology_prefix":"CHEBI","short_form":"CHEBI_32138","description":[],"label":"sodium acetate trihydrate","obo_id":"CHEBI:32138","type":"class","exact_synonyms":["sodium acetate--water (1/3)"]},{"iri":"http://purl.obolibrary.org/obo/NCIT_C61622","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C61622","description":["The sodium salt of acetazolamide, a nonbacteriostatic sulfonamide derivative with diuretic and anticonvulsant properties. Acetazolamide is a potent inhibitor of carbonic anhydrase that plays an important role in the control of fluid secretion. Inhibition of this enzyme in the kidney results in a reduction in the availability of hydrogen ions for active transport in the renal tubule lumen, thereby leading to increased bicarbonate and cation excretion, and increased urinary volume. Reduced bicarbonate level in circulation induces reduction of intraocular pressure via osmotic mechanism. The anticonvulsant activity of acetazolamide may contribute to inhibition of carbonic anhydrase in the CNS, which decreases carbon dioxide tension in the pulmonary alveoli, thus increasing arterial oxygen tension."],"label":"Acetazolamide Sodium","obo_id":"NCIT:C61622","type":"class","exact_synonyms":["ACETAZOLAMIDE SODIUM","Acetazolamide Sodium","Diamox","N-(5-(Aminosulfonyl)-1,3,4-thiadiazol-2-yl)acetamide Monosodium"]},{"iri":"http://snomed.info/id/72469007","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_72469007","description":[],"label":"Acetazolamide sodium","obo_id":"","type":"class"},{"iri":"http://purl.obolibrary.org/obo/DRON_00751141","ontology_name":"dron","ontology_prefix":"DRON","short_form":"DRON_00751141","description":[],"label":"calcium acetate / magnesium acetate / potassium acetate / potassium chloride / sodium acetate / sodium gluconate Injectable Solution","obo_id":"DRON:00751141","type":"class"},{"iri":"http://snomed.info/id/1269099002","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_1269099002","description":[],"label":"Sodium acetate anhydrous","obo_id":"","type":"class"},{"iri":"http://snomed.info/id/726006002","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_726006002","description":[],"label":"Sodium acetate trihydrate","obo_id":"","type":"class"},{"iri":"http://snomed.info/id/734516006","ontology_name":"snomed","ontology_prefix":"SNOMED","short_form":"SNOMED_734516006","description":[],"label":"Theophylline sodium acetate","obo_id":"","type":"class"}],"numFound":601,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["DRON","167","","113","mesh","112","CHEBI","98","NCIT","62","MICRO","13","WBPhenotype","5","UPHENO","5","ECTO","4","MCO","3","FOODON","2","PRIDE","2","MSIO","2","RXNO","1","EFO","1","CHMO","1","SCDO","1","XCO","1","HP","1","GENEPIO","1","TFO","1","OMIT","1","BAO","1","ADO","1","ORDO","1","NMR","1"],"isDefiningOntology":["true","470","false","131"],"ontologyId":["dron","167","mesh","112","chebi","98","slm","92","ncit","62","snomed","17","micro","13","upheno","5","wbphenotype","5","ecto","4","mco","3","pride","2","msio","2","medgen","2","foodon","2","xco","1","scdo","1","hp","1","chmo","1","aro","1","genepio","1","rxno","1","pr","1","nmrcv","1","ado","1","tfo","1","omit","1","efo","1","ordo","1","bao","1"],"ontologyIri":["http://purl.obolibra
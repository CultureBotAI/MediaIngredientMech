  "comments": [
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 3,
      "comment": "Mineral base B and C were filter sterilized and added to cooled autoclaved A + D."
    },
    {
      "paragraph_index": 4,
      "comment": "Unless otherwise specified, the medium was buffered at pH 6.8 with PIPES (10 mM)."
    },
    {
      "paragraph_index": 5,
      "comment": "Medium was dispensed into sterile vials and air was evacuated and replaced by N2 by alternately applying a vacuum and saturating with gas (Appl Environ Microbiol 32:781-791(1976))."
    },
    {
      "paragraph_index": 6,
      "comment": "Final anaerobiosis was achieved by adding neutral sterile Na2S . 9H2O to a final concentration of 0.025%."
    },
    {
      "paragraph_index": 7,
      "comment": "Isolate GE5 was plated on YPS medium solidified by Gelrite (Kelco Div. of Merck and Co., San Daego, Calif., USA) 14 g/L."
    },
    {
      "paragraph_index": 8,
      "comment": "Plates were incubated in an anaerobic jar at 95oC (gas phase N2/H2/CO2 90:5:5; 100 kPa)."
    },
    {
      "paragraph_index": 9,
      "comment": ""
    },
    {
      "paragraph_index": 11,
      "comment": ""
    },
    {
      "paragraph_index": 13,
      "comment": "Dissolve nitrilotriacetic acid with KOH to pH 6.5; then proceed to add minerals."
    },
    {
      "paragraph_index": 14,
      "comment": "pH to 7.0 with KOH"
    },
    {
      "paragraph_index": 15,
      "comment": ""
    },
    {
      "paragraph_index": 17,
      "comment": ""
    }
  ]
}
        {
          "pointer": "/decisions/82/disposition",
          "value": "new_distinct_ingredient_proposal",
          "previous_value_present": true,
          "previous_value": "broad_parent_relation_only",
          "changed": true,
          "disposition": "SUPPORTED_BOUNDED_REPORT_ONLY",
          "evidence_basis": "New distinct proposed owner follows exact supported apple term; original generic-parent-only decision remains historical."
        },
        {
          "pointer": "/decisions/82/reasoning",
          "value": "TOGO M2313 names apple pectin at 0.2% of unspecified basis among one-of alternative carbon materials. A supplier is not necessary to preserve this supported apple-material boundary. Active NCIT:C84042 (Pectin, Apple) supplies an exact term for this bounded material; CHEBI:17309 remains generic pectin and its related apple synonym does not establish generic exact identity. No source-specific grade, polymer structure, species or role is inferred.",
          "previous_value_present": true,
          "previous_value": "The source specifies apple-derived pectin as an alternate carbon material. CHEBI:17309 is a pectin class, not a guarantee of identical esterification, molecular-weight distribution or botanical preparation. An apple-source restriction is meaningful for a heterogeneous polysaccharide material; a broad parent relation can support it, but generic pectin exact identity would erase that restriction.",
          "changed": true,
          "disposition": "SUPPORTED_BOUNDED_REPORT_ONLY",
          "evidence_basis": "M2313 apple/citrus distinction and one-of0.2% unknown basis plus active exact NCIT term support bounded new material despite missing supplier/grade."
        },
        {
          "pointer": "/decisions/82/applicability",
          "value": "Only the one frozen apple-pectin occurrence and its TOGO M2313 primary context. The 0.2% applies to the chosen receiving-medium alternative, not an intrinsic stock strength. Citrus-peel pectin is a separately named alternative.",
          "previous_value_present": true,
          "previous_value": "Applies to the sole minimal-media occurrence and its explicit apple qualifier; no supplier or grade is specified in the frozen recipe.",
          "changed": true,
          "disposition": "SUPPORTED_BOUNDED_REPORT_ONLY",
          "evidence_basis": "Single frozen CM occurrence only; no blanket generic/citrus alias or intrinsic stock strength."
        },

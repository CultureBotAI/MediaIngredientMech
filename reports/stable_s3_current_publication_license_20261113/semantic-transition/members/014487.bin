{"id":31460,"chebi_accession":"CHEBI:31460","name":"desferrioxamine B mesylate","stars":3,"definition":"A methanesulfonate salt obtained by reaction of desferrioxamine B with one molar equivalent of methanesulfonic acid. It is an iron-chelating medicine used to remove excess iron from the body. It binds to iron in the blood, which is then passed out in the urine.","ascii_name":"desferrioxamine B mesylate","names":{"SYNONYM":[{"name":"Deferoxamine B mesylate","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"Deferoxamine B mesylate","adapted":false,"language_code":"en"},{"name":"Deferoxamine mesylate","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"Deferoxamine mesylate","adapted":false,"language_code":"en"},{"name":"Deferoxamine methanesulfonate","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"Deferoxamine methanesulfonate","adapted":false,"language_code":"en"},{"name":"desferrioxamine B methanesulfonate","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"desferrioxamine B methanesulfonate","adapted":false,"language_code":"en"},{"name":"desferrioxamine mesilate","status":"C","type":"SYNONYM","source":"DrugBank","ascii_name":"desferrioxamine mesilate","adapted":false,"language_code":"en"},{"name":"Desferrioxamine mesylate","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"Desferrioxamine mesylate","adapted":false,"language_code":"en"},{"name":"Desferrioxamine methanesulfonate","status":"C","type":"SYNONYM","source":"ChemIDplus","ascii_name":"Desferrioxamine methanesulfonate","adapted":false,"language_code":"en"}],"BRAND NAME":[{"name":"Desferal","status":"C","type":"BRAND NAME","source":"DrugBank","ascii_name":"Desferal","adapted":false,"language_code":"en"},{"name":"Desferin","status":"C","type":"BRAND NAME","source":"DrugBank","ascii_name":"Desferin","adapted":false,"language_code":"en"}],"IUPAC NAME":[{"name":"<em>N</em>'-{5-[acetyl(hydroxy)amino]pentyl}-<em>N</em>-(5-{4-[(5-aminope
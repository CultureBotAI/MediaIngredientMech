    <script>

      var acp_magento_options = {
        isp_serp_callback: function() {
          /* $(".isp_product_title strong").after("<br />");*/
          var title = $('#isp_main_search_box').val();
          $('h1.headline').html(title);
          if ( document.location.href.indexOf('living-algal-strains') > -1 ) {
            $('h1.headline').html('Living Algal Strains')};
                      if ( document.location.href.indexOf('collections-newly-accessioned-algal-strains-at-utex') > -1 ) {
            $('h1.headline').html('Newly Accessioned Algal Strains')};
          if ( document.location.href.indexOf('collections-epizoic-collection') > -1 ) {
            $('h1.headline').html('Epizoic Collection')
            $('div.subtitle').html('<p>UTEX maintains several unique collections of algae acquired through generous donations. Many of these strains are exclusive to UTEX, including numerous diatoms, marcroalgae, algae isolated from soil, and extremophiles bioprospected from harsh environments.</p>')};
          if ( document.location.href.indexOf('collections-dna-sequences-available') > -1 ) {
            $('h1.headline').html('DNA Sequences Available')
            $('div.subtitle').html('<p>This collection includes strains for which DNA sequence data are available.</p>')};

  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Mix ingregients except Solution 2, adjust pH to 7.5 and autoclave at 121°C for 20 min. After autoclaving, add filter-sterilized Solutin 2."
    },
    {
      "paragraph_index": 4,
      "comment": "First dissolve nitrilotriacetic acid and adjust pH to 7.0 with KOH, then add other salts. Adjust the final pH to 6.8 with NaOH or H2SO4."
    },
    {
      "paragraph_index": 6,
      "comment": "First dissolve nitrilotriacetic acid and adjust pH to 6.5 with NaOH, then add other salts.Final pH 7.0 with NaOH."
    },
    {
      "paragraph_index": 8,
      "comment": "Adjust pH to 7.5 and filter-sterilize."
    },
    {
      "paragraph_index": 10,
      "comment": "Adjust pH to 7.0 with NaOH."
    },
    {
      "paragraph_index": 11,
      "comment": ""
    },
    {
      "paragraph_index": 12,
      "comment": "10.0"
    }
  ]
}
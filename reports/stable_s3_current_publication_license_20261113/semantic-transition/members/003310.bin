"""Genuine native self-review save in an exclusively owned local review fixture."""
from pathlib import Path
import datetime, hashlib, json, os, subprocess, sys, types
D=Path(__file__).absolute().parent;F=D/'native-author-fixture'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def write(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b)
def js(p,v):write(p,(json.dumps(v,indent=2,ensure_ascii=False)+'\n').encode())
F.mkdir(exist_ok=False);captures=[]
sources=sorted((D/'inputs').rglob('*'))+sorted((D/'candidates').rglob('*'))
sources += [D/x for x in ['SELECTOR.json','field-deltas.json','origin-proof.json','primary-index.json','CAPTURE-MAP.json','INPUT-RECHECK.json','verification.json','native-row-diagnostic.json','coupled-dependencies.json','baseline-inventory.json','compose.py','compose.stderr','compose.stdout','compose-v2.py','compose-v2.stdout','compose-v2.stderr','verify.py','verify.stderr','verify.stdout','verify-v2.py','verify-v2.stdout','verify-v2.stderr','save_author_review.py']]
for p in sources:
 if not p.is_file():continue
 rel=Path('evidence')/p.relative_to(D);write(F/rel,p.read_bytes());captures.append({'original_path':str(p),'fixture_path':str(rel),'sha256':sha(p)})
for src,dest in [('inputs/producers/scripts/record_review.py','scripts/record_review.py'),('inputs/producers/schema/record_review.yaml','schema/record_review.yaml')]:
 p=D/src;write(F/dest,p.read_bytes());captures.append({'original_path':str(p),'fixture_path':dest,'sha256':sha(p)})
js(F/'evidence/FIXTURE-CAPTURE-MAP.json',{'scope':'Actual private author-review fixture; not a production baseline or independent scientific review. Exact original paths and hashes retained.','files':captures})
write(F/'README.md',b'Exclusive private native author-review fixture. Local Git snapshot identifies these exact captured inputs only; it is not the campaign production baseline. No shared repository or remote mutation.\n')
commands=[]
for args in [['init','--quiet'],['config','user.name','Codex private author fixture'],['config','user.email','codex-private@invalid'],['remote','add','origin','https://github.com/CultureBotAI/MediaIngredientMech.git'],['add','--all'],['-c','commit.gpgsign=false','commit','--quiet','-m','Capture exact three-method author-review inputs']]:
 cmd=['git','-C',str(F),*args];r=subprocess.run(cmd,capture_output=True,text=True,env={**os.environ,'GIT_OPTIONAL_LOCKS':'0'});commands.append({'command':cmd,'exit_code':r.returncode,'stdout':r.stdout,'stderr':r.stderr});assert r.returncode==0,commands[-1]
js(D/'fixture-creation.json',{'commands':commands,'scope':'Root-authorized exclusive private review-only snapshot. No shared branch or GitHub mutation.'})
rr=types.ModuleType('method_author_native');rr.__file__=str(F/'scripts/record_review.py');sys.modules[rr.__name__]=rr;exec(compile(Path(rr.__file__).read_bytes(),rr.__file__,'exec'),rr.__dict__)
sel=json.loads((D/'SELECTOR.json').read_text());groups=sel['groups'];ids=[g['operation_id'] for g in groups]
targets=[{'target_id':g['operation_id'],'path':'evidence/'+g['payload']['path'],'kind':'record','label':Path(g['source_record']).stem,'ownership_note':'Private successor by C; authentic maintained destination '+g['source_record']+' and original source origins remain in SELECTOR. No maintained application. A distinct reviewer must assess the complete candidate.'} for g in groups]
extra=[str(p.relative_to(F)) for p in F.rglob('*') if p.is_file() and '.git' not in p.relative_to(F).parts]
ins=rr.inspect_source(F,targets,extra)
now=datetime.datetime.now(datetime.timezone.utc);at=now.isoformat().replace('+00:00','Z');rid=now.strftime('%Y%m%dT%H%M%SZ')+'-c-three-method-author-response'
ev=[]
for eid,path,kind,summary in [
 ('E-ISSUE','inputs/issue/readback-00.json','record_content','Exact root-filed #1201 comment6724230173 precedes the correction; preserves the Diarsenic synonym-query qualification.'),
 ('E-ORIGINS','origin-proof.json','record_content','Six published proposal objects, eight source cases and their exact committed core/payload bytes; no new source origin or case outcome.'),
 ('E-DELTA','field-deltas.json','record_content','Each change is limited to mapping_quality plus one new LLM_SUGGESTION and one truthful history event; full old evidence/history prefixes and all other fields exact.'),
 ('E-CHECKS','verification.json','validation','Actual19 focused controls including schema, inverse-delta rejection, serialization, full coupled partonomy and three native rows.'),
 ('E-ROWS','native-row-diagnostic.json','validation','Native full13-field per-owner comparison with real KG gzip, cached primary labels and authentic A baseline plus exact three UW dependencies; no full corrected-campaign generation or stamps.'),
 ('E-PRIMARY','primary-index.json','record_content','Full cached primary structural, ontology, supplier, PubChem and actual OLS synonym-query bytes, with original URLs and source-case bindings.'),
 ('E-DEPENDENCIES','coupled-dependencies.json','record_content','Three known UW old-borate references remain a genuine standalone failure; exact previously planned child corrections close the combined bounded overlay.'),
 ('E-PLAN','SELECTOR.json','record_content','Author-only private selection preserves original kinds, authentic preimages and complete origin tuples; no application, export or independent approval.')]:
  fp=F/'evidence'/path;ev.append({'evidence_id':eid,'kind':kind,'reference':str(fp.relative_to(F)),'snapshot_sha256':sha(fp),'accessed_at':at,'support':'supports','summary':summary})
checks=[{'check_id':'C-FOCUSED','name':'Guarded private candidate and exact-delta verification','status':'passed','required':True,'target_ids':ids,'evidence_ids':['E-DELTA','E-CHECKS','E-ORIGINS'],'command':'PYTHONDONTWRITEBYTECODE=1 GIT_OPTIONAL_LOCKS=0 .temp/kgm-unmapped-20261107/env/bin/python -B '+str(D/'verify-v2.py'),'exit_code':0,'summary':'All three full native-schema records pass; exact original histories/evidence and all nonmethod fields preserved.19 checks passed; forbidden identity/history/evidence changes and invalid schema/occupied publication paths refuse.'},{'check_id':'C-ROWS','name':'Native per-owner full row differential','status':'passed','required':True,'target_ids':ids,'evidence_ids':['E-ROWS'],'summary':'Actual native projection retains skos:exactMatch identity and all label/other/comment fields, changes method to ManualMappingCuration, confidence0.99 to0.9 and source attribution. Uses the actual read-only KG gzip and no provider calls; final full-campaign row generation remains separate.'},{'check_id':'C-PARTONOMY','name':'Explicit known Borax dependency closure','status':'passed','required':True,'target_ids':ids,'evidence_ids':['E-DEPENDENCIES'],'summary':'Isolated-three overlay has the same three known unresolved CHEBI131366 references before/after the method edit. All three authentic unchanged UW payloads from cdff close them; full bounded overlay yields zero violations. No missing reference was waived.'}]
ass=[{'assessment_id':'A-PRESERVE','area':'provenance','topic':'Full candidate and source-lineage preservation','outcome':'supported','target_ids':ids,'evidence_ids':['E-ORIGINS','E-DELTA','E-PLAN'],'summary':'All three selected full owner objects retain their identities, chemistry, roles, aliases, rejected labels, source scopes and history. Original edit/create semantics and six source proposals/eight cases remain exact. No ancestor HUMAN evidence is rewritten and no fabricated native origin is introduced.'},{'assessment_id':'A-METHOD','area':'consistency','topic':'Truthful method grade with explicitly agent-authored evidence','outcome':'supported','target_ids':ids,'evidence_ids':['E-ISSUE','E-PRIMARY','E-DELTA','E-ROWS'],'summary':'The recorded structural-borax, material-versus-atom sulfur and empirical-versus-molecular oxide adjudications are represented by MANUAL_CURATION method quality. New evidence is LLM_SUGGESTION and history is LLM-assisted; the mapping-quality vocabulary is not the human-only MappingEvidence enum. Diarsenic retains its real exact As2O3 query and related-synonym support. This is the author response to filed findings, not distinct scientific approval.'},{'assessment_id':'A-DEPENDENCY','area':'ownership','topic':'Dependency and release limits','outcome':'supported','target_ids':ids,'evidence_ids':['E-DEPENDENCIES','E-PLAN'],'summary':'The three already-planned UW child corrections are explicit prerequisites for Borax installation; their bytes are not newly authored or approved here. No source, role, inherited occurrence, supported-export or companion hold is cleared.'}]
review={'schema_version':'1.0.0','review_id':rid,'kind':'batch','repository':ins['repository'],'title':'Author response: three grounded-method corrections under issue1201','started_at':sel['created_at'].replace('+00:00','Z'),'finished_at':at,'reviewer':{'identity':'Codex /root/step7d_science_c','kind':'agent','independence':'self_review','independence_basis':'C authored these exact successors and earlier Sulfur composition. This is only the author integrity and method-response record; root assigned A distinct method/preservation review and will retain separate whole-Sulfur independence. Private fixture source identity is not production baseline842.'},'skill':'curate-yaml-record','completion':'completed','verdict':'pass_with_limitations','scientific_review':False,'summary':'Three private method-quality successors have guarded schema-valid bytes, complete exact history/evidence retention, published source joins and bounded native diagnostic rows. Filed findings remain pending distinct successor review; no maintained or partial-B write, application or export approval.','source':ins['source'],'targets':targets,'scope':{'description':'Three complete private candidate records for a narrow method-quality/evidence/history response, with authentic unchanged source origins and explicit dependency coupling.','selection':'Exactly the three operations in frozen SELECTOR; provisional benzene triol and other W09 science findings excluded.','coverage':'full','population_size':3,'reviewed_target_ids':ids,'exclusions':[{'target':'Independent whole-owner scientific approval','reason':'This is an explicitly self-authored response; distinct final candidate review required.'},{'target':'Full corrected campaign generation/application/export','reason':'No native source prepare/apply, synchronization, full canonical generation, supported admission or receipt advancement occurred.'},{'target':'Benzene triol, selenite alias, Se/W and bicarbonate dispositions','reason':'Separate retained conclusions and author/reviewer assignments.'}]},'checks':checks,'assessments':ass,'evidence':ev,'findings':[],'actions':[],'limitations':['The known standalone Borax partonomy failure is preserved; installation requires the exact three original UW dependency corrections or a separately reviewed authentic successor.','Only original method, new evidence and new history change. All prior source/allotrope/lot/stock/quantity/role/release holds persist; original MANUAL_CURATION evidence authorship is not changed.','W09 original serialized native pair has a separately filed transport defect and is not relabelled as passing. Its scientific ledgers and C qualification remain distinct.','Original compose.py failed before any final candidate write because its private parent was absent; compose-v2 created the parent and reused verified identical frozen inputs. Original failed verify.py assumed an isolated overlay would have no dependency failures; verify-v2 retains the exact known failure and binds the already-planned UW closure. Both raw attempts remain visible.','The native row comparison uses a bounded immutable A842-plus-six overlay, actual KG gzip and cached official labels; no providers or final stamp replay. It does not substitute for independent full corrected-campaign row review.','The local Git snapshot only makes this private author review honestly saveable with exact captured inputs; it is not a production commit, fresh reviewer identity or application acceptance.'],'notes':['Root filed #1201 comment6724230173 before candidate authoring. No issue was closed and no previous finding terminal disposition was fabricated.']}
rr.validate_review(review,F/'schema/record_review.yaml');yp=rr.save_review(F,review,F/'schema/record_review.yaml');actual=rr.read_review(F,str(yp.relative_to(F)),F/'schema/record_review.yaml');assert actual==review
mp=yp.with_name('review.md');receipt={'status':'NATIVE_AUTHOR_SELF_REVIEW_SAVED_AND_STRICTLY_READ_BACK','source_root':str(F),'fixture_git_revision':ins['source']['git_revision'],'pair':{'yaml':str(yp),'markdown':str(mp),'yaml_sha256':sha(yp),'markdown_sha256':sha(mp)},'input_count':len(ins['source']['inputs']),'independence':'self_review','scientific_review':False,'independent_approval':False,'application_authorized':False}
js(D/'NATIVE-AUTHOR-RECEIPT.json',receipt);print(json.dumps(receipt,indent=2))

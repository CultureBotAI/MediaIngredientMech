  "comments": [
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 3,
      "comment": "After the medium has been autoclaved and cooled under 80% N2, 20% CO2, add the following aseptically from sterile stock solutions:"
    },
    {
      "paragraph_index": 5,
      "comment": ""
    },
    {
      "paragraph_index": 7,
      "comment": "The pH of the medium is 7.2-7.3. Adjust with dilute HCl or Na2CO3 if necessary."
    },
    {
      "paragraph_index": 8,
      "comment": "Distribute the medium (under 80% N2, 20% CO2) aseptically into sterile tubes and cap with butyl rubber stoppers."
    },
    {
      "paragraph_index": 9,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": "The pH of the medium is 7.2-7.3. Adjust with dilute HCl or Na2CO3 if necessary."
    },
    {
      "paragraph_index": 11,
      "comment": "Distribute the medium (under 80% N2, 20% CO2) aseptically into sterile tubes and cap with butyl rubber stoppers."
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 14,
      "comment": "Filter-sterilize."
    },
    {
      "paragraph_index": 15,
      "comment": ""
    },
    {
      "paragraph_index": 17,
      "comment": "Filter-sterilize under N2."
    },
    {
      "paragraph_index": 18,
      "comment": ""
    },
    {
      "paragraph_index": 20,
      "comment": "Dissolve the FeCl2 . 4H2O in the concentrated HCl, then dilute. Use 1.0 ml per liter of medium."
    }
  ]
}
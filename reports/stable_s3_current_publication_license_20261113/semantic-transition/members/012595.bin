<TR><TD WIDTH=75%> KCl                                                     </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;0.15&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>
<TR><TD WIDTH=75%> KH<sub>2</sub>PO<sub>4</sub>                                            </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;1.36&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> g  </TD></TR>

        {
          "pointer": "/ontology_mapping/evidence/1",
          "entry": {
            "evidence_type": "MANUAL_CURATION",
            "source": "MIM curation (#260)",
            "notes": "Added 'Natural seawater (filtered, 95% strength)' as a RELATED_SYNONYM (#260): the filtered-seawater term with a dilution stated. `95% strength` is a preparation detail belonging to the recipe, not a different substance, and no ontology distinguishes seawater by dilution. CultureMech uses this surface form and label_index did not contain it, so the lookup missed. No new record: MICRO:0001773 is this record's identifier, and in MIM the identifier IS the ontology CURIE, so a second record on it would be a duplicate primary key rather than added coverage."
          },
          "in_authentic_before": true,
          "entry_sha256": "d3b58822a1ea4d2200502317b04a796ea1291adae7c7c7e738cff1ef356f14b0",

      "annotation" : {
        "createdBy" : [ "Carrine Blank" ],
        "definition" : [ "An enzymatic digest of animal (mammalian) protein (of unspecified orgin), used for the culturing of microorganisms." ],
        "definition source" : [ "From BD Bionutrients Technical Manual (3rd edition revised).:\n\nBacto™ Peptone is an enzymatic digest of animal protein. Bacto Peptone was first introduced in 1914 and became the standard Peptone for the preparation of bacteriological culture media. The nutritive value of Bacto Peptone is largely dependent on the amino acid content that supplies essential nitrogen. Bacto Peptone contains only a negligible quantity of proteoses and more complex constituents.\n\nAsh content is 6.9%\nNaCl content is 1.7%" ],
        "has_exact_synonym" : [ "Bacto Peptone", "Bacto-peptone", "bacterial peptone", "peptones" ]
      },

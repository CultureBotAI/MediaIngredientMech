{"id":17439,"chebi_accession":"CHEBI:17439","name":"cyanocob(III)alamin","stars":3,"definition":"A complex cob(III)alamin in which cobalt is positioned in the centre of a planar corrin tetrapyrrole ring and bound axially to a 5,6-dimethylbenzimidazole moiety and a cyano group. It is one of several forms of the vitamin known as vitamin B12.","ascii_name":"cyanocob(III)alamin","names":{"SYNONYM":[{"name":"CN-Cbl","status":"C","type":"SYNONYM","source":"IUBMB","ascii_name":"CN-Cbl","adapted":false,"language_code":"en"},{"name":"CO-CYANOCOBALAMIN","status":"C","type":"SYNONYM","source":"PDBeChem","ascii_name":"CO-CYANOCOBALAMIN","adapted":false,"language_code":"en"},{"name":"Cyanocob(III)alamin","status":"C","type":"SYNONYM","source":"KEGG COMPOUND","ascii_name":"Cyanocob(III)alamin","adapted":false,"language_code":"en"},{"name":"Dicopac","status":"C","type":"SYNONYM","source":"KEGG COMPOUND","ascii_name":"Dicopac","adapted":false,"language_code":"en"},{"name":"vitamin B-12","status":"C","type":"SYNONYM","source":"IUBMB","ascii_name":"vitamin B-12","adapted":false,"language_code":"en"},{"name":"Vitamin B12 complex","status":"C","type":"SYNONYM","source":"KEGG COMPOUND","ascii_name":"Vitamin B12 complex","adapted":false,"language_code":"en"}],"INN":[{"name":"cyanocobalamin","status":"C","type":"INN","source":"KEGG DRUG","ascii_name":"cyanocobalamin","adapted":true,"language_code":"en"}],"UNIPROT NAME":[{"name":"cyanocob(III)alamin","status":"C","type":"UNIPROT NAME","source":"UniProt","ascii_name":"cyanocob(III)alamin","adapted":false,"language_code":"en"}],"IUPAC NAME":[{"name":"cyanocob(III)alamin","status":"C","type":"IUPAC NAME","source":"IUPAC","ascii_name":"cyanocob(III)alamin","adapted":false,"language_code":"en"},{"name":"<em>Co</em>α-[α-(5,6-dimethylbenzimidazolyl)]-<em>Co</em>β-cyanocobamide","status":"C","type":"IUPAC NAME","source":"IUPAC","ascii_name":"Coalpha-[alpha-(5,6-dimethylbenzimidazolyl)]-Cobeta-cyanocobamide","adapted":false,"language_code":"en"}]},
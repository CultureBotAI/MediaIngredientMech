  ],
  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Adjust medium for a final pH of 7.0. Mix all ingredients except cysteine and bring to boil under 80% N2, 10% H2, 10% CO2."
    },
    {
      "paragraph_index": 3,
      "comment": "Add cysteine and readjust pH, if necessary. Tube medium anaerobically using Hungate methods and the same gas phase. Autoclave at 121C for 15 minutes."
    },
    {
      "paragraph_index": 4,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "Mix CaCl2 and MgSO4 in 300.0 ml distilled water until dissolved. Add 500.0 ml water and the remaining salts while swirling slowly. Add 200.0 ml distilled water and mix. Store at 4C."
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": "Suspend hemin in NaOH; then add water. Autoclave at 121C for 15 minutes."
    },
    {
      "paragraph_index": 10,
      "comment": ""
    },
    {
      "paragraph_index": 12,
      "comment": "Store in brown bottle at 4C. Discard after 1 month."
    }
  ]
}
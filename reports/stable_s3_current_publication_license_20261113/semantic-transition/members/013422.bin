        "steps": [
          {
            "step_number": 1,
            "action": "DISSOLVE",
            "description": "For vial cultures, dissolve all ingredients except ethanol, vitamin solution, Na2S·9H2O, and cysteine-HCl."
          },
          {
            "step_number": 2,
            "action": "ALIQUOT",
            "description": "Flush the medium with N2/CO2 (80/20)."
          },
          {
            "step_number": 3,
            "action": "AUTOCLAVE",
            "description": "Autoclave the flushed medium."
          },
          {
            "step_number": 4,
            "action": "AUTOCLAVE",
            "description": "Sterilize concentrated Na2S·9H2O and cysteine-HCl solutions separately by autoclaving under N2 in tightly closed vessels."
          },
          {
            "step_number": 5,
            "action": "FILTER_STERILIZE",
            "description": "Filter-sterilize the 0.8 M ethanol and vitamin solutions."
          },
          {
            "step_number": 6,
            "action": "MIX",
            "description": "Add filter-sterilized ethanol and vitamin solutions and autoclaved Na2S·9H2O and cysteine-HCl solutions."
          },
          {
            "step_number": 7,
            "action": "MIX",
            "description": "Use a 10-20% inoculum."
          },
          {
            "step_number": 8,
            "action": "ADJUST_PH",
            "description": "For the trace element solution, first dissolve NTA in 200 ml water and adjust pH to 6.5 with KOH."
          }
        ],
        "references": [
          {
            "reference": "https://www.nite.go.jp/nbrc/catalogue/NBRCMediumDetailServlet?NO=1020"
          }

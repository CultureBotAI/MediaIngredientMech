  "comments": [
    {
      "paragraph_index": 1,
      "comment": "C. difficile was routinely cultured on Braziers agar (Bioconnections, Leeds, South Yorkshire, UK) containing 4% egg yolk, C. difficile supplement (Bioconnections) and 2% defibrinated horse blood or in brain heart infusion (BHI) broth containing C. difficile supplement (Oxoid, Basingstoke, Hampshire, UK) and 0.04% cysteine."
    },
    {
      "paragraph_index": 2,
      "comment": "All cultures were grown in an anaerobic atmosphere (10% CO2, 10% H2, 80% N2) at 37°C."
    },
    {
      "paragraph_index": 3,
      "comment": ""
    },
    {
      "paragraph_index": 5,
      "comment": ""
    }
  ]

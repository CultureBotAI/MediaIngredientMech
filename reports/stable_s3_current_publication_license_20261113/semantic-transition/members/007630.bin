    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 3,
      "comment": "Both media were buffered with either 100 mM morpholineethanesulfonic acid buffer or 100 mM morpholinepropanesulfonic acid buffer for growth at pH 6.5 and 7.5, respectively."
    },
    {
      "paragraph_index": 4,
      "comment": "Cultures were grown statically to provide anaerobic (or rather low microaerophilic) conditions."
    }
  ]
}
                "steps": [
                    {
                        "step": "1. Suspend 44 g Columbia Blood Agar Base in 1l deionized water. Heat to boiling to dissolve completely."
                    },
                    {
                        "step": "2. Sterilize by autoclaving for 15 min at 121\u00b0C."
                    },
                    {
                        "step": "3. Cool to 45\u00b0C. Add 5% sterile defibrinated sheep blood and mix well."
                    },
                    {
                        "step": "Rehydrate pellets of freeze-dried ampoules in liquid medium 220 (see below)."
                    }

from pathlib import Path
import copy, datetime, hashlib, importlib.util, io, json, os, subprocess, sys, tarfile
D=Path(__file__).absolute().parent;C=D.parents[1];M=C.parents[1];P=C/'integration/selenite718-alias-successor-v1';J=C/'integration/curation-worktree';A=C/'integration/ancillary1258-worktree';W=C/'workers/w01/worktree';F=D/'native-fixture'

ops={x['operation_id']:x for x in plan['records']};bindings={x['binding_id']:x for x in plan['bindings']}
op=lineage['original_operation_exact'];assert op==ops[op['operation_id']]
base=git(A,'show',plan['baseline_commit']+':'+op['before_source_record']);assert sha(base)==op['before_yaml_sha256'];put(F/'evidence/maintained-before.yaml',base)
ledger={}
for bid in ['w01-decisions','w01-proposals','w01-evidence-core']:
 b=bindings[bid];raw=git(W,'show',b['published_head']+':'+b['published_path']);assert sha(raw)==b['sha256'];put(F/'evidence/published'/Path(b['published_path']).name,raw);ledger[bid]=json.loads(raw)
proposals={x['proposal_id']:x for x in ledger['w01-proposals']['proposals']};decisions={x['case_id']:x for x in ledger['w01-decisions']['decisions']}
assert lineage['original_proposal_exact']==proposals['RS-009-ALIAS']
for k in ['original_case_exact','related_unresolved_case_exact']:
 v=lineage[k];assert v==decisions[v['case_id']]
assert len(lineage['original_case_exact']['occurrence_ids'])==4
assert len(bridge['deferred_operations_exact'])==3 and len(bridge['original_case_objects_exact'])==4
for x in bridge['deferred_operations_exact']:assert x==ops[x['operation_id']] and x['kind']=='create' and x['before_yaml_sha256'] is None
for x in bridge['original_case_objects_exact']:assert x==decisions[x['case_id']]
for x in bridge['original_proposals_exact']:assert x==proposals[x['proposal_id']]
assert set(bridge['case_ids_retained'])=={x['case_id'] for x in bridge['original_case_objects_exact']}
assert bridge['source_decisions_changed'] is False and bridge['not_a_merge_or_retarget'] is True
assert bridge['future_plan_sha256'] is None and bridge['future_operation_count'] is None
other=bridge['generic84gL_operation_remains_separate'];assert other==ops[other['operation_id']]


inv=copy.deepcopy(candidate);inv['synonyms'][12]['synonym_type']='RAW_TEXT';ev=inv['ontology_mapping']['evidence'].pop();hist=inv['curation_history'].pop();assert inv==before
assert ev['evidence_type']=='LLM_SUGGESTION' and hist['llm_assisted'] is True
assert not is_resolving_synonym(candidate['synonyms'][12])
valid=next(x for x in candidate['synonyms'] if x['synonym_text']=='Na2SeO3 (anhydrous)');assert is_resolving_synonym(valid)

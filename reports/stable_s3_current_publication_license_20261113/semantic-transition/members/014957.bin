    "raw_text": "identifier: CHEBI:132766\npreferred_term: Nitrilotriacetic acid, trisodium salt\nmapping_status: MAPPED\ningredient_type: SINGLE_INGREDIENT\nontology_mapping:\n  ontology_id: CHEBI:132766\n  ontology_label: sodium nitrilotriacetate\n  ontology_source: CHEBI\n  mapping_quality: EXACT_MATCH\n  evidence:\n  - evidence_type: MANUAL_CURATION\n    source: https://www.ebi.ac.uk/chebi/CHEBI:132766\n    notes: ChEBI explicitly specifies 3:1 sodium:nitrilotriacetate; restored after\n      a disodium-stock/trisodium-substance merge.\nchemical_properties:\n  cas_rn: 5064-31-3\n  data_source: OAK/CHEBI xref\n  retrieval_date: '2026-04-19T07:39:40.088267+00:00'\n  molecular_formula: C6H6NO6.3Na\n  inchi: InChI=1S/C6H9NO6.3Na/c8-4(9)1-7(2-5(10)11)3-6(12)13;;;/h1-3H2,(H,8,9)(H,10,11)(H,12,13);;;/q;3*+1/p-3\n  smiles: O=C([O-])CN(CC(=O)[O-])CC(=O)[O-].[Na+].[Na+].[Na+]\nsynonyms:\n- synonym_text: N,N-Bis(carboxymethyl)glycine, trisodium salt\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\n- synonym_text: NTA Trisodium salt\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\n- synonym_text: Nitrilotriacetic acid sodium salt\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\n- synonym_text: Nitrilotriacetic acid, trisodium salt\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\n- synonym_text: Trisodium N,N-bis(carboxymethyl)glycinate\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\n- synonym_text: Trisodium NTA\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\n- synonym_text: Trisodium aminotriacetate\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\n- synonym_text: Trisodium nitrilotriacetate\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\n- synonym_text: trisodium 2,2',2''-nitrilotriacetate\n  synonym_type: EXACT_SYNONYM\n  source: kg_microbe\noccurrence_statistics:\n  total_occurrences: 1\n  media_count: 1\ncuration_history:\n- timestamp: '2026-09-21T21:33:25.379198+00:00'\n  curator: mim_semantic_review_20260921\n  action: RESTORE
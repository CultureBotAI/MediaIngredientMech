  "comments": [
    {
      "paragraph_index": 1,
      "comment": "Basal Medium:"
    },
    {
      "paragraph_index": 3,
      "comment": "Adjust pH to 7.3-7.4. Autoclave at 121oC for 15 minutes."
    },
    {
      "paragraph_index": 4,
      "comment": "If agar is used, cool to 50-55 C in a water bath."
    },
    {
      "paragraph_index": 5,
      "comment": "Combine the 500mL of additive solution to the basal medium. Gently mix."
    },
    {
      "paragraph_index": 6,
      "comment": "If necessary, readjust pH to 7.35 +/- 0.1."
    },
    {
      "paragraph_index": 7,
      "comment": "Dispense into appropriate vessel type."
    },
    {
      "paragraph_index": 8,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": "Additive Solution:"
    },
    {
      "paragraph_index": 11,
      "comment": ""
    },
    {
      "paragraph_index": 13,
      "comment": "Prepare by adding 1.0 L of water to one bottle of CMRL-1066 powder. Mix to dissolve and filter-sterilize."
    },
    {
      "paragraph_index": 14,
      "comment": ""
    },
    {
      "paragraph_index": 15,
      "comment": "*This supplement is now available as ATCC 20-2206: 98.0 g powder and as ATCC 20-2207: 100.0 ml (10x solution)."
    },
    {
      "paragraph_index": 16,
      "comment": ""
    },
    {
      "paragraph_index": 17,
      "comment": "**Replaceable with newborn calf serum."
    },
    {
      "paragraph_index": 18,
      "comment": ""
    },
    {
      "paragraph_index": 20,
      "comment": ""
    },
    {
      "paragraph_index": 21,
      "comment": "Mix yeast and water; autoclave at 121C for 90 minutes at 15 psi pressure. Allow to stand."
    },
    {
      "paragraph_index": 22,
      "comment": "Remove supernatant solution. Adjust pH to 6.6-6.8."
    }
  ]
}
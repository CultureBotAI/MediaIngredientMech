  "comments": [
    {
      "paragraph_index": 5,
      "comment": "Dissolve FeCl2・4H2O first in HCl. Then dilute in distilled water and add the remaining salts."
    },
    {
      "paragraph_index": 7,
      "comment": "Autoclave Solutions A and B separately and combine after cooling. Filter--sterilize vitamin solution and add to the autoclaved medium."
    },
    {
      "paragraph_index": 8,
      "comment": "Adjust pH to 7.0."
    }
  ]
}
ipedia.en"}]},"roles_classification":[{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:33287","name":"fertilizer","definition":"A fertilizer is any substance that is added to soil or water to assist the growth of plants.","id":33287,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35610","name":"antineoplastic agent","definition":"A substance that inhibits or prevents the proliferation of neoplasms.","id":35610,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:38070","name":"anti-arrhythmia drug","definition":"A drug used for the treatment or prevention of cardiac arrhythmias. Anti-arrhythmia drugs may affect the polarisation-repolarisation phase of the action potential, its excitability or refractoriness, or impulse conduction or membrane responsiveness within cardiac fibres.","id":38070,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35554","name":"cardiovascular drug","definition":"A drug that affects the rate or intensity of cardiac contraction, blood vessel diameter or blood volume.","id":35554,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:35674","name":"antihypertensive agent","definition":"Any drug used in the treatment of acute or chronic vascular hypertension regardless of pharmacological mechanism.","id":35674,"biological_role":false},{"application":true,"chemical_role":false,"chebi_accession":"CHEBI:50503","name":"laxative","definition":"An agent that produces a soft formed stool, and relaxes and loosens the bowels, typically used over a protracted period, to relieve constipation. Compare with cathartic, which is a substance that accelerates defecation. A substances can be both a laxative and a cathartic.","id":50503,"biological_role":false},{"application":true,"chemical_role":true,"chebi_accession":"CHEBI:228364","name":"NMR chemical shift reference compound","defi
{"response":{"docs":[{"iri":"http://purl.obolibrary.org/obo/NCIT_C44362","ontology_name":"ncit","ontology_prefix":"NCIT","short_form":"NCIT_C44362","description":["A creamy, white crystalline substance. Cupferron is used as an analytical reagent to separate copper, iron and vanadium from other metals. Exposure to this substance causes gastrointestinal disturbances and skin, eye and respiratory-tract irritation. Cupferron is reasonably anticipated to be a human carcinogen based on evidence of carcinogenicity in experimental animals. (NCI05)"],"label":"Cupferron","obo_id":"NCIT:C44362","type":"class","exact_synonyms":["Ammonium N-hydroxy-N-nitrosobenzenamine","CUPFERRON","Cupferron","Inhibitor NPH","N-nitroso-N-phenylhydroxylamine Ammonium Salt"]}],"numFound":1,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["NCIT","1"],"isDefiningOntology":["true","1"],"ontologyId":["mesh","6","ncit","1"],"ontologyIri":["http://purl.obolibrary.org/obo/ncit.owl","1"],"isObsolete":["false","1"],"type":["class","1"]}}}
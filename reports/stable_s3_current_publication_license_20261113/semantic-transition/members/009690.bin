  "comments": [
    {
      "paragraph_index": 2,
      "comment": "Add components to distilled water and bring volume to 900 ml. Adjust pH to7.0 and autoclave. For preparation of solid medium, add 20.0 g/L Bacto agar (BD-Difco). Separately autoclave the following solution:"
    },
    {
      "paragraph_index": 4,
      "comment": "After autoclaving, add the solution to the medium."
    }
  ]
}
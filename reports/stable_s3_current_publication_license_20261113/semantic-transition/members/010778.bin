      "synonyms" : [ "M17 medium" ],
      "annotation" : {
        "createdBy" : [ "Carrine Blank" ],
        "curator note" : [ "DSM strains:\n" ],
        "definition" : [ "An organic-rich, liquid culture medium comprised of peptone from casein (casitone), soya peptone (soy peptone), peptone bacteriological (peptone), yeast extract, ascorbic acid, magnesium sulfate, sodium glycerophosphate, and lactose." ],
        "definition source" : [ "http://www.dsmz.de/microorganisms/medium/pdf/DSMZ_Medium449.pdf\n\n449. M17 MEDIUM FOR LACTIC STREPTOCOCCI\n\nPeptone from casein 5.00 g\nSoya peptone 5.00 g\nPeptone bacteriological 5.00 g\nYeast extract 2.50 g\nAscorbic acid 0.50 g\nMgSO4 x 7 H2O 0.25 g\nNa2-ß-glycerophosphate 19.00 g\nLactose 5.00 g\nDistilled water 1000.00 ml\n\nAdjust pH to 6.9 ± 0.2.\nLactose should be sterilized by filtration.\n\n© 2007 DSMZ GmbH - All rights reserved" ],
        "has_exact_synonym" : [ "M17 medium for lactic streptococci" ]
      },

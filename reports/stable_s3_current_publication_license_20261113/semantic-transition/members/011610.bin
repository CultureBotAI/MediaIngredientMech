<TR><TD WIDTH=75%> Pyridoxine&#183;HCl                                  </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;500.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> mg  </TD></TR>
<TR><TD WIDTH=75%> Vitamin B<sub>1</sub><sub>2</sub>                                     </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;100.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> mg  </TD></TR>
<TR><TD WIDTH=75%> Riboflavin                                            </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;100.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> mg  </TD></TR>
<TR><TD WIDTH=75%> Distilled water                                         </TD><TD WIDTH=15% ALIGN=RIGHT><font size=+1><tt>&nbsp;1.0&nbsp;&nbsp;&nbsp;&nbsp;</tt></font></TD><TD WIDTH=10% ALIGN=RIGHT> L  </TD></TR>
</TABLE>

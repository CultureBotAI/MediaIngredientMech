			});
		}


		  
		  function QuestionChk(){
		    var AlertMsg = '';
		
			
		    if (document.form1.InputRequestTarget.selectedIndex == '0'){
		      AlertMsg += 'お問合わせ区分を選択してください\n';	

		    }
			
		    if ($('#txtFeedback').val() == ''){
		      AlertMsg += '調査依頼内容を入力してください\n';		

		    }
		    if (AlertMsg != ''){						
		      alert(AlertMsg);
		      return false;
		    }else{
		      ShowBlock1();
		      $('#form1').submit();
		    }
		  }

		  function AlertView(){
		
		  }
		  
		
		function dNDLOpen(id){
			document.getElementById('dNID').value = id;
			document.dform.submit();
		}
		
		
		function buttonDisabled(id){
			var btn = document.getElementById(id);
			btn.disabled = true;
			setTimeout(function(){btn.disabled = false},3000); 
		}
		
		
		function OpenChgHistory(JutyuNo){

		<script type="text/javascript"><!--
		    var NextListParam  = [];
		    var NextListParam2 = [];
		

		
		  $(function(){
		

		

		    if($("#txtFeedback").val() == ''){
		      var count = $("#txtFeedback").val().length;
		      var max = $("#txtFeedback").attr("maxlength") - 1;
		      if (max - count < 0){
		        $("#InputNum").css("color", "red");
		      }else{
		        $("#InputNum").css("color", "blue");
		      }
		      $("#InputNum").text(max - count);
		    }
		    $("#txtFeedback").bind("change keyup",function(){
		      count = $(this).val().length;
		      max = $(this).attr("maxlength") - 1;
		      if (max - count < 0){
		        $("#InputNum").css("color", "red");
		      }else{
		        $("#InputNum").css("color", "blue");
		      }
		      $("#InputNum").text(max - count);
		    });

		
		
		  });
		

		
		
		

		  function StartSearch(Para1){
		    if (Para1 == '1'){
		      var TimeOut  = 30000;
		      var Interval = 200;
		      var Cnt      = 0;
		      var BlockView2;
		      BlockView2  = '';
		      BlockView2 += '<div id="ProgressOut" style="height: 24px; display: inline-block;"></div>';
		      $.blockUI({message: BlockView2, css: {padding: '10px', border: '3px solid #999999', color: '#666666'}, overlayCSS: {backgroundColor: '#FFFFFF'}});
		      setInterval(function(){
		        Cnt += Interval;

		        var DataURL = './EC-Progress.cfm?Dum=1&Dum=' + Date.now();
		        $.ajax({
		          url: DataURL,
		          type: "GET",
		          dataType: "html",
		          async: true
		        }).done(function(data){
		          $('#ProgressOut').replaceWith(data);
		        });
		        if (Cnt >= TimeOut){

		          location.href = './EC-TimeOutError.cfm';
		          $.unblockUI();
		          return false;
		        };
		      }, Interval);
		    }else{
		      $.blockUI({message: '<img src="./img/icon_loading03.gif" alt="loading" title="loading" width="160" height="24" style="border-style: none;">', css: {padding: '10px', border: '3px solid #999999', color: '#666666'}, overlayCSS: {backgroundColor: '#FFFFFF'}}); 
		    }
		  }
		
		

		
		
		
		function openDetail(JutyuNo){
			
			var tmpUrl = './EC-HatyuuJyokyoGeneralDetl.cfm?JutyuNo=' + JutyuNo;
			
			$.colorbox({
				iframe:true,
				width:'90%',
				height:'90%',
				maxWidth:'800px',
				fixed:true,
				opacity:0.7,
				scrolling:true,
				returnFocus:true,
				href:tmpUrl
			});
		}
		
		function JokyoUpdate(JutyuNo,tmpDefStatus){
			
			var tmpStatus = document.getElementById(JutyuNo + '-Status').value;
			var tmpNoki = document.getElementById(JutyuNo + '-Noki').value;
			var tmpBiko = document.getElementById(JutyuNo + '-Biko').value;
			var tmpUrl = './EC-HatyuuJyokyoUpdate.cfm';
			
			$.ajax({
				type: "POST",
				url: tmpUrl,
				data: {JutyuNo:JutyuNo,tmpStatus:tmpStatus,tmpDefStatus:tmpDefStatus,tmpNoki:tmpNoki,tmpBiko:tmpBiko}
			}).done(function(data) {
				$('#RapidMsg').fadeIn(800).delay(300).fadeOut(1200);
			});
		}
		
		
		function ExcelDownLoad(WMultiLingual,WSTRYMD,WSTPYMD,WebjutyuNo,AiteTyuban,SyohinCodeSrcKbn,SyohinCode,SyohinNameSrcKbn,SyohinName,ViewMode,ViewNTokuCode,ViewCstmCode,StatusKbn,SortKbn,UpdateDate){

			var tmpUrl = 	'./EC-HatyuuJyokyoExcelDL.cfm'
						+	'?WMultiLingual=' + WMultiLingual
						+	'&WSTRYMD=' + WSTRYMD
						+	'&WSTPYMD=' + WSTPYMD
						+	'&WebjutyuNo=' + WebjutyuNo
						+	'&AiteTyuban=' + AiteTyuban
						+	'&SyohinCodeSrcKbn=' + SyohinCodeSrcKbn
						+	'&SyohinCode=' + SyohinCode
						+	'&SyohinNameSrcKbn=' + SyohinNameSrcKbn
						+	'&SyohinName=' + SyohinName
						+	'&ViewMode=' + ViewMode
						+	'&ViewNTokuCode=' + ViewNTokuCode
						+	'&ViewCstmCode=' + ViewCstmCode
						+	'&StatusKbn=' + StatusKbn
						+	'&SortKbn=' + SortKbn
						+	'&UpdateDate=' + UpdateDate
						+	'&mode=LoadView'
						+	'&type=Hattyuujokyo';
						
			$.colorbox({
				iframe:true,
				width:'90%',
				height:'300px',
				maxWidth:'800px',
				fixed:true,
				opacity:0.7,
				scrolling:true,
				returnFocus:true,
				href:tmpUrl
			});
		
		}
		
		function ExcelDownLoadMeisai(WMultiLingual,WSTRYMD,WSTPYMD,ViewMode,ViewNTokuCode,ViewCstmCode,AddCAS,AddMakerName,AddApproverName,HistoryMemo){
			var tmpUrl = 	'./EC-HatyuuJyokyoExcelDL.cfm'
						+	'?WMultiLingual=' + WMultiLingual
						+	'&WSTRYMD=' + WSTRYMD
						+	'&WSTPYMD=' + WSTPYMD
						+	'&ViewMode=' + ViewMode
						+	'&ViewNTokuCode=' + ViewNTokuCode
						+	'&ViewCstmCode=' + ViewCstmCode
						+	'&AddCAS=' + AddCAS
						+	'&AddMakerName=' + AddMakerName
						+	'&AddApproverName=' + AddApproverName
						+	'&HistoryMemo=' + HistoryMemo
						+	'&mode=LoadView'
						+	'&type=Meisai';
			$.colorbox({
				iframe:true,
				width:'90%',
				height:'300px',
				maxWidth:'800px',
				fixed:true,
				opacity:0.7,
				scrolling:true,
				returnFocus:true,
				href:tmpUrl
			});
		}
		
		function statusCahge(id){
			var tmpType = document.getElementById(id + '-Status').value;
			
			if(tmpType == '01'){
				var tmpCss = '#FF0000';
			}else if(tmpType == '02' || tmpType == '03' || tmpType == '04'){
				var tmpCss = '#008800';
			}else if(tmpType == '05'){
				var tmpCss = '#0000FF';
			}else if(tmpType == '09'){
				var tmpCss = '#555555';
			}
			document.getElementById(id + '-Status').style.color = tmpCss;
		}

		
		function BtnRelation(Para1, Para2){
		  if(window.confirm(Para2 + 'します。よろしいですか？')){
		    ShowBlock1();
		    $('#SubmitID').val(Para1);
		    $('#form1').submit();
		  }else{ 
		    return false;
		  }
		}

		
		
		
		
		
		function _cb() {
			try {
				$("#row").css("display", "table-row");
			}
			catch(e) {}
		}
		
		

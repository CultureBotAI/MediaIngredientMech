  "comments": [
    {
      "paragraph_index": 2,
      "comment": ""
    },
    {
      "paragraph_index": 4,
      "comment": ""
    },
    {
      "paragraph_index": 6,
      "comment": "First dissolve FeCl2 in the HCl, then dilute in water, add and dissolve the other salts. Finally make up to 1000.0 ml."
    },
    {
      "paragraph_index": 7,
      "comment": ""
    },
    {
      "paragraph_index": 9,
      "comment": ""
    },
    {
      "paragraph_index": 10,
      "comment": "Solution C: Seven vitamins solution"
    },
    {
      "paragraph_index": 12,
      "comment": ""
    },
    {
      "paragraph_index": 14,
      "comment": ""
    },
    {
      "paragraph_index": 16,
      "comment": ""
    },
    {
      "paragraph_index": 18,
      "comment": ""
    },
    {
      "paragraph_index": 19,
      "comment": "Add and dissolve ingredients of solution A, adjust pH to 7.2 and sparge medium with 80% N2 and 20% CO2 gas mixture for 30 – 45 min to make it anoxic."
    },
    {
      "paragraph_index": 20,
      "comment": "Dispense medium under the same gas atmosphere into anoxic Hungate-type tubes and autoclave."
    },
    {
      "paragraph_index": 21,
      "comment": "Solution B is prepared under 80% N2 and 20% CO2 gas atmosphere and autoclaved."
    },
    {
      "paragraph_index": 22,
      "comment": "Solution C is prepared under 100% N2 gas and sterilized by filtration."
    },
    {
      "paragraph_index": 23,
      "comment": "Solutions D, E and F are autoclaved under 100% N2 gas atmosphere."
    },
    {
      "paragraph_index": 24,
      "comment": "To complete the medium appropriate amounts of solutions B to F are added to the sterile solution A in in the sequence as indicated."
    },
    {
      "paragraph_index": 25,
      "comment": "Note: Some cultures are shipped in semi-solid medium which stimulates growth at the beginning."
    },
    {
      "paragraph_index": 26,
      "comment": "For agar stabs 3.00 g/l agar are added to the complete medium from a sterile anoxic stock solution (2% w/v)."
    },
    {
      "paragraph_index": 27,
      "comment": "Upon receipt add anoxically 1 - 2 ml of the recommended freshly prepared liquid medium to the agar tube and incubate for 3 - 5 days."
    },
    {
      "paragraph_index": 28,
      "comment": "After incubation transfer 0.5 ml of the resulting cell suspension in the liquid phase to tubes with liquid medium."
    },
    {
      "paragraph_index": 29,
      "comment": ""
    },
    {
      "paragraph_index": 30,
      "comment": "Rumen fluid, clarified:"
    },
    {
      "paragraph_index": 31,
      "comment": "Rumen fluid from cow or sheep (obtained from fistulated animals or abattoir refuse) is filtered through muslin, autoclaved at 121°C for 15 min and then centrifuged at 27,000 g for 20 min."
    },
    {
      "paragraph_index": 32,
      "comment": "The supernatant is made anoxic by sparging with 100% N2 gas for 15 min, dispensed under same gas atmosphere into anoxic serum vials to 30% of volume and then stored frozen at -20°C."
    }
  ]
}
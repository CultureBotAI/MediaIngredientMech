      "iri" : "http://id.nlm.nih.gov/mesh/D010461",
      "lang" : "en",
      "description" : [ "Derived proteins or mixtures of cleavage products produced by the partial hydrolysis of a native protein either by an acid or by an enzyme. Peptones are readily soluble in water, and are not precipitable by heat, by alkalis, or by saturation with ammonium sulfate. (Dorland, 28th ed)" ],
      "synonyms" : [ "Peptone" ],

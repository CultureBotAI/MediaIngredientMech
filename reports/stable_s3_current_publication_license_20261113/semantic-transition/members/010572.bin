ption":[],"label":"tellanyl","obo_id":"CHEBI:30457","type":"class","exact_synonyms":["hydridotellurium(.)","tellanyl"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_30460","ontology_name":"chebi","related_synonyms":["HTe(-)","Tellurium hydride anion","[TeH](-)","hydrogen(tellanide)(1-)","tellanide"],"ontology_prefix":"CHEBI","short_form":"CHEBI_30460","description":[],"label":"tellanide","obo_id":"CHEBI:30460","type":"class","exact_synonyms":["hydrogen(tellanide)(1-)","tellanide"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_30461","ontology_name":"chebi","related_synonyms":["H6TeO6","Orthotellursaeure","[Te(OH)6]","hexahydroxidotellurium","orthotelluric acid","telluric(VI) acid","tellurium hydroxide"],"ontology_prefix":"CHEBI","short_form":"CHEBI_30461","description":[],"label":"orthotelluric acid","obo_id":"CHEBI:30461","type":"class","exact_synonyms":["hexahydroxidotellurium","orthotelluric acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_4613","ontology_name":"chebi","related_synonyms":["Dimethyl telluride","Dimethyltelluride","TeMe2","dimethyl telluride","dimethyltellane","dimethyltellurium"],"ontology_prefix":"CHEBI","short_form":"CHEBI_4613","description":["An  organotellurium compound in which the tellurium atom is covalently  bonded to two methyl groups. A xenobiotic metabolite produced by certain strains of bacteria exposed to tellurium containing compounds."],"label":"dimethyl telluride","obo_id":"CHEBI:4613","type":"class","exact_synonyms":["dimethyl telluride","dimethyltellane","dimethyltellurium"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_70755","ontology_name":"chebi","related_synonyms":["methanetelluronic acid"],"ontology_prefix":"CHEBI","short_form":"CHEBI_70755","description":["A tellurium oxoacid that is telluronic acid in which the hydrogen atom attached to tellurium is substituted by a methyl group."],"label":"methyltelluronic acid","obo_id":"CHEBI:70755","type":"class","exact_synonyms":["methanetelluronic acid"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_137980","ontology_name":"chebi","related_synonyms":["metalloid","metalloids"],"ontology_prefix":"CHEBI","short_form":"CHEBI_137980","description":["An atom of an element that exhibits properties that are between those of metals and nonmetals, or that has a mixture of them. The term generally includes boron, silicon, germanium, arsenic, antimony, and tellurium, while carbon, aluminium, selenium, polonium, and astatine are less commonly included."],"label":"metalloid atom","obo_id":"CHEBI:137980","type":"class"},{"iri":"http://purl.obolibrary.org/obo/CHEBI_30858","ontology_name":"chebi","related_synonyms":["tellurophene"],"ontology_prefix":"CHEBI","short_form":"CHEBI_30858","description":["A five-membered monocyclic heteroarene composed of four CH units and one tellurium atom. The parent of the class of tellurophenes."],"label":"tellurophene","obo_id":"CHEBI:30858","type":"class","exact_synonyms":["tellurophene"]},{"iri":"http://purl.obolibrary.org/obo/CHEBI_71624","ontology_name":"chebi","related_synonyms":["methanetellurite","methanetelluronate","methylated tellurite"],"ontology_prefix":"CHEBI","short_form":"CHEBI_71624","description":["A tellurium oxoanion that is the conjugate base of methanetelluronic acid."],"label":"methanetelluronate(1-)","obo_id":"CHEBI:71624","type":"class","exact_synonyms":["methanetelluronate"]}],"numFound":19,"start":0},"responseHeader":{"QTime":0,"status":0},"facet_counts":{"facet_fields":{"ontologyPreferredPrefix":["CHEBI","19"],"isDefiningOntology":["true","19"],"ontologyId":["snomed","24","mesh","21","chebi","19","slm","19","ecto","9","go","7","fypo","5","mco","5","micro","5","fix","3","rbo","3","ncit","2","chmo","2","pride","2","fbcv","1","obi","1","mondo","1","to","1","cco","1","rexo","1","one","1","oba","1","upheno","1","peco","1","gexo","1","zp","1","reto","1","dron","1","mop","1","valuesets","1","omit","1","wbphenotype","1","agro","1","sio","1"],"ontologyIri":["http://purl.obolibrary.org/obo/chebi.owl","19"
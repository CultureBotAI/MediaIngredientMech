"""2026-11-11: genuine native input inspection for independent chem99 review.

Writes only fresh private review receipts and a byte-identical prior-context copy.
No adoption workflow, decisions, records, lease, test or global review check.
"""
from pathlib import Path
from datetime import datetime, timezone
import contextlib
import hashlib
import json
import sys
import types

HERE=Path(__file__).absolute().parent
TC=HERE.parents[1]
C=TC.parents[1]
PREFIX='.temp/stable-adoption1303-real-canary-inputs-v1'
SCI='reports/separate-real-canary-chem99-inputs-v1'
sha=lambda raw:hashlib.sha256(raw).hexdigest()

def main():
    assert sys.version_info[:2]==(3,13)
    assert sys.executable==str(C/'integration/stable-campaign-adoption-worktree/.venv/bin/python3')
    pins={'context.json':'ab3d1c3947b0ad9933d2722804967208869b6c380b928132e1f7f0e476eca1f9','payloads.json':'21bd18ee7c5e5428c906d87dacd85dbbe6c97a252e524ecddb2408c3f3a0607a','targets.json':'7eb9f06aef2fc496812cb3696db0bb25a453d9e8332869e45fe43edcdb576711','UNASSESSED-REQUEST.json':'949863cd4406c92a7406304986ab34382115923722dadd9ca6e71c179d5b685a'}
    for name,h in pins.items():assert sha((TC/PREFIX/'inspection'/name).read_bytes())==h
    for name,h in {'chebi-16469.json':'3f00d0eb7f2cfc6c54893c000a6f4d65470887de39303fdbb780c2c77aa6147b','nbrc-1181.json':'2724a0074719e6a1ba3cb6b324fc3efb08557d978b430ab4a9f295af8fd57367','culturemech-estradiol.yaml':'5acdbafc9ba20a9e4335cf36f78fca1e319138e2b1c81db2263346188e22ce8e'}.items():assert sha((TC/SCI/name).read_bytes())==h
    prior=C/'integration/stable-campaign-adoption-worktree/.temp/stable-adoption1303-assessed-request-v1/ASSESSED-REQUEST.json'
    raw=prior.read_bytes();assert sha(raw)=='e99c3d34a9cdd0d807674646f9a9d75a0064baec875a9b3764d6a4d72d4fd4b0'
    local=HERE/'PRIOR-N-REQUEST-CONTEXT.json'
    with local.open('xb') as f:f.write(raw)
    provenance={'original_path':str(prior),'sha256':sha(raw),'copy_path':str(local.relative_to(TC)),'purpose':'Historical hold wording/context only; no earlier concept vote or approval is transferred.'}
    with (HERE/'PRIOR-CONTEXT-PROVENANCE.json').open('x') as f:json.dump(provenance,f,indent=2);f.write('\n')
    context=json.loads((TC/PREFIX/'inspection/context.json').read_bytes())
    inputs={'AGENTS.md','MAPPING_SEMANTICS.md','conf/record_review.yaml','schema/record_review.yaml','scripts/record_review.py','src/mediaingredientmech/schema/mediaingredientmech.yaml','.claude/skills/review-yaml-record/SKILL.md','.claude/skills/review-ingredients/SKILL.md','.claude/skills/review-ingredients/reference/validation-rules.md','docs/record-reviews.md','docs/record-review-profile.md','docs/STABLE_ID_ADOPTION.md','docs/STABLE_MIM_IDS.md','src/mediaingredientmech/curate/stable_id_adoption.py','data/ids/mim_id_registry.tsv','data/ids/mim_id_lifecycle.tsv',PREFIX+'/eligibility-intake.json',PREFIX+'/origin_accounting.json',PREFIX+'/origin_proof.json',str(Path(__file__).absolute().relative_to(TC)),str(local.relative_to(TC)),str((HERE/'PRIOR-CONTEXT-PROVENANCE.json').relative_to(TC))}
    inputs.update(PREFIX+'/inspection/'+name for name in pins)
    inputs.update(SCI+'/'+name for name in ['chebi-16469.json','nbrc-1181.json','culturemech-estradiol.yaml','COPY-PROVENANCE.json'])
    assert len(context['target_inventory'])==2956
    for name,h in context['target_inventory'].items():assert sha((TC/name).read_bytes())==h;inputs.add(name)
    p=TC/'scripts/record_review.py';source=p.read_bytes()
    native=types.ModuleType('_tc_chem99_skeptic_native_review');native.__file__=str(p);sys.modules[native.__name__]=native
    exec(compile(source,str(p),'exec'),native.__dict__)
    argv=['--repo-root',str(TC),'inspect','--targets',str(TC/PREFIX/'inspection/targets.json')]
    for name in sorted(inputs):argv+=['--input',name]
    out=HERE/'inspection';out.mkdir();started=datetime.now(timezone.utc).isoformat()
    with (out/'COMMAND.json').open('x') as f:json.dump({'helper':str(p),'helper_sha256':sha(source),'entrypoint':'main(argv)','argv':argv,'cwd':str(TC)},f,indent=2)
    with (out/'stdout.json').open('x') as stdout,(out/'stderr.txt').open('x') as stderr:
        with contextlib.redirect_stdout(stdout),contextlib.redirect_stderr(stderr):value=native.main(argv)
    code=0 if value is None else int(value)
    receipt={'started_at':started,'finished_at':datetime.now(timezone.utc).isoformat(),'exit_code':code,'source_input_count':len(inputs),'native_helper_sha256':sha(source),'stdout_sha256':sha((out/'stdout.json').read_bytes()),'stderr_sha256':sha((out/'stderr.txt').read_bytes()),'purpose':'Current independent native review inspection only; no scientific decision yet.'}
    with (out/'RESULT.json').open('x') as f:json.dump(receipt,f,indent=2);f.write('\n')
    print(json.dumps(receipt));raise SystemExit(code)

if __name__=='__main__':main()

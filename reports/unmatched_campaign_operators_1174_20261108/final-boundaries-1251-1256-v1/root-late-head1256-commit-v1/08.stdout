     ready = prepare(tmp_path)
     original_git = owner.git
 
     def broken_git(root, *args):
-        if args == ("diff", "--name-only", "-z", "HEAD", "--"):
+        # #1256 pins the comparison revision; the malformed-listing guard is unchanged.

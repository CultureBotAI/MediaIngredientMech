+def test_unrelated_inserted_row_preserves_frozen_hold_and_current_claim(corrected_hold):
+    original = json.loads((BUILDER_PATH.parent / "release-holds.json").read_text())
+    assert corrected_hold["document"] == original
+    resolution = original["resolutions"][0]
+    lineage = corrected_hold["lineage"][resolution["assertion_id"]]
+    insertion = next(item for item in lineage["receipts"] if item["sequence"] == 24)
+    assert insertion["before_position"] == 431 and insertion["after_position"] == 432
+    assert insertion["path"].endswith("issue751-313-235-stock-and-source-labels.json")
+    identity = corrected_hold["assertions"][0]
+    assert identity["assertion_id"] == lineage["assertion_id"]
+    assert int(identity["source_position"]) == lineage["current_position"]
+    assert identity["assertion_sha256"] == resolution["assertion_sha256"]
+    assert identity["resolution_status"] == "OPEN"
+    assert (
+        corrected_hold["record_hashes"][resolution["owner_record"]]
+        == resolution["owner_record_sha256"]
+    )
+    assert check(corrected_hold) == {}
+

{"code":"C120561","name":"Sodium Glycerophosphate","terminology":"ncit","version":"26.10d","conceptStatus":"DEFAULT","leaf":true,"active":true,"synonyms":[{"name":"Sodium Glycerophosphate","termType":"SY","type":"FULL_SYN","typeCode":"P90","source":"caDSR"},{"name":"SODIUM GLYCEROPHOSPHATE","termType":"PT","type":"FULL_SYN","typeCode":"P90","source":"FDA","code":"RCS9EQ01V4","subSource":"UNII"},{"name":"1,2,3-Propanetriol, Mono(dihydrogen Phosphate), Disodium Salt, Hydrate","termType":"SN","type":"FULL_SYN","typeCode":"P90","source":"NCI"},{"name":"Sodium Glycerophosphate","termType":"PT","type":"FULL_SYN","typeCode":"P90","source":"NCI"},{"name":"Sodium Glycerophosphate","type":"Preferred_Name","typeCode":"P108"}],"definitions":[{"definition":"The sodium salt form of an organic phosphate compound that provides phosphate for nutritional purposes. In addition, sodium glycerophosphate can be used as a phosphate diluting agent upon internal contamination with the beta-emiting radioisotope phosphate P 32 (P-32) that competes with P-32 for absorption. As sodium glycerophosphate is administered in high amounts, the absorption of P-32 is prevented or minimalized.","code":"P97","type":"DEFINITION","source":"NCI"}],"properties":[{"code":"P210","type":"CAS_Registry","value":"55073-41-1"},{"code":"P322","type":"Contributing_Source","value":"FDA"},{"code":"P319","type":"FDA_UNII_Code","value":"RCS9EQ01V4"},{"code":"P106","type":"Semantic_Type","value":"Pharmacologic Substance"},{"code":"P207","type":"UMLS_CUI","value":"C0377349"}],"parents":[{"code":"C29730","name":"Electrolyte Replacement Agent"}],"associations":[{"code":"A8","type":"Concept_In_Subset","relatedCode":"C63923","relatedName":"FDA Established Names and Unique Ingredient Identifier Codes Terminology"}],"history":[{"code":"C120561","action":"create","date":"2015-03-09"},{"code":"C120561","action":"modify","date":"2020-09-29"},{"code":"C120561","action":"modify","date":"2026-02-23"},{"code":"C120561","action":"modify